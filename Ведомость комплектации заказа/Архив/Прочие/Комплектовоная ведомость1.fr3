m.Cod_Gr, &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr,&#13;&#10;       T_SPRows.Kolvo as K01                                         &#13;&#10;FROM         &#13;&#10;       P_VKZ&#13;&#10;       INNER JOIN P_VKZ AS P_VKZ_SB &#13;&#10;               ON P_VKZ.Key_VKZ_Master = P_VKZ_SB.Key_VKZ &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON P_VKZ.Key_Predm = T_VPredm.Key_Predm &#13;&#10;       INNER JOIN T_VPredm AS T_VPredm_SB &#13;&#10;               ON P_VKZ_SB.Key_Predm = T_VPredm_SB.Key_Predm &#13;&#10;       INNER JOIN Gr_VxodPredm &#13;&#10;               ON P_VKZ.Key_Predm = Gr_VxodPredm.Key_Predm &#13;&#10;       INNER JOIN Gr_Groups &#13;&#10;               ON Gr_VxodPredm.Key_VidGr = Gr_Groups.Key_VidGr &#13;&#10;               AND Gr_VxodPredm.Cod_Gr = Gr_Groups.Cod_Gr&#13;&#10;       LEFT JOIN T_SPRows&#13;&#10;               ON T_SPRows.Key_SPRow= P_VKZ.Key_SPRow                                                                                                    &#13;&#10;GROUP BY &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       P_VKZ.Key_Predm, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.PrintFlag,                                 &#13;&#10;       T_VPredm.Cod_Prin,                                 &#13;&#10;       T_VPredm.Name_Prin,                                 &#13;&#10;       T_VPredm.Sortam, &#13;&#10;       T_VPredm.OrderSortam, &#13;&#10;       T_VPredm.Type_NTD_Sortam,&#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       P_VKZ_SB.Key_Predm,&#13;&#10;       T_VPredm_SB.Cod_Predm, &#13;&#10;       T_VPredm_SB.OrderCod_Predm, &#13;&#10;       P_VKZ.Cod_Postav, &#13;&#10;       Gr_VxodPredm.Key_VidGr, &#13;&#10;       Gr_VxodPredm.Cod_Gr, &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr,&#13;&#10;       T_SPRows.Kolvo  &#13;&#10;HAVING      &#13;&#10;       (P_VKZ.Key_VKZ_Izdel = :Key_VKZ_Izdel) &#13;&#10;       AND (P_VKZ.Cod_Postav &#60;&#62; '1') &#13;&#10;       AND (Gr_VxodPredm.Key_VidGr = 1)&#13;&#10;ORDER BY&#13;&#10;       Gr_VxodPredm.Cod_Gr,  &#13;&#10;       T_VPredm.Name_Predm, T_VPredm.OrderSortam                                   " PropData="05704C656674023C0470546F7002140A506172616D657465727301010C2A000000204E616D653D224B65795F564B5A5F497A64656C222044617461547970653D226674556E6B6E6F776E220000"/>
