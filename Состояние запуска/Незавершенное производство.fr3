<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41410,7068037384" ReportOptions.Description.Text="" ReportOptions.Name="Íåçàâåðøåííîå ïðîèçâîäñòâî.fr3 Ñîñòîÿíèå çàïóñêà" ReportOptions.LastChange="41477,5337632407" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('StartDate',Str);        &#13;&#10;  DateFrom.Date:= StrToDate( Str );  &#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('EndDate',Str);        &#13;&#10;  DateTO.Date:= StrToDate( Str );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnDeactivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:=DateToStr(DateFrom.Date);&#13;&#10;  MySaveString('StartDate',Str);        &#13;&#10;  Str:=DateToStr(DateTo.Date);&#13;&#10;  MySaveString('EndDate',Str);        &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2700000020446174615365743D22535172792220446174615365744E616D653D22D1EEF1F2EEFFEDE8E5220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="SQry" UserName="Ñîñòîÿíèå" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;	P_VKZ_Izdel.Cod_Zak, &#13;&#10;	P_VKZ_Izdel.Key_VKZ, &#13;&#10;	P_VKZ_Izdel.Kolvo,&#13;&#10; P_VKZ_Izdel.DataVip,                               &#13;&#10;&#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm,&#13;&#10;&#13;&#10;	T00.Cnt, &#13;&#10;	T00.Sm,&#13;&#10;	T0.Cnt Cnt0, &#13;&#10;	T0.Sm Sm0,&#13;&#10;	T1.Cnt Cnt1, &#13;&#10;	T1.Sm Sm1,&#13;&#10;	T2.Cnt Cnt2, &#13;&#10;	T2.Sm Sm2,&#13;&#10;	T3.Cnt Cnt3, &#13;&#10;	T3.Sm Sm3,&#13;&#10;	T4.Cnt Cnt4, &#13;&#10;	T4.Sm Sm4,&#13;&#10;	TR.Cnt CntR, &#13;&#10;	TR.Sm SmR,&#13;&#10;	TD.Cnt CntD, &#13;&#10;	TD.Sm SmD  &#13;&#10;       &#13;&#10;FROM         &#13;&#10;	P_VKZ AS P_VKZ_Izdel &#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON P_VKZ_Izdel.Key_Predm = T_VPredm.Key_Predm &#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;		) T00&#13;&#10;&#13;&#10;	ON T00.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND Isnull(dbo.Pr_VKZ_Get_Kolvo_Z0(Key_VKZ),0)  = 0&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;		) T0&#13;&#10;	ON T0.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND dbo.Pr_VKZ_Get_Kolvo_Z0(Key_VKZ)  &#60;&#62;  0&#13;&#10;				AND dbo.Pr_VKZ_Get_Kolvo_Z0(Key_VKZ) &#60; P_VKZ.Kolvo&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;&#13;&#10;		) T1&#13;&#10;	ON T1.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND dbo.Pr_VKZ_Get_Kolvo_Z0(Key_VKZ) &#62;= P_VKZ.Kolvo&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;&#13;&#10;		) T2&#13;&#10;	ON T2.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND dbo.Pr_VKZ_Get_Kolvo_Zap(Key_VKZ) &#62;= P_VKZ.Kolvo&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;&#13;&#10;		) T3&#13;&#10;	ON T3.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND dbo.Pr_VKZ_Get_Kolvo_Z1(Key_VKZ) &#62;= P_VKZ.Kolvo&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;&#13;&#10;		) T4&#13;&#10;	ON T4.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND dbo.Pr_VKZ_Get_Kolvo_Ready(Key_VKZ) &#62;= P_VKZ.Kolvo&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;&#13;&#10;		) TR&#13;&#10;	ON TR.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;  &#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND isnull(dbo.Pr_VKZ_Get_Kolvo_Z0(Key_VKZ),0) &#60; P_VKZ.Kolvo&#13;&#10;				AND P_VKZ.Key_VKZ_Sost = 1&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;		) TD  &#13;&#10;	ON TD.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;    &#13;&#10;  &#13;&#10;      &#13;&#10;WHERE     &#13;&#10;	(P_VKZ_Izdel.Key_VKZ_Master IS NULL)&#13;&#10;	AND P_VKZ_Izdel.Cod_SosZ='Ä'&#13;&#10;	AND P_VKZ_Izdel.Cod_Zak like '[0-9]%'&#13;&#10; AND P_VKZ_Izdel.LockDT = 1&#13;&#10; AND P_VKZ_Izdel.DataVip &#62;= :DateFrom&#13;&#10; AND P_VKZ_Izdel.DataVip &#60;= :DateTo                          &#13;&#10;&#13;&#10;ORDER BY 	 P_VKZ_Izdel.DataVip, dbo.T_OrderSortam(P_VKZ_Izdel.Cod_Zak), T_VPredm.OrderCod_Predm&#13;&#10;  " PropData=""/>
  </TfrxDataPage>
