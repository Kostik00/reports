    <TfrxERQuery Name="PrQRY" UserName="���������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="select * from Pr_Zakl&#13;&#10;where &#13;&#10;	Data_Zakl BETWEEN :DateFrom and :DateTo          &#13;&#10;	AND Key_Zakl IN&#13;&#10;	(&#13;&#10;	SELECT Key_Zakl FROM Pr_NaprZakl where Cod_TT like  :Cod_TT             &#13;&#10;	&#13;&#10;	)&#13;&#10;ORDER BY Data_Zakl, dbo.T_OrderSortam(Num_Zakl)&#13;&#10;  " PropData=""/>
    <TfrxERQuery Name="OborQRY" UserName="������������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="PrQRY" IgnoreDupParams="False" SQL.Text="/****** Script for SelectTopNRows command from SSMS  ******/&#13;&#10;SELECT        DISTINCT&#13;&#10;	Pr_Zakl.Key_Zakl, &#13;&#10;	Pr_NaprOborList.Name_Obor, &#13;&#10;	Pr_NaprOborList.Date_Obor, &#13;&#10;&#13;&#10;	Pr_NaprOborList.OborGr&#13;&#10;FROM            &#13;&#10;	Pr_Zakl &#13;&#10;	INNER JOIN Pr_NaprZakl &#13;&#10;		ON Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl &#13;&#10;	INNER JOIN Pr_NaprZakl_Obor &#13;&#10;		ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprZakl_Obor.Key_NaprZakl &#13;&#10;	INNER JOIN Pr_NaprOborList &#13;&#10;		ON Pr_NaprZakl_Obor.Key_NaprOborList = Pr_NaprOborList.Key_NaprOborList&#13;&#10;WHERE&#13;&#10;       Pr_Zakl.Key_Zakl = :Key_Zakl                " PropData="05704C6566740394000470546F7002300A506172616D657465727301010C25000000204E616D653D224B65795F5A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NaprZaklQRY" UserName="��������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="PrQRY" IgnoreDupParams="False" SQL.Text="SELECT   DISTINCT                                   &#13;&#10;&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;  Pr_Pasp.Cod_Pasp,&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_NaprZakl.Key_Zakl = :Key_Zakl                                                   &#13;&#10;&#13;&#10;  " PropData="05704C6566740394000470546F7002780A506172616D657465727301010C25000000204E616D653D224B65795F5A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
