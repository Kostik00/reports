<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41410,7068037384" ReportOptions.Description.Text="" ReportOptions.Name="Êîíòðîëü ñðîêîâ èçãîòîâëåíèÿ.fr3 Ñîñòîÿíèå çàïóñêà" ReportOptions.LastChange="41473,6289725231" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2700000020446174615365743D22535172792220446174615365744E616D653D22D1EEF1F2EEFFEDE8E5220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="SQry" UserName="Ñîñòîÿíèå" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;	P_VKZ_Izdel.Cod_Zak, &#13;&#10;	P_VKZ_Izdel.Key_VKZ, &#13;&#10;	P_VKZ_Izdel.Kolvo,&#13;&#10; P_VKZ_Izdel.DataVip,                         &#13;&#10;&#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm,&#13;&#10;&#13;&#10;	T00.Cnt, &#13;&#10;	T00.Sm,&#13;&#10; TR.Cnt CntR,       &#13;&#10;  &#13;&#10;	T00SB.Cnt CntSB, &#13;&#10;	T00SB.Sm  SmSB,&#13;&#10; TRSB.Cnt CntRSB,&#13;&#10;   &#13;&#10; TMinus.Cnt CntMinus,&#13;&#10; TMinus.DtMinus,&#13;&#10; TMinusVip.Cnt      CntMinusVip,&#13;&#10; TMinusVip.DtMinus  DtMinusVip,               &#13;&#10;&#13;&#10;&#13;&#10;   &#13;&#10; TMinusSB.Cnt CntMinusSB,&#13;&#10; TMinusSB.DtMinus  DtMinusSB,           &#13;&#10; TMinusVipSB.Cnt      CntMinusVipSB,&#13;&#10; TMinusVipSB.DtMinus  DtMinusVipSB                   &#13;&#10;           &#13;&#10;       &#13;&#10;FROM         &#13;&#10;	P_VKZ AS P_VKZ_Izdel &#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON P_VKZ_Izdel.Key_Predm = T_VPredm.Key_Predm &#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;		) T00&#13;&#10;  	ON  T00.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10; 			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt         &#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;				AND Isnull(dbo.Pr_VKZ_Get_Kolvo_Ready(Key_VKZ),0) &#62;= P_VKZ.Kolvo&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;				&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel  &#13;&#10;		) TR  &#13;&#10;  	ON  TR.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ  &#13;&#10;    &#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('00')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;		) T00SB    &#13;&#10;  	ON  T00SB.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10; 	LEFT JOIN&#13;&#10;		(&#13;&#10; 			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt         &#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('00')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;				AND Isnull(dbo.Pr_VKZ_Get_Kolvo_Ready(Key_VKZ),0) &#62;= P_VKZ.Kolvo&#13;&#10;				&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel  &#13;&#10;		) TRSB      &#13;&#10;  	ON  TRSB.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ  &#13;&#10;  &#13;&#10;    &#13;&#10;    &#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;  &#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				Max(DateDiff(dd,P_VKZ.DataZap,GetDate() ) ) DtMinus            &#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;				AND Isnull(dbo.Pr_VKZ_Get_Kolvo_Zap(Key_VKZ),0) &#60; P_VKZ.Kolvo&#13;&#10;				AND P_VKZ.DataZap &#60;= GetDate()&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;    &#13;&#10;		) TMinus&#13;&#10; 	ON  TMinus.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;  &#13;&#10;    &#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;  &#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				Max(DateDiff(dd,P_VKZ.DataZap,GetDate() ) ) DtMinus            &#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('00')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;				AND Isnull(dbo.Pr_VKZ_Get_Kolvo_Zap(Key_VKZ),0) &#60; P_VKZ.Kolvo&#13;&#10;				AND P_VKZ.DataZap &#60;= GetDate()&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;    &#13;&#10;		) TMinusSB        &#13;&#10; ON  TMinusSB.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10; 	LEFT JOIN&#13;&#10;		(&#13;&#10;  &#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				Max(DateDiff(dd,P_VKZ.DataVip,GetDate() ) ) DtMinus            &#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24', '72')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;				AND Isnull(dbo.Pr_VKZ_Get_Kolvo_Ready(Key_VKZ),0) &#60; P_VKZ.Kolvo&#13;&#10;				AND P_VKZ.DataVip &#60;= GetDate()&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;    &#13;&#10;		) TMinusVip            &#13;&#10; 	ON  TMinusVip.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;     &#13;&#10; 	LEFT JOIN&#13;&#10;		(&#13;&#10;  &#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				Max(DateDiff(dd,P_VKZ.DataVip,GetDate() ) ) DtMinus            &#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('00')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;    AND P_VKZ.Kolvo &#62; 0                                                                &#13;&#10;				AND Isnull(dbo.Pr_VKZ_Get_Kolvo_Ready(Key_VKZ),0) &#60; P_VKZ.Kolvo&#13;&#10;				AND P_VKZ.DataVip &#60;= GetDate()&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;    &#13;&#10;		) TMinusVipSB                    &#13;&#10; 	ON  TMinusVipSB.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;      &#13;&#10;      &#13;&#10;WHERE     &#13;&#10;	(P_VKZ_Izdel.Key_VKZ_Master IS NULL)&#13;&#10;	AND P_VKZ_Izdel.Cod_SosZ='Ä'&#13;&#10;	AND P_VKZ_Izdel.Cod_Zak like '[0-9]%'&#13;&#10; AND P_VKZ_Izdel.LockDT = 1                                                 &#13;&#10;&#13;&#10;ORDER BY 	DatePart(yyyy,P_VKZ_Izdel.DataVip), DatePart(qq,P_VKZ_Izdel.DataVip), DatePart(mm,P_VKZ_Izdel.DataVip), dbo.T_OrderSortam(P_VKZ_Izdel.Cod_Zak), T_VPredm.OrderCod_Predm&#13;&#10;  " PropData="05704C656674024C0470546F70024C0A506172616D65746572730100"/>
  </TfrxDataPage>
