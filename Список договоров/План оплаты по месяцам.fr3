mSm:=Sum(&#60;ÔàêòÎòãð.&#34;Sm&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('StartDate',Str);        &#13;&#10;  StartDate.Date:= StrToDate( Str );  &#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('EndDate',Str);        &#13;&#10;  EndDate.Date:= StrToDate( Str );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnDeactivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:=DateToStr(StartDate.Date);&#13;&#10;  MySaveString('StartDate',Str);        &#13;&#10;  Str:=DateToStr(EndDate.Date);&#13;&#10;  MySaveString('EndDate',Str);        &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CntSp:=0;                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DogovDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; // CntSp:=CntSp+1;&#13;&#10; // SPFtr.Visible:= CntSp&#62;1;                                      &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ProductQRY" UserName="Ïðîäóêöèÿ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;       D.NumSP,&#13;&#10;       D.N_SP,&#13;&#10;       D.Key_Product,&#13;&#10;       D.Cod_Zak,&#13;&#10;       D.Cod_ByDog,&#13;&#10;       D.Name_ByDog,&#13;&#10;       T.Cod_Predm,&#13;&#10;       T.Name_Predm,&#13;&#10;       D.Key_Product,                                     &#13;&#10;       D.Kolvo,&#13;&#10;       D.Kolvo*D.PriceSM Sm,&#13;&#10;&#13;&#10;&#13;&#10;       DBO.D_GetPlanDate(D.Key_Product,0,1,'001') Otgr,&#13;&#10;&#13;&#10;       dbo.D_FnGetPlanSmOnProduct (D.Key_Product, 2, 0, '01.01.01', GetDate() , Convert(datetime,'01.01.01')) PlanSm,&#13;&#10;       dbo.D_FnGetFactSmOnProduct (D.Key_Product, 2,    '01.01.01', GetDate()  )     FactSm,           &#13;&#10;&#13;&#10;--      dbo.D_FnGetFactSmOnProduct   (D.Key_Product, 2,    '01.01.01', :StartDate )     FactSm,&#13;&#10;--       dbo.D_FnGetFactKolvoOnProduct(D.Key_Product, 2,    '01.01.01', :StartDate )     FactKolvo,&#13;&#10;--       dbo.D_FnGetFactSmOnProduct   (D.Key_Product, 2,    :StartDate, :EndDate   )     FactSm1,&#13;&#10;&#13;&#10;--       dbo.D_FnGetFactSmROnProduct(D.Key_Product, 2,    '01.01.01', :StartDate  )    FactSmR,&#13;&#10;--       dbo.D_FnGetFactSmROnProduct(D.Key_Product, 2,    :StartDate, :EndDate    )    FactSmR1,&#13;&#10;                                          &#13;&#10;    &#13;&#10;       D1.Name1,&#13;&#10;       D1.Otgr1,&#13;&#10;       D1.Opl1,&#13;&#10;       D1.Name2,&#13;&#10;       D1.Otgr2,&#13;&#10;       D1.Opl2,&#13;&#10;       D1.Name3,&#13;&#10;       D1.Otgr3,&#13;&#10;       D1.Opl3&#13;&#10;FROM&#13;&#10;    D_Dogovor&#13;&#10;    INNER JOIN D_VProduct D&#13;&#10;       ON D.Cod_Dogov =   D_Dogovor.Cod_Dogov                                      &#13;&#10;        INNER JOIN T_VPredm T ON (D.Key_Izdel=T.Key_Predm)&#13;&#10;        INNER JOIN D_VProductPlanOplOtgr D1 ON (D.Key_Product=D1.Key_Product)&#13;&#10;WHERE&#13;&#10;    D_Dogovor.Cod_Dogov =:Cod_Dogov&#13;&#10;--    AND  (dbo.D_FnGetPlanSmOnProduct (D.Key_Product, 2, 0, :StartDate, :EndDate , GetDate() )   &#62; 0    &#13;&#10;   AND D.Cod_SosZ  = 'Ä'&#13;&#10;           &#13;&#10;&#13;&#10;ORDER BY        dbo.T_OrderSortam(D.NumSP), dbo.T_OrderSortam(D.N_SP)  &#13;&#10;                                    " SQLSchema="" PropData=""/>
    <TfrxERQuery Name="PlnQRY" UserName="Ïëàí" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="ProductQRY" IgnoreDupParams="False" SQL.Text="select &#13;&#10;	N_Str, &#13;&#10;	StrName,&#13;&#10;	dbo.D_FnGetPlanSmOnProduct  (  :Key_Product, 2, 0, Usr_PlnStr.DateFrom , Usr_PlnStr.DateTo, Convert(datetime,'20010101') ) -             &#13;&#10;	dbo.D_FnGetFactSmOnProduct  (  :Key_Product, 2,    Usr_PlnStr.DateFrom , Usr_PlnStr.DateTo            ) PlanSm,    &#13;&#10;  &#13;&#10;	dbo.D_FnGetPlanSmOnProduct  (  :Key_Product, 2, 0, Usr_PlnStr.DateFrom , Usr_PlnStr.DateTo, Convert(datetime,'20010101') ) PlanSm1,       &#13;&#10;	dbo.D_FnGetFactSmOnProduct  (  :Key_Product, 2,    Usr_PlnStr.DateFrom , Usr_PlnStr.DateTo            ) FactSm1       &#13;&#10;    &#13;&#10;from  Usr_PlnStr  &#13;&#10;&#13;&#10;WHERE ReportNum= :RepNum     &#13;&#10;&#13;&#10;ORDER BY N_Str                        " PropData="05704C65667403A0000470546F7002200A506172616D657465727301010C28000000204E616D653D224B65795F50726F64756374222044617461547970653D226674556E6B6E6F776E2200010C40000000204E616D653D225265704E756D222044617461547970653D226674496E7465676572222045787072657373696F6E3D225265704E756D456469742E54657874220000"/>
