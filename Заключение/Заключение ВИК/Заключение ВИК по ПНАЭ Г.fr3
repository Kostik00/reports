        <item FieldName="Tok" FieldType="fftString" Size="50"/>
        <item FieldName="Polyarn" FieldType="fftString" Size="50"/>
        <item FieldName="Sila" FieldType="fftString" Size="50"/>
        <item FieldName="DopInfo" FieldType="fftString" Size="50"/>
        <item FieldName="Napr" FieldType="fftString" Size="50"/>
        <item FieldName="Skor" FieldType="fftString" Size="50"/>
        <item FieldName="Podacha" FieldType="fftString" Size="50"/>
        <item FieldName="VidSert" FieldType="fftString" Size="50"/>
