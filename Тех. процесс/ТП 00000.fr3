    <TfrxERQuery Name="TPMat" UserName="Ìàòåðèàë" CloseDataSource="True" FieldAliases.Text="Key_TPMat=Key_TPMat&#13;&#10;Key_TPRows=Key_TPRows&#13;&#10;Key_SPRow=Key_SPRow&#13;&#10;Key_SPRow1=Key_SPRow1&#13;&#10;Key_Sposob=Key_Sposob&#13;&#10;SvrNum=SvrNum&#13;&#10;SposobSvr=SposobSvr&#13;&#10;Polojenie=Polojenie&#13;&#10;Tok=Tok&#13;&#10;Polyarn=Polyarn&#13;&#10;Sila=Sila&#13;&#10;Napr=Napr&#13;&#10;Skor=Skor&#13;&#10;Podacha=Podacha&#13;&#10;DopInfo=DopInfo&#13;&#10;Key_Predm=Key_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;Key_Predm1=Key_Predm1&#13;&#10;Cod_Predm1=Cod_Predm1&#13;&#10;Name_Predm1=Name_Predm1&#13;&#10;Sortam1=Sortam1&#13;&#10;Type_NTD_Sortam1=Type_NTD_Sortam1&#13;&#10;Name_NTD_Sortam1=Name_NTD_Sortam1&#13;&#10;Marka1=Marka1&#13;&#10;Type_NTD_Marka1=Type_NTD_Marka1&#13;&#10;Name_NTD_Marka1=Name_NTD_Marka1" BCDToCurrency="False" Master="TPData" IgnoreDupParams="False" SQL.Text="&#13;&#10;SELECT&#13;&#10;  T_TPMat.Key_TPMat,&#13;&#10;  convert(int,:Key_TPRows) Key_TPRows,&#13;&#10;  T_TPMat.Key_SPRow,&#13;&#10;  T_TPMat.Key_SPRow1,&#13;&#10;  T_TPMat.Key_Sposob,&#13;&#10;  dbo.T_TPMatSvr(T_TPMat.Key_TPMat) SvrNum,&#13;&#10;  T_SvrSposob.SposobSvr,&#13;&#10;&#13;&#10;  T_TPMat.Polojenie,&#13;&#10;  T_TPMat.Tok,&#13;&#10;  T_TPMat.Polyarn,&#13;&#10;  T_TPMat.Sila,&#13;&#10;  T_TPMat.Napr,&#13;&#10;  T_TPMat.Skor,&#13;&#10;  T_TPMat.Podacha,&#13;&#10;  T_TPMat.DopInfo,&#13;&#10;&#13;&#10;  T_SPRows.Key_Predm,&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;&#13;&#10;  T_SPRows1.Key_Predm Key_Predm1,&#13;&#10;  T_VPredm1.Cod_Predm Cod_Predm1,&#13;&#10;  T_VPredm1.Name_Predm Name_Predm1,&#13;&#10;  T_VPredm1.Sortam Sortam1,&#13;&#10;  T_VPredm1.Type_NTD_Sortam Type_NTD_Sortam1,&#13;&#10;  T_VPredm1.Name_NTD_Sortam Name_NTD_Sortam1,&#13;&#10;  T_VPredm1.Marka Marka1,&#13;&#10;  T_VPredm1.Type_NTD_Marka Type_NTD_Marka1,&#13;&#10;  T_VPredm1.Name_NTD_Marka Name_NTD_Marka1&#13;&#10;&#13;&#10;FROM&#13;&#10;  T_TPMat&#13;&#10;  INNER JOIN T_SPRows&#13;&#10;    ON T_TPMat.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON T_SPRows.Key_Predm = T_VPredm.Key_Predm&#13;&#10;  LEFT JOIN T_SvrSposob&#13;&#10;    ON T_SvrSposob.Key_Sposob=T_TPMat.Key_Sposob&#13;&#10;&#13;&#10;  LEFT JOIN T_SPRows  T_SPRows1&#13;&#10;    ON T_TPMat.Key_SPRow1 = T_SPRows1.Key_SPRow&#13;&#10;  LEFT JOIN T_VPredm  T_VPredm1&#13;&#10;    ON T_SPRows1.Key_Predm = T_VPredm1.Key_Predm&#13;&#10;&#13;&#10;WHERE&#13;&#10;  T_TPMat.Key_TPRows=:Key_TPRows&#13;&#10;ORDER BY T_TPMat.Key_TPMat" PropData="05704C65667403FC000470546F7002140A506172616D657465727301010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E2200010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrQry" UserName="Ñâàðêà" CloseDataSource="True" FieldAliases.Text="Key_TPRows=Key_TPRows&#13;&#10;Key_Svr=Key_Svr&#13;&#10;NumSvr=NumSvr&#13;&#10;OrderNumSvr=OrderNumSvr&#13;&#10;E=E&#13;&#10;EHi=EHi&#13;&#10;ELo=ELo&#13;&#10;E1=E1&#13;&#10;E1Hi=E1Hi&#13;&#10;E1Lo=E1Lo&#13;&#10;G=G&#13;&#10;GHi=GHi&#13;&#10;GLo=GLo&#13;&#10;G1=G1&#13;&#10;G1Hi=G1Hi&#13;&#10;G1Lo=G1Lo&#13;&#10;K=K&#13;&#10;KHi=KHi&#13;&#10;KLo=KLo&#13;&#10;K1=K1&#13;&#10;K1Hi=K1Hi&#13;&#10;K1Lo=K1Lo&#13;&#10;CatSvr=CatSvr&#13;&#10;TypeSvr=TypeSvr&#13;&#10;AdInfoSvr=AdInfoSvr&#13;&#10;SSvr=SSvr&#13;&#10;LSvr=LSvr" BCDToCurrency="False" Master="TPData" IgnoreDupParams="False" SQL.Text="SELECT  DISTINCT&#13;&#10;       T_Svr_TPRows.Key_TPRows,&#13;&#10;       T_Svr_TPRows.Key_Svr,&#13;&#10;--       T_SvrSposob.SposobSvr,&#13;&#10;--       T_SvrSposob.Comment,&#13;&#10;--       T_Svr_TPRows.Key_TPMat,&#13;&#10;--       T_Svr_TPRows.Primen,&#13;&#10;       T_Svr.NumSvr,&#13;&#10;        dbo.T_OrderSOrtam(T_Svr.NumSvr) OrderNumSvr,&#13;&#10;&#13;&#10;       T_Svr.E,&#13;&#10;       T_Svr.EHi,&#13;&#10;       T_Svr.ELo,&#13;&#10;&#13;&#10;       T_Svr.E1,&#13;&#10;       T_Svr.E1Hi,&#13;&#10;       T_Svr.E1Lo,&#13;&#10;&#13;&#10;       T_Svr.G,&#13;&#10;       T_Svr.GHi,&#13;&#10;       T_Svr.GLo,&#13;&#10;&#13;&#10;       T_Svr.G1,&#13;&#10;       T_Svr.G1Hi,&#13;&#10;       T_Svr.G1Lo,&#13;&#10;&#13;&#10;       T_Svr.K,&#13;&#10;       T_Svr.KHi,&#13;&#10;       T_Svr.KLo,&#13;&#10;&#13;&#10;       T_Svr.K1,&#13;&#10;       T_Svr.K1Hi,&#13;&#10;       T_Svr.K1Lo,&#13;&#10;&#13;&#10;       T_Svr.CatSvr,&#13;&#10;       T_Svr.TypeSvr,&#13;&#10;       T_Svr.AdInfoSvr,&#13;&#10;       T_Svr.SSvr,&#13;&#10;       T_Svr.LSvr                     &#13;&#10;         &#13;&#10;FROM&#13;&#10;       T_Svr_TPRows&#13;&#10;       INNER JOIN T_Svr&#13;&#10;         ON T_Svr_TPRows.Key_Svr = T_Svr.Key_Svr&#13;&#10;       INNER JOIN T_TPMat&#13;&#10;         ON T_Svr_TPRows.Key_TPMat = T_TPMat.Key_TPMat&#13;&#10;       INNER JOIN T_SvrSposob&#13;&#10;         ON T_SvrSposob.Key_Sposob=T_TPMat.Key_Sposob&#13;&#10;WHERE   T_Svr_TPRows.Key_TPRows=:Key_TPRows&#13;&#10;       AND :Cod_Oper in ('9100', '9110')&#13;&#10;&#13;&#10;ORDER BY  OrderNumSvr" PropData="05704C656674033C010470546F7002140A506172616D657465727301010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E2200010C25000000204E616D653D22436F645F4F706572222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="InstrumQry" UserName="Èíñòðóìåíò" CloseDataSource="True" FieldAliases.Text="Key_TPRows=Key_TPRows&#13;&#10;Key_Instrum=Key_Instrum&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;AdInfo=AdInfo&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka" BCDToCurrency="False" Master="TPData" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  T_TPInstrum.Key_TPRows,&#13;&#10;  T_TPInstrum.Key_Instrum,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.AdInfo,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka&#13;&#10;FROM&#13;&#10;  T_TPInstrum&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON T_TPInstrum.Key_Instrum = T_VPredm.Key_Predm&#13;&#10;WHERE T_TPInstrum.Key_TPRows=:Key_TPRows" PropData="05704C656674037C010470546F7002140A506172616D657465727301010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrInfo" UserName="Ñâàðêà1" CloseDataSource="True" FieldAliases.Text="Key_TPRows=Key_TPRows&#13;&#10;Key_Svr=Key_Svr&#13;&#10;NumSvr=NumSvr&#13;&#10;OrderNumSvr=OrderNumSvr&#13;&#10;E=E&#13;&#10;EHi=EHi&#13;&#10;ELo=ELo&#13;&#10;E1=E1&#13;&#10;E1Hi=E1Hi&#13;&#10;E1Lo=E1Lo&#13;&#10;G=G&#13;&#10;GHi=GHi&#13;&#10;GLo=GLo&#13;&#10;G1=G1&#13;&#10;G1Hi=G1Hi&#13;&#10;G1Lo=G1Lo&#13;&#10;K=K&#13;&#10;KHi=KHi&#13;&#10;KLo=KLo&#13;&#10;B=B&#13;&#10;BHi=BHi&#13;&#10;BLo=BLo&#13;&#10;H=H&#13;&#10;CatSvr=CatSvr&#13;&#10;TypeSvr=TypeSvr&#13;&#10;AdInfoSvr=AdInfoSvr" BCDToCurrency="False" Master="TPData" IgnoreDupParams="False" SQL.Text="SELECT  DISTINCT&#13;&#10;       T_Svr_TPRows.Key_TPRows,&#13;&#10;       T_Svr_TPRows.Key_Svr,&#13;&#10;       T_Svr.NumSvr,&#13;&#10;        dbo.T_OrderSOrtam(T_Svr.NumSvr) OrderNumSvr,&#13;&#10;&#13;&#10;       T_Svr.E,&#13;&#10;       T_Svr.EHi,&#13;&#10;       T_Svr.ELo,&#13;&#10;&#13;&#10;       T_Svr.E1,&#13;&#10;       T_Svr.E1Hi,&#13;&#10;       T_Svr.E1Lo,&#13;&#10;&#13;&#10;       T_Svr.G,&#13;&#10;       T_Svr.GHi,&#13;&#10;       T_Svr.GLo,&#13;&#10;&#13;&#10;       T_Svr.G1,&#13;&#10;       T_Svr.G1Hi,&#13;&#10;       T_Svr.G1Lo,&#13;&#10;&#13;&#10;       T_Svr.K,&#13;&#10;       T_Svr.KHi,&#13;&#10;       T_Svr.KLo,&#13;&#10;&#13;&#10;       T_Svr.B,&#13;&#10;       T_Svr.BHi,&#13;&#10;       T_Svr.BLo,&#13;&#10;&#13;&#10;       T_Svr.H,&#13;&#10;&#13;&#10;&#13;&#10;       T_Svr.CatSvr,&#13;&#10;       T_Svr.TypeSvr,&#13;&#10;       T_Svr.AdInfoSvr&#13;&#10;FROM&#13;&#10;       T_Svr_TPRows&#13;&#10;       INNER JOIN T_Svr&#13;&#10;         ON T_Svr_TPRows.Key_Svr = T_Svr.Key_Svr&#13;&#10;&#13;&#10;WHERE   T_Svr_TPRows.Key_TPRows=:Key_TPRows&#13;&#10;       AND T_Svr_TPRows.Key_TPMat is NULL&#13;&#10;&#13;&#10;ORDER BY  OrderNumSvr" PropData="05704C65667403BC010470546F7002140A506172616D657465727301010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrTypes" UserName="ÒèïûØâîâ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TPData" IgnoreDupParams="False" SQL.Text="SELECT * FROM T_SvrType&#13;&#10;WHERE TypeSvr in&#13;&#10;(    &#13;&#10;SELECT &#13;&#10;       T_Svr.TypeSvr&#13;&#10;FROM&#13;&#10;       T_Svr_TPRows&#13;&#10;       INNER JOIN T_Svr&#13;&#10;         ON T_Svr_TPRows.Key_Svr = T_Svr.Key_Svr&#13;&#10;       INNER JOIN T_SvrType&#13;&#10;         ON T_SvrType.TypeSvr=T_Svr.TypeSvr                                                               &#13;&#10;           &#13;&#10;WHERE   T_Svr_TPRows.Key_TPRows=:Key_TPRows            &#13;&#10;       AND :Cod_Oper     in ('9100')&#13;&#10;)" PropData="05704C656674033C010470546F70024C0A506172616D657465727301010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E2200010C25000000204E616D653D22436F645F4F706572222044617461547970653D226674556E6B6E6F776E220000"/>
