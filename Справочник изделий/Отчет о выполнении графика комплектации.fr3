<TfrxReport Version="4.15" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41842,6816746875" ReportOptions.Description.Text="" ReportOptions.Name="Îò÷åò î âûïîëíåíèè ãðàôèêà êîìïëåêòàöèè.fr3 Ñïðàâî÷íèê èçäåëèé" ReportOptions.LastChange="42024,6981204861" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10; Y,M,D:word ;                               &#13;&#10;begin&#13;&#10;  DecodeDate(Date,Y,M,D);&#13;&#10;  DateFrom.Date:=EncodeDate(Y,M,1);&#13;&#10;  DateTo.Date:=EncodeDate(Y,M,D) + EncodeTime(23,59,59,99);                                                              &#13;&#10;end;&#13;&#10;&#13;&#10;function FnPercent(P1,P2 :integer):double;                &#13;&#10;begin&#13;&#10;  Result:=0;                             &#13;&#10;  if P1&#62;0 then&#13;&#10;    Result:= P2*100/P1;                                                &#13;&#10;  &#13;&#10;end;          &#13;&#10;    &#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2700000020446174615365743D225A6170496E666F2220446174615365744E616D653D22C7E0EFF3F1EA2200010C2E00000020446174615365743D225A61704B6F6D706C496E666F2220446174615365744E616D653D22C7E0EFCAEEECEFEB220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ZapInfo" UserName="Çàïóñê" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10; D_Zakaz.Name_Zak,                           &#13;&#10; Izdel.Cod_Zak,                                         &#13;&#10;	Izdel.Key_VKZ_Izdel, &#13;&#10;	PredmIzdel.Cod_Predm AS IzdelCod_Predm, &#13;&#10;	PredmIzdel.Name_Predm AS IzdelName_Predm,&#13;&#10;	TAll.CntAll,&#13;&#10; TAllBefore.CntAll CntAllBefore,        &#13;&#10; TAllAfter.CntAll CntAllAfter,&#13;&#10;&#13;&#10; TAllOver.CntAll  CntAllOver,&#13;&#10;&#13;&#10; TOverBefore.InTime CntOverBefore,&#13;&#10; TZap01Over.InTime Zap01Over,                &#13;&#10;    &#13;&#10;	T1.InTime,&#13;&#10;	T1Before.InTime InTimeBefore,&#13;&#10;	T1After.InTime InTimeAfter,&#13;&#10; T1Over.InTime InTimeOver,                  &#13;&#10;    &#13;&#10;	TRezerv.RInTime,&#13;&#10;	TRezervBefore.RInTime RInTimeBefore,&#13;&#10;	TRezervAfter.RInTime RInTimeAfter,&#13;&#10;  &#13;&#10;	TRezervAll.RInTime  RAll ,&#13;&#10;&#13;&#10; TOverAll.CntZap,                 &#13;&#10;&#13;&#10;  &#13;&#10; TOtst.MaxDif,&#13;&#10; TSP.CntSP,&#13;&#10; TTP.CntTP     &#13;&#10;&#13;&#10;FROM         &#13;&#10;       P_VKZ AS Izdel &#13;&#10;       INNER JOIN  T_VPredm AS PredmIzdel &#13;&#10;               ON Izdel.Key_Predm = PredmIzdel.Key_Predm&#13;&#10;       INNER JOIN D_Zakaz&#13;&#10;               ON D_Zakaz.Cod_Zak = Izdel.Cod_Zak                                                                &#13;&#10;LEFT JOIN &#13;&#10;(&#13;&#10;	SELECT &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		COUNT(P_VKZ.Key_VKZ) CntAll&#13;&#10;	FROM P_VKZ&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#62;= :DateFrom&#13;&#10;		AND P_VKZ.DataZapUtv &#60;= :DateTo&#13;&#10;	&#13;&#10;	GROUP BY P_VKZ.Key_VKZ_Izdel&#13;&#10;) TAll&#13;&#10;  ON TAll.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel&#13;&#10;&#13;&#10;LEFT JOIN &#13;&#10;(&#13;&#10;	SELECT &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		COUNT(P_VKZ.Key_VKZ) CntAll&#13;&#10;	FROM P_VKZ&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;	&#13;&#10;	GROUP BY P_VKZ.Key_VKZ_Izdel&#13;&#10;) TAllOver            &#13;&#10;  ON TAllOver.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel  &#13;&#10;    &#13;&#10;&#13;&#10;LEFT JOIN &#13;&#10;(&#13;&#10;	SELECT &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		COUNT(P_VKZ.Key_VKZ) CntAll&#13;&#10;	FROM P_VKZ&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#60; :DateFrom&#13;&#10;&#13;&#10;	&#13;&#10;	GROUP BY P_VKZ.Key_VKZ_Izdel&#13;&#10;) TAllBefore            &#13;&#10;  ON TAllBefore.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel&#13;&#10;&#13;&#10;LEFT JOIN &#13;&#10;(&#13;&#10;	SELECT &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		COUNT(P_VKZ.Key_VKZ) CntAll&#13;&#10;	FROM P_VKZ&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#62; :DateTo  &#13;&#10;&#13;&#10;	&#13;&#10;	GROUP BY P_VKZ.Key_VKZ_Izdel&#13;&#10;) TAllAfter                    &#13;&#10;  ON TAllAfter.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel&#13;&#10;    &#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;(&#13;&#10;SELECT T001.Key_VKZ_Izdel, COUNT(T001.Key_VKZ) InTime&#13;&#10;FROM &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ, &#13;&#10;&#13;&#10;		SUM(Pr_PaspDet.KolvoZap) AS KolvoZap                           &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		INNER JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		INNER JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;			AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#62;= :DateFrom&#13;&#10;		AND P_VKZ.DataZapUtv &#60;= :DateTo&#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ&#13;&#10;) T001&#13;&#10;GROUP BY T001.Key_VKZ_Izdel&#13;&#10;) T1&#13;&#10;	ON T1.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;(&#13;&#10;SELECT T001.Key_VKZ_Izdel, COUNT(T001.Key_VKZ) InTime&#13;&#10;FROM &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ, &#13;&#10;&#13;&#10;		SUM(Pr_PaspDet.KolvoZap) AS KolvoZap                           &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		INNER JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		INNER JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;			AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;	WHERE &#13;&#10;    P_VKZ.DataZapUtv &#60; :DateFrom      &#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ&#13;&#10;) T001&#13;&#10;GROUP BY T001.Key_VKZ_Izdel&#13;&#10;) T1Before                        &#13;&#10;	ON T1Before.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel  &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;(&#13;&#10;SELECT T001.Key_VKZ_Izdel, COUNT(T001.Key_VKZ) InTime&#13;&#10;FROM &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ, &#13;&#10;&#13;&#10;		SUM(Pr_PaspDet.KolvoZap) AS KolvoZap                           &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		INNER JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		INNER JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;	--		AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;	WHERE &#13;&#10;    P_VKZ.DataZapUtv &#60; :DateFrom      &#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ&#13;&#10;) T001&#13;&#10;GROUP BY T001.Key_VKZ_Izdel&#13;&#10;) TOverBefore                        &#13;&#10;	ON TOverBefore.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel  &#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;(&#13;&#10;SELECT T001.Key_VKZ_Izdel, COUNT(T001.Key_VKZ) InTime&#13;&#10;FROM &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ, &#13;&#10;&#13;&#10;		SUM(Pr_PaspDet.KolvoZap) AS KolvoZap                           &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		INNER JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		INNER JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;	--		AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;	WHERE &#13;&#10;    P_VKZ.DataZapUtv &#62;= :DateFrom&#13;&#10;    AND P_VKZ.DataZapUtv &#60;= :DateTo  &#13;&#10;        &#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ&#13;&#10;) T001&#13;&#10;GROUP BY T001.Key_VKZ_Izdel&#13;&#10;) TZap01Over                        &#13;&#10;	ON TZap01Over.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel  &#13;&#10;  &#13;&#10;           &#13;&#10;&#13;&#10;  &#13;&#10;	LEFT JOIN &#13;&#10;(&#13;&#10;SELECT T001.Key_VKZ_Izdel, COUNT(T001.Key_VKZ) InTime&#13;&#10;FROM &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ, &#13;&#10;&#13;&#10;		SUM(Pr_PaspDet.KolvoZap) AS KolvoZap                           &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		INNER JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		INNER JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;			AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;	WHERE &#13;&#10;    P_VKZ.DataZapUtv &#62; :DateTo        &#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ&#13;&#10;) T001&#13;&#10;GROUP BY T001.Key_VKZ_Izdel&#13;&#10;) T1After                                &#13;&#10;	ON T1After.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;(&#13;&#10;SELECT T001.Key_VKZ_Izdel, COUNT(T001.Key_VKZ) InTime&#13;&#10;FROM &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ, &#13;&#10;&#13;&#10;		SUM(Pr_PaspDet.KolvoZap) AS KolvoZap                           &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		INNER JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		INNER JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;			AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;        &#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ&#13;&#10;) T001&#13;&#10;GROUP BY T001.Key_VKZ_Izdel&#13;&#10;) T1Over                                &#13;&#10;	ON T1Over.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel  &#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;(&#13;&#10;SELECT T001.Key_VKZ_Izdel, COUNT(T001.Key_VKZ) CntZap&#13;&#10;FROM &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ, &#13;&#10;&#13;&#10;		SUM(Pr_PaspDet.KolvoZap) AS KolvoZap                           &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		INNER JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		INNER JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;			AND Pr_Pasp.Key_Pasp_Status &#62;= 5&#13;&#10;	--		AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;        &#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		P_VKZ.Key_VKZ&#13;&#10;) T001&#13;&#10;GROUP BY T001.Key_VKZ_Izdel&#13;&#10;) TOverAll                                            &#13;&#10;	ON TOverAll.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel  &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;LEFT JOIN &#13;&#10;(SELECT Key_VKZ_Izdel, COUNT (Key_VKZ) RIntime FROM &#13;&#10;(&#13;&#10;(SELECT&#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo,&#13;&#10;	SUM (P_VKZ_VMZ.KolvoDT) KolvoDT&#13;&#10;FROM &#13;&#10;	P_VKZ&#13;&#10;	INNER JOIN T_VPredm &#13;&#10;&#13;&#10;		ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;		AND T_VPredm.Cod_Prin in ('10')&#13;&#10;    &#13;&#10;INNER JOIN&#13;&#10;	P_VKZ_VMZ&#13;&#10;	ON P_VKZ.Key_VKZ = P_VKZ_VMZ.Key_VKZ&#13;&#10;INNER JOIN&#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	P_VMZ.Key_VMZ, &#13;&#10;	P_VMZ.KolDSE, &#13;&#10;	SUM(A_Rezerv.KolDT) AS KolDT, &#13;&#10;	MAX(A_Rezerv.DateR) AS DateR&#13;&#10;FROM         &#13;&#10;	P_VMZ &#13;&#10;	INNER JOIN T_SPRows &#13;&#10;		ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow &#13;&#10;	INNER JOIN A_Rezerv &#13;&#10;		ON P_VMZ.Key_VMZ = A_Rezerv.Key_VMZ&#13;&#10;WHERE     (T_SPRows.SP_position = 0)&#13;&#10;GROUP BY P_VMZ.Key_VMZ, P_VMZ.KolDSE&#13;&#10;HAVING P_VMZ.KolDSE &#60;= SUM(A_Rezerv.KolDT)&#13;&#10;) TVMZ&#13;&#10;ON P_VKZ_VMZ.Key_VMZ = TVMZ.Key_VMZ&#13;&#10;	AND TVMZ.DateR &#60;= P_VKZ.DataZapUtv&#13;&#10;&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#62;= :DateFrom&#13;&#10;		AND P_VKZ.DataZapUtv &#60;= :DateTo&#13;&#10;GROUP BY P_VKZ.Key_VKZ_Izdel, P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo&#13;&#10;HAVING &#13;&#10;P_VKZ.Kolvo &#60;= SUM (P_VKZ_VMZ.KolvoDT))&#13;&#10;) TRezerv00&#13;&#10;GROUP BY  Key_VKZ_Izdel&#13;&#10;) TRezerv&#13;&#10;ON TRezerv.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN &#13;&#10;(SELECT Key_VKZ_Izdel, COUNT (Key_VKZ) RIntime FROM &#13;&#10;(&#13;&#10;(SELECT&#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo,&#13;&#10;	SUM (P_VKZ_VMZ.KolvoDT) KolvoDT&#13;&#10;FROM &#13;&#10;	P_VKZ&#13;&#10;	INNER JOIN T_VPredm &#13;&#10;&#13;&#10;		ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;		AND T_VPredm.Cod_Prin in ('10')&#13;&#10;    &#13;&#10;INNER JOIN&#13;&#10;	P_VKZ_VMZ&#13;&#10;	ON P_VKZ.Key_VKZ = P_VKZ_VMZ.Key_VKZ&#13;&#10;INNER JOIN&#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	P_VMZ.Key_VMZ, &#13;&#10;	P_VMZ.KolDSE, &#13;&#10;	SUM(A_Rezerv.KolDT) AS KolDT, &#13;&#10;	MAX(A_Rezerv.DateR) AS DateR&#13;&#10;FROM         &#13;&#10;	P_VMZ &#13;&#10;	INNER JOIN T_SPRows &#13;&#10;		ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow &#13;&#10;	INNER JOIN A_Rezerv &#13;&#10;		ON P_VMZ.Key_VMZ = A_Rezerv.Key_VMZ&#13;&#10;WHERE     (T_SPRows.SP_position = 0)&#13;&#10;GROUP BY P_VMZ.Key_VMZ, P_VMZ.KolDSE&#13;&#10;HAVING P_VMZ.KolDSE &#60;= SUM(A_Rezerv.KolDT)&#13;&#10;) TVMZ&#13;&#10;ON P_VKZ_VMZ.Key_VMZ = TVMZ.Key_VMZ&#13;&#10;	AND TVMZ.DateR &#60;= P_VKZ.DataZapUtv&#13;&#10;&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#60; :DateFrom&#13;&#10;&#13;&#10;GROUP BY P_VKZ.Key_VKZ_Izdel, P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo&#13;&#10;HAVING &#13;&#10;P_VKZ.Kolvo &#60;= SUM (P_VKZ_VMZ.KolvoDT))&#13;&#10;) TRezerv00&#13;&#10;GROUP BY  Key_VKZ_Izdel&#13;&#10;) TRezervBefore                        &#13;&#10;ON TRezervBefore.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN &#13;&#10;(SELECT Key_VKZ_Izdel, COUNT (Key_VKZ) RIntime FROM &#13;&#10;(&#13;&#10;(SELECT&#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo,&#13;&#10;	SUM (P_VKZ_VMZ.KolvoDT) KolvoDT&#13;&#10;FROM &#13;&#10;	P_VKZ&#13;&#10;	INNER JOIN T_VPredm &#13;&#10;&#13;&#10;		ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;		AND T_VPredm.Cod_Prin in ('10')&#13;&#10;    &#13;&#10;INNER JOIN&#13;&#10;	P_VKZ_VMZ&#13;&#10;	ON P_VKZ.Key_VKZ = P_VKZ_VMZ.Key_VKZ&#13;&#10;INNER JOIN&#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	P_VMZ.Key_VMZ, &#13;&#10;	P_VMZ.KolDSE, &#13;&#10;	SUM(A_Rezerv.KolDT) AS KolDT, &#13;&#10;	MAX(A_Rezerv.DateR) AS DateR&#13;&#10;FROM         &#13;&#10;	P_VMZ &#13;&#10;	INNER JOIN T_SPRows &#13;&#10;		ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow &#13;&#10;	INNER JOIN A_Rezerv &#13;&#10;		ON P_VMZ.Key_VMZ = A_Rezerv.Key_VMZ&#13;&#10;WHERE     (T_SPRows.SP_position = 0)&#13;&#10;GROUP BY P_VMZ.Key_VMZ, P_VMZ.KolDSE&#13;&#10;HAVING P_VMZ.KolDSE &#60;= SUM(A_Rezerv.KolDT)&#13;&#10;) TVMZ&#13;&#10;ON P_VKZ_VMZ.Key_VMZ = TVMZ.Key_VMZ&#13;&#10;	AND TVMZ.DateR &#60;= P_VKZ.DataZapUtv&#13;&#10;&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#62; :DateTo  &#13;&#10;&#13;&#10;GROUP BY P_VKZ.Key_VKZ_Izdel, P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo&#13;&#10;HAVING &#13;&#10;P_VKZ.Kolvo &#60;= SUM (P_VKZ_VMZ.KolvoDT))&#13;&#10;) TRezerv00&#13;&#10;GROUP BY  Key_VKZ_Izdel&#13;&#10;) TRezervAfter                                &#13;&#10;ON TRezervAfter.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel  &#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;&#13;&#10;            &#13;&#10;&#13;&#10;LEFT JOIN &#13;&#10;(SELECT Key_VKZ_Izdel, COUNT (Key_VKZ) RIntime FROM &#13;&#10;(&#13;&#10;(SELECT&#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo,&#13;&#10;	SUM (P_VKZ_VMZ.KolvoDT) KolvoDT&#13;&#10;FROM &#13;&#10;	P_VKZ&#13;&#10;	INNER JOIN T_VPredm &#13;&#10;&#13;&#10;		ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;		AND T_VPredm.Cod_Prin in ('10')&#13;&#10;INNER JOIN&#13;&#10;	P_VKZ_VMZ&#13;&#10;	ON P_VKZ.Key_VKZ = P_VKZ_VMZ.Key_VKZ&#13;&#10;INNER JOIN&#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	P_VMZ.Key_VMZ, &#13;&#10;	P_VMZ.KolDSE, &#13;&#10;	SUM(A_Rezerv.KolDT) AS KolDT, &#13;&#10;	MAX(A_Rezerv.DateR) AS DateR&#13;&#10;FROM         &#13;&#10;	P_VMZ &#13;&#10;&#13;&#10;&#13;&#10;	INNER JOIN T_SPRows&#13;&#10;		ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow &#13;&#10;	INNER JOIN A_Rezerv &#13;&#10;		ON P_VMZ.Key_VMZ = A_Rezerv.Key_VMZ&#13;&#10;WHERE     (T_SPRows.SP_position = 0)&#13;&#10;GROUP BY P_VMZ.Key_VMZ, P_VMZ.KolDSE&#13;&#10;HAVING P_VMZ.KolDSE &#60;= SUM(A_Rezerv.KolDT)&#13;&#10;) TVMZ&#13;&#10;ON P_VKZ_VMZ.Key_VMZ = TVMZ.Key_VMZ&#13;&#10;	--AND TVMZ.DateR &#60;= P_VKZ.DataZapUtv&#13;&#10;&#13;&#10;&#13;&#10;GROUP BY P_VKZ.Key_VKZ_Izdel, P_VKZ.Key_VKZ,&#13;&#10;	P_VKZ.Kolvo&#13;&#10;HAVING &#13;&#10;P_VKZ.Kolvo &#60;= SUM (P_VKZ_VMZ.KolvoDT))&#13;&#10;) TRezerv00&#13;&#10;GROUP BY  Key_VKZ_Izdel&#13;&#10;) TRezervAll          &#13;&#10;ON TRezervAll.Key_VKZ_Izdel = Izdel.Key_VKZ_Izdel                   &#13;&#10;&#13;&#10;LEFT JOIN &#13;&#10;(&#13;&#10;	SELECT     &#13;&#10;		P_VKZ.Key_VKZ_Izdel, &#13;&#10;		min(Convert(float, (P_VKZ.DataZapUtv - isNull(Pr_Pasp.Date_Zap,Getdate())  ) )) MaxDif                    &#13;&#10;	FROM         &#13;&#10;		P_VKZ &#13;&#10;		LEFT JOIN Pr_PaspDet &#13;&#10;			ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		LEFT JOIN Pr_Pasp &#13;&#10;			ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;			AND Pr_Pasp.Date_Zap &#60;= P_VKZ.DataZapUtv&#13;&#10;		INNER JOIN T_VPredm&#13;&#10;			ON  T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_VPredm.Cod_Prin in ('10')&#13;&#10; where P_VKZ.DataZapUtv &#60; isNull(Pr_Pasp.Date_Zap,Getdate())                    &#13;&#10;	GROUP BY &#13;&#10;		P_VKZ.Key_VKZ_Izdel  &#13;&#10;) TOtst&#13;&#10;ON  TOtst.Key_VKZ_Izdel =   Izdel.Key_VKZ_Izdel&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	COUNT(T_SP.Key_SP)  CntSP          &#13;&#10;	&#13;&#10;FROM         &#13;&#10;	P_VKZ &#13;&#10;		INNER JOIN T_VPredm     T_Predm         &#13;&#10;			ON  T_Predm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_Predm.Cod_Prin in ('10')&#13;&#10;	INNER JOIN T_SP &#13;&#10;		ON T_Predm.Key_Predm = T_SP.Key_Predm &#13;&#10;		AND T_Predm.SP_Version = T_SP.SP_Version&#13;&#10;	--	AND (T_SP.Key_T_Status = 3)&#13;&#10;		AND T_SP.Utv_date &#60; P_VKZ.DataZapUtv&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#62;= :DateFrom&#13;&#10;		AND P_VKZ.DataZapUtv &#60;= :DateTo&#13;&#10;  &#13;&#10;GROUP BY &#13;&#10;	P_VKZ.Key_VKZ_Izdel&#13;&#10;) TSP         &#13;&#10;ON TSP.Key_VKZ_Izdel =   Izdel.Key_VKZ_Izdel&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	COUNT(T_SP.Key_SP) CntTP&#13;&#10;	&#13;&#10;FROM         &#13;&#10;	P_VKZ &#13;&#10;		INNER JOIN T_VPredm     T_Predm         &#13;&#10;			ON  T_Predm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;			AND T_Predm.Cod_Prin in ('10')&#13;&#10;&#13;&#10;  &#13;&#10;	INNER JOIN T_SP &#13;&#10;		ON T_Predm.Key_Predm = T_SP.Key_Predm &#13;&#10;		AND T_Predm.SP_Version = T_SP.SP_Version&#13;&#10;		--AND (T_SP.Key_T_Status = 3)&#13;&#10;		--AND T_SP.Utv_date &#62; P_VKZ.DataZapUtv&#13;&#10;	INNER JOIN T_TP&#13;&#10;		ON T_TP.Key_TP = T_SP.Key_TP&#13;&#10;		--AND (T_TP.Key_T_Status = 3)&#13;&#10;		AND T_TP.Utv_date &#60; P_VKZ.DataZapUtv&#13;&#10;	&#13;&#10;	WHERE &#13;&#10;		    P_VKZ.DataZapUtv &#62;= :DateFrom&#13;&#10;		AND P_VKZ.DataZapUtv &#60;= :DateTo&#13;&#10;  &#13;&#10;GROUP BY &#13;&#10;	P_VKZ.Key_VKZ_Izdel&#13;&#10;    &#13;&#10;) TTP         &#13;&#10;ON TTP.Key_VKZ_Izdel =   Izdel.Key_VKZ_Izdel&#13;&#10;      &#13;&#10;  &#13;&#10; &#13;&#10;WHERE     &#13;&#10;		(Izdel.Cod_SosZ = 'Ä') &#13;&#10;	AND (Izdel.Key_VKZ_Master IS NULL) &#13;&#10;	AND (Izdel.DataZapUtv IS NOT NULL)&#13;&#10; AND TAll.CntAll &#62; 0                                " PropData=""/>
