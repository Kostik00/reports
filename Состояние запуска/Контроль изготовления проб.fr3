<TfrxReport Version="4.15" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41477,6332850579" ReportOptions.Description.Text="" ReportOptions.Name="Êîíòðîëü èçãîòîâëåíèÿ ïðîá.fr3 Ñîñòîÿíèå çàïóñêà" ReportOptions.LastChange="42100,637380463" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';&#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;function FnNamePredm:string;&#13;&#10;begin&#13;&#10;  Result := PrintPredm  (&#60;ERQuery1.&#34;PrintFlag&#34;&#62;,&#60;ERQuery1.&#34;Cod_Predm&#34;&#62;,       &#60;ERQuery1.&#34;Name_Predm&#34;&#62;,&#13;&#10;                         &#60;ERQuery1.&#34;Sortam&#34;&#62;,   &#60;ERQuery1.&#34;Type_NTD_Sortam&#34;&#62;, &#60;ERQuery1.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;                         &#60;ERQuery1.&#34;Marka&#34;&#62;,    &#60;ERQuery1.&#34;Type_NTD_Marka&#34;&#62;,  &#60;ERQuery1.&#34;Name_NTD_Marka&#34;&#62;);      &#13;&#10;end;          &#13;&#10;&#13;&#10;  &#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2A00000020446174615365743D2245525175657279312220446174615365744E616D653D224552517565727931220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;	Pr_Pasp.Cod_Pasp, &#13;&#10;	Pr_Pasp_Status.Name_Pasp_Status, &#13;&#10;	Pr_Pasp.Date_Zap,&#13;&#10;	T_Oper.Name_K_Oper,&#13;&#10;    Pr_Pasp.N_Oper_Sm,&#13;&#10;	Max(Sys_Log.LogDate)  LogDate,&#13;&#10;&#13;&#10;  PredmM.PrintFlag,&#13;&#10;  PredmM.Cod_Predm,&#13;&#10;  PredmM.Name_Predm,&#13;&#10;  PredmM.Sortam,&#13;&#10;  PredmM.Type_NTD_Sortam,&#13;&#10;  PredmM.Name_NTD_Sortam,&#13;&#10;  PredmM.Marka,&#13;&#10;  PredmM.Type_NTD_Marka,&#13;&#10;  PredmM.Name_NTD_Marka ,&#13;&#10;  T_Oper_Gr.Name_Oper_Gr,  &#13;&#10;  A_ID_Mat.VidSert,&#13;&#10;  A_ID_Mat.N_Sert,&#13;&#10;  A_ID_Mat.Date_Sert,&#13;&#10;&#13;&#10;  S_Subjects_Master.Name_Sub                            &#13;&#10;                              &#13;&#10;FROM         &#13;&#10;	Pr_Pasp&#13;&#10; INNER JOIN D_Zakaz&#13;&#10;       ON  D_Zakaz.Cod_Zak =  Pr_Pasp.Cod_Zak&#13;&#10;       AND D_Zakaz.Cod_SosZ = 'Ä'                                                      &#13;&#10;  &#13;&#10;	LEFT JOIN T_VPredm &#13;&#10;		ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	LEFT JOIN Pr_Pasp_Status &#13;&#10;		ON Pr_Pasp.Key_Pasp_Status = Pr_Pasp_Status.Key_Pasp_Status&#13;&#10;	INNER JOIN Sys_Log&#13;&#10;       ON Sys_Log.Docum = 'Òåõíîëîãè÷åñêèé ïàñïîðò'&#13;&#10;	   AND Sys_Log.Key_Docum = Pr_Pasp.Key_Pasport&#13;&#10;	LEFT JOIN Pr_Pasp_Rows&#13;&#10;	  ON Pr_Pasp_Rows.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;		AND Pr_Pasp_Rows.N_Oper_Sm = Pr_Pasp.N_Oper_Sm&#13;&#10;	LEFT JOIN T_Oper&#13;&#10;	  ON T_Oper.Cod_Oper = Pr_Pasp_Rows.Cod_Oper&#13;&#10;	LEFT JOIN Pr_SP&#13;&#10;	  ON Pr_SP.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;	LEFT JOIN A_VID_Mat  A_ID_Mat      &#13;&#10;	  ON A_ID_Mat.Key_ID_Mat = Pr_SP.Key_ID_Mat&#13;&#10;	LEFT JOIN T_VPredm PredmM&#13;&#10;	  ON PredmM.Key_Predm = A_ID_Mat.Key_Predm&#13;&#10;	LEFT JOIN A_Ostatok_Mat&#13;&#10;	  ON A_Ostatok_Mat.Key_ID_Mat = A_ID_Mat.Key_ID_Mat&#13;&#10;      AND A_Ostatok_Mat.Ost &#62;0&#13;&#10; LEFT JOIN T_Oper_Gr&#13;&#10;       ON  T_Oper_Gr.Cod_Oper_Gr = T_Oper.Cod_Oper_Gr&#13;&#10; LEFT JOIN S_Subjects S_Subjects_Master&#13;&#10;       ON  S_Subjects_Master.Key_Sub = Pr_Pasp.Key_Sub_Master                                                                                                         &#13;&#10;&#13;&#10;WHERE     &#13;&#10;          -- (T_VPredm.Name_Predm LIKE 'Îñíîâíîé ìåòàëë') or (T_VPredm.Name_Predm like 'Ïðîãðàììà ïîäòâåðæäåíèÿ ñåðòèôèêàòíûõ äàííûõ')&#13;&#10;           T_VPredm.Cod_Prin in ('72')                                                                          &#13;&#10;       AND (Pr_Pasp.Key_Pasp_Status IN (1, 2, 3, 4, 5))&#13;&#10;GROUP BY&#13;&#10;	Pr_Pasp.Cod_Pasp, &#13;&#10;  PredmM.PrintFlag,&#13;&#10;  PredmM.Cod_Predm,&#13;&#10;  PredmM.Name_Predm,&#13;&#10;  PredmM.Sortam,&#13;&#10;  PredmM.Type_NTD_Sortam,&#13;&#10;  PredmM.Name_NTD_Sortam,&#13;&#10;  PredmM.Marka,&#13;&#10;  PredmM.Type_NTD_Marka,&#13;&#10;  PredmM.Name_NTD_Marka,&#13;&#10;	Pr_Pasp_Status.Name_Pasp_Status, Pr_Pasp.Date_Zap,&#13;&#10;	T_Oper.Name_K_Oper, Pr_Pasp.N_Oper_Sm,&#13;&#10;  T_Oper_Gr.Name_Oper_Gr,  &#13;&#10;  A_ID_Mat.VidSert,&#13;&#10;  A_ID_Mat.N_Sert,&#13;&#10;  A_ID_Mat.Date_Sert,&#13;&#10;&#13;&#10;  S_Subjects_Master.Name_Sub      &#13;&#10;&#13;&#10; HAVING (( Max(Sys_Log.LogDate) &#60; dbo.SYS_ADDWorkDay(GetDate(), 1 - :Kontr ) ) OR  (:PrintAll = 1))                              &#13;&#10;ORDER BY T_Oper_Gr.Name_Oper_Gr, T_Oper.Name_K_Oper, Pr_Pasp.Cod_Pasp                        " PropData=""/>
  </TfrxDataPage>
