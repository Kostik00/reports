  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="SMZData" UserName="SMZData" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TabelFrxDS" IgnoreDupParams="False" SQL.Text="SELECT          Pr_Pasp.Cod_Pasp, Pr_Tabel.Date_Tabel, Pr_Tabel.Key_Sub_Ver, Pr_Tabel.Kolvo, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, T_Oper.Name_K_Oper, Pr_Tabel_MK.KolvoZap, Pr_Tabel_MK.Tzap, &#13;&#10;                         Pr_Tabel_MK.KolRab, Pr_Tabel_MK.Key_Tabel_MK, Pr_Pasp_Rows.N_Oper_Sm, Pr_Pasp_Rows.Tpz, Pr_Pasp_Rows.Tsht, Pr_Pasp_Rows.Ad_Info, Pr_Pasp_Rows.Tsm, &#13;&#10;                         Pr_Pasp_Rows.Tsm - dbo.Pr_Get_Tabel_Mk_TSmPrev(Pr_Pasp_Rows.Key_Pasp_Rows, Pr_Tabel_MK.Key_Tabel) AS TOst, Pr_Tabel_MK.AdInfo, T_SPRows.Prof_Razm, Gr_VxodPredm.Cod_Gr, Gr_Groups.FullNameGr, &#13;&#10;                         T_Predm_M.Key_Predm AS Key_PredmM, T_Predm_M.Cod_Predm AS Cod_PredmM, T_Predm_M.Name_Predm AS Name_PredmM, T_Predm_M.PrintFlag AS PrintFlagM, T_Predm_M.Sortam AS SortamM, &#13;&#10;                         T_Predm_M.OrderSortam AS OrderSortamM, T_Predm_M.SortamFn AS SortamFnM, T_Predm_M.Type_NTD_Sortam AS Name_TypeNTD_SortamM, T_Predm_M.Name_NTD_Sortam AS Name_NTD_SortamM, &#13;&#10;                         T_Predm_M.Marka AS MarkaM, T_Predm_M.Type_NTD_Marka AS Name_TypeNTD_MarkaM, T_Predm_M.Name_NTD_Marka AS Name_NTD_MarkaM, S_PERSONNEL.Name_Sub, S_PERSONNEL.F_Name_Sub&#13;&#10;FROM            Pr_Tabel AS Pr_Tabel INNER JOIN&#13;&#10;                         Pr_VTabel_MK AS Pr_Tabel_MK ON Pr_Tabel.Key_Tabel = Pr_Tabel_MK.Key_Tabel INNER JOIN&#13;&#10;                         Pr_Pasp_Rows ON Pr_Tabel_MK.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows INNER JOIN&#13;&#10;                         Pr_Pasp ON Pr_Pasp_Rows.Key_Pasport = Pr_Pasp.Key_Pasport INNER JOIN&#13;&#10;                         T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm INNER JOIN&#13;&#10;                         T_Oper ON Pr_Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper INNER JOIN&#13;&#10;                         S_PERSONNEL ON Pr_Pasp.Key_Sub_Master = S_PERSONNEL.Key_Sub LEFT OUTER JOIN&#13;&#10;                         T_SPRows ON T_SPRows.Key_SP = Pr_Pasp.Key_SP AND T_SPRows.SP_position = 0 LEFT OUTER JOIN&#13;&#10;                         T_VPredm AS T_Predm_M ON T_Predm_M.Key_Predm = T_SPRows.Key_Predm LEFT OUTER JOIN&#13;&#10;                         Gr_VxodPredm ON T_Predm_M.Key_Predm = Gr_VxodPredm.Key_Predm AND Gr_VxodPredm.Key_VidGr = 1 LEFT OUTER JOIN&#13;&#10;                         Gr_Groups ON Gr_VxodPredm.Key_VidGr = Gr_Groups.Key_VidGr AND Gr_VxodPredm.Cod_Gr = Gr_Groups.Cod_Gr &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;      Pr_Tabel.Key_Tabel=:Key_Tabel&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY&#13;&#10;		T_Predm_M.Cod_Postav, &#13;&#10;		T_Predm_M.Cod_Prin, &#13;&#10;		Gr_VxodPredm.Cod_Gr,&#13;&#10;		T_Predm_M.Name_Predm,&#13;&#10;		T_Predm_M.OrderSortam,&#13;&#10;		T_Predm_M.Sortam,&#13;&#10;		T_Predm_M.Marka   &#13;&#10;&#13;&#10;    " PropData="05704C65667402580470546F7002240A506172616D657465727301010C26000000204E616D653D224B65795F546162656C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="TabelInfoQRY" UserName="TabelInfo" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TabelFrxDS" IgnoreDupParams="False" SQL.Text="SELECT S.F_Name_Sub, S1.Name_Sub, P.Key_Tabel&#13;&#10;FROM&#13;&#10;    Pr_Tabel P&#13;&#10;    INNER JOIN S_SubVer S ON (P.Key_Sub_Ver=S.Key_Sub_Ver)&#13;&#10;    INNER JOIN S_Subjects S1 ON (S.Key_Sub=S1.Key_Sub)&#13;&#10;WHERE&#13;&#10;    P.Key_Tabel =:Key_Tabel" SQLSchema="eAFVj00LwjAMhu+D/ZMITfZRFXIR0YNDJhUvQ0anPUynh20e/PemTqbSXtonefKmWNreLmznjmFgdhlHsdYpalLTMCj2tmpcJyTnvC3l5RrAxF9SCggj6WFTmkd1cC1MNJBOwSNMlCAc2MWd+g4ogXhGX1qs2/osasWrcmtvzltgdBlAUO8TBsj/fPAZ/Ckh3rjnJ+CYNB8LeD5i2Sqr71e/lGKSCR+NH0PSgOA/Jf0LdSxJow==" PropData="05704C65667402580470546F70026C0A506172616D657465727301010C26000000204E616D653D224B65795F546162656C222044617461547970653D226674556E6B6E6F776E220000"/>
