n&#13;&#10;end;&#13;&#10;&#13;&#10;procedure TPzTShtMemoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Òåõïðîöåññ.&#34;Tsht&#34;&#62; &#60;&#62; 0 then&#13;&#10;    if &#60;Òåõïðîöåññ.&#34;Tpz&#34;&#62; &#60;&#62; 0 then&#13;&#10;       TpzTShtMemo.Lines.Text:='Òïç=[Òåõïðîöåññ.&#34;Tpz&#34;] Òøò=[Òåõïðîöåññ.&#34;Tsht&#34;]'&#13;&#10;    else&#13;&#10;       TpzTShtMemo.Lines.Text:='Òøò=[Òåõïðîöåññ.&#34;Tsht&#34;]'&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SvrMatFtrCkOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SvrMatFtr.Visible:=SvrMatFtrCk.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SvrMatFtrOnAfterPrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  x,cnt:integer;&#13;&#10;begin&#13;&#10;&#13;&#10;  Cnt:=StrToInt(CntEdit.text);&#13;&#10;  if SvrMatFtrCk.Checked then&#13;&#10;  for x:= 2 to Cnt do&#13;&#10;    Engine.ShowBand(EmptyStr);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CntEditOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child13OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child10OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FMat.First;&#13;&#10;  if FMat.Eof then&#13;&#10;       Child10.Child:= Child5&#13;&#10;  else&#13;&#10;        Child10.Child:= Child13;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ProbaFooter.Visible:=True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;ÌàòåðèàëÔàêò.&#34;Key_Razdel&#34;&#62; = 1 then ProbaFooter.Visible:=False;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ComplPageOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LNum:=0;&#13;&#10;  CZN:=&#60;Ïàñïîðò.&#34;ZavNumFrom&#34;&#62;;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterDataP2OnBeforePrint(Sen