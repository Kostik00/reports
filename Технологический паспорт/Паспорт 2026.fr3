    <TfrxERQuery Name="PrintFlagQRY" UserName="ДСЕ" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspFrxDS" Left="104" Top="288" IgnoreDupParams="False" SQL.Text="SELECT * FROM T_VPredm where Key_Predm=:Key_Predm                                                                                                       ">
