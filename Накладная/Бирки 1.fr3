    <TfrxERQuery Name="NaclStr" UserName="������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  A_Nacl_Str.Key_Nacl_Str,&#13;&#10;  A_Nacl_Str.Key_Nacl,&#13;&#10;  A_Nacl_Str.Key_ID_Mat,&#13;&#10;  T_VPredm.Key_Predm,&#13;&#10;&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;  A_VID_Mat.VidSert,&#13;&#10;  A_VID_Mat.N_Sert,&#13;&#10;  A_VID_Mat.Date_Sert,&#13;&#10;  A_VID_Mat.Cod_Plavka,&#13;&#10;  A_VID_Mat.Party,&#13;&#10;  A_VID_Mat.SrokGodn,&#13;&#10;      &#13;&#10;  A_Nacl_Str.Kolvo,&#13;&#10;  A_Nacl_Str.Cod_Ed_Izm,&#13;&#10;  T_EdIzm.Name_K_Ed,&#13;&#10;  T_VPredm.Cod_Ed_Izm AS BaseCodEd,&#13;&#10;  T_VPredm.Name_K_Ed AS BaseEdizm,&#13;&#10;  A_Nacl_Str.KolvoInBaseEd,&#13;&#10;  A_Nacl_Str.Price,&#13;&#10;  A_Nacl_Str.PercNds,&#13;&#10;  A_Nacl_Str.Sm,&#13;&#10;  A_Nacl_Str.SmNDS,&#13;&#10;  A_Nacl_Str.SrokKons                        &#13;&#10;    &#13;&#10;&#13;&#10;FROM&#13;&#10;  A_Nacl_Str&#13;&#10;  INNER JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = A_Nacl_Str.Key_ID_Mat&#13;&#10;  INNER JOIN  T_VPredmSkl T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm = A_VID_Mat.Key_Predm&#13;&#10;  INNER JOIN T_EdIzm&#13;&#10;    ON A_Nacl_Str.Cod_Ed_Izm = T_EdIzm.Cod_Ed_Izm&#13;&#10;WHERE&#13;&#10;   A_Nacl_Str.Key_Nacl=:Key_Nacl" PropData="05704C656674023C0470546F7002140A506172616D657465727301010C25000000204E616D653D224B65795F4E61636C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="ZakazQRY" UserName="������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaclStr" IgnoreDupParams="False" SQL.Text="SELECT A.Key_Nacl_Str, A1.Cod_Zak, T.Cod_Predm, T.Name_Predm, T.OrderCod_Predm&#13;&#10;FROM&#13;&#10;    A_Nacl_Str_LZK A&#13;&#10;    INNER JOIN A_LZK A1 ON (A.Key_LZK=A1.Key_LZK)&#13;&#10;    INNER JOIN D_VProduct_Pub D ON (A1.Cod_Zak=D.Cod_Zak)&#13;&#10;    INNER JOIN T_VPredm T ON (D.Key_Izdel=T.Key_Predm)&#13;&#10;WHERE&#13;&#10;    A.Key_Nacl_Str =:Key_Nacl_Str" SQLSchema="" PropData="05704C656674027C0470546F7002140A506172616D657465727301010C29000000204E616D653D224B65795F4E61636C5F537472222044617461547970653D226674556E6B6E6F776E220000"/>
