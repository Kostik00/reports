    <TfrxERQuery Name="DetailQRY" UserName="Детали" CloseDataSource="True" FieldAliases.Text="" Master="SertQry" SQL.Text="SELECT DISTINCT&#13;&#10;  T_VPredm.Cod_Predm   Cod_Predm,&#13;&#10;  T_VPredm.OrderCod_Predm OrderCod_Predm,&#13;&#10;&#13;&#10;  Gr_Groups.FullNameGr,&#13;&#10;  S_SubVer.F_Name_Sub,&#13;&#10;&#13;&#10;  FMat.Name_Predm      Name_FMat,&#13;&#10;&#13;&#10;  FMat.OrderSortam,&#13;&#10;  FMat.Sortam          Sortam_FMat,&#13;&#10;  FMat.Type_NTD_Sortam Type_NTD_Sortam_Mat,&#13;&#10;  FMat.Name_NTD_Sortam Name_NTD_Sortam_Mat,&#13;&#10;&#13;&#10;  FMat.MarkaPrn        Marka_FMat,&#13;&#10;  FMat.MarkaPrn        MarkaPrn_FMat,&#13;&#10;  FMat.Type_NTD_Marka  Type_NTD_Marka_Mat,&#13;&#10;  FMat.Name_NTD_Marka  Name_NTD_Marka_Mat,&#13;&#10;&#13;&#10;  A_VId_Mat.Key_ID_Mat,&#13;&#10;  A_VId_Mat.VidSert,&#13;&#10;  A_VId_Mat.N_Sert,&#13;&#10;  A_VId_Mat.Date_Sert,&#13;&#10;  A_VId_Mat.Cod_Plavka,&#13;&#10;  A_VId_Mat.Party,&#13;&#10;  A_VId_Mat.Key_Pasport PaspMat&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Otgr&#13;&#10;  INNER JOIN P_VKZ P_VKZ                       -- берем  всю ВКЗ на изделие&#13;&#10;    ON P_VKZ.Key_VKZ_Izdel=Pr_Otgr.Key_Vkz&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet             -- смотрим для нее какие есть паспорта&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  INNER JOIN PR_Pasp                -- берем все паспорта&#13;&#10;    ON  PR_Pasp.Key_Pasport=PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm             -- Детали&#13;&#10;    ON T_VPredm.Key_Predm=PR_Pasp.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;  INNER JOIN Pr_SP                   -- Ну и смотрим только то, на что есть фактический материал&#13;&#10;    ON Pr_SP.Key_Pasport=PR_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_SP&#13;&#10;    ON T_SP.Key_SP=PR_Pasp.Key_SP&#13;&#10;&#13;&#10;  INNER JOIN A_VId_Mat                -- Это мы смотрим материал в идентефикаторе&#13;&#10;    ON A_VId_Mat.Key_ID_Mat=Pr_SP.Key_ID_Mat&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm FMat            -- А это собственно говоря и есть сам материал&#13;&#10;    ON FMat.Key_Predm=A_VId_Mat.Key_Predm&#13;&#10;  INNER JOIN Gr_VxodPredm&#13;&#10;    ON Gr_VxodPredm.Key_Predm=FMat.Key_Predm&#13;&#10;    AND Gr_VxodPredm.Key_VidGr=1&#13;&#10;  INNER JOIN Gr_Groups&#13;&#10;    ON Gr_Groups.Cod_Gr=Gr_VxodPredm.Cod_Gr&#13;&#10;    AND Gr_VxodPredm.Key_VidGr= Gr_VxodPredm.Key_VidGr&#13;&#10;  LEFT JOIN S_SubVer&#13;&#10;    ON S_SubVer.Key_Sub_Ver=A_VId_Mat.Key_Sub_Ver_Postav&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Otgr.NumOtgr=:NumOtgr&#13;&#10;  AND A_VId_Mat.Key_ID_Mat=:Key_ID_Mat&#13;&#10;&#13;&#10;  AND FMat.Cod_Prin=50&#13;&#10;ORDER BY   S_SubVer.F_Name_Sub, Name_FMat, FMat.OrderSortam, OrderCod_Predm" PropData="0A506172616D657465727301010C3E000000204E616D653D224E756D4F746772222044617461547970653D226674537472696E67222045787072657373696F6E3D224F746772456469742E546578742200010C27000000204E616D653D224B65795F49445F4D6174222044617461547970653D226674556E6B6E6F776E220000"/>
  </TfrxReportPage>
</TfrxReport>
