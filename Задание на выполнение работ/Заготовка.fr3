    <TfrxERQuery Name="PlnRQry" UserName="Задание" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_PaspR_Pln.Key_PaspR_Pln,&#13;&#10;  Pr_Pasp.Cod_Zak,&#13;&#10;  Pr_Pasp.Cod_Pasp,                                              &#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  Pr_Pasp_Rows.N_Oper_Sm,&#13;&#10;  Pr_Pasp_Rows.PlnDate,&#13;&#10;  Pr_Pasp_Rows.Dt_PaspR_Pln,&#13;&#10;  Pr_Pasp_Rows.TSm,                &#13;&#10;   &#13;&#10;  T_Oper.Name_K_Oper,  &#13;&#10;  T_Oper.Name_Oper,&#13;&#10;  T_Oper_Gr.Name_GrGr, &#13;&#10;  T_Oper_Gr.Name_Oper_Gr&#13;&#10;      &#13;&#10;FROM&#13;&#10;  Pr_PaspR_Pln&#13;&#10;  INNER JOIN Pr_Pasp_Rows&#13;&#10;    ON Pr_PaspR_Pln.Key_PaspR_Pln = Pr_Pasp_Rows.Key_PaspR_Pln&#13;&#10;&#13;&#10;                                                                                          &#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp_Rows.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm&#13;&#10;  INNER JOIN T_Oper&#13;&#10;    ON Pr_Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper&#13;&#10;  INNER JOIN T_Oper_Gr &#13;&#10;    ON T_Oper.Cod_Oper_Gr = T_Oper_Gr.Cod_Oper_Gr&#13;&#10;      &#13;&#10;WHERE&#13;&#10;  Pr_PaspR_Pln.Key_PaspR_Pln = :Key_PaspR_Pln&#13;&#10;ORDER BY  &#13;&#10;  Pr_Pasp.Cod_Zak, &#13;&#10;  T_Oper_Gr.Name_GrGr, &#13;&#10;  T_Oper_Gr.Name_Oper_Gr,  &#13;&#10;  Cod_Predm&#13;&#10;&#13;&#10;  " PropData="05704C65667402380470546F7002280A506172616D657465727301010C2A000000204E616D653D224B65795F50617370525F506C6E222044617461547970653D226674556E6B6E6F776E220000"/>
