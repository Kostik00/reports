    <TfrxERQuery Name="VPQry" UserName="ВП" CloseDataSource="False" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="36" Top="528" IgnoreDupParams="False" SQL.Text="SELECT  DISTINCT                &#13;&#10;       P_VKZ_Izdel.Key_VKZ Key_VKZ_Izdel,                                      &#13;&#10;&#13;&#10;       T_VPredm.Key_Predm,&#13;&#10;       T_VPredm.PrintFlag, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam,&#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       T_VPredm.Cod_Prin, &#13;&#10;       T_VPredm.Name_Prin, &#13;&#10;       T_VPredm.Sortam , &#13;&#10;       T_VPredm.OrderSortam,&#13;&#10;       T_VPredm.Cod_Postav, &#13;&#10;       T_VPredm.Name_Postav,&#13;&#10;       Gr_Groups.Cod_Gr,                           &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr,&#13;&#10;--       P_VKZ.Kolvo AS KolvoDSE, &#13;&#10;--       P_VKZ.Kolvo_On_Izdel AS KolvoDSEOnIzdel,&#13;&#10;--       T_SPRows.Kolvo  &#13;&#10;&#13;&#10;         T_SPRows.Kolvo  SmKolvo    &#13;&#10;--       SUM(P_VKZ.Kolvo_On_Izdel * T_SPRows.Kolvo) SmKolvo                                         &#13;&#10;--       SUM(/*P_VKZ.Kolvo_On_Izdel **/ T_SPRows.Kolvo) SmKolvo                                         &#13;&#10;           &#13;&#10;FROM&#13;&#10;       P_VKZ P_VKZ_Izdel&#13;&#10;         &#13;&#10;       INNER JOIN P_VKZ&#13;&#10;               ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ_Izdel&#13;&#10;               AND  P_VKZ.CodStrSv like P_VKZ_Izdel.CodStrSv   -- + &#39;%&#39;                                                            &#13;&#10;                 &#13;&#10;       INNER JOIN T_VPredm AS DSE&#13;&#10;               ON P_VKZ.Key_Predm = DSE.Key_Predm &#13;&#10;       INNER JOIN T_SPRows &#13;&#10;               ON P_VKZ.Key_SP = T_SPRows.Key_SP &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON T_SPRows.Key_Predm = T_VPredm.Key_Predm&#13;&#10;       INNER JOIN Gr_VxodPredm&#13;&#10;               ON Gr_VxodPredm.Key_Predm = T_VPredm.Key_Predm&#13;&#10;               AND Gr_VxodPredm.Key_VidGr  =1&#13;&#10;       INNER JOIN Gr_Groups&#13;&#10;               ON Gr_Groups.Cod_Gr = Gr_VxodPredm.Cod_Gr&#13;&#10;               AND Gr_Groups.Key_VidGr = Gr_VxodPredm.Key_VidGr                                          &#13;&#10;                 &#13;&#10;WHERE     &#13;&#10;--(P_VKZ_Izdel.Key_VKZ =  (Select top 1 Key_VKZ from Pr_PaspDet where Pr_PaspDet.Key_Pasport= :Key_Pasport ))&#13;&#10;       (P_VKZ_Izdel.Key_VKZ   in  (Select  Key_VKZ from Pr_PaspDet where Pr_PaspDet.Key_Pasport= :Key_Pasport ))    &#13;&#10;AND ((T_SPRows.Cod_Ed_Izm  = &#39;796&#39;) OR (T_VPredm.Cod_Prin=&#39;51&#39;))                         &#13;&#10;AND T_SPRows.SP_Position &#62;0&#13;&#10;AND T_SPRows.SP_Position &#60; 1000                                 &#13;&#10;AND T_VPredm.Cod_Postav = &#39;8&#39;&#13;&#10;/*    &#13;&#10;GROUP BY&#13;&#10;       P_VKZ_Izdel.Key_VKZ,                                      &#13;&#10;       T_VPredm.Key_Predm,&#13;&#10;       T_VPredm.PrintFlag, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam,&#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       T_VPredm.Cod_Prin, &#13;&#10;       T_VPredm.Name_Prin, &#13;&#10;       T_VPredm.Sortam , &#13;&#10;       T_VPredm.OrderSortam,&#13;&#10;       T_VPredm.Cod_Postav, &#13;&#10;       T_VPredm.Name_Postav,&#13;&#10;       Gr_Groups.Cod_Gr,                           &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr&#13;&#10;                         */      &#13;&#10;ORDER BY&#13;&#10;&#13;&#10;	T_VPredm.Cod_Postav, &#13;&#10;	T_VPredm.Cod_Prin, &#13;&#10;	Gr_Groups.Cod_Gr,   &#13;&#10;	T_VPredm.Name_Predm, &#13;&#10;	T_VPredm.OrderSortam       ">
      <FieldDefs>
        <item FieldName="Key_VKZ_Izdel"/>
        <item FieldName="Key_Predm"/>
        <item FieldName="PrintFlag"/>
        <item FieldName="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="Type_NTD_Sortam" FieldType="fftString"/>
        <item FieldName="Name_NTD_Sortam" FieldType="fftString" Size="254"/>
        <item FieldName="Marka" FieldType="fftString" Size="150"/>
        <item FieldName="Type_NTD_Marka" FieldType="fftString"/>
        <item FieldName="Name_NTD_Marka" FieldType="fftString" Size="254"/>
        <item FieldName="Cod_Prin" FieldType="fftString"/>
