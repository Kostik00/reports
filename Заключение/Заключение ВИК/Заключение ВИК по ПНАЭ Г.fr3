<TfrxReport Version="2026.2.4" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38529,9873035995" ReportOptions.Description.Text="" ReportOptions.Name="Заключение ВИК по ПНАЭ Г.f&#38;r3 Заключение № 160/2-8от 14.08.2026" ReportOptions.LastChange="46288,9697262153" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  StrSm: string;&#13;&#10;  StrSmIzdel: string;&#13;&#10;  StrSmNameIzdel : string;&#13;&#10;  StrSmKolvo :string;&#13;&#10;  Cod_TT:string;&#13;&#10;  VidKontrSM:string;&#13;&#10;&#13;&#10;  NTDSm:string;&#13;&#10;&#13;&#10;procedure KleimoDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;function fnCod_Predm2(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if pos(&#39;*&#39;,S)&#62;0 then&#13;&#10;   Result:=Copy(S,1,pos(&#39;*&#39;,S)-1);&#13;&#10;&#13;&#10; if (&#60;Паспорта.&#34;ZavNumFrom&#34;&#62; &#62; 0) AND (&#60;Паспорта.&#34;ZavNumTo&#34;&#62; &#62; 0) then&#13;&#10;  begin&#13;&#10;    if &#60;Паспорта.&#34;ZavNumFrom&#34;&#62; &#60; &#60;Паспорта.&#34;ZavNumTo&#34;&#62;   then&#13;&#10;      Result:=  Result + &#39; зав.№&#39;#160 + IntToStr(&#60;Паспорта.&#34;ZavNumFrom&#34;&#62;) + &#39;-&#39; + IntToStr(&#60;Паспорта.&#34;ZavNumTo&#34;&#62;)&#13;&#10;    else&#13;&#10;      Result:=  Result + &#39; зав.№&#39;#160 + IntToStr(&#60;Паспорта.&#34;ZavNumFrom&#34;&#62;);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Header4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;function fnCod_Predm(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if pos(&#39;*&#39;,S)&#62;0 then&#13;&#10;   Result:=Copy(S,1,pos(&#39;*&#39;,S)-1);&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function FnPredm001(Cod,Name:string):string;&#13;&#10;begin&#13;&#10;  if        (Name&#60;&#62;&#39;Основной металл&#39;)&#13;&#10;       and  (Name&#60;&#62;&#39;Подтверждения сертификатных данных&#39;)&#13;&#10;       and  (Name&#60;&#62;&#39;Программа подтверждения сертификатных данных&#39;)&#13;&#10;  then&#13;&#10;  begin&#13;&#10;    Result:=  Cod + &#39; &#39; + Name;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result:=&#39;Основной металл&#39;;&#13;&#10;  end;&#13;&#10;       if (&#60;ИзделиеДСЕ.&#34;ZavNumFromMin&#34;&#62; &#62; 0) AND (&#60;ИзделиеДСЕ.&#34;ZavNumToMax&#34;&#62; &#62; 0) then&#13;&#10;  begin&#13;&#10;    if &#60;ИзделиеДСЕ.&#34;ZavNumFromMin&#34;&#62; &#60; &#60;ИзделиеДСЕ.&#34;ZavNumToMax&#34;&#62;   then&#13;&#10;      Result:=  Result + &#39; зав.№&#39;#160 + IntToStr(&#60;ИзделиеДСЕ.&#34;ZavNumFromMin&#34;&#62;) + &#39;-&#39; + IntToStr(&#60;ИзделиеДСЕ.&#34;ZavNumToMax&#34;&#62;)&#13;&#10;    else&#13;&#10;      Result:=  Result + &#39; зав.№&#39;#160 + IntToStr(&#60;ИзделиеДСЕ.&#34;ZavNumFromMin&#34;&#62;);&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function fnZavNumIzdel:string;&#13;&#10;begin&#13;&#10;  result:= &#60;ИзделиеДСЕ.&#34;Izdel_ZavNum&#34;&#62;;&#13;&#10; &#13;&#10;end;&#13;&#10;&#13;&#10;   function fnDataSI:string;      //Проверка срока поверки/калибровки инструмента&#13;&#10;begin&#13;&#10;result:=&#39;&#39;;&#13;&#10;    if &#60;OborQRY.&#34;Date_Obor&#34;&#62; &#60; strtodate(&#39;10.01.2000&#39;) then&#13;&#10;  Result := &#39;&#39;&#13;&#10; else&#13;&#10;  Result:=&#39;, срок поверки/калибровки: &#39; + datetostr( &#60;OborQRY.&#34;Date_Obor&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure VidKontrHDROnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  VidKontrSM:=&#39;&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure VidKontrDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if VidKontrSM&#60;&#62;&#39;&#39; then VidKontrSM:=VidKontrSM+&#39; + &#39;;&#13;&#10;  VidKontrSM:=VidKontrSM+&#60;Вид контроля.&#34;VidKontr&#34;&#62;+&#39;(&#39;+&#60;Вид контроля.&#34;VolKontr&#34;&#62;+&#39;)&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FreeSpace &#60; MasterData1.Height then&#13;&#10;    Engine.ShowBand(GroupFooter1);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function Fn000(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if Result = &#39;&#39; then Result:=&#39;-&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;function Fn001(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if Result = &#39;&#39; then Result:=&#39;---&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PartSvrMemo.Visible:=&#60;Исполнители.&#34;Key_SvrPrimen&#34;&#62; &#62; 0;&#13;&#10;       //&#60;Исполнители.&#34;Key_Sposob&#34;&#62; &#62; 0;&#13;&#10;  PartSvrMemo1.Visible:=&#60;Исполнители.&#34;Key_SvrPrimen&#34;&#62; &#62; 0;&#13;&#10;       //&#60;Исполнители.&#34;Key_Sposob&#34;&#62; &#62; 0;&#13;&#10;&#13;&#10;&#13;&#10;  ZavNumMemo1.Visible := &#60;СтрокиНапр.&#34;ZavNumTo&#34;&#62; &#62; &#60;СтрокиНапр.&#34;ZavNumFrom&#34;&#62;;&#13;&#10;  ZavNumMemo.Visible := not ZavNumMemo1.Visible;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;  StrSm:=&#39;&#39;;&#13;&#10;  StrSmIzdel:=&#39;&#39;;&#13;&#10;  StrSmNameIzdel :=&#39;&#39;;&#13;&#10;  StrSmKolvo:=&#39;&#39;;&#13;&#10;&#13;&#10;  IzdelQRY.Open;&#13;&#10;  Cod_TT:=&#60;Заключение.&#34;Cod_TT&#34;&#62;;&#13;&#10;  while not IzdelQRY.Eof do&#13;&#10;  begin&#13;&#10;{&#13;&#10;    if Cod_TT &#60;&#62; &#60;Направление.&#34;Cod_TT&#34;&#62; then&#13;&#10;      ErrorPage.Visible:=True;&#13;&#10;}&#13;&#10;    if StrSm&#60;&#62;&#39;&#39; then StrSm:=StrSm+&#39; + &#39;;&#13;&#10;      StrSm:=StrSm+&#60;Изделия.&#34;Cod_Predm_Izdel&#34;&#62;+&#39; &#39;+&#60;Изделия.&#34;Name_Predm_Izdel&#34;&#62;;&#13;&#10;&#13;&#10;    if StrSmIzdel&#60;&#62;&#39;&#39; then StrSmIzdel:=StrSmIzdel+&#39; + &#39;;&#13;&#10;      StrSmIzdel:=StrSmIzdel+&#60;Изделия.&#34;Cod_Predm_Izdel&#34;&#62;;&#13;&#10;&#13;&#10;    if StrSmNameIzdel&#60;&#62;&#39;&#39; then StrSmNameIzdel:=StrSmNameIzdel+&#39; + &#39;;&#13;&#10;      StrSmNameIzdel:=StrSmNameIzdel+&#60;Изделия.&#34;Name_Predm_Izdel&#34;&#62;;&#13;&#10;{&#13;&#10;    if StrSmKolvo&#60;&#62;&#39;&#39; then StrSmKolvo:=StrSmKolvo+&#39; + &#39;;&#13;&#10;      StrSmKolvo:=StrSmKolvo+&#60;Направление.&#34;Kolvo&#34;&#62;;&#13;&#10;}&#13;&#10;    IzdelQRY.Next;&#13;&#10;  end;&#13;&#10;  IzdelQRY.First;&#13;&#10;  NTDSM:=&#39;&#39;;&#13;&#10;  NTDQry.Open;&#13;&#10;  while not(NTDQry.Eof) do&#13;&#10;  begin&#13;&#10;    if NTDSM&#60;&#62;&#39;&#39; then NTDSM:=NTDSM+&#39;, &#39;;&#13;&#10;    NTDSM:=NTDSM+&#60;NTDQry.&#34;Name_NTD&#34;&#62;;&#13;&#10;    NTDQry.Next;&#13;&#10;  end;&#13;&#10;  NTDQry.Close;&#13;&#10;end." StoreInDFM="False">
