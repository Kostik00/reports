<TfrxReport Version="2026.2.4" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38489,0831465162" ReportOptions.Description.Text="" ReportOptions.Name="ВСНРМ.fr3 СП СКА997.00.00.000 (Редактирование)" ReportOptions.LastChange="46334,9916046991" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  IdxGr,IdxMat:integer;&#13;&#10;  GrCnt:integer;&#13;&#10;  SmGrCnt:integer;&#13;&#10;  SmTTStr:string;&#13;&#10;&#13;&#10;  SmTT:string;&#13;&#10;&#13;&#10;function FnKolZag:string;&#13;&#10;begin&#13;&#10;  Result:=&#39;&#39;;&#13;&#10;  if &#60;ВСНРМ.&#34;KolZag&#34;&#62; &#62; 0 then&#13;&#10;  begin&#13;&#10;    Result:=#13#10&#39;(&#39;+IntToStr(&#60;ВСНРМ.&#34;KolZag&#34;&#62;)+&#39; заг.)&#39;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PrintRptTitleOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  RPTHDR.Visible:=PrintRptTitle.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;function TTStr:string;&#13;&#10;begin&#13;&#10;  TTQry.Close;&#13;&#10;  if SmTT&#60;&#62;&#39;&#39; then&#13;&#10;    TTQry.SQL.Text:=&#39;SELECT * FROM T_TechTreb where Cod_TT in (&#39; + Sm0001Memo.Lines.CommaText + &#39;)&#39; ;&#13;&#10;  TTQry.Open;&#13;&#10;&#13;&#10;  SmTTStr:=&#39;&#39;;&#13;&#10;  if PrintTT.Checked then&#13;&#10;  begin&#13;&#10;    if not  TTQry.Eof then&#13;&#10;    SmTTStr:=&#39;&#60;B&#62;Расшифровка контрольных операций в соответствии с ОСТ 108.004.10-86:&#60;/B&#62;&#39;#13#10;&#13;&#10;  //  TTQry.Open;&#13;&#10;    while not TTQry.Eof do&#13;&#10;    begin&#13;&#10;      SmTTStr:=SmTTStr+&#60;TTQry.&#34;Cod_TT&#34;&#62;+&#39; - &#39;+&#60;TTQry.&#34;Name_TT&#34;&#62;+#13#10;&#13;&#10;&#13;&#10;      TTQry.Next;&#13;&#10;    end;&#13;&#10;    TTQry.Close;&#13;&#10;  end;&#13;&#10;&#13;&#10; Result:=SmTTStr;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure OkButtonOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;&#13;&#10;begin&#13;&#10;  TMPTBL.Open;&#13;&#10;  Str:=&#39;&#39;;&#13;&#10;  if PrintMD.Checked then&#13;&#10;    Str:=&#39;МД=[ВСНРМ.&#34;MassaOnDSE&#34;]&#39;;&#13;&#10;  if PrintKIM.Checked then&#13;&#10;    if KIMBox.Checked then&#13;&#10;      Str:=Str+ &#39; (КИМ=[IIF(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62; &#62; 0, &#60;ВСНРМ.&#34;KolvoInKG&#34;&#62;/&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62; , 0) #n%1,3f])&#39;&#13;&#10;    else&#13;&#10;      Str:=Str+ &#39; (КИМ=[IIF(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62; &#62; 0, &#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;/&#60;ВСНРМ.&#34;KolvoInKG&#34;&#62; , 0) #n%1,3f])&#39;;&#13;&#10;  KimDSE.Memo.Text:=Str;&#13;&#10;  SokrMemo.Visible:=PrintKIM.Checked;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure GrHDROnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  IdxGr:=0;&#13;&#10;  if Engine.Freespace&#60;50 then Engine.NewPage;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MatHDROnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Engine.AddAnchor(&#60;ВСНРМ.&#34;Cod_Predm&#34;&#62;);&#13;&#10;  if IdxGr=0 then&#13;&#10;    GrFtr.Visible:=False&#13;&#10;  else&#13;&#10;    GrFtr.Visible:=True;&#13;&#10;&#13;&#10;  IdxGr:=IdxGr+1;&#13;&#10;  IdxMat:=0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.Freespace&#60;20 then Engine.NewPage;&#13;&#10;&#13;&#10;  KimChild.Visible:=&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62; &#60;&#62; 0;&#13;&#10;&#13;&#10;  IdxMat:=IdxMat+1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MainPageOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CommentChild.Visible:=True;&#13;&#10;  TTChild1.Visible:=PrintTT.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo24OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Примен.&#34;Cod_Predm&#34;&#62;= &#60;ВСНРМ.&#34;Cod_Predm_Master&#34;&#62; then&#13;&#10;  begin&#13;&#10;    Memo37.Visible:=False;&#13;&#10;    Memo24.Visible:=False;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Memo37.Visible:=True;&#13;&#10;    Memo24.Visible:=True;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo21OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.Freespace&#60;80 then Engine.NewPage;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CommentOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MatFtrOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;&#13;&#10;begin&#13;&#10;  SmMemo01.Lines.Text:=&#39;КГ  ([SUM(&#60;ВСНРМ.&#34;KolvoInBaseEd&#34;&#62;,MasterData1) #n%2,2n] [ВСНРМ.&#34;Base_Ed&#34;])&#39;;&#13;&#10;  if  (SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0) then&#13;&#10;  begin&#13;&#10;    if PrintMD.Checked then&#13;&#10;      Str:=&#39;М.Д.=[SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1) #n%2,2n]&#39;&#13;&#10;    else&#13;&#10;      Str:=&#39;&#39;;&#13;&#10;    if PrintKIM.Checked then&#13;&#10;      if KIMBox.Checked then&#13;&#10;        Str:=Str&#13;&#10;        +&#39; (КИМ=[IIF(SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0, SUM(&#60;ВСНРМ.&#34;KolvoInKG&#34;&#62;,MasterData1)/SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1),0) #n%1,3n])&#39;&#13;&#10;      else&#13;&#10;        Str:=Str&#13;&#10;        +&#39; (КИМ=[IIF(SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0, SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)/SUM(&#60;ВСНРМ.&#34;KolvoInKG&#34;&#62;,MasterData1),0) #n%1,3n])&#39;;&#13;&#10;    SmMemo01.Lines.Text:=SmMemo01.Lines.Text+Str;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SmMemo02OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:String;&#13;&#10;begin&#13;&#10;  if  (SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0) then&#13;&#10;  begin&#13;&#10;    if PrintMD.Checked then&#13;&#10;      Str:=&#39;КГ М.Д.=[SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1) #n%2,2n]&#39;&#13;&#10;    else&#13;&#10;      Str:=&#39;КГ &#39;;&#13;&#10;    if PrintKIM.Checked then&#13;&#10;      if KIMBox.Checked then&#13;&#10;        Str:=Str&#13;&#10;        +&#39; (КИМ=[IIF(SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0, SUM(&#60;ВСНРМ.&#34;KolvoInKG&#34;&#62;,MasterData1)/SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1),0) #n%1,3n])&#39;&#13;&#10;      else&#13;&#10;        Str:=Str&#13;&#10;        +&#39; (КИМ=[IIF(SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0, SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)/SUM(&#60;ВСНРМ.&#34;KolvoInKG&#34;&#62;,MasterData1),0) #n%1,3n])&#39;;&#13;&#10;    SmMemo02.Lines.Text:=Str;&#13;&#10;  end&#13;&#10;  else&#13;&#10;    SmMemo02.Lines.Text:=&#39;КГ&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PrinadlFtrOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:String;&#13;&#10;begin&#13;&#10;  if  (SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0) then&#13;&#10;  begin&#13;&#10;    if PrintMD.Checked then&#13;&#10;      Str:=&#39;КГ М.Д.=[SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1) #n%2,2n]&#39;&#13;&#10;    else&#13;&#10;      Str:=&#39;КГ &#39;;&#13;&#10;&#13;&#10;    if KIMBox.Checked then&#13;&#10;      Str:=Str&#13;&#10;      +&#39; (КИМ=[IIF(SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0, SUM(&#60;ВСНРМ.&#34;KolvoInKG&#34;&#62;,MasterData1)/SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1),0) #n%1,3n])&#39;&#13;&#10;    else&#13;&#10;      Str:=Str&#13;&#10;      +&#39; (КИМ=[IIF(SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)&#62;0, SUM(&#60;ВСНРМ.&#34;MassaOnDSE&#34;&#62;,MasterData1)/SUM(&#60;ВСНРМ.&#34;KolvoInKG&#34;&#62;,MasterData1),0) #n%1,3n])&#39;;&#13;&#10;    SmMemo03.Lines.Text:=Str;&#13;&#10;  end&#13;&#10;  else&#13;&#10;    SmMemo03.Lines.Text:=&#39;КГ&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  GrCnt:=0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  GrCnt:= GrCnt+1;&#13;&#10;  SmGrCnt:=SmGrCnt+1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupFooterOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  GroupFooter.Visible:=GrCnt&#62;1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure KIMBoxOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PrintSMPageOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SmPage.Visible:=PrintSMNRM.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure SmMemo01OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SmGrCnt:=0;&#13;&#10;  SmSortamHDR.Visible:= PrintSortamSm.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SmGrFtrOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    SmGrFtr.Visible:=(SmGrCnt&#62;1) AND PrintSortamSm.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure ReportParamsOnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MyRestoreString(&#39;ВСНРМКомментарий&#39;, Comment.Lines.Text);&#13;&#10;//  MyRestoreString(&#39;ВСНРМКомментарий1&#39;, Comment1.Lines.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportParamsOnDeactivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MySaveString(&#39;ВСНРМКомментарий&#39;, Comment.Lines.Text);&#13;&#10;//  MySaveString(&#39;ВСНРМКомментарий1&#39;, Comment1.Lines.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CheckBox2OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TTChild1.Visible:=PrintTT.Checked;&#13;&#10;  TTChild2.Visible:=PrintTT.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure KolvoEditOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Child2OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if CommentChild.Visible then&#13;&#10;  begin&#13;&#10;    CommentChild.Visible:=False;&#13;&#10;  //  Engine.ShowBand(TTChild1);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PrintKIMOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;var&#13;&#10;  LM:variant;&#13;&#10;procedure CheckBox1OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Report.EngineOptions.DoublePass:=DoublePass.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PrintDTOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MainPage.Visible:=PrintDT.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure TTMemo1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure TTChild1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TTChild1.Visible:=False;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  S:string;&#13;&#10;  I:integer;&#13;&#10;begin&#13;&#10;  ZagotovChild.Visible:=True;&#13;&#10;&#13;&#10;  if (&#60;ВСНРМ.&#34;KolZagBySP&#34;&#62; = 1) AND (&#60;ВСНРМ.&#34;EdNormBySP&#34;&#62;=1) then&#13;&#10;    ZagotovChild.Visible:=False;&#13;&#10;&#13;&#10;  if (&#60;ВСНРМ.&#34;UseZagotov&#34;&#62; &#60;&#62; 1)   then&#13;&#10;    ZagotovChild.Visible:=False;&#13;&#10;&#13;&#10;   S:=StringReplace(&#60;ВСНРМ.&#34;TT&#34;&#62;,&#39;c&#39;,&#39;&#39;,3);&#13;&#10; //  S:=StringReplace(S,&#39;с&#39;,&#39;&#39;,0);&#13;&#10;  if S&#60;&#62;&#39;&#39; then&#13;&#10;  begin&#13;&#10;    if SmTT&#60;&#62;&#39;&#39; then SmTT:=SmTT+&#39;,&#39;;&#13;&#10;    SmTT:=SmTT+S;&#13;&#10;  end;&#13;&#10;&#13;&#10;  TmpMemo.Lines.CommaText:=S;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  for I := 4 to  TmpMemo.Lines.Count-1 do&#13;&#10;  begin&#13;&#10;    if TmpMemo.Lines.Strings(I) &#60;&#62; &#39;&#39; then&#13;&#10;    begin&#13;&#10;     S:= &#39;&#39;&#39;&#39;+TmpMemo.Lines.Strings(I)+&#39;&#39;&#39;&#39;;&#13;&#10;  //   if Length(TmpMemo.Lines.Strings(I))&#60;5 then&#13;&#10;     if Sm0001Memo.Lines.IndexOf(S)&#60;0  then&#13;&#10;       Sm0001Memo.Lines.Add(S);&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  LM:=MyReadProp(&#39;Левое поле&#39;);&#13;&#10;  if Length(LM)&#60;&#62;0 then&#13;&#10;  begin&#13;&#10;    RPTHDR.LeftMargin:=LM;&#13;&#10;    SmPage.LeftMargin:=LM;&#13;&#10;    MainPage.LeftMargin:=LM;&#13;&#10;  end;&#13;&#10; SmTT:=&#39;&#39;;&#13;&#10;&#13;&#10;end." StoreInDFM="False">
