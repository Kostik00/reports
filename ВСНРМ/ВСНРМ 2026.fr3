    <TfrxERQuery Name="SmNRM" UserName="СМНРМ" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="60" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  P_VMZ.Key_WSNRM,&#13;&#10;&#13;&#10;  Gr_Groups.Cod_Gr,&#13;&#10;  Gr_Groups.FullNameGr,&#13;&#10;&#13;&#10;  T_Prinadl.Cod_Prin,&#13;&#10;  T_Prinadl.WSNRMOrder,&#13;&#10;  T_Prinadl.Name_Prin,&#13;&#10;  T_Prinadl.PrintFlag  PrintFlag,&#13;&#10;&#13;&#10;  T_VPredm.Cod_Postav,&#13;&#10;  T_VPredm.Name_Postav,                                &#13;&#10;&#13;&#10;  T_VPredm.Key_Predm,&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.OrderSortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;&#13;&#10;  T_VPredm.Cod_Ed_Izm,&#13;&#10;  T_VPredm.Name_K_Ed,&#13;&#10;&#13;&#10;--  T_EdIzm.Cod_Ed_Izm Sp_Ed_Izm,&#13;&#10;--  T_EdIzm.Name_K_Ed  SP_Name_K_Ed,&#13;&#10;&#13;&#10;  Sklad_Ed_Izm.Cod_Ed_Izm Sklad_Ed_Izm,&#13;&#10;  Sklad_Ed_Izm.Name_K_Ed  Sklad_Name_K_Ed,&#13;&#10;&#13;&#10;  SUM(P_VMZ.Kolvo_BySP*dbo.T_GetKoefTo(T_VPredm.Key_Predm, P_VMZ.Cod_Ed_Izm_BySP, T_VPredm.Cod_Ed_Izm )) AS KolvoSM,&#13;&#10;  SUM(P_VMZ.KolvoInBaseEd_BySP) AS KolvoSMInSkladEd,&#13;&#10;  SUM(P_VMZ.Kolvo_BySP*dbo.T_GetKoefTo(T_VPredm.Key_Predm, P_VMZ.Cod_Ed_Izm_BySP, &#39;166&#39; )) AS KolvoInKG      &#13;&#10;  --,  SUM(P_VMZ.Kolvo_BySP) AS SpKolvoSM&#13;&#10;                     &#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VMZ&#13;&#10;  INNER JOIN T_VPredm  T_VPredm&#13;&#10;    ON P_VMZ.Key_Predm_BySP = T_VPredm.Key_Predm&#13;&#10;  INNER JOIN T_Prinadl&#13;&#10;    ON T_Prinadl.Cod_Prin=T_VPredm.Cod_Prin&#13;&#10;&#13;&#10;--  INNER JOIN T_EdIzm&#13;&#10;--    ON P_VMZ.Cod_Ed_Izm = T_EdIzm.Cod_Ed_Izm&#13;&#10;&#13;&#10;  INNER JOIN T_EdIzm  Sklad_Ed_Izm&#13;&#10;    ON T_VPredm.Sklad_Ed_Izm = Sklad_Ed_Izm.Cod_Ed_Izm&#13;&#10;&#13;&#10;  INNER JOIN dbo.Gr_VxodPredm Gr_VxodPredm&#13;&#10;    ON  Gr_VxodPredm.Key_Predm=T_VPredm.Key_Predm&#13;&#10;    AND Gr_VxodPredm.Key_VidGr=1&#13;&#10;  INNER JOIN dbo.Gr_Groups Gr_Groups&#13;&#10;    ON Gr_Groups.Key_VidGr=Gr_VxodPredm.Key_VidGr&#13;&#10;    AND Gr_Groups.Cod_Gr=Gr_VxodPredm.Cod_Gr&#13;&#10;&#13;&#10;&#13;&#10;      &#13;&#10;  &#13;&#10;&#13;&#10;      &#13;&#10;WHERE&#13;&#10;/*FILTER*/ 1=1&#13;&#10;  AND P_VMZ.Key_WSNRM =:Key_WSNRM&#13;&#10;&#13;&#10;GROUP BY&#13;&#10;  P_VMZ.Key_WSNRM,&#13;&#10;&#13;&#10;  Gr_Groups.Cod_Gr,&#13;&#10;  Gr_Groups.FullNameGr,&#13;&#10;&#13;&#10;  T_VPredm.Cod_Postav,&#13;&#10;  T_VPredm.Name_Postav,                                &#13;&#10;    &#13;&#10;  T_Prinadl.Cod_Prin,&#13;&#10;  T_Prinadl.WSNRMOrder,&#13;&#10;  T_Prinadl.Name_Prin,&#13;&#10;  T_Prinadl.PrintFlag,&#13;&#10;&#13;&#10;  T_VPredm.Key_Predm,&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.OrderSortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;&#13;&#10;  T_VPredm.Cod_Ed_Izm,&#13;&#10;  T_VPredm.Name_K_Ed,&#13;&#10;&#13;&#10;--  T_EdIzm.Cod_Ed_Izm,&#13;&#10;--  T_EdIzm.Name_K_Ed,&#13;&#10;&#13;&#10;  Sklad_Ed_Izm.Cod_Ed_Izm,&#13;&#10;  Sklad_Ed_Izm.Name_K_Ed&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY   &#13;&#10;  T_VPredm.Cod_Postav,&#13;&#10;  T_Prinadl.WSNRMOrder,  &#13;&#10;  Gr_Groups.Cod_Gr, &#13;&#10;  Name_Predm  ,  &#13;&#10;  T_VPredm.OrderSortam">
