    <TfrxERQuery Name="DSEList" UserName="DSEList" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="VKZfrxDS" IgnoreDupParams="False" SQL.Text="SELECT     P_VKZ.Cod_Zak, P_VKZ.Key_VKZ_Izdel, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, Pr_Pasp.Cod_Pasp, P_VKZ.Kolvo, Pr_PaspDet.KolvoZap&#13;&#10;FROM         Pr_Pasp INNER JOIN&#13;&#10;                      Pr_PaspDet ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport RIGHT OUTER JOIN&#13;&#10;                      P_VKZ INNER JOIN&#13;&#10;                      T_VPredm ON P_VKZ.Key_Predm = T_VPredm.Key_Predm ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;WHERE     (P_VKZ.Cod_Zak = :Cod_Zak)&#13;&#10;ORDER BY T_VPredm.OrderCod_Predm  " PropData="05704C65667402300470546F7002440A506172616D657465727301010C24000000204E616D653D22436F645F5A616B222044617461547970653D226674556E6B6E6F776E220000"/>
