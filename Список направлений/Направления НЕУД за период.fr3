  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="NaprList" UserName="Íàïðàâëåíèÿ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;1 as volume,                                                      &#13;&#10;--  Pr_Napr.Key_Napr Key_Napr,&#13;&#10;--  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.Cod_TT Cod_TT,&#13;&#10; -- T_TechTreb.Name_TT,&#13;&#10;  --Pr_NaprZakl.Kolvo,&#13;&#10;  Pr_NaprZakl.VolKontr,&#13;&#10; -- Pr_NaprZakl.ParamKontr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.ZavNumFrom,&#13;&#10;  Pr_NaprZakl.ZavNumTo,&#13;&#10;                            &#13;&#10;&#13;&#10;  Pr_Zakl.Vid_Zakl,&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;&#13;&#10; -- Pr_Pasp.Cod_Pasp,&#13;&#10;  T_VPredm.Cod_Predm,  &#13;&#10;  T_VPredm.Name_Predm&#13;&#10;&#13;&#10; /* PredmM.Cod_Predm    Cod_PredmM,&#13;&#10;  PredmM.Name_Predm   Name_PredmM,&#13;&#10;  PredmM.Sortam       SortamM,&#13;&#10;  PredmM.Marka        MarkaM,&#13;&#10;  Pr_Pasp_Place.Cod_Pasp_Place,&#13;&#10;  Pr_Pasp.Date_Place                          */&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp_Place&#13;&#10;    ON  Pr_Pasp_Place.Key_Pasp_Place=  Pr_Pasp.Key_Pasp_Place                                                                           &#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;              &#13;&#10;&#13;&#10;WHERE&#13;&#10;       Pr_Napr.Data_Napr BETWEEN :DateFrom AND :DateTO&#13;&#10;       AND Pr_NaprZakl.Cod_TT like :Cod_TT&#13;&#10;       AND Num_Zakl like '%ÍÅÓÄ%'&#13;&#10;       AND Num_Zakl is not null&#13;&#10;       AND /*FILTER*/ 1=1&#13;&#10;                                           &#13;&#10;  &#13;&#10;ORDER BY   Data_Napr, Num_Zakl             &#13;&#10;&#13;&#10;              &#13;&#10;&#13;&#10;                                  " PropData=""/>
    <TfrxERQuery Name="NaprListTotal" UserName="TotalV" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="&#13;&#10;                                                       &#13;&#10;/*SELECT&#13;&#10; 1 as volume,    &#13;&#10;  Pr_Napr.Key_Napr Key_Napr,&#13;&#10;  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.Cod_TT Cod_TT,&#13;&#10;  T_TechTreb.Name_TT,&#13;&#10;  Pr_NaprZakl.Kolvo,&#13;&#10;  Pr_NaprZakl.VolKontr,&#13;&#10;  Pr_NaprZakl.ParamKontr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.ZavNumFrom,&#13;&#10;  Pr_NaprZakl.ZavNumTo,&#13;&#10;                            &#13;&#10;&#13;&#10;  Pr_Zakl.Vid_Zakl,&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;&#13;&#10;  Pr_Pasp.Cod_Pasp,&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;&#13;&#10;  PredmM.Cod_Predm    Cod_PredmM,&#13;&#10;  PredmM.Name_Predm   Name_PredmM,&#13;&#10;  PredmM.Sortam       SortamM,&#13;&#10;  PredmM.Marka        MarkaM,&#13;&#10;  Pr_Pasp_Place.Cod_Pasp_Place,&#13;&#10;  Pr_Pasp.Date_Place                          &#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp_Place&#13;&#10;    ON  Pr_Pasp_Place.Key_Pasp_Place=  Pr_Pasp.Key_Pasp_Place                                                                           &#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;              &#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_NaprZakl.Key_Zakl IS NULL&#13;&#10;AND    Pr_Napr.Data_Napr BETWEEN :DateFrom AND :DateTO&#13;&#10;AND Pr_NaprZakl.Cod_TT like :Cod_TT                                       &#13;&#10;AND        &#13;&#10;--FILTER&#13;&#10; 1=1&#13;&#10;  &#13;&#10;ORDER BY   Pr_NaprZakl.Cod_TT, Pr_Napr.Num_Napr*/&#13;&#10;SELECT&#13;&#10;1 as volume,                                                      &#13;&#10;--  Pr_Napr.Key_Napr Key_Napr,&#13;&#10;--  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.Cod_TT Cod_TT,&#13;&#10; -- T_TechTreb.Name_TT,&#13;&#10;  --Pr_NaprZakl.Kolvo,&#13;&#10;  Pr_NaprZakl.VolKontr,&#13;&#10; -- Pr_NaprZakl.ParamKontr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.ZavNumFrom,&#13;&#10;  Pr_NaprZakl.ZavNumTo,&#13;&#10;                            &#13;&#10;&#13;&#10;  Pr_Zakl.Vid_Zakl,&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;&#13;&#10; -- Pr_Pasp.Cod_Pasp,&#13;&#10;  T_VPredm.Cod_Predm,  &#13;&#10;  T_VPredm.Name_Predm&#13;&#10;&#13;&#10; /* PredmM.Cod_Predm    Cod_PredmM,&#13;&#10;  PredmM.Name_Predm   Name_PredmM,&#13;&#10;  PredmM.Sortam       SortamM,&#13;&#10;  PredmM.Marka        MarkaM,&#13;&#10;  Pr_Pasp_Place.Cod_Pasp_Place,&#13;&#10;  Pr_Pasp.Date_Place                          */&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp_Place&#13;&#10;    ON  Pr_Pasp_Place.Key_Pasp_Place=  Pr_Pasp.Key_Pasp_Place                                                                           &#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;              &#13;&#10;&#13;&#10;WHERE&#13;&#10;       Pr_Napr.Data_Napr BETWEEN :DateFrom AND :DateTO&#13;&#10;       AND Pr_NaprZakl.Cod_TT like :Cod_TT&#13;&#10;      -- AND Num_Zakl like '%ÍÅÓÄ%'&#13;&#10;       AND Num_Zakl is not null&#13;&#10;       AND /*FILTER*/ 1=1&#13;&#10;                                           &#13;&#10;  &#13;&#10;ORDER BY   Data_Napr, Num_Zakl             &#13;&#10;&#13;&#10;              &#13;&#10;&#13;&#10;             &#13;&#10;&#13;&#10;              &#13;&#10;&#13;&#10;                                  " PropData=""/>
  </TfrxDataPage>
