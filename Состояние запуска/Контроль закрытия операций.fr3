<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41449,6830513773" ReportOptions.Description.Text="" ReportOptions.Name="Êîíòðîëü çàêðûòèÿ îïåðàöèé.fr3 Ñîñòîÿíèå çàïóñêà" ReportOptions.LastChange="41473,684337662" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;procedure PrintAllOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2A00000020446174615365743D2245525175657279312220446174615365744E616D653D224552517565727931220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT                     &#13;&#10;	Pr_Pasp.Cod_Zak,&#13;&#10; P_VKZ_Izdel.Key_VKZ_Izdel,                                     &#13;&#10;	T_VPredm_Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;	T_VPredm_Izdel.Name_Predm AS Name_Predm_Izdel, &#13;&#10;	Pr_Pasp.Key_Pasport, &#13;&#10;	Pr_Pasp.Cod_Pasp, &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm,&#13;&#10;	T1.CntOper,&#13;&#10;	T1.SmTrudOper,&#13;&#10;	T1.SmOper,&#13;&#10; S_SUBJECTS.Name_Sub                         &#13;&#10;FROM         &#13;&#10;	Pr_Pasp &#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	INNER JOIN Pr_PaspDet &#13;&#10;		ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport &#13;&#10;	INNER JOIN P_VKZ &#13;&#10;		ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ &#13;&#10;	INNER JOIN P_VKZ AS P_VKZ_Izdel &#13;&#10;		ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ &#13;&#10;	INNER JOIN T_VPredm AS T_VPredm_Izdel &#13;&#10;		ON P_VKZ_Izdel.Key_Predm = T_VPredm_Izdel.Key_Predm&#13;&#10; LEFT JOIN S_SUBJECTS                                                                        &#13;&#10;  ON S_SUBJECTS.Key_Sub = P_VKZ_Izdel.Key_Sub_Master                                                                   &#13;&#10;	INNER JOIN (&#13;&#10;&#13;&#10;		select &#13;&#10;			Key_Pasport,&#13;&#10;			Count(Key_Pasp_Rows) CntOper,&#13;&#10;			SUM(Tsm) SmTrudOper,&#13;&#10;			dbo.Pr_Pasp_GenNRowsPr(Key_Pasport) SmOper&#13;&#10;		from dbo.Pr_Pasp_Rows Pr_Pasp_Rows&#13;&#10;		where &#13;&#10;		Pr_Pasp_Rows.Status_Oper &#60; 2&#13;&#10;		AND exists (&#13;&#10;			select * &#13;&#10;			from dbo.Pr_Pasp_Rows T1 &#13;&#10;			where T1.Key_Pasport = Pr_Pasp_Rows.Key_Pasport&#13;&#10;			AND T1.N_Oper_SM &#62; Pr_Pasp_Rows.N_Oper_SM&#13;&#10;			AND T1.Status_Oper = 2&#13;&#10;			)&#13;&#10;		GROUP BY Key_Pasport&#13;&#10;&#13;&#10;	) T1&#13;&#10;	ON T1.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;&#13;&#10;INNER JOIN &#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	Pr_Pasp.Key_Pasport, &#13;&#10;	MAX(T0.N_Oper_Sm) AS Expr1&#13;&#10;&#13;&#10;FROM         &#13;&#10;	Pr_Pasp &#13;&#10;	LEFT JOIN Pr_Pasp_Rows   T0 &#13;&#10;		ON   T0.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;&#13;&#10;&#13;&#10;GROUP BY Pr_Pasp.Key_Pasport&#13;&#10;) T001&#13;&#10;ON T001.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;&#13;&#10;&#13;&#10;INNER JOIN &#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	Pr_Pasp.Key_Pasport, &#13;&#10;	MAX(T0.N_Oper_Sm) AS Expr1&#13;&#10;&#13;&#10;FROM         &#13;&#10;	Pr_Pasp &#13;&#10;	LEFT JOIN Pr_Pasp_Rows   T0 &#13;&#10;		ON   T0.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;		AND  T0.Status_Oper = 2&#13;&#10;&#13;&#10;GROUP BY Pr_Pasp.Key_Pasport&#13;&#10;) T002&#13;&#10;ON T002.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;&#13;&#10;&#13;&#10;INNER JOIN &#13;&#10;(&#13;&#10;SELECT     &#13;&#10;	Pr_Pasp.Key_Pasport, &#13;&#10;	MAX(T0.N_Oper_Sm) AS Expr1&#13;&#10;&#13;&#10;FROM         &#13;&#10;	Pr_Pasp &#13;&#10;	LEFT JOIN Pr_Pasp_Rows   T0 &#13;&#10;		ON   T0.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;		AND  T0.Status_Oper &#60; 2&#13;&#10;&#13;&#10;GROUP BY Pr_Pasp.Key_Pasport&#13;&#10;) T003&#13;&#10;ON T003.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;WHERE&#13;&#10;  P_VKZ_Izdel.Cod_SosZ='Ä'&#13;&#10;  AND P_VKZ_Izdel.Cod_Zak like '[0-9]%'&#13;&#10;  AND (( T003.Expr1 is NOT NULL   AND T001.Expr1  = T002.Expr1 ) OR :PrintAll = 1)                                       &#13;&#10;&#13;&#10;ORDER BY S_SUBJECTS.Name_Sub, Pr_Pasp.Cod_Zak, Cod_Predm_Izdel         " PropData="05704C65667402280470546F7002200A506172616D657465727301010C43000000204E616D653D225072696E74416C6C222044617461547970653D226674496E7465676572222045787072657373696F6E3D225072696E74416C6C2E436865636B6564220000"/>
