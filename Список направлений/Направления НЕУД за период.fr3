<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="44049,4930780671" ReportOptions.Description.Text="" ReportOptions.Name="Íàïðàâëåíèÿ ÍÅÓÄ çà ïåðèîä.fr3 Ñïèñîê íàïðàâëåíèé" ReportOptions.LastChange="44097,4060368519" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;function FnProcent():integer;&#13;&#10;begin&#13;&#10;&#13;&#10;    Result:=1 ;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Cod_TTOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DateFrom.Date:=Date-DayOf(Date)+1;&#13;&#10;  DateTo.Date:=Date&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
