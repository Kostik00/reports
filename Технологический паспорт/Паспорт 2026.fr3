    <TfrxERQuery Name="KolvoQRY" UserName="Колво" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspFrxDS" Left="168" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;      Key_Pasport,&#13;&#10;&#13;&#10;      SUM(KolvoZap) AS SM&#13;&#10;FROM         Pr_PaspDet&#13;&#10;WHERE&#13;&#10;      Key_Pasport=:Key_Pasport&#13;&#10;&#13;&#10;GROUP BY Key_Pasport">
      <FieldDefs>
        <item FieldName="Key_Pasport"/>
        <item FieldName="SM"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Pasport" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="PrimenQRY" UserName="Применяемость" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspFrxDS" Left="248" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      sum(P_VKZ_1.Kolvo) AS Kolvo,&#13;&#10;      sum(P_VKZ.Kolvo) AS KolvoDT,&#13;&#10;      sum(Pr_PaspDet.KolvoZap) KolvoSM&#13;&#10;FROM&#13;&#10;    P_VKZ&#13;&#10;    LEFT JOIN P_VKZ P_VKZ_1&#13;&#10;          ON isnull(P_VKZ.Key_VKZ_Master,P_VKZ.Key_VKZ) = P_VKZ_1.Key_VKZ&#13;&#10;    LEFT JOIN T_VPredm T_Predm&#13;&#10;          ON T_Predm.Key_Predm = P_VKZ_1.Key_Predm&#13;&#10;    LEFT JOIN dbo.Pr_PaspDet Pr_PaspDet&#13;&#10;          ON  Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;&#13;&#10;WHERE&#13;&#10;        Pr_PaspDet.Key_Pasport=:Key_Pasport&#13;&#10;  AND  P_VKZ.Key_Predm=:Key_Predm&#13;&#10;GROUP BY&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm&#13;&#10;    &#13;&#10;ORDER BY       T_Predm.OrderCod_Predm                           ">
      <FieldDefs>
        <item FieldName="OrderCod_Predm" FieldAlias="OrderCod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldAlias="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="Kolvo" FieldAlias="Kolvo"/>
        <item FieldName="KolvoDT" FieldAlias="KolvoDT"/>
        <item FieldName="KolvoSM" FieldAlias="KolvoSM"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Pasport" DataType="ftUnknown"/>
        <item Name="Key_Predm" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="MatPL" UserName="МатериалПлан" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspFrxDS" Left="168" Top="84" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Pasp.Key_Pasport,&#13;&#10;&#13;&#10;  T_SP.Key_SP,&#13;&#10;  T_SPRows.Key_SPRow,&#13;&#10;  &#13;&#10;  T_SP.InTB1, &#13;&#10;&#13;&#10;&#13;&#10;  T_SP.Treb,&#13;&#10;&#13;&#10;  T_SPRows.Key_Predm,&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS Name_NTD_Sortam,&#13;&#10;&#13;&#10;&#13;&#10;  T_Predm.Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS Name_NTD_Marka,&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  dbo.T_SpTTSert(T_SPRows.Key_SPRow) AS TTSert,&#13;&#10;  dbo.T_SpTTZap(T_SPRows.Key_SPRow) AS TTZap,&#13;&#10;  dbo.T_SpTTPr(T_SPRows.Key_SPRow) AS TTPr&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Pasp&#13;&#10;  INNER JOIN T_SP T_SP&#13;&#10;    ON Pr_Pasp.Key_SP=T_SP.Key_SP&#13;&#10;&#13;&#10;  INNER JOIN T_SPRows T_SPRows&#13;&#10;    ON T_SPRows.Key_SP=T_SP.Key_SP&#13;&#10;&#13;&#10;&#13;&#10;  INNER JOIN Pr_SP&#13;&#10;    ON  Pr_SP.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;    AND PR_SP.Key_SP      = Pr_Pasp.Key_SP&#13;&#10;    AND Pr_SP.Key_SPRow   = T_SPRows.Key_SPRow&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm  T_Predm&#13;&#10;    ON  T_SPRows.Key_Predm = T_Predm.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10; -- AND T_SPRows.SP_position=0">
      <FieldDefs>
        <item FieldName="Key_Pasport" FieldAlias="Key_Pasport"/>
        <item FieldName="Key_SP" FieldAlias="Key_SP"/>
        <item FieldName="Key_SPRow" FieldAlias="Key_SPRow"/>
        <item FieldName="Treb" FieldAlias="Treb" FieldType="fftString" Size="50"/>
        <item FieldName="Key_Predm" FieldAlias="Key_Predm"/>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldAlias="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="Sortam" FieldAlias="Sortam" FieldType="fftString" Size="150"/>
