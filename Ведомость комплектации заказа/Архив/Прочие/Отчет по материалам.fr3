<TfrxReport Version="4.4.26" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="Отчет по материалам ВКЗ № 58" ReportOptions.LastChange="39426,0811443866" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonEN.pas';&#13;&#10;&#13;&#10;  &#13;&#10;begin&#13;&#10;  &#13;&#10;end." StoreInDFM="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="FmatQRY" UserName="Материалы" CloseDataSource="True" FieldAliases.Text="" Master="VKZfrxDS" SQL.Text="SELECT &#13;&#10;       P.Key_VKZ_Izdel, &#13;&#10;       P.Key_VKZ, &#13;&#10;       P1.Key_Pasport,&#13;&#10;       P1.KolvoZap,                           &#13;&#10;       T.Name_Predm, &#13;&#10;       T.Sortam, &#13;&#10;       T.Type_NTD_Sortam, &#13;&#10;       T.Name_NTD_Sortam, &#13;&#10;       T.Marka, &#13;&#10;       T.Type_NTD_Marka, &#13;&#10;       T.Name_NTD_Marka, &#13;&#10;       T1.Cod_Zagotov, &#13;&#10;       T1.Name_Zagotov, &#13;&#10;       P4.ProfRazm, &#13;&#10;       P4.M_Zag, &#13;&#10;       P4.Kolvo, &#13;&#10;       T2.Cod_Predm Cod_DSE, &#13;&#10;       T2.Name_Predm Name_DSE&#13;&#10;       ,Pr_VPaspKolvo.KolvoZap PaspKolvo                                              &#13;&#10;FROM&#13;&#10;    P_VKZ P&#13;&#10;    INNER JOIN Pr_PaspDet P1 ON (P.Key_VKZ=P1.Key_VKZ)&#13;&#10;    INNER JOIN Pr_Pasp P2 ON (P1.Key_Pasport=P2.Key_Pasport)&#13;&#10;    INNER JOIN Pr_SP P3 ON (P2.Key_Pasport=P3.Key_Pasport)&#13;&#10;    INNER JOIN Pr_SPDetail P4 ON (P3.Key_PrSP=P4.Key_PrSP)&#13;&#10;    INNER JOIN A_VID_Mat A ON (P3.Key_ID_Mat=A.Key_ID_Mat)&#13;&#10;    INNER JOIN T_VPredm T ON (A.Key_Predm=T.Key_Predm)&#13;&#10;    INNER JOIN T_Zagotov T1 ON (P4.Cod_Zagotov=T1.Cod_Zagotov)&#13;&#10;    INNER JOIN T_VPredm T2 ON (P2.Key_Predm=T2.Key_Predm)&#13;&#10;    INNER JOIN Pr_VPaspKolvo&#13;&#10;       on      Pr_VPaspKolvo.Key_Pasport=P2.Key_Pasport                                                                                        &#13;&#10;WHERE&#13;&#10;    P.Key_VKZ_Izdel =:Key_VKZ_Izdel&#13;&#10;ORDER BY T2.OrderCod_Predm                                                              " SQLSchema="" PropData="05704C65667402440470546F70024C0A506172616D657465727301010C2A000000204E616D653D224B65795F564B5A5F497A64656C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="ListDSE" UserName="Детали" CloseDataSource="False" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Cod_Pasp=Cod_Pasp&#13;&#10;Key_SP=Key_SP&#13;&#10;Key_TP=Key_TP&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;OrderCod_Predm=OrderCod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;KolvoDet=KolvoDet&#13;&#10;SkipSert=SkipSert&#13;&#10;Cod_TP=Cod_TP&#13;&#10;Name_FMat=Name_FMat&#13;&#10;Sortam_FMat=Sortam_FMat&#13;&#10;Type_NTD_Sortam_Mat=Type_NTD_Sortam_Mat&#13;&#10;Name_NTD_Sortam_Mat=Name_NTD_Sortam_Mat&#13;&#10;Marka_FMat=Marka_FMat&#13;&#10;MarkaPrn_FMat=MarkaPrn_FMat&#13;&#10;Type_NTD_Marka_Mat=Type_NTD_Marka_Mat&#13;&#10;Name_NTD_Marka_Mat=Name_NTD_Marka_Mat&#13;&#10;Key_ID_Mat=Key_ID_Mat&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;Party=Party&#13;&#10;Key_Sert_Pos=Key_Sert_Pos&#13;&#10;PaspMat=PaspMat&#13;&#10;XimC=XimC&#13;&#10;XimSi=XimSi&#13;&#10;XimMn=XimMn&#13;&#10;XimS=XimS&#13;&#10;XimP=XimP&#13;&#10;XimCr=XimCr&#13;&#10;XimNi=XimNi&#13;&#10;XimCu=XimCu&#13;&#10;XimAs=XimAs&#13;&#10;XimAl=XimAl&#13;&#10;XimN=XimN&#13;&#10;XimMo=XimMo&#13;&#10;XimW=XimW&#13;&#10;XimV=XimV&#13;&#10;XimTi=XimTi&#13;&#10;Sootv=Sootv" Master="MainFrxDS" SQL.Text="SELECT DISTINCT&#13;&#10;&#13;&#10;  PR_Pasp.Key_Pasport,&#13;&#10;  PR_Pasp.Cod_Pasp,&#13;&#10;  PR_Pasp.Key_SP,&#13;&#10;  PR_Pasp.Key_TP,&#13;&#10;&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.OrderCod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam,&#13;&#10;&#13;&#10;  dbo.Pr_GetKolvoOnVKZ1(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport, Pr_SP.Key_PrSP ) KolvoDet,&#13;&#10;&#13;&#10;  T_TP.SkipSert,&#13;&#10;  T_TP.Cod_TP,&#13;&#10;&#13;&#10;  FMat.Name_Predm      Name_FMat,&#13;&#10;&#13;&#10;  FMat.Sortam          Sortam_FMat,&#13;&#10;  FMat.Type_NTD_Sortam Type_NTD_Sortam_Mat,&#13;&#10;  FMat.Name_NTD_Sortam Name_NTD_Sortam_Mat,&#13;&#10;&#13;&#10;  FMat.Marka           Marka_FMat,&#13;&#10;  FMat.MarkaPrn        MarkaPrn_FMat,&#13;&#10;  isnull(Pr_SP.Type_NTD, FMat.Type_NTD_Marka)  Type_NTD_Marka_Mat,&#13;&#10;  isnull(Pr_SP.Name_NTD, FMat.Name_NTD_Marka)  Name_NTD_Marka_Mat,&#13;&#10;&#13;&#10;  A_VId_Mat.Key_ID_Mat,&#13;&#10;  A_VId_Mat.N_Sert,&#13;&#10;  A_VId_Mat.Date_Sert,&#13;&#10;  A_VId_Mat.Cod_Plavka,&#13;&#10;  A_VId_Mat.Party,&#13;&#10;  A_VId_Mat.Key_Sert_Pos,&#13;&#10;  A_VId_Mat.Key_Pasport PaspMat ,&#13;&#10;&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'C')  XimC,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Si') XimSi,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Mn') XimMn,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'S')  XimS,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'P')  XimP,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Cr') XimCr,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Ni') XimNi,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Cu') XimCu,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'As') XimAs,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Al') XimAl,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'N')  XimN,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Mo')  XimMo,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'W')  XimW,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'V')  XimV,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Ti') XimTi,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Соответствует') Sootv           &#13;&#10;  &#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ                       -- берем  всю ВКЗ на изделие&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet             -- смотрим для нее какие есть паспорта&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  INNER JOIN PR_Pasp                -- берем все паспорта&#13;&#10;    ON  PR_Pasp.Key_Pasport=PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm       -- данные о самих ДСЕ&#13;&#10;    ON T_Predm.Key_Predm=PR_Pasp.Key_Predm&#13;&#10;  INNER JOIN T_SP                    -- также просматриваем спецификацию&#13;&#10;    ON T_SP.Key_SP=PR_Pasp.Key_SP&#13;&#10;  INNER JOIN Pr_SP                   -- Ну и смотрим только то, на что есть фактический материал&#13;&#10;    ON Pr_SP.Key_Pasport=PR_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_SPRows                 -- Из фактических материалов нас интересует только те, которые относятся к основным материалам&#13;&#10;    ON  T_SPRows.Key_SPRow=Pr_SP.Key_SPRow&#13;&#10;    AND T_SPRows.SP_Position=0&#13;&#10;  INNER JOIN A_VId_Mat                -- Это мы смотрим материал в идентефикаторе&#13;&#10;    ON A_VId_Mat.Key_ID_Mat=Pr_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm FMat            -- А это собственно говоря и есть сам материал&#13;&#10;    ON FMat.Key_Predm=A_VId_Mat.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_TP                    -- выбираем параметры ТП и проверяем, что его надо выдавать в паспорт&#13;&#10;    ON T_TP.Key_TP=PR_Pasp.Key_TP&#13;&#10;    AND T_SP.InTB1=1&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  P_VKZ.Key_VKZ_Izdel=:Key_VKZ_Izdel&#13;&#10;  AND dbo.Pr_GetKolvoOnVKZ1(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport, Pr_SP.Key_PrSP ) &#62; 0&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY T_Predm.OrderCod_Predm" PropData=""/>
  </TfrxDataPage>
