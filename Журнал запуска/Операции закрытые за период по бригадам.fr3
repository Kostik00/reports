<TfrxReport Version="5.6.18" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40903,0009191319" ReportOptions.Description.Text="" ReportOptions.Name="Îïåðàöèè çàêðûòûå çà ïåðèîä ïî áðèãàäàì.fr3 Æóðíàë çàïóñêà" ReportOptions.LastChange="43578,7381145023" ScriptLanguage="PascalScript" ScriptText.Text="function FnPercent(A,B: double):double ;&#13;&#10;begin&#13;&#10;  if B &#60;&#62; 0  then&#13;&#10;    Result:=100*A/B&#13;&#10;  else Result:=0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DateFrom.Date:=Date;&#13;&#10;  DateTo.Date:=Date;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
  <Datasets>
