  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="    SELECT        P_VKZ.Key_VKZ, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, P_VKZ.Key_VKZ_Izdel, T_VPredm_Izdel.Cod_Predm AS Cod_Predm_Izdel, T_VPredm_Izdel.Name_Predm AS Name_Predm_Izdel, &#13;&#10;                         P_VKZ_Izdel.Cod_SosZ AS Cod_SosIzd, T_VPredm_SB.Cod_Predm AS Cod_Predm_SB, T_VPredm_SB.Name_Predm AS Name_Predm_SB, P_VKZ.Kolvo, dbo.Pr_VKZ_Get_Kolvo_Zap(P_VKZ.Key_VKZ) AS Kolvo_Zap, &#13;&#10;                         dbo.Pr_VKZ_Get_Kolvo_Ready(P_VKZ.Key_VKZ) AS Kolvo_Ready, P_VKZ.Kolvo - ISNULL(TPasp.KolvoZap, 0) AS Kolvo_PaspOst, P_VKZ.DataZapUtv, P_VKZ.Cod_Zak, P_VKZ.Key_GrZap, P_VKZ_GrZap.DateGrZap, &#13;&#10;                         T_Predm_Mat.PrintFlag AS PrintFlag_Mat, T_Predm_Mat.Cod_Predm AS Cod_Predm_Mat, T_Predm_Mat.Name_Predm AS Name_Predm_Mat, T_Predm_Mat.Sortam AS Sortam_Mat, T_Predm_Mat.Marka AS Marka_Mat, &#13;&#10;                         P_VKZ_Sost.Name_VKZ_Sost, S_PERSONNEL.Name_Sub, P_VKZ_GrZap_Status.Name_GrZap_Status&#13;&#10;FROM            S_PERSONNEL INNER JOIN&#13;&#10;                         P_VKZ_GrZap ON S_PERSONNEL.Key_Sub_Ver = P_VKZ_GrZap.Key_Sub_Ver_Z INNER JOIN&#13;&#10;                         P_VKZ_GrZap_Status ON P_VKZ_GrZap.Key_GrZap_Status = P_VKZ_GrZap_Status.Key_GrZap_Status RIGHT OUTER JOIN&#13;&#10;                         P_VKZ INNER JOIN&#13;&#10;                         T_VPredm ON P_VKZ.Key_Predm = T_VPredm.Key_Predm INNER JOIN&#13;&#10;                         P_VKZ AS P_VKZ_Izdel ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ INNER JOIN&#13;&#10;                         T_VPredm AS T_VPredm_Izdel ON P_VKZ_Izdel.Key_Predm = T_VPredm_Izdel.Key_Predm LEFT OUTER JOIN&#13;&#10;                         P_VKZ AS P_VKZ_SB ON P_VKZ.Key_VKZ_Master = P_VKZ_SB.Key_VKZ LEFT OUTER JOIN&#13;&#10;                         T_VPredm AS T_VPredm_SB ON P_VKZ_SB.Key_Predm = T_VPredm_SB.Key_Predm LEFT OUTER JOIN&#13;&#10;                         T_SP ON T_SP.Key_Predm = T_VPredm.Key_Predm AND T_SP.SP_Version = T_VPredm.SP_Version LEFT OUTER JOIN&#13;&#10;                         T_SPRows ON T_SPRows.Key_SP = T_SP.Key_SP AND T_SPRows.SP_position = 0 LEFT OUTER JOIN&#13;&#10;                         T_VPredm AS T_Predm_Mat ON T_Predm_Mat.Key_Predm = T_SPRows.Key_Predm INNER JOIN&#13;&#10;                         P_VKZ_Sost ON P_VKZ_Sost.Key_VKZ_Sost = P_VKZ.Key_VKZ_Sost ON P_VKZ_GrZap.Key_GrZap = P_VKZ.Key_GrZap LEFT OUTER JOIN&#13;&#10;                             (SELECT        Key_VKZ, SUM(KolvoZap) AS KolvoZap&#13;&#10;                               FROM            Pr_PaspDet&#13;&#10;                               GROUP BY Key_VKZ) AS TPasp ON TPasp.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;WHERE        (P_VKZ.Kolvo - ISNULL(TPasp.KolvoZap, 0) &#62; 0) AND (P_VKZ_Izdel.Cod_SosZ = '�') AND (P_VKZ.Key_GrZap &#62; 0) --AND (P_VKZ_GrZap_Status.Name_GrZap_Status = '� ������ �������')&#13;&#10;ORDER BY P_VKZ_GrZap.DateGrZap DESC, P_VKZ.Key_GrZap, Name_Predm_Mat            " PropData="05704C6566740384000470546F7002700A506172616D65746572730100"/>
  </TfrxDataPage>
