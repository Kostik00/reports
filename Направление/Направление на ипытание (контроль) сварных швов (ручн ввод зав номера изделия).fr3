<TfrxReport Version="6.9.6" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="42033,1185296065" ReportOptions.Description.Text="" ReportOptions.Name="Направление на ипытание (контроль) сварных швов (ручн ввод зав номера изделия).f&#38;r3 Напр. № 858-1 от 21.10.2022" ReportOptions.LastChange="46070,9633019097" ScriptLanguage="PascalScript" ScriptText.Text="USES 'CommonRU.pas';&#13;&#10;&#13;&#10;var&#13;&#10;  SmTO:string;&#13;&#10;  PlusMp:boolean;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function FnPlusMP():string;&#13;&#10;begin&#13;&#10;  if &#60;СтрокиНапр.&#34;PlusMP&#34;&#62; = '' then&#13;&#10;    Result:=''&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result:=#13#10+&#60;СтрокиНапр.&#34;PlusMP&#34;&#62;;&#13;&#10;    PlusMP:=True;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function FnPlavka(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if Result &#60;&#62; '' then Result:= '(плавка ' + S + ')';&#13;&#10;end;&#13;&#10;&#13;&#10;function FnPlusMPP():string;&#13;&#10;begin&#13;&#10;  if &#60;СтрокиНапр.&#34;PlusMP&#34;&#62; = '' then&#13;&#10;    Result:=''&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result:=#13#10'(100%)';&#13;&#10;    PlusMP:=True;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function FnSvrDtMat:string;&#13;&#10;begin&#13;&#10;//  if &#60;МатериалДт.&#34;Key_Predm_Mat&#34;&#62; &#62; 0 then&#13;&#10;//    Result:=&#60;МатериалДт.&#34;Name_Predm_Mat&#34;&#62;+#13#10+ &#60;МатериалДт.&#34;Marka_Mat&#34;&#62;&#13;&#10;//  else&#13;&#10;    Result:=  PrintPredm(&#60;МатериалДт.&#34;PrintFlag_Mat&#34;&#62;, &#60;МатериалДт.&#34;Cod_Predm_Mat&#34;&#62;, &#60;МатериалДт.&#34;Name_Predm_Mat&#34;&#62;,&#13;&#10;       &#60;МатериалДт.&#34;Sortam_Mat&#34;&#62;, &#60;МатериалДт.&#34;Type_NTD_Sortam_Mat&#34;&#62;, &#60;МатериалДт.&#34;Name_NTD_Sortam_Mat&#34;&#62;,&#13;&#10;       &#60;МатериалДт.&#34;Marka_Mat&#34;&#62;, &#60;МатериалДт.&#34;Type_NTD_Marka_Mat&#34;&#62;, &#60;МатериалДт.&#34;Name_NTD_Marka_Mat&#34;&#62;);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function Fn000(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if Result = '' then Result:='-';&#13;&#10;end;&#13;&#10;&#13;&#10;function FnSootv(S:String):string;&#13;&#10;var&#13;&#10;  str:string;&#13;&#10;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  Result:= StringReplace(Result, 'требования', 'требованиям', 3);&#13;&#10;  Result:= StringReplace(Result, 'требование', 'требованиям', 3);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function FnZavNum:string;&#13;&#10;begin&#13;&#10;  if &#60;Направление.&#34;ZavNumFrom&#34;&#62;  = 0 then&#13;&#10;  begin&#13;&#10;    Result:='';&#13;&#10;  end&#13;&#10;  else&#13;&#10;  if &#60;Направление.&#34;ZavNumTo&#34;&#62; &#62; &#60;Направление.&#34;ZavNumFrom&#34;&#62; then&#13;&#10;  begin&#13;&#10;    Result:=' зав.№ '+IntToStr(&#60;Направление.&#34;ZavNumFrom&#34;&#62;) + '...'+ IntToStr(&#60;Направление.&#34;ZavNumTo&#34;&#62;);&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result:='зав.№ '+IntToStr(&#60;Направление.&#34;ZavNumFrom&#34;&#62;);&#13;&#10;  end&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function FnPredm001(Cod,Name:string):string;&#13;&#10;begin&#13;&#10;  if        (Name&#60;&#62;'Основной металл')&#13;&#10;       and  (Name&#60;&#62;'Подтверждения сертификатных данных')&#13;&#10;       and  (Name&#60;&#62;'Программа подтверждения сертификатных данных')&#13;&#10;  then&#13;&#10;  begin&#13;&#10;    Result:=  Cod + ' ' + Name;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result:='Основной металл';&#13;&#10;  end;&#13;&#10;  if  ZavNumIzdel.Text &#60;&#62; ''&#13;&#10;  then&#13;&#10;  begin&#13;&#10;    Result:=  Result + ' ' + 'Зав. № ' + ZavNumIzdel.Text;&#13;&#10;  end&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function FnPredm022(Cod,Name:string):string;&#13;&#10;begin&#13;&#10;  if        (Name&#60;&#62;'Основной металл')&#13;&#10;       and  (Name&#60;&#62;'Подтверждения сертификатных данных')&#13;&#10;       and  (Name&#60;&#62;'Программа подтверждения сертификатных данных')&#13;&#10;  then&#13;&#10;  begin&#13;&#10;    Result:=  Cod + ' ' + Name;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result:='Основной металл';&#13;&#10;  end;&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function PredmProba(S:String):string;&#13;&#10;begin&#13;&#10;  result := S;&#13;&#10;&#13;&#10;  if Pos('*', S) &#62; 1 then&#13;&#10;  begin&#13;&#10;    Result:= Copy(S,1,Pos('*', S)-1);&#13;&#10;  end;&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure TODataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Footer2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Footer1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SubdetailData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;//  Result1Band.Visible:= not RezQRY1.Eof ;&#13;&#10;//  Result2Band.Visible:= (not RezQRY2.Eof )or(not RezQRY3.eof) ;&#13;&#10;//  Result4Band.Visible:= not RezQRY4.Eof ;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  UdFooter.Visible := (&#60;TTQry.&#34;TTNTDUd&#34;&#62; &#60;&#62; '' ) OR (&#60;TTQry.&#34;TxtUd&#34;&#62; &#60;&#62; '');&#13;&#10;//  NUdFooter.Visible := (&#60;TTQry.&#34;TTNTDNUd&#34;&#62; &#60;&#62; '') or (&#60;TTQry.&#34;TxtNud&#34;&#62; &#60;&#62; '');&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  Child1.visible :=( &#60;СтрокиНапр.&#34;ParamKontr&#34;&#62; &#60;&#62; '') AND ( &#60;СтрокиНапр.&#34;ParamKontr&#34;&#62; &#60;&#62; '-');&#13;&#10;{&#13;&#10;  NominBand1.Visible:= not NominValQRY1.Eof ;&#13;&#10;  NominBand2.Visible:= (not NominValQRY2.Eof )or(not NominValQRY3.eof) ;&#13;&#10;  NominBand4.Visible:= not NominValQRY4.Eof ;&#13;&#10;&#13;&#10;  ParamHDRChild.Visible := NominBand1.Visible or NominBand2.Visible  or NominBand4.Visible;&#13;&#10;  }&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData5OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//    NoTOBand.Visible:=False;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10; NaprHDR.Open;&#13;&#10;&#13;&#10; SmTO:='';&#13;&#10; TOQry.Open;&#13;&#10; TOQry.First;&#13;&#10;&#13;&#10; while not TOQry.Eof do&#13;&#10; begin&#13;&#10;&#13;&#10;  if SmTO&#60;&#62;'' then SmTO:=SmTO+' + ';&#13;&#10;  SmTO:=SmTO+' '+&#60;ТермОбраб.&#34;Isp180&#34;&#62;+' ';&#13;&#10;&#13;&#10;  TOQry.Next;&#13;&#10; end;&#13;&#10; TOQry.First;&#13;&#10;&#13;&#10;  if SmTO=''     then  SmTO := 'в состоянии поставки'&#13;&#10;&#13;&#10;end." StoreInDFM="False">
