    <TfrxERQuery Name="NaclStr" UserName="������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  A_Nacl_Str.Key_Nacl_Str,&#13;&#10;  A_Nacl_Str.Key_Nacl,&#13;&#10;  A_Nacl_Str.Key_ID_Mat,&#13;&#10;  T_VPredm.Key_Predm,&#13;&#10;&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;  A_VID_Mat.VidSert,&#13;&#10;  A_VID_Mat.N_Sert,&#13;&#10;  A_VID_Mat.Date_Sert,&#13;&#10;  A_VID_Mat.Cod_Plavka,&#13;&#10;  A_VID_Mat.Party,&#13;&#10;  A_VID_Mat.RegN_Sert, &#13;&#10;  A_VID_Mat.RegN,&#13;&#10;  A_VID_Mat.Pokovka,                                              &#13;&#10;  &#13;&#10;    &#13;&#10;  A_Nacl_Str.Kolvo,&#13;&#10;  A_Nacl_Str.Cod_Ed_Izm,&#13;&#10;  T_EdIzm.Name_K_Ed,&#13;&#10;  T_VPredm.Cod_Ed_Izm AS BaseCodEd,&#13;&#10;  T_VPredm.Name_K_Ed AS BaseEdizm,&#13;&#10;  A_Nacl_Str.KolvoInBaseEd,&#13;&#10;  A_Nacl_Str.Price,&#13;&#10;  A_Nacl_Str.PercNds,&#13;&#10;  A_Nacl_Str.Sm,&#13;&#10;  A_Nacl_Str.SmNDS&#13;&#10;      ,A_Nacl_Str.Cod_By_Docum&#13;&#10;      ,A_Nacl_Str.Name_By_Docum&#13;&#10;      ,A_Nacl_Str.NumStr_By_Docum      &#13;&#10;  ,T_SertPos.AdDocum                                    &#13;&#10;&#13;&#10;FROM&#13;&#10;  A_Nacl_Str&#13;&#10;  INNER JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = A_Nacl_Str.Key_ID_Mat&#13;&#10;  INNER JOIN  T_VPredmSkl T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm = A_VID_Mat.Key_Predm&#13;&#10;  INNER JOIN T_EdIzm&#13;&#10;    ON A_Nacl_Str.Cod_Ed_Izm = T_EdIzm.Cod_Ed_Izm&#13;&#10;  INNER JOIN T_SertPos&#13;&#10;    ON T_SertPos.Key_Sert_Pos =  A_VID_Mat.Key_Sert_Pos                                                                   &#13;&#10;WHERE&#13;&#10;   A_Nacl_Str.Key_Nacl=:Key_Nacl&#13;&#10;ORDER BY NumStr_By_Docum                             " PropData="05704C656674023C0470546F7002140A506172616D657465727301010C25000000204E616D653D224B65795F4E61636C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="LimitQRY" UserName="LimitQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaclStr" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  A_Nacl_Str.Key_Nacl_Str,&#13;&#10;  A_LZK.Key_LZK,&#13;&#10;  A_Nacl_Str_LZK.Kolvo,&#13;&#10;  A_LZK.Cod_Zak,&#13;&#10;  A_LZK.Cod_Zak Cod_Zak1,&#13;&#10;  A_LZK.Key_ID_Mat,&#13;&#10;  A_LZK.Key_Sub_Ver Key_Sub_Ver,&#13;&#10;  A_LZK.Key_Sub_Ver_Poluch,&#13;&#10;  A_LZK.Ostatok&#13;&#10;FROM&#13;&#10;  A_Nacl_Str&#13;&#10;  CROSS JOIN A_LZK&#13;&#10;  INNER JOIN A_Nacl_Str_LZK&#13;&#10;    ON A_Nacl_Str_LZK.Key_LZK = A_LZK.Key_LZK&#13;&#10;    AND  A_Nacl_Str_LZK.Key_Nacl_Str=A_Nacl_Str.Key_Nacl_Str&#13;&#10;WHERE&#13;&#10;       A_Nacl_Str.Key_Nacl_Str=:Key_Nacl_Str&#13;&#10;  AND  A_LZK.Key_ID_Mat=:Key_Id_Mat&#13;&#10;  AND A_Nacl_Str_LZK.Kolvo &#62;0  &#13;&#10;   " PropData="05704C656674039C000470546F7002140A506172616D657465727301010C29000000204E616D653D224B65795F4E61636C5F537472222044617461547970653D226674556E6B6E6F776E2200010C27000000204E616D653D224B65795F49645F4D6174222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="Kladovshik" UserName="���������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="--SubjQRY&#13;&#10;SELECT&#13;&#10;  S_Subjects.Key_Sub  AS Key_Sprav,&#13;&#10;  S_Subjects.Name_Sub AS Name_Sprav,&#13;&#10;&#13;&#10;&#13;&#10;  SubAtrib11.Val_Str Val_Str11,&#13;&#10;  SubAtrib19.Val_Str Val_Str19,&#13;&#10;  SubAtrib20.Val_Str Val_Str20,&#13;&#10;&#13;&#10;  SubAtrib9.Val_Str Val_Str9&#13;&#10;&#13;&#10;&#13;&#10;FROM   S_Subjects S_Subjects&#13;&#10;   LEFT JOIN S_SubVer Sub_Ver&#13;&#10;   ON  S_Subjects.Key_Sub=Sub_Ver.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib11&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib11.Key_Sub&#13;&#10;       AND SubAtrib11.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib11.Key_Rekv = 11&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib19&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib19.Key_Sub&#13;&#10;        AND SubAtrib19.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;      AND SubAtrib19.Key_Rekv = 19&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib20&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib20.Key_Sub&#13;&#10;       AND SubAtrib20.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib20.Key_Rekv = 20&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib9&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib9.Key_Sub&#13;&#10;       AND SubAtrib9.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib9.Key_Rekv = 9&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Sub_Ver.Key_Sub_Ver = :Key_Sub_Ver_Mol_To                                                               &#13;&#10;&#13;&#10;  " PropData="05704C656674039C000470546F7002640A506172616D657465727301010C2F000000204E616D653D224B65795F5375625F5665725F4D6F6C5F546F222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="DvigDetail" UserName="������������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaclStr" IgnoreDupParams="False" SQL.Text="SELECT A.*, T_Zagotov.Name_Zagotov                                   &#13;&#10;FROM&#13;&#10;    A_Nacl_Str_Sost A&#13;&#10;    INNER JOIN T_Zagotov ON  T_Zagotov.Cod_Zagotov=A.Cod_Zagotov                                                                                            &#13;&#10;      &#13;&#10;WHERE&#13;&#10;    A.Key_Nacl_Str =:Key_Nacl_Str" SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTY2MTGxNDU2sOTlig5JTMpJLQbKONo6xvslJufEB5cUxQfnF5fomJjomJrpGBlY6hiamgOVuhdlpgAVGthq6aArddQx1DEAQ14uQ1vv1Eq4UViUQhQa6NhawRQCrQSa75OZlw1yCQBCHDLg" PropData="05704C656674039C000470546F7003B4000A506172616D657465727301010C29000000204E616D653D224B65795F4E61636C5F537472222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="ZakazQry" UserName="ZakazQry" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaclStr" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  A_Nacl_Str.Key_Nacl_Str,&#13;&#10;  A_LZK.Key_LZK,&#13;&#10;  A_Nacl_Str_LZK.Kolvo,&#13;&#10;  A_LZK.Cod_Zak,&#13;&#10;  A_LZK.Cod_Zak Cod_Zak1,&#13;&#10;  A_LZK.Key_ID_Mat,&#13;&#10;  D_Zakaz.Name_Zak,&#13;&#10;  A_LZK.Key_Sub_Ver Key_Sub_Ver,&#13;&#10;  A_LZK.Key_Sub_Ver_Poluch,&#13;&#10;  S_Subjects.Name_Sub  Name_Sub_Poluch,&#13;&#10;  A_LZK.Ostatok&#13;&#10;FROM&#13;&#10;  A_Nacl_Str&#13;&#10;  CROSS JOIN A_LZK&#13;&#10;  LEFT JOIN A_Nacl_Str_LZK&#13;&#10;    ON A_Nacl_Str_LZK.Key_LZK = A_LZK.Key_LZK&#13;&#10;    AND  A_Nacl_Str_LZK.Key_Nacl_Str=A_Nacl_Str.Key_Nacl_Str&#13;&#10;  INNER JOIN D_Zakaz&#13;&#10;    ON A_LZK.Cod_Zak = D_Zakaz.Cod_Zak&#13;&#10;  INNER JOIN S_SubVer&#13;&#10;    ON A_LZK.Key_Sub_Ver_Poluch = S_SubVer.Key_Sub_Ver&#13;&#10;  INNER JOIN S_Subjects&#13;&#10;    ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;WHERE&#13;&#10;       A_Nacl_Str.Key_Nacl_Str=:Key_Nacl_Str&#13;&#10;  AND  A_LZK.Key_ID_Mat=:Key_Id_Mat&#13;&#10;  AND A_Nacl_Str_LZK.Kolvo &#62;0                                 " PropData="05704C656674039C000470546F700300010A506172616D657465727301010C29000000204E616D653D224B65795F4E61636C5F537472222044617461547970653D226674556E6B6E6F776E2200010C27000000204E616D653D224B65795F49645F4D6174222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="IzdelQRY" UserName="�������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaclStr" IgnoreDupParams="False" SQL.Text="SELECT        &#13;&#10;	A_Nacl_Str_VKZ.Key_Nacl_Str,&#13;&#10;	A_Nacl_Str_VKZ.Key_VKZ_Izdel, &#13;&#10;	P_VKZ.Cod_Zak,&#13;&#10; P_VKZ.KLB,                      &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm&#13;&#10;FROM            &#13;&#10;	A_Nacl_Str_VKZ &#13;&#10;	INNER JOIN P_VKZ &#13;&#10;		ON A_Nacl_Str_VKZ.Key_VKZ_Izdel = P_VKZ.Key_VKZ &#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON P_VKZ.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE&#13;&#10;  A_Nacl_Str_VKZ.Key_Nacl_Str = :Key_Nacl_Str&#13;&#10;ORDER BY 	&#13;&#10; P_VKZ.Cod_Zak,&#13;&#10;	T_VPredm.Cod_Predm                              " PropData="05704C656674039C000470546F70034C010A506172616D657465727301010C29000000204E616D653D224B65795F4E61636C5F537472222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="OMTS" UserName="����" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="--SubjQRY&#13;&#10;SELECT&#13;&#10;  S_Subjects.Key_Sub  AS Key_Sprav,&#13;&#10;  S_Subjects.Name_Sub AS Name_Sprav,&#13;&#10;&#13;&#10;&#13;&#10;  SubAtrib11.Val_Str Val_Str11,&#13;&#10;  SubAtrib19.Val_Str Val_Str19,&#13;&#10;  SubAtrib20.Val_Str Val_Str20,&#13;&#10;&#13;&#10;  SubAtrib9.Val_Str Val_Str9&#13;&#10;&#13;&#10;&#13;&#10;FROM   S_Subjects S_Subjects&#13;&#10;   LEFT JOIN S_SubVer Sub_Ver&#13;&#10;   ON  S_Subjects.Key_Sub=Sub_Ver.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib11&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib11.Key_Sub&#13;&#10;       AND SubAtrib11.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib11.Key_Rekv = 11&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib19&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib19.Key_Sub&#13;&#10;        AND SubAtrib19.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;      AND SubAtrib19.Key_Rekv = 19&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib20&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib20.Key_Sub&#13;&#10;       AND SubAtrib20.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib20.Key_Rekv = 20&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib9&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib9.Key_Sub&#13;&#10;       AND SubAtrib9.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib9.Key_Rekv = 9&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Sub_Ver.Key_Sub_Ver = :Key_Sub_Ver_Mol_From                                                                     &#13;&#10;&#13;&#10;  " PropData="05704C6566740308010470546F7002640A506172616D657465727301010C31000000204E616D653D224B65795F5375625F5665725F4D6F6C5F46726F6D2220446