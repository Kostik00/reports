<TfrxReport Version="2026.2.4" DataSet="PaspFrxDS" DataSetName="Паспорт" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38506,1609096412" ReportOptions.Description.Text="" ReportOptions.Name="Паспорт 2026.fr3 Техн. пасп. № 02000.01101.97223/13" ReportOptions.LastChange="46313,1273794676" ScriptLanguage="PascalScript" ScriptText.Text="uses &#39;CommonRU.pas&#39;;&#13;&#10;&#13;&#10;&#13;&#10;Var&#13;&#10;  StrSm00:string;&#13;&#10;  StrSm01:string;&#13;&#10;  StrSm02:string;&#13;&#10;  StrSm03:string;&#13;&#10;  StartPage:integer;&#13;&#10;&#13;&#10;  StrH:extended;&#13;&#10;&#13;&#10;  LM:variant;&#13;&#10;&#13;&#10;&#13;&#10;  Lnum:integer;&#13;&#10;  CZN: int;&#13;&#10;&#13;&#10;&#13;&#10;const&#13;&#10;  K=1.4;   // размер последней строчки может быть больше нормального размера в К раз&#13;&#10;&#13;&#10;&#13;&#10;function FnPredm:string;&#13;&#10;begin&#13;&#10;  Result:=PrintNameDSE(&#60;ВСИ.&#34;PrintFlag&#34;&#62;,&#60;ВСИ.&#34;Cod_Predm&#34;&#62;, &#60;ВСИ.&#34;Name_Predm&#34;&#62;,&#13;&#10;                       &#60;ВСИ.&#34;Sortam&#34;&#62;, &#60;ВСИ.&#34;Type_NTD_Sortam&#34;&#62;, &#60;ВСИ.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;                       &#60;ВСИ.&#34;Marka&#34;&#62;,  &#60;ВСИ.&#34;Type_NTD_Marka&#34;&#62;,  &#60;ВСИ.&#34;Name_NTD_Marka&#34;&#62;);&#13;&#10;&#13;&#10;//  Result:=Result+&#39;(&#39;+VarToStr(&#60;ВСИ.&#34;PrintFlag&#34;&#62;)+&#39;)&#39;;&#13;&#10;&#13;&#10;end;&#13;&#10;{&#13;&#10;function fnCod_Predm(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if pos(&#39;*&#39;,S)&#62;0 then&#13;&#10;   Result:=Copy(S,1,pos(&#39;*&#39;,S)-1);&#13;&#10;end;&#13;&#10;}&#13;&#10;&#13;&#10;&#13;&#10;function FnPredm1:string;&#13;&#10;begin&#13;&#10;  Result:=PrintNameDSE(&#60;ВП.&#34;PrintFlag&#34;&#62;,&#60;ВП.&#34;Cod_Predm&#34;&#62;, &#60;ВП.&#34;Name_Predm&#34;&#62;,&#13;&#10;                       &#60;ВП.&#34;Sortam&#34;&#62;, &#60;ВП.&#34;Type_NTD_Sortam&#34;&#62;, &#60;ВП.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;                       &#60;ВП.&#34;Marka&#34;&#62;,  &#60;ВП.&#34;Type_NTD_Marka&#34;&#62;,  &#60;ВП.&#34;Name_NTD_Marka&#34;&#62;);&#13;&#10;&#13;&#10;  //Result:=Result+&#39;(&#39;+VarToStr(&#60;ВП.&#34;PrintFlag&#34;&#62;)+&#39;)&#39;;&#13;&#10;&#13;&#10;  if &#60;ВП.&#34;PrintFlag&#34;&#62; and 2 = 2 then&#13;&#10;  Result:=Result+&#39;(&#39;+VarToStr(&#60;ВП.&#34;Cod_Predm&#34;&#62;)+&#39;)&#39;;&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function FnPredm2:string;&#13;&#10;begin&#13;&#10;  Result:=PrintNameDSE(&#60;Резерв.&#34;PrintFlag&#34;&#62;,&#60;Резерв.&#34;Cod_Predm&#34;&#62;, &#60;Резерв.&#34;Name_Predm&#34;&#62;,&#13;&#10;                       &#60;Резерв.&#34;Sortam&#34;&#62;, &#60;Резерв.&#34;Type_NTD_Sortam&#34;&#62;, &#60;Резерв.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;                       &#60;Резерв.&#34;Marka&#34;&#62;,  &#60;Резерв.&#34;Type_NTD_Marka&#34;&#62;,  &#60;Резерв.&#34;Name_NTD_Marka&#34;&#62;);&#13;&#10;&#13;&#10;//  Result:=Result+&#39;(&#39;+VarToStr(&#60;ВСИ.&#34;PrintFlag&#34;&#62;)+&#39;)&#39;;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function fnZavNum:string;&#13;&#10;begin&#13;&#10;  result:=&#39;&#39;;&#13;&#10;  if &#60;MainDS.&#34;ZavNumFrom&#34;&#62; &#62; 0 then&#13;&#10;  begin&#13;&#10;    Result := IntToStr(&#60;MainDS.&#34;ZavNumFrom&#34;&#62;);&#13;&#10;    if &#60;MainDS.&#34;ZavNumTo&#34;&#62;  &#62; &#60;MainDS.&#34;ZavNumFrom&#34;&#62; then&#13;&#10;      Result := Result + &#39;-&#39; + IntToStr(&#60;MainDS.&#34;ZavNumTo&#34;&#62;)&#13;&#10;    else&#13;&#10;      Result := Result;&#13;&#10;  end;&#13;&#10;&#13;&#10;//  if Result=&#39;1&#39; then Result:=Result+&#39;(Головной образец)&#39;&#13;&#10;end;&#13;&#10;&#13;&#10;function fnTpzTsht(Tpz,TSht:double):string;&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function fnCod_Predm1(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;  if pos(&#39;*&#39;,S)&#62;0 then&#13;&#10;   Result:=Copy(S,1,pos(&#39;*&#39;,S)-1);&#13;&#10;&#13;&#10;  if ((&#60;ДСЕ.&#34;PrintFlag&#34;&#62; and 1) = 1) then&#13;&#10;    Result:=&#60;ДСЕ.&#34;Sortam&#34;&#62;+&#39; &#39;+&#60;ДСЕ.&#34;Type_NTD_Sortam&#34;&#62;+&#39; &#39;+&#60;ДСЕ.&#34;Name_NTD_Sortam&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function fnSortam(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;//  if pos(Chr(160),S)&#62;0 then&#13;&#10;//   Result:=Copy(S,1,pos(Chr(160),S)-1);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DrawPageFtr;&#13;&#10;begin&#13;&#10;&#13;&#10;//  if Engine.FreeSpace &#60;=2 then&#13;&#10;//    exit;&#13;&#10;&#13;&#10;//  EmptyStrMemo.Height:=Engine.FreeSpace-1;&#13;&#10;&#13;&#10;//  Engine.ShowBand(EmptyStr);&#13;&#10;//  EmptyStrMemo.Height:=0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure FillEmptyPage;&#13;&#10;begin&#13;&#10;   while Engine.FreeSpace &#62; (K * EmptyStr.Height) do&#13;&#10;     Engine.ShowBand(EmptyStr);&#13;&#10;//   Engine.NewPage;&#13;&#10;&#13;&#10;{&#13;&#10;  if Engine.FreeSpace &#60;=2 then&#13;&#10;    exit;&#13;&#10;  while (Engine.FreeSpace&#62;(TPOperFtr.Height*K)) do&#13;&#10;  begin&#13;&#10;    EmptyStrMemo.Height:=TPOperFtr.Height;&#13;&#10;    Engine.ShowBand(EmptyStr);&#13;&#10;    EmptyStrMemo.Height:=0;&#13;&#10;  end;&#13;&#10;  DrawPageFtr;&#13;&#10;  }&#13;&#10;end;&#13;&#10;&#13;&#10;function CheckFreeSpace1(CheckHeigh:double = 0):boolean;&#13;&#10;begin&#13;&#10;  Result:=False;&#13;&#10;  if CheckHeigh=0 then CheckHeigh:=StrH;&#13;&#10;  if (Engine.FreeSpace &#60; CheckHeigh) then&#13;&#10;  begin&#13;&#10;    DrawPageFtr;&#13;&#10;    Result:=True;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function CheckFreeSpace(CheckHeigh:double = 0):boolean;&#13;&#10;begin&#13;&#10;  Result:=False;&#13;&#10;  if CheckHeigh=0 then CheckHeigh:=StrH;&#13;&#10;  if (Engine.FreeSpace &#60; CheckHeigh) then&#13;&#10;  begin&#13;&#10;    FillEmptyPage;&#13;&#10;    Result:=True;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure NameHeaderOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  StrSm00:=&#39;&#39;; // Сумма наименований&#13;&#10;  StrSm01:=&#39;&#39;; // Сумма обозначений&#13;&#10;  StrSm02:=&#39;&#39;; // Сумма количеств изделий&#13;&#10;  StrSm03:=&#39;&#39;; // Сумма количества деталей&#13;&#10;end;&#13;&#10;&#13;&#10;procedure NameDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if StrSm03&#60;&#62;&#39;&#39; then&#13;&#10;  begin&#13;&#10;    StrSm03:=StrSm03+&#39; + &#39;;&#13;&#10;&#13;&#10;  end;&#13;&#10;&#13;&#10;  StrSm03:=StrSm03+FloatToStr(&#60;Применяемость.&#34;KolvoSM&#34;&#62;);&#13;&#10;  if &#60;Применяемость.&#34;KolvoSM&#34;&#62; &#60;&#62;  &#60;Применяемость.&#34;KolvoDT&#34;&#62;  then&#13;&#10;   StrSm03:=StrSm03 +&#39; (&#39; +FloatToStr(&#60;Применяемость.&#34;KolvoDT&#34;&#62;)+&#39;)&#39;;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  if (&#60;Применяемость.&#34;Cod_Predm&#34;&#62; = &#60;IzdelQRY.&#34;Cod_Predm&#34;&#62;)AND(PrintSB.Checked) then&#13;&#10;    exit;&#13;&#10;  if StrSm01&#60;&#62;&#39;&#39; then&#13;&#10;  begin&#13;&#10;    StrSm00:=StrSm00+&#39; + &#39;;&#13;&#10;    StrSm01:=StrSm01+&#39; + &#39;;&#13;&#10;    StrSm02:=StrSm02+&#39; + &#39;;&#13;&#10;  end;&#13;&#10;  StrSm00:=StrSm00+&#60;Применяемость.&#34;Name_Predm&#34;&#62;;&#13;&#10;  StrSm01:=StrSm01+&#60;Применяемость.&#34;Cod_Predm&#34;&#62;;&#13;&#10;  StrSm02:=StrSm02+FloatToStr(&#60;Применяемость.&#34;Kolvo&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure MasterDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  // Проверяем необходимость печати расширенного описания&#13;&#10;&#13;&#10; // AdInfoPasp.Visible:=False;&#13;&#10; // AdInfoTP.Visible:=False;&#13;&#10;&#13;&#10;  if not (TPQry.FieldByName(&#39;Ad_Info&#39;).isnull)   then&#13;&#10;    AdInfoTP.Visible:=True&#13;&#10;  else&#13;&#10;    AdInfoTP.Visible:=False;&#13;&#10;&#13;&#10;  if not (TPQry.FieldByName(&#39;Ad_Info_Pasp&#39;).isnull)  then&#13;&#10;    AdInfoPasp.Visible:=True&#13;&#10;  else&#13;&#10;    AdInfoPasp.Visible:=False;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  DetailHDR.Visible:= PrintDetail.Checked and  ((&#60;Техпроцесс.&#34;Cod_Oper&#34;&#62;=&#39;0200&#39;)&#13;&#10;  or (&#60;Техпроцесс.&#34;Cod_Oper&#34;&#62;=&#39;0201&#39;)&#13;&#10;  or (&#60;Техпроцесс.&#34;Cod_Oper&#34;&#62;=&#39;0005&#39;)&#13;&#10;  or (Pos(&#39;сварных швов&#39;, &#60;Расшир_Описание.&#34;Razdel&#34;&#62;)&#62;0) );&#13;&#10;&#13;&#10;//  StrBefore.Visible:=(&#60;Техпроцесс.&#34;Cod_Oper&#34;&#62;=&#39;0200&#39;);&#13;&#10;&#13;&#10;//  TPOperFtr.Visible:=TPQry.RecNo &#60; (TPQry.RecordCount-1);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Child7OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TTmemo.Lines.Text:=&#39;&#39;;&#13;&#10;  if &#60;Паспорт.&#34;TTSert&#34;&#62; &#60;&#62; &#39;&#39; then&#13;&#10;  TTmemo.Lines.Text:= TTMemo.Lines.Text+&#39;Проконтролировано в состоянии поставки: &#60;I&#62;[Паспорт.&#34;TTSert&#34;]&#60;/I&#62;&#39;#13#10;&#13;&#10;  if &#60;Паспорт.&#34;TTZap&#34;&#62; &#60;&#62; &#39;&#39; then&#13;&#10;  TTmemo.Lines.Text:= TTMemo.Lines.Text+&#39;Проконтролировано при запуске: &#60;I&#62;[Паспорт.&#34;TTZap&#34;]&#60;/I&#62;&#39;#13#10;&#13;&#10;  if &#60;Паспорт.&#34;TTSvr&#34;&#62; &#60;&#62; &#39;&#39; then&#13;&#10;  TTmemo.Lines.Text:= TTMemo.Lines.Text+&#39;Проконтролированны сварочные материалы в процессе запуска по операциям: &#60;I&#62;[Паспорт.&#34;TTSvr&#34;]&#60;/I&#62;&#39;#13#10;&#13;&#10;  if &#60;Паспорт.&#34;TTPr&#34;&#62; &#60;&#62; &#39;&#39; then&#13;&#10;  TTmemo.Lines.Text:= TTMemo.Lines.Text+&#39;Контролировать в процессе изготовления: &#60;I&#62;[Паспорт.&#34;TTPr&#34;]&#60;/I&#62;&#39;#13#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  exit;&#13;&#10;  if &#60;Применяемость.&#34;Cod_Predm&#34;&#62;=&#60;Паспорт.&#34;Cod_Predm&#34;&#62; then&#13;&#10;  begin&#13;&#10;    Cod_PredmMemo.Lines.Text:=&#39;&#39;;&#13;&#10;    Name_PredmMemo.Lines.Text:=&#39;&#39;;&#13;&#10;    Predm_KolvoMemo.Lines.Text:=&#39;&#39;;&#13;&#10;    ZavNumDSE.Lines.Text:=&#39;&#39;;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    ZavNumIzdel.Lines.Text:=&#39;&#39;;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure ReportSummary1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    FillEmptyPage;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure TPOperHDROnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if  CheckFreeSpace(StrH*3+PageFooter1.Height) then Engine.NewPage;&#13;&#10;&#13;&#10;  if (&#60;Техпроцесс.&#34;Cod_Oper&#34;&#62; = &#39;0200&#39;)AND (FlPlan.ItemIndex = 2) then&#13;&#10;  begin&#13;&#10;    EmptySvrHdr.Visible:=True;&#13;&#10;    EmptySvrDt.Visible:=True;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    EmptySvrHdr.Visible:=False;&#13;&#10;    EmptySvrDt.Visible:=False;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Button1OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TPRows_Detail.Visible:=PrintDetail.Checked;&#13;&#10;  DetailHDR.Visible:=PrintDetail.Checked;&#13;&#10;  SvrBand.Visible:=PrintSvr.Checked;&#13;&#10;&#13;&#10;    ComplPage.Visible:=PrintCompl.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure TitlePrintOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TitlePage.Visible:=TitlePrint.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PasportOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if  TitlePrint.Checked  then&#13;&#10;    StartPage:=1&#13;&#10;  else&#13;&#10;    StartPage:=0;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure DetailHDROnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SvrMatHDR.Visible:=True;       &#13;&#10; // SvrMatHDR.Visible:=(&#60;Расшир_Описание.&#34;Key_ID_Mat&#34;&#62; &#62;0)and(PrintDetail.Checked);&#13;&#10;  CheckFreeSpace(StrH*2);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogOnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MyRestoreString(&#39;ПаспКомментарий&#39;, Comment.Lines.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogOnDeactivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MySaveString(&#39;ПаспКомментарий&#39;, Comment.Lines.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure TPRows_DetailOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SvrMatHDR.Visible:=(&#60;Расшир_Описание.&#34;Key_ID_Mat&#34;&#62; &#62;0)and(PrintDetail.Checked);&#13;&#10;&#13;&#10;  CheckFreeSpace;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Child12OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;{  if FMat.Eof then&#13;&#10;       ChildGrIsp.Child:=EmptyMatChild&#13;&#10;  else&#13;&#10;       ChildGrIsp.Child:=FMatChild;&#13;&#10;       }&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure MainOnAfterCalcHeight(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  h:extended;&#13;&#10;begin&#13;&#10;  h:=TfrxBand(Sender).Height;&#13;&#10;  CheckFreeSpace1(h)&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CheckBox1OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; // DetailFtr.Visible:=DetailFtrCheckBox.Checked;&#13;&#10; StrBefore.Visible:=StrBeforeCheckBox.Checked;&#13;&#10; StrAfter.Visible:=StrAfterCheckBox.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10; s:string;&#13;&#10;begin&#13;&#10;&#13;&#10;  s:= &#60;Заголовок_ТП.&#34;Cod_Prin&#34;&#62;;&#13;&#10;//  if  (S[1] in  [&#39;1&#39;,&#39;2&#39;]) then&#13;&#10;  if 1=1 then&#13;&#10;  begin&#13;&#10;//    EmptyStrMemo.Height:=TPOperFtr.Height;&#13;&#10;    Engine.ShowBand(EmptyStr);&#13;&#10;    EmptyStrMemo.Height:=0;&#13;&#10;&#13;&#10;    UdMemo.Text:=&#39;Торцы деталей и кромки отверстий визуально проконтролированы: трещин, расслоений нет.&#39;#13#10&#13;&#10;       +&#39;Операции 301, 401 выполнены. Детали соответствуют требованиям чертежа.&#39;&#13;&#10;  end&#13;&#10;  else&#13;&#10;   UdMemo.Text:=&#39;&#39;;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure PageFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure TPzTShtMemoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Техпроцесс.&#34;Tsht&#34;&#62; &#60;&#62; 0 then&#13;&#10;    if &#60;Техпроцесс.&#34;Tpz&#34;&#62; &#60;&#62; 0 then&#13;&#10;       TpzTShtMemo.Lines.Text:=&#39;Тпз=[Техпроцесс.&#34;Tpz&#34;] Тшт=[Техпроцесс.&#34;Tsht&#34;]&#39;&#13;&#10;    else&#13;&#10;       TpzTShtMemo.Lines.Text:=&#39;Тшт=[Техпроцесс.&#34;Tsht&#34;]&#39;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SvrMatFtrCkOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SvrMatFtr.Visible:=SvrMatFtrCk.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SvrMatFtrOnAfterPrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  x,cnt:integer;&#13;&#10;begin&#13;&#10;&#13;&#10;  Cnt:=StrToInt(CntEdit.text);&#13;&#10;  if SvrMatFtrCk.Checked then&#13;&#10;  for x:= 2 to Cnt do&#13;&#10;    Engine.ShowBand(EmptyStr);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CntEditOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child13OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child10OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FMat.First;&#13;&#10;  if FMat.Eof then&#13;&#10;       Child10.Child:= Child5&#13;&#10;  else&#13;&#10;        Child10.Child:= Child13;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ProbaFooter.Visible:=True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;МатериалФакт.&#34;Key_Razdel&#34;&#62; = 1 then ProbaFooter.Visible:=False;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ComplPageOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LNum:=0;&#13;&#10;  CZN:=&#60;Паспорт.&#34;ZavNumFrom&#34;&#62;;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterDataP2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Lnum:=Lnum+1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Lnum:=Lnum+1;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure InTBChildOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  InTbChild.Visible := &#60;МатериалПлан.&#34;InTB1&#34;&#62;  =1;             &#13;&#10;end;&#13;&#10;&#13;&#10;procedure PrintLitOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo153.Text:=&#39;Лит. И&#39;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  LM:=MyReadProp(&#39;Левое поле&#39;);&#13;&#10;  if Length(LM)&#60;&#62;0 then&#13;&#10;  begin&#13;&#10;    TitlePage.LeftMargin:=LM;&#13;&#10;  end;&#13;&#10;&#13;&#10;&#13;&#10;  StrH:=TPOperHDR.Height;&#13;&#10;end." StoreInDFM="False">
