    <TfrxERQuery Name="ERQuery1" UserName="Статистика" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT DatePart(yy, T1.DT) Y, DatePart(MONTH, T1.DT)  M, COUNT(T1.Key_TP) CNT                &#13;&#10;FROM&#13;&#10;(&#13;&#10;SELECT        T_TP.Key_TP, Isnull(T_TP.Razrab_Date, T_TP_CodeReg.CodeDate) DT, T_TP.Cod_TP&#13;&#10;FROM            T_TP INNER JOIN&#13;&#10;                         T_TP_CodeReg ON T_TP.Cod_TP = T_TP_CodeReg.TP_Code&#13;&#10;) T1&#13;&#10;&#13;&#10;GROUP BY&#13;&#10;DatePart(yy, T1.DT) , DatePart(MONTH, T1.DT) &#13;&#10;ORDER BY Y,M    " PropData="05704C656674024C0470546F7002340A506172616D65746572730100"/>
