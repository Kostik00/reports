    <TfrxERQuery Name="DocumHDR" UserName="DocumHDR" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Left="316" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  T_SP.Key_SP,&#13;&#10;  T_SP.Key_Predm,&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_SnPredm.Name_Predm,&#13;&#10;  T_SP.SP_Version,&#13;&#10;  T_SP.Key_TP,&#13;&#10;  T_TP.TP_Code,&#13;&#10;  T_SP.Treb,&#13;&#10;&#13;&#10;  T_SP.Key_Sub_Ver_Razrab,&#13;&#10;  S_Subjects_Razrab.Name_Sub AS Name_Sub_Razrab,&#13;&#10;  T_SP.Razrab_date,&#13;&#10;&#13;&#10;  T_SP.Key_Sub_Ver_Prov,&#13;&#10;  S_Subjects_Prov.Name_Sub AS Name_Sub_Prov,&#13;&#10;  T_SP.Prov_date,&#13;&#10;&#13;&#10;  T_SP.Key_Sub_Ver_NKontr,&#13;&#10;  S_Subjects_NKontr.Name_Sub AS Name_Sub_NKontr,&#13;&#10;  T_SP.NKontr_date,&#13;&#10;&#13;&#10;  T_SP.Key_Sub_Ver_Utv,&#13;&#10;  S_Subjects_Utv.Name_Sub AS Name_Sub_Utv,&#13;&#10;  T_SP.Utv_date,&#13;&#10;&#13;&#10;  dbo.S_GegSubVerAtrib(T_SP.Key_Sub_Ver_Razrab,9) RazrabD,&#13;&#10;  dbo.S_GegSubVerAtrib(T_SP.Key_Sub_Ver_Prov,9) ProvD,&#13;&#10;&#13;&#10;&#13;&#10;  T_SP.Litera&#13;&#10;FROM&#13;&#10;  T_Predm T_Predm&#13;&#10;  INNER JOIN T_SnPredm T_SnPredm&#13;&#10;      ON T_SnPredm.Key_SnPredm = T_Predm.Key_SnPredm&#13;&#10;  INNER JOIN T_SP&#13;&#10;      ON T_Predm.Key_Predm = T_SP.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub_Ver = T_SP.Key_Sub_Ver_Razrab&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub = S_Subjects_Razrab.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub_Ver = T_SP.Key_Sub_Ver_Prov&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub = S_Subjects_Prov.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_NKontr&#13;&#10;    ON S_SubVer_NKontr.Key_Sub_Ver = T_SP.Key_Sub_Ver_NKontr&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_NKontr&#13;&#10;    ON S_SubVer_NKontr.Key_Sub = S_Subjects_NKontr.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub_Ver = T_SP.Key_Sub_Ver_Utv&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub = S_Subjects_Utv.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN T_TP&#13;&#10;      ON T_TP.Key_TP=T_SP.Key_TP&#13;&#10;&#13;&#10;WHERE T_SP.Key_SP=:Key_SP">
      <FieldDefs>
        <item FieldName="Key_SP" FieldAlias="Key_SP"/>
        <item FieldName="Key_Predm" FieldAlias="Key_Predm"/>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldAlias="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="SP_Version" FieldAlias="SP_Version"/>
        <item FieldName="Key_TP" FieldAlias="Key_TP"/>
        <item FieldName="TP_Code" FieldAlias="TP_Code" FieldType="fftString" Size="58"/>
        <item FieldName="Treb" FieldAlias="Treb" FieldType="fftString" Size="50"/>
        <item FieldName="Key_Sub_Ver_Razrab" FieldAlias="Key_Sub_Ver_Razrab"/>
        <item FieldName="Name_Sub_Razrab" FieldAlias="Name_Sub_Razrab" FieldType="fftString" Size="80"/>
        <item FieldName="Razrab_date" FieldAlias="Razrab_date" FieldType="fftDateTime"/>
        <item FieldName="Key_Sub_Ver_Prov" FieldAlias="Key_Sub_Ver_Prov"/>
        <item FieldName="Name_Sub_Prov" FieldAlias="Name_Sub_Prov" FieldType="fftString" Size="80"/>
        <item FieldName="Prov_date" FieldAlias="Prov_date" FieldType="fftDateTime"/>
        <item FieldName="Key_Sub_Ver_NKontr" FieldAlias="Key_Sub_Ver_NKontr"/>
        <item FieldName="Name_Sub_NKontr" FieldAlias="Name_Sub_NKontr" FieldType="fftString" Size="80"/>
        <item FieldName="NKontr_date" FieldAlias="NKontr_date" FieldType="fftDateTime"/>
        <item FieldName="Key_Sub_Ver_Utv" FieldAlias="Key_Sub_Ver_Utv"/>
        <item FieldName="Name_Sub_Utv" FieldAlias="Name_Sub_Utv" FieldType="fftString" Size="80"/>
        <item FieldName="Utv_date" FieldAlias="Utv_date" FieldType="fftDateTime"/>
        <item FieldName="RazrabD" FieldAlias="RazrabD" FieldType="fftString" Size="80"/>
        <item FieldName="ProvD" FieldAlias="ProvD" FieldType="fftString" Size="80"/>
        <item FieldName="Litera" FieldAlias="Litera" FieldType="fftString"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_SP" DataType="ftInteger" Expression="&#60;MainDS.&#34;Key_SP&#34;&#62;"/>
      </Parameters>
    </TfrxERQuery>
