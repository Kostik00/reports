    <TfrxERQuery Name="NaprList" UserName="Íàïðàâëåíèÿ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;Pr_Napr.Key_Napr Key_NaprSVR,      &#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;  Pr_Napr.Num_Napr,      &#13;&#10;  S_SubVer.F_Name_Sub,  &#13;&#10;  Pr_NaprZakl.Cod_TT Cod_TT,&#13;&#10;  Pr_NaprZakl.VolKontr,&#13;&#10;  Pr_NaprZakl.ZavNumFrom,&#13;&#10;  Pr_NaprZakl.ZavNumTo,&#13;&#10;  Pr_Zakl.Vid_Zakl,&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;  T_VPredm.Cod_Predm,  &#13;&#10;  T_VPredm.Name_Predm&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp_Place&#13;&#10;    ON  Pr_Pasp_Place.Key_Pasp_Place=  Pr_Pasp.Key_Pasp_Place                                                                           &#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;              &#13;&#10; LEFT JOIN   S_SubVer&#13;&#10;    ON Pr_Napr.Key_Sub_Ver_Otv =   S_SubVer.Key_Sub_Ver  &#13;&#10;/*	-- --------------------&#13;&#10;	 LEFT JOIN Pr_NaprSvr&#13;&#10;       ON  Pr_NaprSvr.Key_NaprZakl =  Pr_NaprZakl.Key_NaprZakl &#13;&#10;LEFT JOIN  Pr_Svr&#13;&#10;       ON Pr_Svr.Key_PrSvr = Pr_NaprSvr.Key_PrSvr*/      &#13;&#10;WHERE&#13;&#10;       Pr_Napr.Data_Napr BETWEEN :DateFrom AND :DateTO&#13;&#10;       AND Pr_NaprZakl.Cod_TT like :Cod_TT&#13;&#10;       AND Num_Zakl like '%ÍÅÓÄ%'&#13;&#10;       AND Num_Zakl is not null&#13;&#10;       AND /*FILTER*/ 1=1&#13;&#10;                                           &#13;&#10;--GROUP BY Data_Napr, Pr_Napr.Key_Sub_Ver_Otv, S_SubVer.F_Name_Sub, Pr_NaprZakl.Cod_TT, VolKontr, Pr_NaprZakl.ZavNumFrom, Pr_NaprZakl.ZavNumTo,Vid_Zakl,Num_Zakl,Data_Zakl,T_VPredm.Cod_Predm,T_VPredm.Name_Predm&#13;&#10;--Pr_Svr.Key_PrSvr,Pr_Svr.ZavNumFrom, Pr_Svr.ZavNumTo, Pr_NaprSvr.Key_NaprZakl,Pr_Napr.Num_Napr              &#13;&#10;ORDER BY S_SubVer.F_Name_Sub, Data_Napr                            &#13;&#10;&#13;&#10;              &#13;&#10;&#13;&#10;                                  " PropData=""/>
    <TfrxERQuery Name="NaprListTotal" UserName="TotalV" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="&#13;&#10;                                                       &#13;&#10;/*SELECT&#13;&#10; 1 as volume,    &#13;&#10;  Pr_Napr.Key_Napr Key_Napr,&#13;&#10;  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.Cod_TT Cod_TT,&#13;&#10;  T_TechTreb.Name_TT,&#13;&#10;  Pr_NaprZakl.Kolvo,&#13;&#10;  Pr_NaprZakl.VolKontr,&#13;&#10;  Pr_NaprZakl.ParamKontr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.ZavNumFrom,&#13;&#10;  Pr_NaprZakl.ZavNumTo,&#13;&#10;                            &#13;&#10;&#13;&#10;  Pr_Zakl.Vid_Zakl,&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;&#13;&#10;  Pr_Pasp.Cod_Pasp,&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;&#13;&#10;  PredmM.Cod_Predm    Cod_PredmM,&#13;&#10;  PredmM.Name_Predm   Name_PredmM,&#13;&#10;  PredmM.Sortam       SortamM,&#13;&#10;  PredmM.Marka        MarkaM,&#13;&#10;  Pr_Pasp_Place.Cod_Pasp_Place,&#13;&#10;  Pr_Pasp.Date_Place                          &#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp_Place&#13;&#10;    ON  Pr_Pasp_Place.Key_Pasp_Place=  Pr_Pasp.Key_Pasp_Place                                                                           &#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;              &#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_NaprZakl.Key_Zakl IS NULL&#13;&#10;AND    Pr_Napr.Data_Napr BETWEEN :DateFrom AND :DateTO&#13;&#10;AND Pr_NaprZakl.Cod_TT like :Cod_TT                                       &#13;&#10;AND        &#13;&#10;--FILTER&#13;&#10; 1=1&#13;&#10;  &#13;&#10;ORDER BY   Pr_NaprZakl.Cod_TT, Pr_Napr.Num_Napr*/&#13;&#10;SELECT&#13;&#10;1 as volume,                                                      &#13;&#10;--  Pr_Napr.Key_Napr Key_Napr,&#13;&#10;--  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.Cod_TT Cod_TT,&#13;&#10; -- T_TechTreb.Name_TT,&#13;&#10;  --Pr_NaprZakl.Kolvo,&#13;&#10;  Pr_NaprZakl.VolKontr,&#13;&#10; -- Pr_NaprZakl.ParamKontr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.ZavNumFrom,&#13;&#10;  Pr_NaprZakl.ZavNumTo,&#13;&#10;                            &#13;&#10;&#13;&#10;  Pr_Zakl.Vid_Zakl,&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;&#13;&#10; -- Pr_Pasp.Cod_Pasp,&#13;&#10;  T_VPredm.Cod_Predm,  &#13;&#10;  T_VPredm.Name_Predm&#13;&#10;&#13;&#10; /* PredmM.Cod_Predm    Cod_PredmM,&#13;&#10;  PredmM.Name_Predm   Name_PredmM,&#13;&#10;  PredmM.Sortam       SortamM,&#13;&#10;  PredmM.Marka        MarkaM,&#13;&#10;  Pr_Pasp_Place.Cod_Pasp_Place,&#13;&#10;  Pr_Pasp.Date_Place                          */&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp_Place&#13;&#10;    ON  Pr_Pasp_Place.Key_Pasp_Place=  Pr_Pasp.Key_Pasp_Place                                                                           &#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;              &#13;&#10;&#13;&#10;WHERE&#13;&#10;       Pr_Napr.Data_Napr BETWEEN :DateFrom AND :DateTO&#13;&#10;       AND Pr_NaprZakl.Cod_TT like :Cod_TT&#13;&#10;      -- AND Num_Zakl like '%ÍÅÓÄ%'&#13;&#10;       AND Num_Zakl is not null&#13;&#10;       AND /*FILTER*/ 1=1&#13;&#10;                                           &#13;&#10;  &#13;&#10;ORDER BY   Data_Napr, Num_Zakl             &#13;&#10;&#13;&#10;              &#13;&#10;&#13;&#10;             &#13;&#10;&#13;&#10;              &#13;&#10;&#13;&#10;                                  " PropData=""/>
    <TfrxERQuery Name="ERQuery1" UserName="ÍàïðàâëåíèÿÂñåãî" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;sum(1) as volume,                                                      &#13;&#10;--  Pr_Napr.Key_Napr Key_Napr,&#13;&#10;--  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;       S_SubVer.F_Name_Sub,  &#13;&#10;  Pr_NaprZakl.Cod_TT Cod_TT,&#13;&#10; -- T_TechTreb.Name_TT,&#13;&#10;  --Pr_NaprZakl.Kolvo,&#13;&#10;  Pr_NaprZakl.VolKontr,&#13;&#10; -- Pr_NaprZakl.ParamKontr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.ZavNumFrom,&#13;&#10;  Pr_NaprZakl.ZavNumTo,&#13;&#10;                            &#13;&#10;&#13;&#10;  Pr_Zakl.Vid_Zakl,&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;&#13;&#10;  -- ----------------------                                                   &#13;&#10;sum(CASE&#13;&#10;		WHEN Pr_Zakl.Num_Zakl like '%ÍÅÓÄ%'&#13;&#10;			THEN 1&#13;&#10;		ELSE 0&#13;&#10;	END) as Neud,&#13;&#10;&#13;&#10;sum(CASE&#13;&#10;		WHEN Pr_Zakl.Num_Zakl like '%ÍÅÓÄ%'&#13;&#10;			THEN 0   &#13;&#10;		ELSE 1   &#13;&#10;	END) as Ud,    &#13;&#10;  -- ----------------------                                                                                                  &#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;&#13;&#10; -- Pr_Pasp.Cod_Pasp,&#13;&#10;  T_VPredm.Cod_Predm,  &#13;&#10;  T_VPredm.Name_Predm&#13;&#10;&#13;&#10; /* PredmM.Cod_Predm    Cod_PredmM,&#13;&#10;  PredmM.Name_Predm   Name_PredmM,&#13;&#10;  PredmM.Sortam       SortamM,&#13;&#10;  PredmM.Marka        MarkaM,&#13;&#10;  Pr_Pasp_Place.Cod_Pasp_Place,&#13;&#10;  Pr_Pasp.Date_Place                          */&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT OUTER JOIN Pr_NaprZakl&#13;&#10;    ON  Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;  LEFT OUTER JOIN Pr_Zakl&#13;&#10;    ON  Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl&#13;&#10;  LEFT OUTER JOIN T_TechTreb&#13;&#10;    ON  Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  LEFT OUTER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport =  Pr_NaprZakl.Key_Pasport&#13;&#10;  LEFT JOIN T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm =   Pr_Pasp.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp_Place&#13;&#10;    ON  Pr_Pasp_Place.Key_Pasp_Place=  Pr_Pasp.Key_Pasp_Place                                                                           &#13;&#10;&#13;&#10;  LEFT JOIN PR_SP&#13;&#10;    ON  PR_SP.Key_PrSp =  Pr_NaprZakl.Key_PrSp&#13;&#10;  LEFT JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = PR_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm   PredmM&#13;&#10;    ON PredmM.Key_Predm =   A_VID_Mat.Key_Predm&#13;&#10;              &#13;&#10; LEFT JOIN   S_SubVer&#13;&#10;    ON Pr_Napr.Key_Sub_Ver_Otv =   S_SubVer.Key_Sub_Ver  &#13;&#10;WHERE&#13;&#10;       Pr_Napr.Data_Napr BETWEEN :DateFrom AND :DateTO&#13;&#10;       AND Pr_NaprZakl.Cod_TT like :Cod_TT&#13;&#10;     --  AND Num_Zakl like '%ÍÅÓÄ%'&#13;&#10;       AND Num_Zakl is not null&#13;&#10;       AND /*FILTER*/ 1=1&#13;&#10;                                           &#13;&#10;GROUP BY Data_Napr, Pr_Napr.Key_Sub_Ver_Otv, S_SubVer.F_Name_Sub, Pr_NaprZakl.Cod_TT, VolKontr, Pr_NaprZakl.ZavNumFrom, Pr_NaprZakl.ZavNumTo,Vid_Zakl,Num_Zakl,Data_Zakl,T_VPredm.Cod_Predm,T_VPredm.Name_Predm        &#13;&#10;ORDER BY S_SubVer.F_Name_Sub, Data_Napr                            &#13;&#10;&#13;&#10;              &#13;&#10;&#13;&#10;                                  " PropData=""/>
    <TfrxERQuery Name="Ispolnitely" UserName="Èñïîëíèòåëè" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprList" IgnoreDupParams="False" SQL.Text="SELECT        Pr_Napr.Num_Napr, Pr_Svr.DateSvr, Pr_Svr.AdNumSvr, T_Svr.NumSvr, Pr_Svr.Kolvo&#13;&#10;, Pr_Svr.Key_PrSvr    &#13;&#10;FROM            Pr_Napr INNER JOIN&#13;&#10;                         Pr_NaprZakl ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr INNER JOIN&#13;&#10;                         Pr_NaprSvr ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl INNER JOIN&#13;&#10;                         Pr_Svr ON Pr_NaprSvr.Key_PrSvr = Pr_Svr.Key_PrSvr INNER JOIN&#13;&#10;                         T_Svr ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Napr.Key_Napr = :Key_NaprSVR&#13;&#10;ORDER BY  Pr_Svr.AdNumSvr,T_Svr.NumSvr                                        " PropData="05704C65667403F8000470546F7003A8000A506172616D657465727301010C28000000204E616D653D224B65795F4E617072535652222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrIspQRY" UserName="Ñâàðùèêè" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="Ispolnitely" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr_Isp.Key_PrSvr,&#13;&#10;  Pr_Svr_Isp.Key_SvrPrimen,&#13;&#10;  Pr_Svr_Isp.Key_Sub_Ver_Svr,&#13;&#10;  T_Svr_PrimenMat.SvrPrimen,&#13;&#10;  S_Subjects.Name_Sub Name_Sub_Svr&#13;&#10;&#13;&#10;  , Pr_Svr_Isp.Key_Sposob&#13;&#10;  , T_SvrSposob.SposobSvr&#13;&#10;  , T_SvrSposob.SpSvr&#13;&#10;&#13;&#10;  , dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 10) Kleimo,&#13;&#10;  dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 11) N_Ud,&#13;&#10;  dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 12) Razr&#13;&#10;      &#13;&#10;FROM&#13;&#10;  Pr_Svr_Isp&#13;&#10;  INNER JOIN T_Svr_PrimenMat&#13;&#10;    ON Pr_Svr_Isp.Key_SvrPrimen = T_Svr_PrimenMat.Key_SvrPrimen&#13;&#10;  INNER JOIN S_SubVer&#13;&#10;    ON Pr_Svr_Isp.Key_Sub_Ver_Svr = S_SubVer.Key_Sub_Ver&#13;&#10;  INNER JOIN S_Subjects&#13;&#10;    ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN dbo.T_SvrSposob T_SvrSposob&#13;&#10;    ON T_SvrSposob.Key_Sposob= Pr_Svr_Isp.Key_Sposob&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Svr_Isp.Key_PrSvr = :Key_PrSvr&#13;&#10;  " PropData="05704C65667403F8000470546F7003F0000A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
