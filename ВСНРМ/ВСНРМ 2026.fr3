        <item FieldName="Cod_WSNRM" FieldAlias="Cod_WSNRM" FieldType="fftString" Size="50"/>
        <item FieldName="Name_WSNRM" FieldAlias="Name_WSNRM" FieldType="fftString" Size="100"/>
