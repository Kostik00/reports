  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="zagryz" UserName="загрузка" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT    &#13;&#10;P_VKZ.Key_VKZ,&#13;&#10;Pr_Pasp.Cod_Pasp,&#13;&#10;T_VPredm.Cod_Predm,&#13;&#10;T_VPredm.Name_Predm,&#13;&#10;T_Obor.Name_K_Obor,&#13;&#10;Pr_Pasp_Rows.Tsm,&#13;&#10;Pr_Pasp.PaspKolvo,&#13;&#10;Pr_PaspDet.KolvoZap,&#13;&#10;Pr_Pasp_Rows.N_Oper_Sm,&#13;&#10;T_Obor.Name_Obor,&#13;&#10;Izdel.Cod_SosZ, &#13;&#10;Pr_Pasp_Rows.Status_Oper ,&#13;&#10; T_Obor.Cod_Obor,&#13;&#10;  P_VKZ.DataVip, &#13;&#10; P_VKZ.Cod_Zak  &#13;&#10;FROM       &#13;&#10;  Pr_Pasp&#13;&#10;   INNER JOIN&#13;&#10;                      T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm &#13;&#10;                      INNER JOIN&#13;&#10;                      Pr_Pasp_Rows&#13;&#10;                       ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport&#13;&#10;                        INNER JOIN&#13;&#10;                      T_TPRows&#13;&#10;                       ON Pr_Pasp_Rows.Key_TPRows = T_TPRows.Key_TPRows&#13;&#10;                        INNER JOIN&#13;&#10;                      T_TPRows_Obor &#13;&#10;                      ON T_TPRows.Key_TPRows = T_TPRows_Obor.Key_TPRows&#13;&#10;                       INNER JOIN&#13;&#10;                      T_Obor&#13;&#10;                       ON T_TPRows_Obor.Cod_Obor = T_Obor.Cod_Obor&#13;&#10;                        INNER JOIN&#13;&#10;                      Pr_PaspDet &#13;&#10;                      ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport &#13;&#10;                      INNER JOIN&#13;&#10;                      P_VKZ&#13;&#10;                       ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;                        INNER JOIN&#13;&#10;                      P_VKZ AS Izdel&#13;&#10;                       ON P_VKZ.Key_VKZ_Izdel = Izdel.Key_VKZ&#13;&#10;WHERE    (T_Obor.Name_K_Obor LIKE :Param1 ) AND         (Izdel.Cod_SosZ = 'Д')&#13;&#10;  AND (Pr_Pasp_Rows.Status_Oper &#60; 6)&#13;&#10;  ORDER BY T_Obor.Name_K_Obor,&#13;&#10;   T_Obor.Cod_Obor,&#13;&#10;   P_VKZ.Cod_Zak" PropData="05704C656674039C000470546F70026C0A506172616D657465727301010C3A000000204E616D653D22506172616D31222044617461547970653D226674537472696E67222045787072657373696F6E3D2245646974312E54657874220000"/>
