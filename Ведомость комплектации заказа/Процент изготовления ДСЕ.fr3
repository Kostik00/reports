<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40888,1098601389" ReportOptions.Description.Text="" ReportOptions.Name="Ïðîöåíò èçãîòîâëåíèÿ ÄÑÅ.fr3 ÂÊÇ ¹ 840-À02-1612" ReportOptions.LastChange="43187,3972717361" ScriptLanguage="PascalScript" ScriptText.Text="const&#13;&#10;  LvlWidth=20;&#13;&#10;&#13;&#10;var&#13;&#10;  Cod_PredmWidth,Cod_PredmLeft:double;&#13;&#10;&#13;&#10;&#13;&#10;function FnTSm:double;&#13;&#10;begin&#13;&#10;  Result:=&#60;TrudQRY.&#34;SmTrudByPasp&#34;&#62;;&#13;&#10;  if Result &#60;= 0 then&#13;&#10;  Result:= &#60;TrudQRY.&#34;SmByTP&#34;&#62;;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function FnProcent:double;&#13;&#10;begin&#13;&#10;  if  FnTSm = 0 then&#13;&#10;       Result:=0&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result := 100 * &#60;TrudQRY.&#34;SmTrudByPaspRowF&#34;&#62;/FnTSm;&#13;&#10;  end&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;function FnProcent1:double;&#13;&#10;begin&#13;&#10;  if  FnTSm = 0 then&#13;&#10;       Result:=0&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result := 100 * &#60;TrudQRY.&#34;SmTrudByZ&#34;&#62;/FnTSm;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Cod_Predm_Memo.Left:=Cod_PredmLeft+(&#60;TrudQRY.&#34;Lvl&#34;&#62;)*LvlWidth;&#13;&#10;  Cod_Predm_Memo.Width:=Cod_PredmWidth-(&#60;TrudQRY.&#34;Lvl&#34;&#62;)*LvlWidth;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  Cod_PredmWidth:=Cod_Predm_Memo.Width;&#13;&#10;  Cod_PredmLeft:=Cod_Predm_Memo.Left;&#13;&#10;end." StoreInDFM="False">
