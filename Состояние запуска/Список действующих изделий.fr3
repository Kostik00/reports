  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="Izdel" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     P_VKZ.Key_VKZ, P_VKZ.Cod_Zak, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, S_Subjects.Name_Sub, MIN(P_VKZ_1.DataZap) AS DtZap, MAX(P_VKZ_1.DataVip) &#13;&#10;                      AS DtVip, P_VKZ.LockDT, P_VKZ.Kolvo                 &#13;&#10;FROM         P_VKZ INNER JOIN&#13;&#10;                      T_VPredm ON P_VKZ.Key_Predm = T_VPredm.Key_Predm INNER JOIN&#13;&#10;                      P_VKZ AS P_VKZ_1 ON P_VKZ.Key_VKZ_Izdel = P_VKZ_1.Key_VKZ_Izdel LEFT OUTER JOIN&#13;&#10;                      S_Subjects ON P_VKZ.Key_Sub_Master = S_Subjects.Key_Sub&#13;&#10;WHERE     (P_VKZ.Key_VKZ_Master IS NULL)&#13;&#10;GROUP BY P_VKZ.Key_VKZ, P_VKZ.Cod_Zak, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, S_Subjects.Name_Sub, P_VKZ.LockDT, P_VKZ.Cod_SosZ, P_VKZ.Kolvo  &#13;&#10;HAVING      (P_VKZ.LockDT = 1) AND (P_VKZ.Cod_SosZ = '�')&#13;&#10;ORDER BY P_VKZ.Cod_Zak, T_VPredm.Cod_Predm  " PropData="05704C65667402340470546F7002280A506172616D65746572730100"/>
