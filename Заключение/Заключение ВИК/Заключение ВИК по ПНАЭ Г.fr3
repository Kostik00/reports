    <TfrxERQuery Name="IzdelQRY" UserName="Изделия" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="60" Top="96" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;  Pr_Napr.Key_Napr,&#13;&#10;  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;      &#13;&#10;&#13;&#10;  T_VPredm_Izdel.Cod_Predm Cod_Predm_Izdel,&#13;&#10;  T_VPredm_Izdel.Name_Predm Name_Predm_Izdel&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT JOIN Pr_NaprZakl&#13;&#10;    ON Pr_NaprZakl.Key_Napr=Pr_Napr.Key_Napr&#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;    ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN  T_TP&#13;&#10;    ON T_TP.Key_TP=Pr_Pasp.Key_TP&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm&#13;&#10;  LEFT JOIN Pr_PaspDet&#13;&#10;    ON Pr_PaspDet.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN P_VKZ&#13;&#10;    ON Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  LEFT JOIN P_VKZ Pr_VKZIzdel&#13;&#10;    ON Pr_VKZIzdel.Key_VKZ=P_VKZ.Key_VKZ_Master&#13;&#10;  LEFT JOIN T_VPredm T_VPredm_Izdel&#13;&#10;    ON T_VPredm_Izdel.Key_Predm=Pr_VKZIzdel.Key_Predm&#13;&#10;  LEFT JOIN T_TechTreb&#13;&#10;    ON T_TechTreb.Cod_TT= Pr_NaprZakl.Cod_TT&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Napr.Key_Napr=:Key_Napr">
      <FieldDefs>
        <item FieldName="Key_Napr"/>
        <item FieldName="Num_Napr" FieldType="fftString" Size="50"/>
        <item FieldName="Data_Napr" FieldType="fftDateTime"/>
        <item FieldName="Cod_Predm_Izdel" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm_Izdel" FieldType="fftString" Size="254"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Napr" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="VidKontr" UserName="Вид контроля" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="NaprStrQRY" Left="380" Top="20" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;       Pr_Napr.Key_Napr,&#13;&#10;       T_TechTreb.VidKontr,&#13;&#10;       Pr_NaprZakl.Cod_TT,&#13;&#10;       Pr_NaprSvr.Key_PrSvr,&#13;&#10;       Pr_NaprZakl.Kolvo,&#13;&#10;       Pr_NaprZakl.VolKontr,&#13;&#10;       T_Svr.NumSvr,&#13;&#10;       dbo.T_Ordersortam(T_Svr.NumSvr) OrderNumSvr,&#13;&#10;       Pr_Svr.AdNumSvr,&#13;&#10;       T_Svr.CatSvr&#13;&#10;FROM&#13;&#10;       Pr_Napr&#13;&#10;       INNER JOIN Pr_NaprZakl&#13;&#10;               ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr&#13;&#10;       INNER JOIN Pr_NaprSvr&#13;&#10;               ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl&#13;&#10;       INNER JOIN Pr_Svr&#13;&#10;               ON Pr_NaprSvr.Key_PrSvr = Pr_Svr.Key_PrSvr&#13;&#10;       INNER JOIN T_Svr&#13;&#10;               ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;       INNER JOIN T_TechTreb&#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;WHERE     Pr_Napr.Key_Napr=:Key_Napr&#13;&#10;      AND Pr_NaprSvr.Key_PrSvr=:Key_PrSvr&#13;&#10;ORDER BY     Pr_NaprZakl.Cod_TT">
      <FieldDefs>
        <item FieldName="Key_Napr"/>
        <item FieldName="VidKontr" FieldType="fftString" Size="50"/>
        <item FieldName="Cod_TT" FieldType="fftString" Size="20"/>
        <item FieldName="Key_PrSvr"/>
        <item FieldName="Kolvo" FieldType="fftString" Size="250"/>
        <item FieldName="VolKontr" FieldType="fftString" Size="500"/>
        <item FieldName="NumSvr" FieldType="fftString" Size="50"/>
        <item FieldName="OrderNumSvr" FieldType="fftString" Size="100"/>
        <item FieldName="AdNumSvr" FieldType="fftString" Size="30"/>
        <item FieldName="CatSvr" FieldType="fftString" Size="20"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Napr" DataType="ftUnknown"/>
        <item Name="Key_PrSvr" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="NTDQry" UserName="NTDQry" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="444" Top="20" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;--  Pr_NaprZakl.Key_Napr,&#13;&#10;  Pr_NaprZakl.Name_NTD&#13;&#10;FROM&#13;&#10;   Pr_NaprZakl&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp&#13;&#10;    ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN  T_TP&#13;&#10;    ON T_TP.Key_TP=Pr_Pasp.Key_TP&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm&#13;&#10;  LEFT JOIN Pr_PaspDet&#13;&#10;    ON Pr_PaspDet.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN P_VKZ&#13;&#10;    ON Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  LEFT JOIN P_VKZ Pr_VKZIzdel&#13;&#10;    ON Pr_VKZIzdel.Key_VKZ=P_VKZ.Key_VKZ_Master&#13;&#10;  LEFT JOIN T_VPredm T_VPredm_Izdel&#13;&#10;    ON T_VPredm_Izdel.Key_Predm=Pr_VKZIzdel.Key_Predm&#13;&#10;  LEFT JOIN T_TechTreb&#13;&#10;    ON T_TechTreb.Cod_TT= Pr_NaprZakl.Cod_TT&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_NaprZakl.Key_Zakl=:Key_Zakl      ">
      <FieldDefs>
        <item FieldName="Name_NTD" FieldType="fftString" Size="500"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Zakl" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="ERQuery1" UserName="KontrQRY" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="384" Top="152" IgnoreDupParams="False" SQL.Text="--SubjQRY&#13;&#10;SELECT&#13;&#10;  S_Subjects.Key_Sub  AS Key_Sprav,&#13;&#10;  S_Subjects.Name_Sub AS Name_Sprav,&#13;&#10;&#13;&#10;&#13;&#10;  SubAtrib11.Val_Str Val_Str11,&#13;&#10;  SubAtrib19.Val_Str Val_Str19,&#13;&#10;  SubAtrib20.Val_Str Val_Str20,&#13;&#10;&#13;&#10;  SubAtrib9.Val_Str Val_Str9&#13;&#10;&#13;&#10;&#13;&#10;FROM   S_Subjects S_Subjects&#13;&#10;   LEFT JOIN S_SubVer Sub_Ver&#13;&#10;   ON  S_Subjects.Key_Sub=Sub_Ver.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib11&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib11.Key_Sub&#13;&#10;       AND SubAtrib11.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib11.Key_Rekv = 11&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib19&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib19.Key_Sub&#13;&#10;        AND SubAtrib19.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;      AND SubAtrib19.Key_Rekv = 19&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib20&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib20.Key_Sub&#13;&#10;       AND SubAtrib20.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib20.Key_Rekv = 20&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib9&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib9.Key_Sub&#13;&#10;       AND SubAtrib9.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib9.Key_Rekv = 9&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Sub_Ver.Key_Sub_Ver = :Key_Sub_Ver_OTK                                         &#13;&#10;&#13;&#10;  ">
      <FieldDefs>
        <item FieldName="Key_Sprav"/>
        <item FieldName="Name_Sprav" FieldType="fftString" Size="80"/>
        <item FieldName="Val_Str11" FieldType="fftString" Size="150"/>
        <item FieldName="Val_Str19" FieldType="fftString" Size="150"/>
        <item FieldName="Val_Str20" FieldType="fftString" Size="150"/>
        <item FieldName="Val_Str9" FieldType="fftString" Size="150"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Sub_Ver_OTK" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="SvrIspQRY" UserName="Исполнители" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="NaprStrQRY" Left="252" Top="140" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr_Isp.Key_PrSvr,&#13;&#10;  Pr_Svr_Isp.Key_SvrPrimen,&#13;&#10;  Pr_Svr_Isp.Key_Sub_Ver_Svr,&#13;&#10;  T_Svr_PrimenMat.SvrPrimen,&#13;&#10;  S_Subjects.Name_Sub Name_Sub_Svr&#13;&#10;&#13;&#10;  , Pr_Svr_Isp.Key_Sposob&#13;&#10;  , T_SvrSposob.SposobSvr&#13;&#10;  , dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 10) Kleimo           &#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Svr_Isp&#13;&#10;  INNER JOIN T_Svr_PrimenMat&#13;&#10;    ON Pr_Svr_Isp.Key_SvrPrimen = T_Svr_PrimenMat.Key_SvrPrimen&#13;&#10;  INNER JOIN S_SubVer&#13;&#10;    ON Pr_Svr_Isp.Key_Sub_Ver_Svr = S_SubVer.Key_Sub_Ver&#13;&#10;  INNER JOIN S_Subjects&#13;&#10;    ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN dbo.T_SvrSposob T_SvrSposob&#13;&#10;    ON T_SvrSposob.Key_Sposob= Pr_Svr_Isp.Key_Sposob&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Svr_Isp.Key_PrSvr = :Key_PrSvr&#13;&#10;ORDER BY  Pr_Svr_Isp.Key_SvrPrimen desc                                       ">
      <FieldDefs>
        <item FieldName="Key_PrSvr"/>
        <item FieldName="Key_SvrPrimen"/>
        <item FieldName="Key_Sub_Ver_Svr"/>
        <item FieldName="SvrPrimen" FieldType="fftString" Size="50"/>
        <item FieldName="Name_Sub_Svr" FieldType="fftString" Size="80"/>
        <item FieldName="Key_Sposob"/>
        <item FieldName="SposobSvr" FieldType="fftString" Size="50"/>
        <item FieldName="Kleimo" FieldType="fftString" Size="80"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_PrSvr" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="PaspQRY" UserName="Паспорта" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="72" Top="196" IgnoreDupParams="False" SQL.Text="SELECT        &#13;&#10;       Pr_Zakl.Key_Zakl, &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;       Izdel.Name_Predm AS Name_Predm_Izdel,                                                                                                        &#13;&#10;       Pr_NaprZakl.Key_NaprZakl, &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       DSE.Cod_Predm, &#13;&#10;       DSE.Name_Predm,&#13;&#10;         &#13;&#10;       Pr_NaprZakl.ZavNumFrom, &#13;&#10;       Pr_NaprZakl.ZavNumTo,&#13;&#10;       Pr_NaprZakl.DopInfo                 &#13;&#10;FROM            Pr_Zakl INNER JOIN&#13;&#10;                         Pr_NaprZakl ON Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl INNER JOIN&#13;&#10;                         Pr_Pasp ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport INNER JOIN&#13;&#10;                         Pr_PaspDet ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport INNER JOIN&#13;&#10;                         P_VKZ ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ INNER JOIN&#13;&#10;                         P_VKZ AS VKZ_IZDEL ON P_VKZ.Key_VKZ_Izdel = VKZ_IZDEL.Key_VKZ INNER JOIN&#13;&#10;                         T_VPredm AS Izdel ON VKZ_IZDEL.Key_Predm = Izdel.Key_Predm INNER JOIN&#13;&#10;                         T_VPredm AS DSE ON Pr_Pasp.Key_Predm = DSE.Key_Predm&#13;&#10;WHERE&#13;&#10;       Pr_Zakl.Key_Zakl = :Key_Zakl&#13;&#10;                  &#13;&#10;&#13;&#10;ORDER BY&#13;&#10;Cod_Predm_Izdel ,&#13;&#10;DSE.Cod_Predm,&#13;&#10;Pr_Pasp.Cod_Pasp,      &#13;&#10;Key_NaprZakl    &#13;&#10;                        ">
      <FieldDefs>
        <item FieldName="Key_Zakl" FieldAlias="Key_Zakl"/>
        <item FieldName="Key_VKZ_Izdel" FieldAlias="Key_VKZ_Izdel"/>
        <item FieldName="Cod_Predm_Izdel" FieldAlias="Cod_Predm_Izdel" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm_Izdel" FieldAlias="Name_Predm_Izdel" FieldType="fftString" Size="254"/>
        <item FieldName="Key_NaprZakl" FieldAlias="Key_NaprZakl"/>
        <item FieldName="Key_Pasport" FieldAlias="Key_Pasport"/>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldAlias="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="ZavNumFrom" FieldAlias="ZavNumFrom"/>
        <item FieldName="ZavNumTo" FieldAlias="ZavNumTo"/>
        <item FieldName="DopInfo" FieldAlias="DopInfo" FieldType="fftString" Size="200"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Zakl" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="IzdelDSEQRY" UserName="ИзделиеДСЕ" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="144" Top="192" IgnoreDupParams="False" SQL.Text="DECLARE @Key_Zakl int = 280642;&#13;&#10;&#13;&#10;WITH T1 As &#13;&#10;(&#13;&#10;SELECT DISTINCT                      &#13;&#10; &#13;&#10;       --Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;       --Izdel.Name_Predm AS Name_Predm_Izdel,&#13;&#10;       --Pr_PaspIzdel.ZavNumIzdel as Izdel_ZavNum,&#13;&#10;&#13;&#10;       Pr_Pasp.Key_Pasport,&#13;&#10;                  &#13;&#10;       DSE.Cod_Predm Cod_Predm_DSE, &#13;&#10;       DSE.Name_Predm Name_Predm_DSE, &#13;&#10;       Pr_Pasp.Cod_Pasp, &#13;&#10;       Pr_Pasp.Cod_Zak&#13;&#10;                    &#13;&#10;                                 &#13;&#10;       ,Pr_NaprZakl.Key_Zakl&#13;&#10;       ,Pr_NaprZakl.ZavNumFrom&#13;&#10;       ,Pr_NaprZakl.ZavNumTo&#13;&#10;       , (select min(Pr_NaprZakl.ZavNumFrom ) from Pr_NaprZakl where Pr_NaprZakl.Key_Zakl = @Key_Zakl) as ZavNumFromMin&#13;&#10;	   , (select max(Pr_NaprZakl.ZavNumTo) from Pr_NaprZakl where Pr_NaprZakl.Key_Zakl = @Key_Zakl) as ZavNumToMax           &#13;&#10;                                  &#13;&#10;         &#13;&#10;FROM            &#13;&#10;    Pr_NaprZakl &#13;&#10;    INNER JOIN Pr_Pasp &#13;&#10;        ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;    INNER JOIN T_VPredm AS DSE &#13;&#10;        ON Pr_Pasp.Key_Predm = DSE.Key_Predm&#13;&#10;&#13;&#10;WHERE        (Pr_NaprZakl.Key_Zakl = @Key_Zakl )&#13;&#10;) &#13;&#10;SELECT * &#13;&#10;FROM T1 &#13;&#10;    CROSS APPLY &#13;&#10;    (&#13;&#10;        SELECT   &#13;&#10;           Pr_PaspIzdel.Key_VKZ_Izdel, &#13;&#10;           Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;           Izdel.Name_Predm AS Name_Predm_Izdel,&#13;&#10;           STRING_AGG (CAST (Pr_PaspIzdel.ZavNumIzdel as varchar(MAX)), &#39;,&#39;  ) as Izdel_ZavNum &#13;&#10;        FROM   Pr_PaspIzdel &#13;&#10;                INNER JOIN P_VKZ AS P_VKZ_Izdel &#13;&#10;                    ON Pr_PaspIzdel.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ &#13;&#10;                INNER JOIN T_VPredm AS Izdel &#13;&#10;                    ON P_VKZ_Izdel.Key_Predm = Izdel.Key_Predm &#13;&#10;        WHERE   &#13;&#10;            Pr_PaspIzdel.Key_Pasport  = T1.Key_Pasport&#13;&#10;            AND Pr_PaspIzdel.ZavNumFrom &#62;= T1.ZavNumFromMin &#13;&#10;            AND Pr_PaspIzdel.ZavNumTo   &#60;= T1.ZavNumToMax&#13;&#10;        GROUP BY &#13;&#10;           Pr_PaspIzdel.Key_VKZ_Izdel, &#13;&#10;           Izdel.Cod_Predm, &#13;&#10;           Izdel.Name_Predm&#13;&#10;    ) T2">
      <FieldDefs>
        <item FieldName="Key_Pasport"/>
        <item FieldName="Cod_Predm_DSE" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm_DSE" FieldType="fftString" Size="254"/>
        <item FieldName="Cod_Pasp" FieldType="fftString" Size="50"/>
        <item FieldName="Cod_Zak" FieldType="fftString" Size="30"/>
        <item FieldName="Key_Zakl"/>
        <item FieldName="ZavNumFrom"/>
        <item FieldName="ZavNumTo"/>
        <item FieldName="ZavNumFromMin"/>
        <item FieldName="ZavNumToMax"/>
        <item FieldName="Key_VKZ_Izdel"/>
        <item FieldName="Cod_Predm_Izdel" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm_Izdel" FieldType="fftString" Size="254"/>
        <item FieldName="Izdel_ZavNum" FieldType="fftString"/>
      </FieldDefs>
    </TfrxERQuery>
    <TfrxERQuery Name="TTQry" UserName="TTQry" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspQRY" Left="348" Top="320" IgnoreDupParams="False" SQL.Text="SELECT                                       &#13;&#10;       Pr_NaprZakl.Key_Zakl, &#13;&#10;       Pr_NaprZakl.ZavNumFrom, &#13;&#10;       Pr_NaprZakl.ZavNumTo, &#13;&#10;       Pr_NaprZakl.Key_PrSp, &#13;&#10;       Pr_NaprZakl.Cod_TT,&#13;&#10;       Pr_NaprZakl.DopInfo,&#13;&#10;       Pr_NaprZakl.TypeObr,                             &#13;&#10;&#13;&#10;       Pr_NaprZakl.ParamKontr,&#13;&#10;       Pr_NaprZakl.VolKontr,             &#13;&#10;       Pr_NaprZakl.Kolvo,             &#13;&#10;       Pr_NaprZakl.Name_NTD,&#13;&#10;&#13;&#10;       Pr_NaprZakl.TOInfo,  &#13;&#10;       Pr_NaprZakl.TOSadka,&#13;&#10;&#13;&#10;        dbo.P_VKZ_Get_KK(Pr_NaprZakl.Key_Pasport,Pr_NaprZakl.Cod_TT)  KK,           &#13;&#10;  &#13;&#10;       dbo.Pr_Get_Zakl_TT ( Pr_NaprZakl.Key_NaprZakl ,0)   NTDTT,           &#13;&#10;       dbo.Pr_Get_Zakl_TT ( Pr_NaprZakl.Key_NaprZakl ,1)   TTNTDUd,&#13;&#10;       dbo.Pr_Get_Zakl_TT ( Pr_NaprZakl.Key_NaprZakl ,2)   TTNTDNUd,  &#13;&#10;  &#13;&#10;       Pr_NaprZakl.TxtUd,&#13;&#10;       Pr_NaprZakl.TxtNud,                             &#13;&#10;  &#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       T_VPredm.Cod_Predm,&#13;&#10;         &#13;&#10;      Pr_NaprZakl.Key_NaprZakl&#13;&#10;FROM                                &#13;&#10;       Pr_NaprZakl&#13;&#10;       LEFT JOIN Pr_SP&#13;&#10;			            	ON Pr_SP.Key_PrSP = Pr_NaprZakl.Key_PrSP&#13;&#10;  &#13;&#10;       LEFT JOIN  T_TechTreb&#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT &#13;&#10; &#13;&#10;       LEFT OUTER JOIN T_VPredm &#13;&#10;               ON Pr_NaprZakl.Key_Predm_Proba = T_VPredm.Key_Predm&#13;&#10;                                                                                             &#13;&#10;&#13;&#10;                        &#13;&#10;WHERE     &#13;&#10;            (Pr_NaprZakl.Key_NaprZakl = :Key_NaprZakl )&#13;&#10; --      AND (Pr_SP.Key_Id_Mat = :Key_Id_Mat )&#13;&#10;  --     AND (Isnull(Pr_NaprZakl.TOSadka,&#39;-&#39;) = Isnull(:TOSadka,&#39;-&#39;) )&#13;&#10;  --     AND (Isnull(Pr_NaprZakl.TOInfo,&#39;-&#39;) = Isnull(:TOInfo,&#39;-&#39;) )&#13;&#10;  --     AND (Pr_NaprZakl.Key_Pasport = :Key_Pasport )           &#13;&#10;         &#13;&#10;                    &#13;&#10;ORDER BY Pr_NaprZakl.Cod_TT">
      <FieldDefs>
        <item FieldName="Key_Zakl"/>
        <item FieldName="ZavNumFrom"/>
        <item FieldName="ZavNumTo"/>
        <item FieldName="Key_PrSp"/>
        <item FieldName="Cod_TT" FieldType="fftString" Size="20"/>
        <item FieldName="DopInfo" FieldType="fftString" Size="200"/>
        <item FieldName="TypeObr" FieldType="fftString" Size="100"/>
        <item FieldName="ParamKontr" FieldType="fftString" Size="500"/>
        <item FieldName="VolKontr" FieldType="fftString" Size="500"/>
        <item FieldName="Kolvo" FieldType="fftString" Size="250"/>
        <item FieldName="Name_NTD" FieldType="fftString" Size="500"/>
        <item FieldName="TOInfo" FieldType="fftString" Size="200"/>
        <item FieldName="TOSadka" FieldType="fftString" Size="50"/>
        <item FieldName="KK" FieldType="fftString" Size="1500"/>
        <item FieldName="NTDTT" FieldType="fftString" Size="255"/>
        <item FieldName="TTNTDUd" FieldType="fftString" Size="255"/>
        <item FieldName="TTNTDNUd" FieldType="fftString" Size="255"/>
        <item FieldName="TxtUd" FieldType="fftString" Size="150"/>
        <item FieldName="TxtNud" FieldType="fftString" Size="150"/>
        <item FieldName="Name_TT" FieldType="fftString" Size="150"/>
        <item FieldName="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Key_NaprZakl"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_NaprZakl" DataType="ftUnknown"/>
        <item Name="Key_Id_Mat" DataType="ftUnknown"/>
        <item Name="TOSadka" DataType="ftUnknown"/>
        <item Name="TOInfo" DataType="ftUnknown"/>
        <item Name="Key_Pasport" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="ERQuery2" UserName="ERQuery2" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspQRY" Left="128" Top="284" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      P_VKZ_1.Kolvo  AS Kolvo,&#13;&#10;      P_VKZ_1.ZavNum_From,&#13;&#10;      P_VKZ_1.ZavNum_To,                                &#13;&#10;      sum(P_VKZ.Kolvo) AS KolvoDT,&#13;&#10;      sum(Pr_PaspDet.KolvoZap) KolvoSM&#13;&#10;FROM&#13;&#10;    P_VKZ&#13;&#10;    LEFT JOIN P_VKZ P_VKZ_1&#13;&#10;          ON isnull(P_VKZ.Key_VKZ_Izdel,P_VKZ.Key_VKZ) = P_VKZ_1.Key_VKZ&#13;&#10;    LEFT JOIN T_VPredm T_Predm&#13;&#10;          ON T_Predm.Key_Predm = P_VKZ_1.Key_Predm&#13;&#10;    LEFT JOIN dbo.Pr_PaspDet Pr_PaspDet&#13;&#10;          ON  Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;&#13;&#10;WHERE&#13;&#10;        Pr_PaspDet.Key_Pasport=:Key_Pasport&#13;&#10;  AND  P_VKZ.Key_Predm=:Key_Predm&#13;&#10;GROUP BY&#13;&#10;      P_VKZ_1.Kolvo,                                         &#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      P_VKZ_1.ZavNum_From,&#13;&#10;      P_VKZ_1.ZavNum_To  &#13;&#10;    --  ,      P_VKZ_1.Kolvo&#13;&#10;    &#13;&#10;ORDER BY       T_Predm.OrderCod_Predm">
      <FieldDefs>
        <item FieldName="OrderCod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="Kolvo"/>
        <item FieldName="ZavNum_From"/>
        <item FieldName="ZavNum_To"/>
        <item FieldName="KolvoDT"/>
        <item FieldName="KolvoSM"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Pasport" DataType="ftUnknown"/>
        <item Name="Key_Predm" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="OborQRY" UserName="OborQRY" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="72" Top="284" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT &#13;&#10;	Pr_NaprZakl.Key_Zakl, &#13;&#10;	Pr_NaprOborList.Name_Obor, &#13;&#10;	Pr_NaprOborList.Date_Obor,&#13;&#10; Pr_NaprOborList.OborGr        &#13;&#10;FROM            &#13;&#10;	Pr_NaprZakl &#13;&#10;	INNER JOIN Pr_NaprZakl_Obor &#13;&#10;		ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprZakl_Obor.Key_NaprZakl &#13;&#10;	INNER JOIN Pr_NaprOborList &#13;&#10;		ON Pr_NaprZakl_Obor.Key_NaprOborList = Pr_NaprOborList.Key_NaprOborList&#13;&#10;WHERE&#13;&#10;  Pr_NaprZakl.Key_Zakl = :Key_Zakl&#13;&#10;ORDER BY Pr_NaprOborList.OborGr">
      <FieldDefs>
        <item FieldName="Key_Zakl"/>
        <item FieldName="Name_Obor" FieldType="fftString" Size="250"/>
        <item FieldName="Date_Obor" FieldType="fftDateTime"/>
        <item FieldName="OborGr" FieldType="fftString" Size="50"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Zakl" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
