    <TfrxERQuery Name="TPQry" UserName="Òåõïðîöåññ" CloseDataSource="True" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Key_TPRows=Key_TPRows&#13;&#10;Key_TP=Key_TP&#13;&#10;N_Oper_SM=N_Oper_SM&#13;&#10;N_OPER_MK=N_OPER_MK&#13;&#10;N_OPER_TP=N_OPER_TP&#13;&#10;Key_Pasp_Rows=Key_Pasp_Rows&#13;&#10;Cod_Oper=Cod_Oper&#13;&#10;Name_Oper=Name_Oper&#13;&#10;IOT=IOT&#13;&#10;Cod_Prof=Cod_Prof&#13;&#10;Name_Prof=Name_Prof&#13;&#10;Razr=Razr&#13;&#10;Cod_Tarif=Cod_Tarif&#13;&#10;Cod_Obor=Cod_Obor&#13;&#10;Name_K_Obor=Name_K_Obor&#13;&#10;KolRab=KolRab&#13;&#10;KolOOD=KolOOD&#13;&#10;EdNorm=EdNorm&#13;&#10;Ad_Info=Ad_Info&#13;&#10;Cod_TP=Cod_TP&#13;&#10;Print_AdInfo=Print_AdInfo&#13;&#10;Tpz=Tpz&#13;&#10;Tsht=Tsht&#13;&#10;Ad_Info_Pasp=Ad_Info_Pasp" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="	SELECT&#13;&#10;	  :Key_Pasport Key_Pasport,&#13;&#10;	  T_TPRows.Key_TPRows,&#13;&#10;	  T_TPRows.Key_TP,&#13;&#10;	  Pasp_Rows.N_Oper_SM,&#13;&#10;	  T_TPRows.N_OPER_MK,&#13;&#10;	  T_TPRows.N_OPER_TP,&#13;&#10;   Pasp_Rows.Key_Pasp_Rows,                                              &#13;&#10;	  Pasp_Rows.Cod_Oper,&#13;&#10;	  T_Oper.Name_Oper,           &#13;&#10;	  Isnull(T_Oper.IOT, T_Prof.IOT) IOT,&#13;&#10;&#13;&#10;	  T_TPRows.Cod_Prof,&#13;&#10;	  T_Prof.Name_Prof,&#13;&#10;	  T_TPRows.Razr,&#13;&#10;	  T_TPRows.Cod_Tarif,&#13;&#10;	  T_TPRows.Cod_Obor,&#13;&#10;	  T_Obor.Name_K_Obor,&#13;&#10;	  T_TPRows.KolRab,&#13;&#10;	  T_TPRows.KolOOD,&#13;&#10;	  T_TpRows.EdNorm,&#13;&#10;	  Pasp_Rows.Ad_Info,&#13;&#10;	  T_TP.Cod_TP,&#13;&#10;	  T_TPRows.Print_AdInfo,&#13;&#10;	  Pasp_Rows.Tpz,&#13;&#10;	  Pasp_Rows.Tsht,&#13;&#10;      Pasp_Rows.Ad_Info_Pasp&#13;&#10;	FROM dbo.Pr_Pasp_Rows Pasp_Rows&#13;&#10;	  LEFT JOIN dbo.T_TPRows T_TPRows&#13;&#10;	      	ON T_TPRows.Key_TPRows=Pasp_Rows.Key_TPRows&#13;&#10;	  LEFT JOIN T_Oper&#13;&#10;	      ON Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper&#13;&#10;	  LEFT JOIN T_Prof&#13;&#10;	      ON T_TPRows.Cod_Prof = T_Prof.Cod_Prof&#13;&#10;	  LEFT OUTER JOIN T_Obor&#13;&#10;	      ON T_TPRows.Cod_Obor = T_Obor.Cod_Obor&#13;&#10;	  LEFT JOIN T_TP&#13;&#10;	      ON T_TP.Key_TP=T_TPRows.Key_V_TP&#13;&#10;	WHERE&#13;&#10;	  Pasp_Rows.Key_Pasport=:Key_Pasport&#13;&#10;	  AND Pasp_Rows.Row_Src in (1,2)&#13;&#10;	  AND ( ( (Isnull(Pasp_Rows.Lvl,0)&#60;=1) AND (Datalength(Pasp_Rows.N_Oper_SM) &#60; 5)) OR (:PrintOper = 1))         &#13;&#10;	ORDER BY&#13;&#10;	  Pasp_Rows.N_OPER_SM" PropData=""/>
    <TfrxERQuery Name="KolvoQRY" UserName="Êîëâî" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="PaspFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;      Key_Pasport,&#13;&#10;&#13;&#10;      SUM(KolvoZap) AS SM&#13;&#10;FROM         Pr_PaspDet&#13;&#10;WHERE&#13;&#10;      Key_Pasport=:Key_Pasport&#13;&#10;&#13;&#10;GROUP BY Key_Pasport" PropData="05704C65667403A8000470546F7002140A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="PrimenQRY" UserName="Ïðèìåíÿåìîñòü" CloseDataSource="True" FieldAliases.Text="OrderCod_Predm=OrderCod_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Kolvo=Kolvo&#13;&#10;KolvoDT=KolvoDT&#13;&#10;KolvoSM=KolvoSM" BCDToCurrency="False" Master="PaspFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      sum(P_VKZ_1.Kolvo) AS Kolvo,&#13;&#10;      sum(P_VKZ.Kolvo) AS KolvoDT,&#13;&#10;      sum(Pr_PaspDet.KolvoZap) KolvoSM&#13;&#10;FROM&#13;&#10;    P_VKZ&#13;&#10;    LEFT JOIN P_VKZ P_VKZ_1&#13;&#10;          ON isnull(P_VKZ.Key_VKZ_Master,P_VKZ.Key_VKZ) = P_VKZ_1.Key_VKZ&#13;&#10;    LEFT JOIN T_VPredm T_Predm&#13;&#10;          ON T_Predm.Key_Predm = P_VKZ_1.Key_Predm&#13;&#10;    LEFT JOIN dbo.Pr_PaspDet Pr_PaspDet&#13;&#10;          ON  Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;&#13;&#10;WHERE&#13;&#10;        Pr_PaspDet.Key_Pasport=:Key_Pasport&#13;&#10;  AND  P_VKZ.Key_Predm=:Key_Predm&#13;&#10;GROUP BY&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm&#13;&#10;    &#13;&#10;ORDER BY       T_Predm.OrderCod_Predm                           " PropData="05704C65667403F8000470546F7002140A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E2200010C26000000204E616D653D224B65795F507265646D222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="MatPL" UserName="ÌàòåðèàëÏëàí" CloseDataSource="True" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Key_SP=Key_SP&#13;&#10;Key_SPRow=Key_SPRow&#13;&#10;Treb=Treb&#13;&#10;Key_Predm=Key_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;TTSert=TTSert&#13;&#10;TTZap=TTZap&#13;&#10;TTPr=TTPr" BCDToCurrency="False" Master="PaspFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Pasp.Key_Pasport,&#13;&#10;&#13;&#10;  T_SP.Key_SP,&#13;&#10;  T_SPRows.Key_SPRow,&#13;&#10;&#13;&#10;&#13;&#10;  T_SP.Treb,&#13;&#10;&#13;&#10;  T_SPRows.Key_Predm,&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS Name_NTD_Sortam,&#13;&#10;&#13;&#10;&#13;&#10;  T_Predm.Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS Name_NTD_Marka,&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  dbo.T_SpTTSert(T_SPRows.Key_SPRow) AS TTSert,&#13;&#10;  dbo.T_SpTTZap(T_SPRows.Key_SPRow) AS TTZap,&#13;&#10;  dbo.T_SpTTPr(T_SPRows.Key_SPRow) AS TTPr&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Pasp&#13;&#10;  INNER JOIN T_SP T_SP&#13;&#10;    ON Pr_Pasp.Key_SP=T_SP.Key_SP&#13;&#10;&#13;&#10;  INNER JOIN T_SPRows T_SPRows&#13;&#10;    ON T_SPRows.Key_SP=T_SP.Key_SP&#13;&#10;&#13;&#10;&#13;&#10;  INNER JOIN Pr_SP&#13;&#10;    ON  Pr_SP.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;    AND PR_SP.Key_SP      = Pr_Pasp.Key_SP&#13;&#10;    AND Pr_SP.Key_SPRow   = T_SPRows.Key_SPRow&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm  T_Predm&#13;&#10;    ON  T_SPRows.Key_Predm = T_Predm.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10; -- AND T_SPRows.SP_position=0" PropData="05704C65667403A8000470546F7002540A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674496E7465676572220000"/>
    <TfrxERQuery Name="FMat" UserName="ÌàòåðèàëÔàêò" CloseDataSource="True" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Key_SP=Key_SP&#13;&#10;Key_SPRow=Key_SPRow&#13;&#10;Key_PrSP=Key_PrSP&#13;&#10;Key_ID_Mat=Key_ID_Mat&#13;&#10;Zamena_Docum=Zamena_Docum&#13;&#10;F_Pokovka=F_Pokovka&#13;&#10;ProfRazm=ProfRazm&#13;&#10;Kolvo=Kolvo&#13;&#10;NumP=NumP&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;VidPostav=VidPostav&#13;&#10;N_SertPos=N_SertPos&#13;&#10;Party=Party&#13;&#10;Pokovka=Pokovka&#13;&#10;AdInfo=AdInfo&#13;&#10;Key_Predm=Key_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;Key_Razdel=Key_Razdel&#13;&#10;Razdel_Name=Razdel_Name" BCDToCurrency="False" Master="PaspFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Pasp.Key_Pasport,&#13;&#10;  T_SPRows.Key_SP,&#13;&#10;  T_SPRows.Key_SPRow,&#13;&#10;  Pr_SP.Key_PrSP,&#13;&#10;  Pr_SP.Key_ID_Mat,&#13;&#10;  Pr_SP.Zamena_Docum,&#13;&#10;  Isnull(Pr_SP.F_Pokovka,A_ID_Mat.Pokovka) F_Pokovka,                                &#13;&#10;    &#13;&#10;  Pr_SPDetail.ProfRazm,&#13;&#10;  Pr_SPDetail.Kolvo,&#13;&#10;  Pr_SPDetail.NumP,&#13;&#10;&#13;&#10;    &#13;&#10;&#13;&#10;  A_ID_Mat.N_Sert,&#13;&#10;  A_ID_Mat.Date_Sert,&#13;&#10;  A_ID_Mat.Cod_Plavka,&#13;&#10;  A_ID_Mat.VidPostav,&#13;&#10;  A_ID_Mat.N_SertPos,&#13;&#10;  A_ID_Mat.Party,&#13;&#10;  A_ID_Mat.Pokovka,&#13;&#10;  A_ID_Mat.AdInfo,&#13;&#10;&#13;&#10;  A_ID_Mat.Key_Predm,&#13;&#10;&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS Name_NTD_Sortam,&#13;&#10;&#13;&#10;&#13;&#10;  T_Predm.Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS Name_NTD_Marka,&#13;&#10;&#13;&#10;  Pr_SPD_Razdel.Key_Razdel,&#13;&#10;  Pr_SPD_Razdel.Razdel_Name                              &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Pasp&#13;&#10;  INNER JOIN T_SP T_SP&#13;&#10;    ON Pr_Pasp.Key_SP=T_SP.Key_SP&#13;&#10;  INNER JOIN T_SPRows T_SPRows&#13;&#10;    ON T_SPRows.Key_SP=T_SP.Key_SP&#13;&#10;&#13;&#10;  LEFT JOIN Pr_SP&#13;&#10;    ON  Pr_SP.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;    AND PR_SP.Key_SP      = Pr_Pasp.Key_SP&#13;&#10;    AND Pr_SP.Key_SPRow   = T_SPRows.Key_SPRow&#13;&#10;      &#13;&#10;  LEFT JOIN Pr_SPDetail&#13;&#10;    ON Pr_SPDetail.Key_PrSP =Pr_SP.Key_PrSP&#13;&#10;      &#13;&#10;  LEFT JOIN Pr_SPD_Razdel&#13;&#10;    ON Pr_SPD_Razdel.Key_Razdel = Pr_SPDetail.Key_Razdel                                                                         &#13;&#10;&#13;&#10;  LEFT JOIN A_VID_Mat A_ID_Mat&#13;&#10;    ON  A_ID_Mat.Key_ID_Mat=PR_SP.Key_ID_Mat&#13;&#10;&#13;&#10;  LEFT JOIN T_VPredm T_Predm&#13;&#10;    ON  A_ID_Mat.Key_Predm = T_Predm.Key_Predm&#13;&#10;&#13;&#10;WHERE&#13;&#10;  (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10;  AND Pr_SP.Key_ID_Mat IS NOT NULL                                            &#13;&#10;-- AND T_SPRows.SP_position=0&#13;&#10;ORDER BY A_ID_Mat.Key_Predm, Pr_SP.Key_ID_Mat, Pr_SPD_Razdel.Key_Razdel                                                                 " PropData="05704C65667403F8000470546F7002540A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674496E7465676572220000"/>
    <TfrxERQuery Name="TPHDR" UserName="Çàãîëîâîê_ÒÏ" CloseDataSource="True" FieldAliases.Text="Key_TP=Key_TP&#13;&#10;Key_SP=Key_SP&#13;&#10;SP_Version=SP_Version&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;TP_Version=TP_Version&#13;&#10;Cod_TP=Cod_TP&#13;&#10;Cod_KTP=Cod_KTP&#13;&#10;DopInfo=DopInfo&#13;&#10;Cod_Prin=Cod_Prin&#13;&#10;UseInPasp=UseInPasp&#13;&#10;SkipSert=SkipSert&#13;&#10;RazrabD=RazrabD&#13;&#10;ProvD=ProvD&#13;&#10;Key_Sub_Ver_Razrab=Key_Sub_Ver_Razrab&#13;&#10;Name_Sub_Razrab=Name_Sub_Razrab&#13;&#10;Razrab_Date=Razrab_Date&#13;&#10;Key_Sub_Ver_Prov=Key_Sub_Ver_Prov&#13;&#10;Name_Sub_Prov=Name_Sub_Prov&#13;&#10;Prov_Date=Prov_Date&#13;&#10;Key_Sub_Ver_NKontr=Key_Sub_Ver_NKontr&#13;&#10;Name_Sub_NKontr=Name_Sub_NKontr&#13;&#10;NKontr_Date=NKontr_Date&#13;&#10;Key_Sub_Ver_Utv=Key_Sub_Ver_Utv&#13;&#10;Name_Sub_Utv=Name_Sub_Utv&#13;&#10;Utv_Date=Utv_Date&#13;&#10;Key_Sub_Ver_Norm=Key_Sub_Ver_Norm&#13;&#10;Name_Sub_Norm=Name_Sub_Norm&#13;&#10;Norm_Date=Norm_Date" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  T_TP.Key_TP AS Key_TP,&#13;&#10;  T_SP.Key_SP AS Key_SP,&#13;&#10;  T_SP.SP_Version AS SP_Version,&#13;&#10;  T_Predm.Cod_Predm AS Cod_Predm,&#13;&#10;  T_SnPredm.Name_Predm AS Name_Predm,&#13;&#10;  T_TP.TP_Version AS TP_Version,&#13;&#10;  T_TP.Cod_TP AS Cod_TP,&#13;&#10;  T_TP.Cod_KTP AS Cod_KTP,&#13;&#10;  T_TP.DopInfo DopInfo,&#13;&#10;  T_Predm.Cod_Prin Cod_Prin,                                      &#13;&#10;&#13;&#10;  T_TP.UseInPasp,&#13;&#10;  T_TP.SkipSert,&#13;&#10;&#13;&#10;  dbo.S_GegSubVerAtrib(T_TP.Key_Sub_Ver_Razrab,9) RazrabD,&#13;&#10;  dbo.S_GegSubVerAtrib(T_TP.Key_Sub_Ver_Prov,9) ProvD,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Razrab,&#13;&#10;  S_Subjects_Razrab.Name_Sub AS Name_Sub_Razrab,&#13;&#10;  T_TP.Razrab_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Prov,&#13;&#10;  S_Subjects_Prov.Name_Sub AS Name_Sub_Prov,&#13;&#10;  T_TP.Prov_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_NKontr,&#13;&#10;  S_Subjects_NKontr.Name_Sub AS Name_Sub_NKontr,&#13;&#10;  T_TP.NKontr_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Utv,&#13;&#10;  S_Subjects_Utv.Name_Sub AS Name_Sub_Utv,&#13;&#10;  T_TP.Utv_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Norm,&#13;&#10;  S_Subjects_Norm.Name_Sub AS Name_Sub_Norm,&#13;&#10;  T_TP.Norm_Date&#13;&#10;&#13;&#10;FROM&#13;&#10;--  Gr_VxodGr Gr_VxodGr&#13;&#10;--  INNER JOIN Gr_VxodPredm Gr_VxodPredm ON Gr_VxodPredm.Key_VidGr = Gr_VxodGr.Key_VidGr AND Gr_VxodPredm.Cod_Gr = Gr_VxodGr.Cod_Gr&#13;&#10;--  INNER JOIN&#13;&#10;  T_Predm T_Predm&#13;&#10;--  ON T_Predm.Key_Predm = Gr_VxodPredm.Key_Predm&#13;&#10;  INNER JOIN T_SnPredm T_SnPredm ON T_SnPredm.Key_SnPredm = T_Predm.Key_SnPredm&#13;&#10;  INNER JOIN T_Prinadl ON T_Predm.Cod_Prin = T_Prinadl.Cod_Prin&#13;&#10;  INNER JOIN T_SP ON T_Predm.Key_Predm = T_SP.Key_Predm&#13;&#10;  INNER JOIN T_TP ON T_SP.Key_SP = T_TP.Key_SP&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub_Ver = T_TP.Key_Sub_Ver_Razrab&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub = S_Subjects_Razrab.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub_Ver = T_TP.Key_Sub_Ver_Prov&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub = S_Subjects_Prov.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_NKontr&#13;&#10;    ON S_SubVer_NKontr.Key_Sub_Ver = T_TP.Key_Sub_Ver_NKontr&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_NKontr&#13;&#10;    ON S_SubVer_NKontr.Key_Sub = S_Subjects_NKontr.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub_Ver = T_TP.Key_Sub_Ver_Utv&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub = S_Subjects_Utv.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Norm&#13;&#10;    ON S_SubVer_Norm.Key_Sub_Ver = T_TP.Key_Sub_Ver_Norm&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Norm&#13;&#10;    ON S_SubVer_Norm.Key_Sub = S_Subjects_Norm.Key_Sub&#13;&#10;&#13;&#10;WHERE&#13;&#10;  T_TP.Key_TP=:Key_TP" PropData="05704C65667402680470546F7002140A506172616D657465727301010C23000000204E616D653D224B65795F5450222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="PaspDetail" UserName="Ðàñøèð_Îïèñàíèå" CloseDataSource="True" FieldAliases.Text="RazdelID=RazdelID&#13;&#10;Razdel=Razdel&#13;&#10;Key_Id_Mat=Key_Id_Mat&#13;&#10;Cod_TT=Cod_TT&#13;&#10;Descr=Descr&#13;&#10;ValStr=ValStr&#13;&#10;OrderID=OrderID&#13;&#10;Vid_Docum=Vid_Docum&#13;&#10;Cod_Docum=Cod_Docum&#13;&#10;Data_Docum=Data_Docum&#13;&#10;NumSvr=NumSvr&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;Party=Party" BCDToCurrency="False" Master="TPQry" IgnoreDupParams="False" SQL.Text="&#13;&#10;EXEC dbo.Pr_GetPaspDetail3    &#13;&#10;       @Key_Pasport=:Key_Pasport,&#13;&#10;       @Key_TPRows=:Key_TPRows,&#13;&#10;       @FlPlan=:FlPlan,&#13;&#10;       @Key_Pasp_Rows = :Key_Pasp_Rows                         &#13;&#10;--       , @SvrMat = 0" PropData=""/>
    <TfrxERQuery Name="InstrumQry" UserName="Èíñòðóìåíò" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TPQry" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  T_TPInstrum.Key_TPRows,&#13;&#10;  T_TPInstrum.Key_Instrum,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka&#13;&#10;FROM&#13;&#10;  T_TPInstrum&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON T_TPInstrum.Key_Instrum = T_VPredm.Key_Predm&#13;&#10;WHERE T_TPInstrum.Key_TPRows=:Key_TPRows" PropData="05704C6566740358010470546F7003A4000A506172616D657465727301010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrQry" UserName="Ñâàðêà" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TPQry" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;       T_Svr.Key_Svr,&#13;&#10;       T_Svr.NumSvr,&#13;&#10;       T_Svr.CatSvr,&#13;&#10;       Pr_Svr.Key_Pasport,&#13;&#10;       Pr_Svr.Key_TPRows,&#13;&#10;       Pr_Svr.Key_PrSvr,&#13;&#10;       Pr_Isp.Svarshik,&#13;&#10;       Pr_Isp.Kleimo,&#13;&#10;       T_SvrSposob.SposobSvr&#13;&#10;FROM&#13;&#10;       Pr_Svr&#13;&#10;       INNER JOIN T_Svr&#13;&#10;               ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;       INNER JOIN Pr_Isp&#13;&#10;               ON Pr_Svr.Key_PrSvr = Pr_Isp.Key_PrSvr&#13;&#10;       INNER JOIN T_SvrSposob&#13;&#10;               ON Pr_Isp.Key_Sposob = T_SvrSposob.Key_Sposob&#13;&#10;WHERE&#13;&#10;       Pr_Svr.Key_Pasport =  :Key_Pasport&#13;&#10;       AND Pr_Svr.Key_TPRows  =  :Key_TPRows&#13;&#10;&#13;&#10;ORDER BY Pr_Isp.Svarshik, T_SvrSposob.SposobSvr" PropData="05704C65667403BC010470546F7003A4000A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E2200010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="PrintFlagQRY" UserName="ÄÑÅ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="PaspFrxDS" IgnoreDupParams="False" SQL.Text="SELECT * FROM T_VPredm where Key_Predm=:Key_Predm                                                                                                       " PropData="05704C65667402680470546F700320010A506172616D657465727301010C26000000204E616D653D224B65795F507265646D222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="EmptySvrMQRY" UserName="ÏóñòûåÑÂÌ" CloseDataSource="False" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       T_SPRows.Key_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Sortam, &#13;&#10;       T_VPredm.Type_NTD_Sortam,&#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       P_SvrM_TT.Cod_TT&#13;&#10;FROM         &#13;&#10;       Pr_Pasp &#13;&#10;       INNER JOIN T_SPRows &#13;&#10;               ON Pr_Pasp.Key_SP = T_SPRows.Key_SP&#13;&#10;              -- and T_SPRows.SP_position &#60; 0                                                              &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON T_SPRows.Key_Predm = T_VPredm.Key_Predm&#13;&#10;                AND T_VPredm.Cod_Prin = '51'                   &#13;&#10;       INNER JOIN Pr_PaspDet &#13;&#10;               ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport&#13;&#10;       INNER JOIN P_VKZ &#13;&#10;               ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;       INNER JOIN P_SvrM &#13;&#10;               ON ((isnull(P_VKZ.Key_VKZ_IZDEL,P_VKZ.Key_VKZ)  = P_SvrM.Key_VKZ_Izdel))                &#13;&#10;               AND T_VPredm.Key_Predm = P_SvrM.Key_Predm &#13;&#10;       INNER JOIN P_SvrM_TT &#13;&#10;               ON P_SvrM.Key_P_SvrM = P_SvrM_TT.Key_P_SvrM&#13;&#10;               AND P_SvrM_TT.Cod_TT='102'&#13;&#10;WHERE      (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10;          -- AND :Cod_Oper = '0200'                   &#13;&#10;GROUP BY &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       T_SPRows.Key_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Sortam, &#13;&#10;       T_VPredm.Type_NTD_Sortam,&#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       P_SvrM_TT.Cod_TT&#13;&#10;         &#13;&#10;HAVING      (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10;          -- AND :Cod_Oper = '0200'                                               &#13;&#10;                                                                    &#13;&#10;                                       &#13;&#10;ORDER BY T_VPredm.Name_Predm, T_VPredm.Sortam, T_SPRows.Key_Predm, P_SvrM_TT.Cod_TT" PropData="05704C65667403E0000470546F700320010A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E2200010C25000000204E616D653D22436F645F4F706572222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="IzdelQRY" UserName="IzdelQRY" CloseDataSource="True" FieldAliases.Text="OrderCod_Predm=OrderCod_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Kolvo=Kolvo&#13;&#10;KolvoDT=KolvoDT&#13;&#10;KolvoSM=KolvoSM" BCDToCurrency="False" Master="PaspFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      P_VKZ_1.Kolvo  AS Kolvo,&#13;&#10;      sum(P_VKZ.Kolvo) AS KolvoDT,&#13;&#10;      sum(Pr_PaspDet.KolvoZap) KolvoSM&#13;&#10;FROM&#13;&#10;    P_VKZ&#13;&#10;    LEFT JOIN P_VKZ P_VKZ_1&#13;&#10;          ON isnull(P_VKZ.Key_VKZ_Izdel,P_VKZ.Key_VKZ) = P_VKZ_1.Key_VKZ&#13;&#10;    LEFT JOIN T_VPredm T_Predm&#13;&#10;          ON T_Predm.Key_Predm = P_VKZ_1.Key_Predm&#13;&#10;    LEFT JOIN dbo.Pr_PaspDet Pr_PaspDet&#13;&#10;          ON  Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;&#13;&#10;WHERE&#13;&#10;        Pr_PaspDet.Key_Pasport=:Key_Pasport&#13;&#10;  AND  P_VKZ.Key_Predm=:Key_Predm&#13;&#10;GROUP BY&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      P_VKZ_1.Kolvo          &#13;&#10;    &#13;&#10;ORDER BY       T_Predm.OrderCod_Predm                           " PropData="05704C65667402640470546F70037C010A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E2200010C26000000204E616D653D224B65795F507265646D222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="OborQry" UserName="Îáîðóäîâàíèå" CloseDataSource="True" FieldAliases.Text="Key_TPRows=Key_TPRows&#13;&#10;Cod_Obor=Cod_Obor&#13;&#10;Name_Obor=Name_Obor&#13;&#10;Name_K_Obor=Name_K_Obor" BCDToCurrency="False" Master="TPQry" IgnoreDupParams="False" SQL.Text="&#13;&#10;SELECT&#13;&#10;       T_TPRows_Obor.Key_TPRows,&#13;&#10;       T_TPRows_Obor.Cod_Obor,&#13;&#10;       T_Obor.Name_Obor,&#13;&#10;       T_Obor.Name_K_Obor&#13;&#10;FROM        &#13;&#10;       T_TPRows&#13;&#10;       LEFT JOIN  T_TPRows_Obor on  T_TPRows_Obor.Key_TPRows =  T_TPRows.Key_TPRows                            &#13;&#10;       LEFT JOIN T_Obor ON &#13;&#10;               T_TPRows_Obor.Cod_Obor = T_Obor.Cod_Obor&#13;&#10;WHERE T_TPRows.Key_TPRows=:Key_TPRows&#13;&#10;       AND T_TPRows_Obor.Cod_Obor &#60;&#62; ''                   &#13;&#10;  " PropData="05704C6566740354010470546F700398010A506172616D657465727301010C27000000204E616D653D224B65795F5450526F7773222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="WSIQRY" UserName="ÂÑÈ" CloseDataSource="False" FieldAliases.Text="Cod_Predm_Master=Cod_Predm_Master&#13;&#10;Name_Predm_Master=Name_Predm_Master&#13;&#10;KolvoDSE=KolvoDSE&#13;&#10;Kolvo_On_Izdel=Kolvo_On_Izdel&#13;&#10;Key_Predm=Key_Predm&#13;&#10;PrintFlag=PrintFlag&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;Cod_Prin=Cod_Prin&#13;&#10;Name_Prin=Name_Prin&#13;&#10;Sortam=Sortam&#13;&#10;Cod_Postav=Cod_Postav&#13;&#10;Name_Postav=Name_Postav&#13;&#10;Kolvo=Kolvo&#13;&#10;PaspList=PaspList" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_VPredm.Cod_Predm AS Cod_Predm_Master, &#13;&#10;       T_VPredm.Name_Predm AS Name_Predm_Master,&#13;&#10;         &#13;&#10;       P_VKZ.Kolvo AS KolvoDSE, &#13;&#10;       P_VKZ.Kolvo_On_Izdel AS Kolvo_On_Izdel,&#13;&#10;         &#13;&#10;       T_VPredm.Key_Predm,                                 &#13;&#10;       T_VPredm.PrintFlag,&#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam,&#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       T_VPredm.Cod_Prin, &#13;&#10;       T_VPredm.Name_Prin, &#13;&#10;       T_VPredm.Sortam ,&#13;&#10;       T_VPredm.Cod_Postav Cod_Postav, &#13;&#10;       T_VPredm.Name_Postav,&#13;&#10;&#13;&#10;       T_SPRows.Kolvo,&#13;&#10;       dbo.P_VKZ_GetPaspList(P_VKZ.Key_VKZ)   PaspList                                               &#13;&#10;         &#13;&#10;FROM         &#13;&#10;       P_VKZ AS P_VKZ &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;       INNER JOIN T_SPRows &#13;&#10;               ON T_SPRows.Key_SpRow = P_VKZ.Key_SpRow             &#13;&#10;                          &#13;&#10;&#13;&#10;WHERE     (P_VKZ.Key_VKZ_Master = (Select top 1 Key_VKZ from Pr_PaspDet where Pr_PaspDet.Key_Pasport= :Key_Pasport ))&#13;&#10;&#13;&#10;ORDER BY    Cod_Postav, Cod_Prin, T_VPredm.OrderCod_Predm                                                                                   &#13;&#10;&#13;&#10;    " PropData="05704C65667402240470546F7003CC010A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="VPQry" UserName="ÂÏ" CloseDataSource="False" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT  DISTINCT                &#13;&#10;       P_VKZ_Izdel.Key_VKZ Key_VKZ_Izdel,                                      &#13;&#10;&#13;&#10;       T_VPredm.Key_Predm,&#13;&#10;       T_VPredm.PrintFlag, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam,&#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       T_VPredm.Cod_Prin, &#13;&#10;       T_VPredm.Name_Prin, &#13;&#10;       T_VPredm.Sortam , &#13;&#10;       T_VPredm.OrderSortam,&#13;&#10;       T_VPredm.Cod_Postav, &#13;&#10;       T_VPredm.Name_Postav,&#13;&#10;       Gr_Groups.Cod_Gr,                           &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr,&#13;&#10;--       P_VKZ.Kolvo AS KolvoDSE, &#13;&#10;--       P_VKZ.Kolvo_On_Izdel AS KolvoDSEOnIzdel,&#13;&#10;--       T_SPRows.Kolvo  &#13;&#10;&#13;&#10;         T_SPRows.Kolvo  SmKolvo    &#13;&#10;--       SUM(P_VKZ.Kolvo_On_Izdel * T_SPRows.Kolvo) SmKolvo                                         &#13;&#10;--       SUM(/*P_VKZ.Kolvo_On_Izdel **/ T_SPRows.Kolvo) SmKolvo                                         &#13;&#10;           &#13;&#10;FROM&#13;&#10;       P_VKZ P_VKZ_Izdel&#13;&#10;         &#13;&#10;       INNER JOIN P_VKZ&#13;&#10;               ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ_Izdel&#13;&#10;               AND  P_VKZ.CodStrSv like P_VKZ_Izdel.CodStrSv   -- + '%'                                                            &#13;&#10;                 &#13;&#10;       INNER JOIN T_VPredm AS DSE&#13;&#10;               ON P_VKZ.Key_Predm = DSE.Key_Predm &#13;&#10;       INNER JOIN T_SPRows &#13;&#10;               ON P_VKZ.Key_SP = T_SPRows.Key_SP &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON T_SPRows.Key_Predm = T_VPredm.Key_Predm&#13;&#10;       INNER JOIN Gr_VxodPredm&#13;&#10;               ON Gr_VxodPredm.Key_Predm = T_VPredm.Key_Predm&#13;&#10;               AND Gr_VxodPredm.Key_VidGr  =1&#13;&#10;       INNER JOIN Gr_Groups&#13;&#10;               ON Gr_Groups.Cod_Gr = Gr_VxodPredm.Cod_Gr&#13;&#10;               AND Gr_Groups.Key_VidGr = Gr_VxodPredm.Key_VidGr                                          &#13;&#10;                 &#13;&#10;WHERE     &#13;&#10;--(P_VKZ_Izdel.Key_VKZ =  (Select top 1 Key_VKZ from Pr_PaspDet where Pr_PaspDet.Key_Pasport= :Key_Pasport ))&#13;&#10;       (P_VKZ_Izdel.Key_VKZ   in  (Select  Key_VKZ from Pr_PaspDet where Pr_PaspDet.Key_Pasport= :Key_Pasport ))    &#13;&#10;AND ((T_SPRows.Cod_Ed_Izm  = '796') OR (T_VPredm.Cod_Prin='51'))                         &#13;&#10;AND T_SPRows.SP_Position &#62;0&#13;&#10;AND T_SPRows.SP_Position &#60; 1000                                 &#13;&#10;AND T_VPredm.Cod_Postav = '8'&#13;&#10;/*    &#13;&#10;GROUP BY&#13;&#10;       P_VKZ_Izdel.Key_VKZ,                                      &#13;&#10;       T_VPredm.Key_Predm,&#13;&#10;       T_VPredm.PrintFlag, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam,&#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       T_VPredm.Cod_Prin, &#13;&#10;       T_VPredm.Name_Prin, &#13;&#10;       T_VPredm.Sortam , &#13;&#10;       T_VPredm.OrderSortam,&#13;&#10;       T_VPredm.Cod_Postav, &#13;&#10;       T_VPredm.Name_Postav,&#13;&#10;       Gr_Groups.Cod_Gr,                           &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr&#13;&#10;                         */      &#13;&#10;ORDER BY&#13;&#10;&#13;&#10;	T_VPredm.Cod_Postav, &#13;&#10;	T_VPredm.Cod_Prin, &#13;&#10;	Gr_Groups.Cod_Gr,   &#13;&#10;	T_VPredm.Name_Predm, &#13;&#10;	T_VPredm.OrderSortam       " PropData="05704C65667402240470546F700310020A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="PaspQRY" RangeBegin="rbCurrent" RangeEnd="reCurrent" UserName="PaspQRY" CloseDataSource="False" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Cod_Pasp=Cod_Pasp&#13;&#10;Cod_Zak=Cod_Zak&#13;&#10;Key_SP=Key_SP&#13;&#10;SP_Version=SP_Version&#13;&#10;Key_TP=Key_TP&#13;&#10;Cod_TP=Cod_TP&#13;&#10;TP_Version=TP_Version&#13;&#10;TTSert=TTSert&#13;&#10;TTZap=TTZap&#13;&#10;TTPr=TTPr&#13;&#10;TTSvr=TTSvr&#13;&#10;ZavNumFrom=ZavNumFrom&#13;&#10;ZavNumTo=ZavNumTo&#13;&#10;AdInfo=AdInfo&#13;&#10;Key_Predm=Key_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;ProfRazmZagotov=ProfRazmZagotov&#13;&#10;KolvoZagotov=KolvoZagotov&#13;&#10;Key_GrZap=Key_GrZap&#13;&#10;PaspKolvo=PaspKolvo&#13;&#10;ProfRazmProba=ProfRazmProba&#13;&#10;KolvoProba=KolvoProba&#13;&#10;KolProbaZag=KolProbaZag&#13;&#10;Key_Proba=Key_Proba&#13;&#10;Cod_Proba=Cod_Proba&#13;&#10;Key_Sub_Ver_Pasp=Key_Sub_Ver_Pasp&#13;&#10;Name_Sub_Pasp=Name_Sub_Pasp&#13;&#10;Date_Pasp=Date_Pasp&#13;&#10;Name_Pasp_Status=Name_Pasp_Status&#13;&#10;Key_Sub_Ver_Prov=Key_Sub_Ver_Prov&#13;&#10;Name_Sub_Prov=Name_Sub_Prov&#13;&#10;Date_Prov=Date_Prov&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Pasp.Key_Pasport,&#13;&#10;  Pr_Pasp.Cod_Pasp,&#13;&#10;  Pr_Pasp.Cod_Zak,&#13;&#10;  Pr_Pasp.Key_SP,&#13;&#10;  T_SP.SP_Version,&#13;&#10;  Pr_Pasp.Key_TP,&#13;&#10;  T_TP.Cod_TP,&#13;&#10;  T_TP.TP_Version,&#13;&#10;  Pr_Pasp.TTSert,&#13;&#10;  Pr_Pasp.TTZap,&#13;&#10;  Pr_Pasp.TTPr,&#13;&#10;  Pr_Pasp.TTSvr,&#13;&#10;  Pr_Pasp.ZavNumFrom,&#13;&#10;  Pr_Pasp.ZavNumTo,&#13;&#10;  &#13;&#10;  Pr_Pasp.AdInfo,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_Predm,&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Pasp.ProfRazmZagotov,&#13;&#10;  Pr_Pasp.KolvoZagotov,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_GrZap,&#13;&#10;&#13;&#10;  Pr_Pasp.PaspKolvo,                                                  &#13;&#10;&#13;&#10;  Pr_Pasp.ProfRazmProba,&#13;&#10;  Pr_Pasp.KolvoProba,&#13;&#10;  Pr_Pasp.KolProbaZag,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_Proba,&#13;&#10;  Proba.Cod_Predm Cod_Proba,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_Sub_Ver_Pasp,&#13;&#10;  S_Subjects_Pasp.Name_Sub AS Name_Sub_Pasp,&#13;&#10;  Pr_Pasp.Date_Pasp,&#13;&#10;&#13;&#10;  Pr_Pasp_Status.Name_Pasp_Status   Name_Pasp_Status,&#13;&#10;  &#13;&#10;&#13;&#10;  Pr_Pasp.Key_Sub_Ver_Prov,&#13;&#10;  S_Subjects_Prov.Name_Sub AS Name_Sub_Prov,&#13;&#10;  Pr_Pasp.Date_Prov,&#13;&#10;&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS Name_NTD_Sortam,&#13;&#10;&#13;&#10;  T_Predm.Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS Name_NTD_Marka&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Pasp&#13;&#10;  LEFT JOIN T_SP&#13;&#10;    ON Pr_Pasp.Key_SP = T_SP.Key_SP&#13;&#10;  LEFT JOIN T_TP&#13;&#10;    ON Pr_Pasp.Key_TP = T_TP.Key_TP&#13;&#10;&#13;&#10;  LEFT JOIN T_Predm Proba&#13;&#10;    ON Pr_Pasp.Key_Proba=Proba.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm&#13;&#10;    ON  Pr_Pasp.Key_Predm = T_Predm.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Pasp&#13;&#10;    ON S_SubVer_Pasp.Key_Sub_Ver = Pr_Pasp.Key_Sub_Ver_Pasp&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Pasp&#13;&#10;    ON S_SubVer_Pasp.Key_Sub = S_Subjects_Pasp.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub_Ver = Pr_Pasp.Key_Sub_Ver_Prov&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub = S_Subjects_Prov.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN dbo.Pr_Pasp_Status   Pr_Pasp_Status&#13;&#10;    ON  Pr_Pasp.Key_Pasp_Status=Pr_Pasp_Status.Key_Pasp_Status&#13;&#10;&#13;&#10;WHERE&#13;&#10;   Pr_Pasp.Key_Pasport=:Key_Pasport&#13;&#10;&#13;&#10;  " PropData="05704C65667402140470546F7002140A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E220000"/>
