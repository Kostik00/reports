<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40903,0009191319" ReportOptions.Description.Text="" ReportOptions.Name="Îïåðàöèè çàêðûòûå çà ïåðèîä ïî áðèãàäàì ñ äåòàëèçàöèåé ïî êîíòðîëëåðàì.fr3 Æóðíàë çàïóñêà" ReportOptions.LastChange="44229,4174840741" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DateFrom.Date:=Date;&#13;&#10;  DateTo.Date:=Date;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
