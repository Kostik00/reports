<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41456,6287463773" ReportOptions.Description.Text="" ReportOptions.Name="Остаточная трудоемкость.fr3 Состояние запуска" ReportOptions.LastChange="41653,6450057639" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;&#13;&#10;function FnOstTrud:double;&#13;&#10;begin&#13;&#10;  Result:=&#60;OstTrud.&#34;SMTrudTP&#34;&#62; - &#60;OstTrud.&#34;SMTrudByPaspF&#34;&#62;;                                       &#13;&#10;end;&#13;&#10;&#13;&#10;function FnOstTrud1:double;&#13;&#10;begin&#13;&#10;  Result:=FnOstTrud;&#13;&#10;//  if Result &#60; 0 then Result :=0;                                                                                                  &#13;&#10;end;&#13;&#10;  &#13;&#10;  &#13;&#10;procedure Label2OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2400000020446174615365743D22497A64656C2220446174615365744E616D653D22497A64656C2200010C2800000020446174615365743D224F7374547275642220446174615365744E616D653D224F737454727564220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="Izdel" UserName="Izdel" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       P_VKZ.Key_VKZ, &#13;&#10;       P_VKZ.Cod_Zak, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       P_VKZ.Kolvo, &#13;&#10;       P_VKZ.Cod_SosZ, &#13;&#10;       P_VKZ.DataVip, &#13;&#10;       D_Zakaz.Name_Zak,&#13;&#10;       P_VKZ.DataVipK  &#13;&#10;FROM         P_VKZ INNER JOIN&#13;&#10;                      T_VPredm ON P_VKZ.Key_Predm = T_VPredm.Key_Predm INNER JOIN&#13;&#10;                      D_Zakaz ON P_VKZ.Cod_Zak = D_Zakaz.Cod_Zak&#13;&#10;WHERE     (P_VKZ.Key_VKZ_Master IS NULL) AND (P_VKZ.Cod_SosZ = 'Д') AND (D_Zakaz.Cod_SosZ = 'Д') AND (P_VKZ.Cod_Zak LIKE '[0-9]%')&#13;&#10;       AND P_VKZ.FlPln &#62;= :ParamFrom&#13;&#10;       AND P_VKZ.FlPln &#60;= :ParamTo  &#13;&#10;           &#13;&#10;ORDER BY P_VKZ.Cod_Zak  " PropData=""/>
    <TfrxERQuery Name="OstTrud" UserName="OstTrud" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="Izdel" IgnoreDupParams="False" SQL.Text="&#13;&#10;SET NOCOUNT ON&#13;&#10;&#13;&#10;declare &#13;&#10;	@MaxLvl int,&#13;&#10;	@PrintD int,&#13;&#10;	@PrintDT int&#13;&#10;&#13;&#10;SET @MaxLvl  =2&#13;&#10;SET @PrintD  = 0&#13;&#10;SET @PrintDT  = 0&#13;&#10;&#13;&#10;	CREATE TABLE #TmpIzdelDSE&#13;&#10;	(&#13;&#10;		Key_VKZ_Izdel int,&#13;&#10;		Key_Predm int,&#13;&#10;		Kolvo int&#13;&#10;	)&#13;&#10;&#13;&#10; INSERT INTO #TmpIzdelDSE (Key_VKZ_Izdel, Key_Predm, Kolvo)&#13;&#10;	SELECT     Key_VKZ_Izdel, Key_Predm, SUM(Kolvo) AS Kolvo&#13;&#10;	FROM         P_VKZ&#13;&#10;	WHERE Key_VKZ_Izdel = :Key_VKZ&#13;&#10;	GROUP BY   Key_VKZ_Izdel, Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;	CREATE TABLE #TmpMK&#13;&#10;	(&#13;&#10;		Key_VKZ_Izdel int,&#13;&#10;		Key_Predm int,&#13;&#10;		Key_TpRows int,&#13;&#10;		Key_V_TP int,&#13;&#10;		lvl int&#13;&#10;	)&#13;&#10;&#13;&#10;	INSERT INTO #TmpMK&#13;&#10;		SELECT Key_VKZ_Izdel, T_Predm.Key_Predm, T_TPRows.Key_TPRows, T_TPRows.Key_V_TP, 1&#13;&#10;	FROM #TmpIzdelDSE&#13;&#10;		INNER JOIN T_Predm &#13;&#10;			ON #TmpIzdelDSE.Key_Predm = T_Predm.Key_Predm &#13;&#10;		INNER JOIN T_SP &#13;&#10;			ON T_Predm.Key_Predm = T_SP.Key_Predm &#13;&#10;			AND T_Predm.SP_Version = T_SP.SP_Version &#13;&#10;		INNER JOIN T_TPRows &#13;&#10;			ON T_SP.Key_TP = T_TPRows.Key_TP&#13;&#10;&#13;&#10;	DECLARE @Lvl int&#13;&#10;	SET @Lvl = 1&#13;&#10;&#13;&#10;	WHILE @Lvl &#60; @MaxLvl &#13;&#10;	BEGIN&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;		INSERT INTO #TmpMK&#13;&#10;		SELECT #TmpMK.Key_VKZ_Izdel, #TmpMK.Key_Predm, T_TPRows.Key_TPRows,  T_TPRows.Key_V_TP, @Lvl+1&#13;&#10;		FROM #TmpMK&#13;&#10;			INNER JOIN T_TPRows  T1&#13;&#10;				ON T1.Key_TPRows = #TmpMK.Key_TPRows &#13;&#10;&#13;&#10;			INNER JOIN T_TPRows &#13;&#10;				ON T_TPRows.Key_Tp = T1.Key_V_TP &#13;&#10;				AND  ((T_TPRows.N_Oper_MK=T1.N_Oper_MK) OR( T_TPRows.N_Oper_MK='' ))&#13;&#10;&#13;&#10;		WHERE #TmpMK.Lvl=@Lvl&#13;&#10;&#13;&#10;		SET @Lvl = @Lvl+1&#13;&#10;	END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;SET NOCOUNT OFF&#13;&#10;&#13;&#10;SELECT&#13;&#10; P_VKZ_IZDEL.Key_VKZ,&#13;&#10; T1.Name_Sub,             &#13;&#10;	T1.Name_GrGr,&#13;&#10;	T2.SMTrudTP,&#13;&#10;	T3.SMTrudByPasp,&#13;&#10;	T3.SMTrudByPaspF&#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ_IZDEL                               &#13;&#10;  CROSS JOIN                                  &#13;&#10; 		(&#13;&#10;    SELECT DISTINCT &#13;&#10;       Isnull(S_SubVer.F_Name_Sub,'') Name_GrGr, &#13;&#10;       Isnull(S_Subjects.Name_Sub,'') Name_Sub             &#13;&#10;    FROM         &#13;&#10;       T_Oper &#13;&#10;       LEFT JOIN  S_SubVer &#13;&#10;               ON T_Oper.Key_Sub_Ver = S_SubVer.Key_Sub_Ver &#13;&#10;       LEFT JOIN  S_Subjects &#13;&#10;               ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;   ) T1&#13;&#10;     &#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			SELECT &#13;&#10;					#TmpIzdelDSE.Key_VKZ_Izdel,&#13;&#10;					T_V_OPERGR.Expr00 Name_GrGr,&#13;&#10;					Sum(#TmpIzdelDSE.Kolvo * isnull(T_TPRows.TSht,0) + isnull(T_TPRows.Tpz,0)) SMTrudTP&#13;&#10;				FROM &#13;&#10;					#TmpIzdelDSE&#13;&#10;					INNER JOIN #TmpMK&#13;&#10;						ON  #TmpMK.Key_VKZ_Izdel	= #TmpIzdelDSE.Key_VKZ_Izdel&#13;&#10;						AND #TmpMK.Key_Predm		= #TmpIzdelDSE.Key_Predm&#13;&#10;					INNER JOIN T_TPRows &#13;&#10;						ON T_TPRows.Key_TPRows=#TmpMK.Key_TPRows&#13;&#10;					LEFT JOIN T_V_OPERGR &#13;&#10;							ON T_TPRows.Cod_Oper = T_V_OPERGR.Cod_Oper&#13;&#10;  &#13;&#10;    WHERE #TmpIzdelDSE.Key_VKZ_Izdel = :Key_VKZ  &#13;&#10;      &#13;&#10;				GROUP BY &#13;&#10;				#TmpIzdelDSE.Key_VKZ_Izdel,&#13;&#10;				T_V_OPERGR.Expr00&#13;&#10;&#13;&#10;		) T2&#13;&#10;&#13;&#10;	ON T2.Key_VKZ_Izdel = P_VKZ_IZDEL.Key_VKZ&#13;&#10;	AND T2.Name_GrGr = T1.Name_GrGr  &#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;	(&#13;&#10;		SELECT     &#13;&#10;			P_VKZ_IZDEL.Key_VKZ_Izdel,&#13;&#10;			T_V_OPERGR.Expr00 Name_GrGr, &#13;&#10;			SUM(Pr_Pasp_Rows.Tsm*Pr_PaspDet.KolvoZap/Pr_Pasp.PaspKolvo) SMTrudByPasp,&#13;&#10;			SUM(Pr_Pasp_Rows.Tsm*Pr_PaspDet.KolvoZap * dbo.Sys_EQ(Pr_Pasp_Rows.Status_Oper,2)/Pr_Pasp.PaspKolvo) SMTrudByPaspF&#13;&#10;&#13;&#10;		FROM         &#13;&#10;			P_VKZ AS P_VKZ_IZDEL&#13;&#10;			INNER JOIN P_VKZ &#13;&#10;				ON P_VKZ_IZDEL.Key_VKZ_Izdel = P_VKZ.Key_VKZ_Izdel &#13;&#10;			INNER JOIN Pr_PaspDet &#13;&#10;				on P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;			INNER JOIN Pr_Pasp &#13;&#10;				ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;			INNER JOIN Pr_Pasp_Rows &#13;&#10;				ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport &#13;&#10;			LEFT JOIN T_V_OPERGR &#13;&#10;				ON Pr_Pasp_Rows.Cod_Oper = T_V_OPERGR.Cod_Oper&#13;&#10;		WHERE     &#13;&#10;			(P_VKZ_IZDEL.Key_VKZ_Master IS NULL)&#13;&#10;		 AND Pr_Pasp.Key_Pasp_Status &#62; 0                              &#13;&#10;			AND Pr_Pasp.PaspKolvo &#62;0&#13;&#10;   AND P_VKZ_IZDEL.Key_VKZ_Izdel = :Key_VKZ                                                            &#13;&#10;		GROUP BY&#13;&#10;			P_VKZ_IZDEL.Key_VKZ_Izdel, &#13;&#10;			T_V_OPERGR.Expr00&#13;&#10;  	) T3&#13;&#10;	ON T3.Key_VKZ_Izdel = P_VKZ_IZDEL.Key_VKZ_Izdel&#13;&#10;	AND T3.Name_GrGr = T1.Name_GrGr&#13;&#10;&#13;&#10;&#13;&#10;WHERE     &#13;&#10;	(P_VKZ_IZDEL.Key_VKZ = :Key_VKZ)&#13;&#10;    AND ((P_VKZ_IZDEL.Cod_SosZ='Д') or (@PrintDT =0))&#13;&#10;&#13;&#10;ORDER BY&#13;&#10;	P_VKZ_IZDEL.Key_VKZ_Izdel,&#13;&#10; T1.Name_Sub,    &#13;&#10;	T1.Name_GrGr&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  " PropData="05704C65667403A4000470546F70022C0A506172616D657465727301010C24000000204E616D653D224B65795F564B5A222044617461547970653D226674556E6B6E6F776E220000"/>
  </TfrxDataPage>
