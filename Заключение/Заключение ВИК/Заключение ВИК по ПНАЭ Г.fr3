    <TfrxERQuery Name="SvrMatQRY" UserName="СварМатериалы" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="NaprStrQRY" Left="188" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;       Pr_Svr_Mat.Key_SvrMat,&#13;&#10;       Pr_Svr_Mat.Key_PrSvr,&#13;&#10;       Pr_Svr_Mat.Key_Id_Mat,&#13;&#10;       Pr_Svr_Mat.Polojenie,&#13;&#10;       Pr_Svr_Mat.Tok,&#13;&#10;       Pr_Svr_Mat.Polyarn,&#13;&#10;       Pr_Svr_Mat.Sila,&#13;&#10;       Pr_Svr_Mat.DopInfo,&#13;&#10;       Pr_Svr_Mat.Napr,&#13;&#10;       Pr_Svr_Mat.Skor,&#13;&#10;       Pr_Svr_Mat.Podacha,&#13;&#10;       A_VID_Mat.VidSert,&#13;&#10;       A_VID_Mat.N_Sert,&#13;&#10;       A_VID_Mat.Date_Sert,&#13;&#10;       A_VID_Mat.Cod_Plavka,&#13;&#10;       A_VID_Mat.Party,&#13;&#10;       T_VPredm.Name_Predm&#13;&#10;FROM&#13;&#10;       Pr_Svr_Mat&#13;&#10;       INNER JOIN  A_VID_Mat&#13;&#10;               ON Pr_Svr_Mat.Key_Id_Mat = A_VID_Mat.Key_ID_Mat&#13;&#10;       INNER JOIN  T_VPredm&#13;&#10;               ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;&#13;&#10;WHERE  Pr_Svr_Mat.Key_PrSvr=:Key_PrSvr">
