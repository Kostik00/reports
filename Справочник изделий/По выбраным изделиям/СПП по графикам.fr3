  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="qVKZChild" UserName="dsVKZChild" CloseDataSource="False" FieldAliases.Text="Key_VKZ=Key_VKZ&#13;&#10;DataZap=DataZap&#13;&#10;DataZapA=DataZapA&#13;&#10;DataZapK=DataZapK&#13;&#10;DataZapUtv=DataZapUtv&#13;&#10;DZR=DZR&#13;&#10;DTZCR=DTZCR&#13;&#10;DTZCRMIN=DTZCRMIN&#13;&#10;DTVCR=DTVCR&#13;&#10;DTZPLN=DTZPLN&#13;&#10;DTVPLN=DTVPLN&#13;&#10;DTVPLNMAX=DTVPLNMAX&#13;&#10;DataVip=DataVip&#13;&#10;DataVipA=DataVipA&#13;&#10;DataVipK=DataVipK&#13;&#10;DataVipUtv=DataVipUtv&#13;&#10;DataPlnO=DataPlnO&#13;&#10;PlnPrior=PlnPrior&#13;&#10;INVKZCOUNT=INVKZCOUNT&#13;&#10;MAXDZR=MAXDZR&#13;&#10;MINDZR=MINDZR" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="--  USE KASKAD;&#13;&#10;SET DATEFORMAT YMD;&#13;&#10;&#13;&#10;SELECT&#13;&#10;    [P_VKZ].[Key_VKZ],          &#13;&#10;&#13;&#10;    [P_VKZ].[DataZap]     AS [DataZap],&#13;&#10;    [P_VKZ].[DataZapA]    AS [DataZapA],  &#13;&#10;    [P_VKZ].[DataZapK]    AS [DataZapK],  &#13;&#10;    [P_VKZ].[DataZapUtv]  AS [DataZapUtv],&#13;&#10;    [P_VKZ].[DZR]         AS [DZR],&#13;&#10;&#13;&#10;    [PLNVKZ].[DTZCR]      AS [DTZCR],&#13;&#10;    [PLNVKZ].[DTZCRMIN]   AS [DTZCRMIN],        &#13;&#10;    [PLNVKZ].[DTVCR]      AS [DTVCR],        &#13;&#10;&#13;&#10;    [PLNVKZ].[DTZPLN]     AS [DTZPLN],&#13;&#10;    [PLNVKZ].[DTVPLN]     AS [DTVPLN],&#13;&#10;    [PLNVKZ].[DTVPLNMAX]  AS [DTVPLNMAX],        &#13;&#10;  &#13;&#10;    [P_VKZ].[DataVip]     AS [DataVip],&#13;&#10;    [P_VKZ].[DataVipA]    AS [DataVipA],  &#13;&#10;    [P_VKZ].[DataVipK]    AS [DataVipK],  &#13;&#10;    [P_VKZ].[DataVipUtv]  AS [DataVipUtv],&#13;&#10;&#13;&#10;    [P_VKZ].[DataPlnO]    AS [DataPlnO],&#13;&#10;    [P_VKZ].[PlnPrior]    AS [PlnPrior],                            &#13;&#10;&#13;&#10;    COUNT([INVKZ].[Key_VKZ]) AS [INVKZCOUNT],&#13;&#10;    MAX([INVKZ].[DZR])       AS [MAXDZR],&#13;&#10;    MIN([INVKZ].[DZR])       AS [MINDZR]  &#13;&#10;  FROM [P_VKZ]&#13;&#10;    INNER JOIN [P_VKZ] AS [INVKZ]   &#13;&#10;    ON [INVKZ].[Key_VKZ_Izdel] = [P_VKZ].[Key_VKZ_Izdel]&#13;&#10;    LEFT  JOIN [P_VKZ_PLN] AS [PLNVKZ]   &#13;&#10;    ON [PLNVKZ].[Key_VKZ] = [P_VKZ].[Key_VKZ] AND [PLNVKZ].[Key_PlnV] = :Variant                                                 &#13;&#10;  WHERE&#13;&#10;    [P_VKZ].[Key_VKZ] = :KeyVKZ&#13;&#10;/*    AND&#13;&#10;    (NOT ([PLNVKZ].[DTVCR] IS NULL)) */                                      &#13;&#10;GROUP BY&#13;&#10;    [P_VKZ].[Key_VKZ],          &#13;&#10;&#13;&#10;    [P_VKZ].[DataZap],&#13;&#10;    [P_VKZ].[DataZapA],  &#13;&#10;    [P_VKZ].[DataZapK],  &#13;&#10;    [P_VKZ].[DataZapUtv],&#13;&#10;    [P_VKZ].[DZR],&#13;&#10;&#13;&#10;    [PLNVKZ].[DTZCR],&#13;&#10;    [PLNVKZ].[DTZCRMIN],  &#13;&#10;    [PLNVKZ].[DTVCR],&#13;&#10;&#13;&#10;    [PLNVKZ].[DTZPLN],&#13;&#10;    [PLNVKZ].[DTVPLN],&#13;&#10;    [PLNVKZ].[DTVPLNMAX],        &#13;&#10;  &#13;&#10;    [P_VKZ].[DataVip],&#13;&#10;    [P_VKZ].[DataVipA],  &#13;&#10;    [P_VKZ].[DataVipK],  &#13;&#10;    [P_VKZ].[DataVipUtv],&#13;&#10;&#13;&#10;    [P_VKZ].[DataPlnO],&#13;&#10;    [P_VKZ].[PlnPrior]" PropData=""/>
