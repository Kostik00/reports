    <TfrxERQuery Name="WSNRMHdrQRY" UserName="ЗаголовокВСНРМ" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="252" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  P_WSNRM.*,&#13;&#10;  S_SubVer_Utv.F_Name_Sub AS F_Name_Sub_Utv,&#13;&#10;  S_Subjects_Utv.Name_Sub AS Name_Sub_Utv,&#13;&#10;&#13;&#10;  S_SubVer_Razrab.F_Name_Sub AS F_Name_Sub_Razrab,&#13;&#10;  S_Subjects_Razrab.Name_Sub AS Name_Sub_Razrab,&#13;&#10;  dbo.S_GegSubVerAtrib(P_WSNRM.Key_Sub_Ver_Razrab,9) RazrabD,&#13;&#10;  dbo.S_GegSubVerAtrib(P_WSNRM.Key_Sub_Ver_Utv,9) UtvD&#13;&#10;&#13;&#10;FROM P_WSNRM&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub_Ver = P_WSNRM.Key_Sub_Ver_Utv&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub = S_Subjects_Utv.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub_Ver = P_WSNRM.Key_Sub_Ver_Razrab&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub = S_Subjects_Razrab.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;WHERE Key_WSNRM=:Key_WSNRM">
