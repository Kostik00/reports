  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ListQRY" UserName="Ñïèñîê" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT T1.*, &#13;&#10;	Predm_Izdel.Cod_Predm Cod_Predm_Izdel, &#13;&#10;	Predm_Izdel.Name_Predm Name_Predm_Izdel,&#13;&#10;	Predm_DSE.Cod_Predm,&#13;&#10;	Predm_DSE.Name_Predm,&#13;&#10;	Predm_DSE.Cod_Prin&#13;&#10;FROM&#13;&#10;(&#13;&#10;SELECT  distinct       &#13;&#10;	P_VKZ.Cod_Zak, &#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	P_VKZ.Key_Predm, &#13;&#10;	Min(P_VKZ.DataZapUtv) DataZapUtv,&#13;&#10;	COUNT(T_TP.Key_TP) AS CntTP&#13;&#10;FROM            &#13;&#10;	P_VKZ &#13;&#10;	INNER JOIN T_Predm&#13;&#10;		ON T_Predm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;	LEFT JOIN T_SP &#13;&#10;		ON  T_SP.Key_Predm = T_Predm.Key_Predm&#13;&#10;		AND T_SP.SP_Version = T_Predm.SP_Version &#13;&#10;	LEFT JOIN T_TP &#13;&#10;		ON T_SP.Key_SP = T_TP.Key_SP&#13;&#10;		AND T_TP.Key_T_Status = 3&#13;&#10;GROUP BY &#13;&#10;	P_VKZ.Cod_Zak, &#13;&#10;	P_VKZ.Key_VKZ_Izdel, &#13;&#10;	P_VKZ.DataZapUtv, &#13;&#10;	P_VKZ.Key_Predm&#13;&#10;HAVING        &#13;&#10;	( P_VKZ.DataZapUtv between :DateFrom AND :DateTo )&#13;&#10;) T1&#13;&#10;&#13;&#10;INNER JOIN P_VKZ VKZ_Izdel&#13;&#10;	ON VKZ_Izdel.Key_VKZ = T1.Key_VKZ_Izdel&#13;&#10;INNER JOIN T_VPredm Predm_Izdel&#13;&#10;	ON Predm_Izdel.Key_Predm = VKZ_Izdel.Key_Predm&#13;&#10;&#13;&#10;INNER JOIN T_VPredm Predm_DSE&#13;&#10;	ON Predm_DSE.Key_Predm = T1.Key_Predm&#13;&#10;&#13;&#10;ORDER BY T1.Cod_Zak, Predm_Izdel.Cod_Predm, Predm_DSE.Cod_Prin, Predm_DSE.Cod_Predm  " PropData=""/>
  </TfrxDataPage>
