    <TfrxERQuery Name="SvrMat" UserName="��_���������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr_Mat.Key_SvrMat,&#13;&#10;  Pr_Svr_Mat.Key_PrSvr,&#13;&#10;  Pr_Svr_Mat.Key_Id_Mat,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;  A_VID_Mat.VidSert,&#13;&#10;  A_VID_Mat.N_Sert,&#13;&#10;  A_VID_Mat.Date_Sert,&#13;&#10;  A_VID_Mat.Cod_Plavka,&#13;&#10;  A_VID_Mat.Party ,&#13;&#10;&#13;&#10;  Pr_Svr_Mat.Polojenie,&#13;&#10;  Pr_Svr_Mat.Tok,&#13;&#10;  Pr_Svr_Mat.Polyarn,&#13;&#10;  Pr_Svr_Mat.Napr,&#13;&#10;  Pr_Svr_Mat.DopInfo,&#13;&#10;  Pr_Svr_Mat.Sila,&#13;&#10;  Pr_Svr_Mat.Skor,&#13;&#10;  Pr_Svr_Mat.Podacha&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Svr_Mat&#13;&#10;  INNER JOIN A_VID_Mat&#13;&#10;    ON Pr_Svr_Mat.Key_Id_Mat = A_VID_Mat.Key_ID_Mat&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE&#13;&#10;  Pr_Svr_Mat.Key_PrSvr = :Key_PrSvr" PropData="05704C656674023C0470546F7002140A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrDetail" UserName="SvrDetail" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr_Isp.Key_PrSvr,&#13;&#10;  Pr_Svr_Isp.Key_SvrPrimen,&#13;&#10;  Pr_Svr_Isp.Key_Sub_Ver_Svr,&#13;&#10;  T_Svr_PrimenMat.SvrPrimen,&#13;&#10;  S_Subjects.Name_Sub Name_Sub_Svr&#13;&#10;&#13;&#10;  , Pr_Svr_Isp.Key_Sposob&#13;&#10;  , T_SvrSposob.SposobSvr&#13;&#10;  , dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 10) Kleimo,&#13;&#10;  dbo.S_GegSubVerAtrib(S_SubVer.Key_Sub_Ver, 11) N_Ud,&#13;&#10;  dbo.S_GegSubVerAtrib(S_SubVer.Key_Sub_Ver, 12) Razr,&#13;&#10;  T_Svr.*             &#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Svr&#13;&#10;  INNER JOIN Pr_Svr_Isp&#13;&#10;    ON Pr_Svr_Isp.Key_PrSvr = Pr_Svr.Key_PrSvr&#13;&#10;  INNER JOIN T_Svr_PrimenMat&#13;&#10;    ON Pr_Svr_Isp.Key_SvrPrimen = T_Svr_PrimenMat.Key_SvrPrimen&#13;&#10;  INNER JOIN S_SubVer&#13;&#10;    ON Pr_Svr_Isp.Key_Sub_Ver_Svr = S_SubVer.Key_Sub_Ver&#13;&#10;  INNER JOIN S_Subjects&#13;&#10;    ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN dbo.T_SvrSposob T_SvrSposob&#13;&#10;    ON T_SvrSposob.Key_Sposob= Pr_Svr_Isp.Key_Sposob&#13;&#10;      &#13;&#10;  LEFT JOIN T_Svr&#13;&#10;    ON  T_Svr.Key_Svr=Pr_Svr.Key_Svr&#13;&#10;  &#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Svr.Key_PrSvr = :Key_PrSvr        " PropData="05704C656674027C0470546F7002140A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="KontrQRY" UserName="KontrQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_NaprZakl.Key_Pasport,&#13;&#10;  Pr_NaprZakl.Key_NaprZakl,&#13;&#10;&#13;&#10;  Pr_NaprSvr.Key_PrSvr,&#13;&#10;&#13;&#10;  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  Pr_NaprZakl.Cod_TT,&#13;&#10;  T_TechTreb.Name_TT,&#13;&#10;  T_TechTreb.VidKontr,&#13;&#10;  Pr_NaprZakl.VolKontr,        &#13;&#10;      &#13;&#10;&#13;&#10;  Pr_Zakl.Num_Zakl,&#13;&#10;  Pr_Zakl.Data_Zakl,&#13;&#10;  Pr_Napr.Key_Napr,&#13;&#10;  Pr_NaprZakl.Name_NTD&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  INNER JOIN Pr_NaprZakl&#13;&#10;    ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr&#13;&#10;  INNER JOIN Pr_NaprSvr&#13;&#10;    ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl&#13;&#10;  LEFT JOIN Pr_Zakl&#13;&#10;    ON Pr_NaprZakl.Key_Zakl = Pr_Zakl.Key_Zakl&#13;&#10;  LEFT JOIN T_TechTreb&#13;&#10;    ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;WHERE&#13;&#10;  Pr_NaprSvr.Key_PrSvr=:Key_PrSvr&#13;&#10;  AND Pr_NaprZakl.Cod_TT in ('301', '301�', '401')&#13;&#10;ORDER BY Pr_Zakl.Data_Zakl                                                                                  " PropData="05704C65667403BC000470546F7002140A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="KontrDetail" UserName="KontrDetail" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_NaprZakl.Key_Pasport, &#13;&#10;       Pr_NaprZakl.Key_NaprZakl, &#13;&#10;       Pr_NaprSvr.Key_PrSvr, &#13;&#10;       Pr_Napr.Num_Napr, &#13;&#10;       Pr_Napr.Data_Napr, &#13;&#10;       Pr_NaprZakl.Cod_TT, &#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       T_TechTreb.VidKontr, &#13;&#10;       Pr_NaprZakl.VolKontr, &#13;&#10;       Pr_Zakl.Num_Zakl, &#13;&#10;       Pr_Zakl.Data_Zakl, &#13;&#10;       Pr_Napr.Key_Napr, &#13;&#10;       Pr_NaprZakl.Name_NTD,&#13;&#10;         &#13;&#10;       T_Sert_Rez.Attr_Val,&#13;&#10;       T_Sert_Attr.Attr, &#13;&#10;       T_Sert_Isp.Cod_Isp,&#13;&#10;         &#13;&#10;       T_Sert_Rez1.Attr_Val Val301,&#13;&#10;       T_Sert_Rez2.Attr_Val Val302,&#13;&#10;       T_Sert_Rez3.Attr_Val Val303,&#13;&#10;       T_Sert_Rez4.Attr_Val Val304,  &#13;&#10;       T_Sert_Rez5.Attr_Val Val305,&#13;&#10;       T_Sert_Rez6.Attr_Val Val306,&#13;&#10;       T_Sert_Rez10.Attr_Val Val310    &#13;&#10;             &#13;&#10;             &#13;&#10;           &#13;&#10;  &#13;&#10;FROM         &#13;&#10;       Pr_Napr &#13;&#10;       INNER JOIN Pr_NaprZakl ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr &#13;&#10;       INNER JOIN Pr_NaprSvr ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl &#13;&#10;       INNER JOIN T_Sert_Isp ON Pr_NaprZakl.Key_NaprZakl = T_Sert_Isp.Key_NaprZakl&#13;&#10;&#13;&#10;         &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez     &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez.Key_Isp&#13;&#10;               AND T_Sert_Rez.Key_Sert_Attr = 300&#13;&#10;       LEFT JOIN T_Sert_Attr &#13;&#10;               ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez1       &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez1.Key_Isp&#13;&#10;               AND T_Sert_Rez1.Key_Sert_Attr = 301&#13;&#10;  &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez2       &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez2.Key_Isp&#13;&#10;               AND T_Sert_Rez2.Key_Sert_Attr = 302&#13;&#10;  &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez3       &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez3.Key_Isp&#13;&#10;               AND T_Sert_Rez3.Key_Sert_Attr = 303&#13;&#10;  &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez4       &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez4.Key_Isp&#13;&#10;               AND T_Sert_Rez4.Key_Sert_Attr = 304&#13;&#10;  &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez5       &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez5.Key_Isp&#13;&#10;               AND T_Sert_Rez5.Key_Sert_Attr = 305&#13;&#10;&#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez6       &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez6.Key_Isp&#13;&#10;               AND T_Sert_Rez6.Key_Sert_Attr = 306&#13;&#10;&#13;&#10;                 &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez10         &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez10.Key_Isp&#13;&#10;               AND T_Sert_Rez10.Key_Sert_Attr = 310  &#13;&#10;&#13;&#10;                 &#13;&#10;                 &#13;&#10;                                                                &#13;&#10;       LEFT OUTER JOIN T_TechTreb ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT &#13;&#10;       LEFT OUTER JOIN Pr_Zakl ON Pr_NaprZakl.Key_Zakl = Pr_Zakl.Key_Zakl&#13;&#10;         &#13;&#10;WHERE     (Pr_NaprSvr.Key_PrSvr = :Key_PrSvr) &#13;&#10;       AND (Pr_NaprZakl.Cod_TT IN ('301', '301�', '401'))&#13;&#10;       AND (Pr_NaprZakl.Cod_TT IN ('301�'))           &#13;&#10;ORDER BY Pr_NaprZakl.Cod_TT, DBO.T_OrderSortam(T_Sert_Isp.Cod_Isp), DBO.T_OrderSortam(T_Sert_Rez.Attr_Val)               " PropData="05704C65667403BC000470546F700