    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       Pr_Pasp.Cod_Pasp, &#13;&#10;       Pr_Pasp_Status.Name_Pasp_Status, &#13;&#10;       Pr_Pasp_Status.Key_Pasp_Status, &#13;&#10;       Pr_Pasp.Key_Predm, &#13;&#10;       T_VPredm.Cod_Predm,&#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_Oper_Gr.Name_GrGr, &#13;&#10;       COUNT(Pr_Pasp_Rows.Key_Pasp_Rows) AS Cnt, &#13;&#10;       Pr_Pasp.Cod_Zak,&#13;&#10;       T_VPredm.OrderCod_Predm--,&#13;&#10;      -- Pr_Pasp_Rows.N_Oper_SM                               &#13;&#10;FROM         &#13;&#10;       Pr_Pasp INNER JOIN&#13;&#10;                      Pr_Pasp_Status ON Pr_Pasp.Key_Pasp_Status = Pr_Pasp_Status.Key_Pasp_Status INNER JOIN&#13;&#10;                      T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm INNER JOIN&#13;&#10;                      Pr_Pasp_Rows ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport INNER JOIN&#13;&#10;                      T_Oper ON Pr_Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper INNER JOIN&#13;&#10;                      T_Oper_Gr ON T_Oper.Cod_Oper_Gr = T_Oper_Gr.Cod_Oper_Gr&#13;&#10;                      LEFT JOIN T_TpRows ON T_TpRows.Key_TpRows  =  Pr_Pasp_Rows.Key_TpRows                                                                                                        &#13;&#10;WHERE     &#13;&#10;       ((Pr_Pasp_Status.Key_Pasp_Status = 5) OR (0 = :ShowAll))                 &#13;&#10;       AND (Pr_Pasp_Rows.Tsm = 0.0)&#13;&#10;       AND (Pr_Pasp_Rows.Cod_Oper not in ('0000'))                                     &#13;&#10;       AND (T_Oper_Gr.Name_GrGr not like 'Контр%')&#13;&#10;       AND (Pr_Pasp_Rows.Status_Oper = 1)&#13;&#10;       AND T_TpRows.Key_V_TP is NULL           &#13;&#10;         &#13;&#10;                                        &#13;&#10;GROUP BY Pr_Pasp.Key_Pasport, Pr_Pasp.Cod_Pasp, Pr_Pasp_Status.Name_Pasp_Status, Pr_Pasp_Status.Key_Pasp_Status, Pr_Pasp.Key_Predm, T_VPredm.Cod_Predm, &#13;&#10;                      T_VPredm.Name_Predm, T_Oper_Gr.Name_GrGr, Pr_Pasp.Cod_Zak, T_VPredm.OrderCod_Predm--,&#13;&#10;       --Pr_Pasp_Rows.N_Oper_SM&#13;&#10;      &#13;&#10;ORDER BY Pr_Pasp_Status.Name_Pasp_Status, Pr_Pasp.Cod_Zak, T_VPredm.OrderCod_Predm  " PropData="05704C65667402500470546F7002400A506172616D657465727301010C41000000204E616D653D2253686F77416C6C222044617461547970653D226674496E7465676572222045787072657373696F6E3D2253686F77416C6C2E436865636B6564220000"/>
