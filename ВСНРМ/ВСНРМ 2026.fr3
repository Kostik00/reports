    <TfrxERQuery Name="IzdelQRY" UserName="Изделия" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="188" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  P_WSNRM_Izdel.Key_WSNRM,&#13;&#10;  P_WSNRM_Izdel.Key_VKZ,&#13;&#10;  P_VKZ.Cod_Zak,&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.AdInfo,&#13;&#10;  P_VKZ.Kolvo,  &#13;&#10;  T_VPredm.Massa                    &#13;&#10;FROM&#13;&#10;  P_WSNRM_Izdel&#13;&#10;  INNER JOIN  P_VKZ&#13;&#10;      ON P_WSNRM_Izdel.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;      ON P_VKZ.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE&#13;&#10;  P_WSNRM_Izdel.Key_WSNRM=:Key_WSNRM">
