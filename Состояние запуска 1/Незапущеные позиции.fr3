  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT                   &#13;&#10;  distinct P_WSNRM.Key_WSNRM Key_WSNRM,&#13;&#10;  P_WSNRM.Cod_WSNRM Cod_WSNRM,&#13;&#10;  P_WSNRM.DataWSNRM DataWSNRM,&#13;&#10;&#13;&#10;  P_VMZ.Key_VMZ,&#13;&#10;  A_Rezerv.Key_Id_Mat,&#13;&#10;&#13;&#10;  DSE.Key_Predm AS Key_PredmDSE,&#13;&#10;  DSE.Cod_Predm AS Cod_PredmDSE,&#13;&#10;  DSE.Name_Predm AS Name_PredmDSE,&#13;&#10;  DSE.Name_K_Prin Name_K_Prin,&#13;&#10;  P_VMZ.KolDSE,&#13;&#10;&#13;&#10;&#13;&#10;  PredmM.Key_Predm,&#13;&#10;  PredmM.PrintFlag,&#13;&#10;  PredmM.Cod_Predm,&#13;&#10;  PredmM.Name_Predm,&#13;&#10;  PredmM.Sortam,&#13;&#10;  PredmM.Type_NTD_Sortam,&#13;&#10;  PredmM.Name_NTD_Sortam,&#13;&#10;  PredmM.Marka,&#13;&#10;  PredmM.Type_NTD_Marka,&#13;&#10;  PredmM.Name_NTD_Marka,&#13;&#10;&#13;&#10;  PredmBySP.PrintFlag        PrintFlagBySP,&#13;&#10;  PredmBySP.Cod_Predm        Cod_PredmBySP,&#13;&#10;  PredmBySP.Name_Predm       Name_PredmBySP,&#13;&#10;  PredmBySP.Sortam           SortamBySP,&#13;&#10;  PredmBySP.Type_NTD_Sortam  Type_NTD_SortamBySP,&#13;&#10;  PredmBySP.Name_NTD_Sortam  Name_NTD_SortamBySP,&#13;&#10;  PredmBySP.Marka            MarkaBySP,&#13;&#10;  PredmBySP.Type_NTD_Marka   Type_NTD_MarkaBySP,&#13;&#10;  PredmBySP.Name_NTD_Marka   Name_NTD_MarkaBySP,&#13;&#10;&#13;&#10;  P_VMZ.Cod_Zagotov_BySP,&#13;&#10;  P_VMZ.Prof_Razm_BySP,&#13;&#10;  P_VMZ.MZag_BySP,&#13;&#10;  P_VMZ.KolZag_BySP,&#13;&#10;  P_VMZ.Kolvo_BySP,&#13;&#10;  P_VMZ.KolvoInBaseEd_BySP,&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  T_Zagotov_BySP.Name_Zagotov Name_Zagotov_BySP,&#13;&#10;  T_Edizm.Name_K_Ed           Name_K_EdBySP,&#13;&#10;  T_EdizmBySP.Name_K_Ed       Name_K_EdBySPBE,&#13;&#10;&#13;&#10;&#13;&#10;  A_Rezerv.Key_Rezerv,&#13;&#10;&#13;&#10;  A_Rezerv.Cod_Zagotov,&#13;&#10;  A_Rezerv.Prof_Razm,&#13;&#10;  A_Rezerv.MZag,&#13;&#10;  A_Rezerv.KolZag,&#13;&#10;  A_Rezerv.Kolvo,&#13;&#10;  A_Rezerv.KolvoInBaseEd,&#13;&#10;&#13;&#10;  A_Rezerv.DateR,&#13;&#10;  A_Rezerv.DateZ,&#13;&#10;&#13;&#10;  T_Zagotov.Name_Zagotov  Name_Zagotov,&#13;&#10;  T_EdizmR.Name_K_Ed        Name_K_Ed,&#13;&#10;  T_EdizmM.Name_K_Ed      Name_K_EdBE,&#13;&#10;&#13;&#10;&#13;&#10;  A_Rezerv.KolDT,&#13;&#10;  T1.KolvoDTR,&#13;&#10;  (P_VMZ.KolDSE - Isnull(T1.KolvoDTR,0))  KolvoOst,&#13;&#10;&#13;&#10;&#13;&#10;  A_ID_Mat.VidSert,&#13;&#10;  A_ID_Mat.N_Sert,&#13;&#10;  A_ID_Mat.Date_Sert,&#13;&#10;  A_ID_Mat.Cod_Plavka,&#13;&#10;  A_ID_Mat.Party,&#13;&#10;&#13;&#10;  P_VMZ.Key_Sub_Ver,&#13;&#10;  P_VMZ.DatePostav,&#13;&#10;&#13;&#10;  TZapData.DataZapUtv&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  P_WSNRM&#13;&#10;&#13;&#10;  INNER JOIN P_VMZ&#13;&#10;    ON  P_VMZ.Key_WSNRM =  P_WSNRM.Key_WSNRM&#13;&#10;&#13;&#10;  INNER JOIN T_SPRows&#13;&#10;    ON T_SPRows.Key_SPRow =  P_VMZ.Key_SPRow&#13;&#10;    AND  T_SPRows.SP_position = 0&#13;&#10;&#13;&#10;  LEFT JOIN&#13;&#10;  (&#13;&#10;      SELECT     P_VMZ.Key_VMZ, MIN(P_VKZ.DataZapUtv) AS DataZapUtv&#13;&#10;      FROM         P_VMZ INNER JOIN&#13;&#10;                            P_VKZ_VMZ ON P_VMZ.Key_VMZ = P_VKZ_VMZ.Key_VMZ INNER JOIN&#13;&#10;                            P_VKZ ON P_VKZ_VMZ.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;      GROUP BY P_VMZ.Key_VMZ&#13;&#10;  )  TZapData&#13;&#10;  ON TZapData.Key_VMZ =  P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;    &#13;&#10;  INNER JOIN T_VPredm AS DSE&#13;&#10;    ON P_VMZ.Key_PredmDSE = DSE.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm AS PredmBySP&#13;&#10;    ON P_VMZ.Key_Predm_BySP = PredmBySP.Key_Predm&#13;&#10;  INNER JOIN T_Edizm  T_EdizmBySP&#13;&#10;    ON T_EdizmBySP.Cod_Ed_Izm =  PredmBySP.Sklad_Ed_Izm&#13;&#10;  LEFT JOIN T_Zagotov  T_Zagotov_BySP&#13;&#10;    ON P_VMZ.Cod_Zagotov_BySP = T_Zagotov_BySP.Cod_Zagotov&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN dbo.A_Rezerv  A_Rezerv&#13;&#10;    ON A_Rezerv.Key_VMZ =  P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;  LEFT JOIN A_VID_Mat   A_ID_Mat&#13;&#10;    ON  A_ID_Mat.Key_Id_Mat =  A_Rezerv.Key_Id_Mat&#13;&#10;&#13;&#10;  LEFT JOIN T_VPredm AS PredmM&#13;&#10;    ON A_ID_Mat.Key_Predm = PredmM.Key_Predm&#13;&#10;&#13;&#10; LEFT JOIN T_Edizm   T_EdizmR&#13;&#10;    ON T_EdizmR.Cod_Ed_Izm =  A_Rezerv.Cod_Ed_Izm&#13;&#10;&#13;&#10;&#13;&#10; LEFT JOIN T_Edizm&#13;&#10;    ON T_Edizm.Cod_Ed_Izm =  PredmM.Cod_Ed_Izm&#13;&#10; LEFT JOIN T_Edizm  T_EdizmM&#13;&#10;    ON T_EdizmM.Cod_Ed_Izm =  PredmM.Sklad_Ed_Izm&#13;&#10; LEFT JOIN T_Zagotov&#13;&#10;    ON A_Rezerv.Cod_Zagotov = T_Zagotov.Cod_Zagotov&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  INNER JOIN&#13;&#10;  (&#13;&#10;    SELECT     P_VMZ.Key_VMZ, SUM(A_Rezerv.KolDT) AS KolvoDTR&#13;&#10;    FROM         P_VMZ LEFT OUTER JOIN&#13;&#10;                          A_Rezerv ON P_VMZ.Key_VMZ = A_Rezerv.Key_VMZ&#13;&#10;    GROUP BY P_VMZ.Key_VMZ&#13;&#10;  )  T1&#13;&#10;  ON T1.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;  	LEFT JOIN&#13;&#10;	(&#13;&#10;	SELECT&#13;&#10;		P_VMZ.Key_VMZ,&#13;&#10;		SUM(T1.Kolvo) Kolvo,&#13;&#10;		SUM(T1.KolvoZap) KolvoZap&#13;&#10;	FROM  P_VMZ&#13;&#10;		INNER JOIN P_VKZ_VMZ&#13;&#10;			ON P_VKZ_VMZ.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;		INNER JOIN&#13;&#10;		(&#13;&#10;			SELECT&#13;&#10;				P_VKZ.Key_VKZ,&#13;&#10;				P_VKZ.Kolvo,&#13;&#10;				SUM(Isnull(Pr_PaspDet.KolvoZap, 0)) AS KolvoZap&#13;&#10;			FROM&#13;&#10;				P_VKZ&#13;&#10;				INNER JOIN Pr_PaspDet&#13;&#10;					ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;				INNER JOIN Pr_Pasp&#13;&#10;					ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport&#13;&#10;					AND  (Pr_Pasp.Key_Pasp_Status &#62;= 1)&#13;&#10;	&#13;&#10;			GROUP BY P_VKZ.Key_VKZ, P_VKZ.Kolvo &#13;&#10;&#13;&#10;		) T1&#13;&#10;		ON T1.Key_VKZ = P_VKZ_VMZ.Key_VKZ&#13;&#10;	GROUP BY P_VMZ.Key_VMZ&#13;&#10;	HAVING SUM(T1.Kolvo) &#60;= SUM(T1.KolvoZap)&#13;&#10;&#13;&#10;	) TZ01&#13;&#10;&#13;&#10;	ON TZ01.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  TZ01.Key_VMZ is null&#13;&#10;  AND P_VMZ.VMZActive &#60;&#62; 0  &#13;&#10;  AND  TZapData.DataZapUtv &#62;= (GetDate()+1)&#13;&#10;  AND P_WSNRM.Key_WSNRM_Status in (0,1,2)&#13;&#10;Order by DataZapUtv ASC                                                       &#13;&#10;  " PropData="05704C65667402480470546F7002440A506172616D65746572730100"/>
  </TfrxDataPage>
