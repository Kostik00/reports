  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="TrudQRY" UserName="TrudQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="VKZfrxDS" IgnoreDupParams="False" SQL.Text="&#13;&#10;&#13;&#10;--&#13;&#10;-- Ðàñ÷åò îñòàòêà òðóäîåìêîñòè íà óçåë â ðàçðåçå âèäîâ ðàáîò&#13;&#10;--&#13;&#10;&#13;&#10;&#13;&#10;	Declare @Key_Vkz int,&#13;&#10;	@MaxLvl int,&#13;&#10;	@PrintD int ,&#13;&#10;	@PrintDT int &#13;&#10;&#13;&#10;set @Key_Vkz = :Key_Vkz  &#13;&#10;set @MaxLvl = 2&#13;&#10;set @PrintD = 0&#13;&#10;set @PrintDT = 0&#13;&#10;&#13;&#10;&#13;&#10;	SET NOCOUNT ON&#13;&#10;	CREATE TABLE #TmpIzdelDSE&#13;&#10;	(&#13;&#10;		Key_VKZ_Izdel int,&#13;&#10;		Key_Predm int,&#13;&#10;		Kolvo int&#13;&#10;	)&#13;&#10;&#13;&#10;    INSERT INTO #TmpIzdelDSE (Key_VKZ_Izdel, Key_Predm, Kolvo)&#13;&#10;&#13;&#10;	SELECT       @Key_Vkz, Key_Predm, SUM(Kolvo) AS Kolvo&#13;&#10;	FROM         P_VKZ&#13;&#10;	WHERE   P_VKZ.Key_VKZ_Izdel = (Select Key_VKZ_Izdel from P_VKZ T1 WHERE T1.Key_VKZ = @Key_Vkz)&#13;&#10;		AND P_VKZ.CodStrSv like (Select CodStrSv + '%' from P_VKZ T1 WHERE T1.Key_VKZ = @Key_Vkz)&#13;&#10;		&#13;&#10;	GROUP BY  Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;	CREATE TABLE #TmpMK&#13;&#10;	(&#13;&#10;		Key_VKZ_Izdel int,&#13;&#10;		Key_Predm int,&#13;&#10;		Key_TpRows int,&#13;&#10;		Key_V_TP int,&#13;&#10;		lvl int&#13;&#10;	)&#13;&#10;&#13;&#10;	INSERT INTO #TmpMK&#13;&#10;		SELECT Key_VKZ_Izdel, T_Predm.Key_Predm, T_TPRows.Key_TPRows, T_TPRows.Key_V_TP, 1&#13;&#10;	FROM #TmpIzdelDSE&#13;&#10;		INNER JOIN T_Predm &#13;&#10;			ON #TmpIzdelDSE.Key_Predm = T_Predm.Key_Predm &#13;&#10;		INNER JOIN T_SP &#13;&#10;			ON T_Predm.Key_Predm = T_SP.Key_Predm &#13;&#10;			AND T_Predm.SP_Version = T_SP.SP_Version &#13;&#10;		INNER JOIN T_TPRows &#13;&#10;			ON T_SP.Key_TP = T_TPRows.Key_TP&#13;&#10;&#13;&#10;	DECLARE @Lvl int&#13;&#10;	SET @Lvl = 1&#13;&#10;&#13;&#10;	WHILE @Lvl &#60; @MaxLvl &#13;&#10;	BEGIN&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;		INSERT INTO #TmpMK&#13;&#10;		SELECT #TmpMK.Key_VKZ_Izdel, #TmpMK.Key_Predm, T_TPRows.Key_TPRows,  T_TPRows.Key_V_TP, @Lvl+1&#13;&#10;		FROM #TmpMK&#13;&#10;			INNER JOIN T_TPRows  T1&#13;&#10;				ON T1.Key_TPRows = #TmpMK.Key_TPRows &#13;&#10;&#13;&#10;			INNER JOIN T_TPRows &#13;&#10;				ON T_TPRows.Key_Tp = T1.Key_V_TP &#13;&#10;				AND  ((T_TPRows.N_Oper_MK=T1.N_Oper_MK) OR( T_TPRows.N_Oper_MK='' ))&#13;&#10;&#13;&#10;		WHERE #TmpMK.Lvl=@Lvl&#13;&#10;&#13;&#10;		SET @Lvl = @Lvl+1&#13;&#10;	END&#13;&#10;&#13;&#10;SET NOCOUNT OFF&#13;&#10;&#13;&#10;SELECT     &#13;&#10;	P_VKZ_IZDEL.Cod_Zak, &#13;&#10;	SUM(P_VKZ_IZDEL.Kolvo) Kolvo,&#13;&#10;	T_VPredm.Cod_Predm,&#13;&#10;	T_VPredm.OrderCod_Predm ,&#13;&#10;	T_VPredm.Name_Predm,&#13;&#10;	T1.Name_GrGr,&#13;&#10;	SUM(T2.SMTrudTP ) SMTrudTP,&#13;&#10;	SUM(T3.SMTrudByPasp) SMTrudByPasp,&#13;&#10;	SUM(T3.SMTrudByPaspF) SMTrudByPaspF&#13;&#10;&#13;&#10;FROM         &#13;&#10;	P_VKZ AS P_VKZ_IZDEL&#13;&#10;	INNER JOIN D_Zakaz&#13;&#10;       ON D_Zakaz.Cod_Zak=P_VKZ_IZDEL.Cod_Zak&#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON P_VKZ_IZDEL.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	CROSS JOIN &#13;&#10;		(SELECT  DISTINCT Name_GrGr FROM T_V_OPERGR) T1&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			SELECT &#13;&#10;					#TmpIzdelDSE.Key_VKZ_Izdel,&#13;&#10;					T_V_OPERGR.Name_GrGr,&#13;&#10;					Sum(#TmpIzdelDSE.Kolvo * isnull(T_TPRows.TSht,0) + isnull(T_TPRows.Tpz,0)) SMTrudTP&#13;&#10;				FROM &#13;&#10;					#TmpIzdelDSE&#13;&#10;					INNER JOIN #TmpMK&#13;&#10;						ON  #TmpMK.Key_VKZ_Izdel	= #TmpIzdelDSE.Key_VKZ_Izdel&#13;&#10;						AND #TmpMK.Key_Predm		= #TmpIzdelDSE.Key_Predm&#13;&#10;					INNER JOIN T_TPRows &#13;&#10;						ON T_TPRows.Key_TPRows=#TmpMK.Key_TPRows&#13;&#10;					LEFT JOIN T_V_OPERGR &#13;&#10;							ON T_TPRows.Cod_Oper = T_V_OPERGR.Cod_Oper&#13;&#10;&#13;&#10;				GROUP BY &#13;&#10;				#TmpIzdelDSE.Key_VKZ_Izdel,&#13;&#10;				T_V_OPERGR.Name_GrGr&#13;&#10;&#13;&#10;		) T2&#13;&#10;	ON T2.Key_VKZ_Izdel = P_VKZ_IZDEL.Key_VKZ&#13;&#10;	AND T2.Name_GrGr = T1.Name_GrGr&#13;&#10;&#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;	(&#13;&#10;		SELECT     &#13;&#10;			P_VKZ_IZDEL.Key_VKZ Key_VKZ_Izdel,&#13;&#10;			T_V_OPERGR.Name_GrGr, &#13;&#10;			SUM(Pr_Pasp_Rows.Tsm*Pr_PaspDet.KolvoZap/Pr_Pasp.PaspKolvo) SMTrudByPasp,&#13;&#10;			SUM(Pr_Pasp_Rows.Tsm*Pr_PaspDet.KolvoZap * dbo.Sys_EQ(Pr_Pasp_Rows.Status_Oper,2)/Pr_Pasp.PaspKolvo) SMTrudByPaspF&#13;&#10;&#13;&#10;		FROM         &#13;&#10;			P_VKZ AS P_VKZ_IZDEL&#13;&#10;			INNER JOIN P_VKZ &#13;&#10;				ON P_VKZ_IZDEL.Key_VKZ_Izdel = P_VKZ.Key_VKZ_Izdel &#13;&#10;				AND P_VKZ.CodStrSv like   P_VKZ_IZDEL.CodStrSv+'%'&#13;&#10;&#13;&#10;			INNER JOIN Pr_PaspDet &#13;&#10;				on P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;			INNER JOIN Pr_Pasp &#13;&#10;				ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;			INNER JOIN Pr_Pasp_Rows &#13;&#10;				ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport &#13;&#10;			LEFT JOIN T_V_OPERGR &#13;&#10;				ON Pr_Pasp_Rows.Cod_Oper = T_V_OPERGR.Cod_Oper&#13;&#10;		WHERE     &#13;&#10;			P_VKZ_IZDEL.Key_VKZ = @Key_VKZ &#13;&#10;			AND  Pr_Pasp.Key_Pasp_Status &#62; 0                              &#13;&#10;			AND Pr_Pasp.PaspKolvo &#62;0&#13;&#10;		GROUP BY&#13;&#10;			P_VKZ_IZDEL.Key_VKZ, &#13;&#10;			T_V_OPERGR.Name_GrGr&#13;&#10;	) T3 &#13;&#10;	ON T3.Key_VKZ_Izdel = P_VKZ_IZDEL.Key_VKZ&#13;&#10;	AND T3.Name_GrGr = T1.Name_GrGr&#13;&#10;&#13;&#10;&#13;&#10;WHERE P_VKZ_IZDEL.Key_VKZ  = @Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;GROUP BY&#13;&#10;	P_VKZ_IZDEL.Cod_Zak, &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.OrderCod_Predm ,&#13;&#10;	T_VPredm.Name_Predm,&#13;&#10;	T1.Name_GrGr&#13;&#10;&#13;&#10;having&#13;&#10;	   SUM(T2.SMTrudTP )&#62; 0 &#13;&#10;	OR SUM(T3.SMTrudByPasp) &#62; 0&#13;&#10;	OR SUM(T3.SMTrudByPaspF) &#62; 0&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY&#13;&#10;	P_VKZ_IZDEL.Cod_Zak, &#13;&#10;	T_VPredm.OrderCod_Predm,&#13;&#10;	T1.Name_GrGr" PropData="05704C656674024C0470546F7002500A506172616D657465727301010C24000000204E616D653D224B65795F566B7A222044617461547970653D226674556E6B6E6F776E220000"/>
  </TfrxDataPage>
