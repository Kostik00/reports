<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41295,0680531829" ReportOptions.Description.Text="" ReportOptions.Name="Ïëàí âûïóñêà (ïîäåòàëüíûé).fr3 Ãðàôèê 662-À11" ReportOptions.LastChange="41631,6693809259" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';&#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('StartDate',Str);        &#13;&#10;  DateFrom.Date:= StrToDate( Str );  &#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('EndDate',Str);        &#13;&#10;  DateTO.Date:= StrToDate( Str );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnDeactivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:=DateToStr(DateFrom.Date);&#13;&#10;  MySaveString('StartDate',Str);        &#13;&#10;  Str:=DateToStr(DateTo.Date);&#13;&#10;  MySaveString('EndDate',Str);        &#13;&#10;end;  &#13;&#10;             &#13;&#10;procedure PlnQRYCod_PredmOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;      &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="PlnQRY" UserName="PlnQRY" CloseDataSource="True" FieldAliases.Text="Key_VKZ=Key_VKZ&#13;&#10;Cod_PredmIzdel=Cod_PredmIzdel&#13;&#10;Cod_Zak=Cod_Zak&#13;&#10;DataZap=DataZap&#13;&#10;DataVip=DataVip&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Cod_Prin=Cod_Prin&#13;&#10;Name_K_Prin=Name_K_Prin&#13;&#10;DateStr=DateStr&#13;&#10;Cod_PredmM=Cod_PredmM&#13;&#10;Name_PredmM=Name_PredmM&#13;&#10;PrintFlagM=PrintFlagM&#13;&#10;SortamM=SortamM&#13;&#10;Type_NTD_SortamM=Type_NTD_SortamM&#13;&#10;Name_NTD_SortamM=Name_NTD_SortamM&#13;&#10;MarkaM=MarkaM&#13;&#10;Type_NTD_MarkaM=Type_NTD_MarkaM&#13;&#10;Name_NTD_MarkaM=Name_NTD_MarkaM&#13;&#10;Prof_Razm=Prof_Razm&#13;&#10;Kolvo_Zap=Kolvo_Zap&#13;&#10;Kolvo_Vip=Kolvo_Vip&#13;&#10;Kolvo_VipM=Kolvo_VipM&#13;&#10;Kolvo=Kolvo" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT P_VKZ.Key_VKZ,                         &#13;&#10;&#13;&#10;       T_VPredm_Izdel.Cod_Predm AS Cod_PredmIzdel, &#13;&#10;       P_VKZ_Izdel.Cod_Zak, &#13;&#10;       P_VKZ.DataZap,      &#13;&#10;       P_VKZ.DataVip,&#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Cod_Prin,&#13;&#10;       T_VPredm.Name_K_Prin,&#13;&#10;       Convert (varchar,P_VKZ.DataVip,112) DateStr,&#13;&#10;&#13;&#10;        PredmM.Cod_Predm 	AS Cod_PredmM,&#13;&#10;        PredmM.Name_Predm 	AS Name_PredmM,&#13;&#10;        PredmM.PrintFlag AS PrintFlagM,                                                                &#13;&#10;&#13;&#10;        PredmM.Sortam SortamM,&#13;&#10;        PredmM.Type_NTD_Sortam AS Type_NTD_SortamM,&#13;&#10;        PredmM.Name_NTD_Sortam AS Name_NTD_SortamM,&#13;&#10;          &#13;&#10;        PredmM.Marka MarkaM,&#13;&#10;        PredmM.Type_NTD_Marka AS Type_NTD_MarkaM,&#13;&#10;        PredmM.Name_NTD_Marka AS Name_NTD_MarkaM,&#13;&#10;        T_SPROWS.Prof_Razm,&#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_Zap   (P_VKZ.Key_VKZ) Kolvo_Zap,&#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_Ready (P_VKZ.Key_VKZ) Kolvo_Vip,&#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_ReadyM(P_VKZ.Key_VKZ) Kolvo_VipM,&#13;&#10;            &#13;&#10;        P_VKZ.Kolvo            &#13;&#10;FROM         &#13;&#10;       P_VKZ INNER JOIN T_VPredm &#13;&#10;               ON P_VKZ.Key_Predm = T_VPredm.Key_Predm &#13;&#10;       INNER JOIN P_VKZ AS P_VKZ_Izdel &#13;&#10;               ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ &#13;&#10;       INNER JOIN T_VPredm AS T_VPredm_Izdel &#13;&#10;               ON P_VKZ_Izdel.Key_Predm = T_VPredm_Izdel.Key_Predm&#13;&#10;&#13;&#10;	   LEFT JOIN dbo.T_SPRows T_SPRows &#13;&#10;				ON T_SPRows.Key_SP = P_VKZ.Key_SP&#13;&#10;				AND T_SPRows.SP_position = 0&#13;&#10;	   LEFT JOIN T_VPredm AS PredmM&#13;&#10;               ON T_SPRows.Key_Predm = PredmM.Key_Predm&#13;&#10;			&#13;&#10;&#13;&#10;                 &#13;&#10;WHERE     &#13;&#10;       P_VKZ.DataVip     &#62;= :DateFrom                                    &#13;&#10;       AND P_VKZ.DataVip &#60;= :DateTo&#13;&#10;       AND P_VKZ.Cod_Postav = '1'&#13;&#10;       AND P_VKZ.Kolvo &#62;0                                       &#13;&#10;       AND  ((IsNull(dbo.Pr_VKZ_Get_Kolvo_Ready (P_VKZ.Key_VKZ),0) &#60; P_VKZ.Kolvo) or (:PrintZap  = 0))                                                                  &#13;&#10;       AND  ((IsNull(dbo.Pr_VKZ_Get_Kolvo_ReadyM(P_VKZ.Key_VKZ),0) &#60; P_VKZ.Kolvo) or (:PrintZapM = 0))&#13;&#10;       AND P_VKZ_Izdel.Cod_SosZ = 'Ä'&#13;&#10;--       AND P_VKZ_Izdel.LockDT = 1                                                           &#13;&#10;       AND P_VKZ_Izdel.FlPln = :Param1&#13;&#10;       AND T_VPredm.Cod_Prin not in ('72')           &#13;&#10;ORDER by DateStr, T_VPredm_Izdel.OrderCod_Predm, T_VPredm.OrderCod_Predm, &#13;&#10;       T_VPredm.Name_Predm  " PropData=""/>
    <TfrxERQuery Name="PaspQRY" UserName="Ïàñïîðòà" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="PlnQRY" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       P_VKZ.Key_Predm, &#13;&#10;       SUM(Pr_PaspDet.KolvoZap) AS KolvoZap, &#13;&#10;       Pr_Pasp.Cod_Pasp, &#13;&#10;       S_Subjects.Name_Sub,&#13;&#10;       Pr_Pasp_Status.Name_Pasp_Status, &#13;&#10;       Pr_Pasp_Rows.N_Oper_SM, &#13;&#10;       T_Oper.Name_K_Oper&#13;&#10;FROM         &#13;&#10;       P_VKZ &#13;&#10;       INNER JOIN Pr_PaspDet&#13;&#10;               ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;       INNER JOIN Pr_Pasp &#13;&#10;               ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;       LEFT JOIN S_Subjects &#13;&#10;               ON Pr_Pasp.Key_Sub_Master = S_Subjects.Key_Sub &#13;&#10;       LEFT JOIN Pr_Pasp_Rows &#13;&#10;               ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport &#13;&#10;               AND Pr_Pasp.N_Oper_Sm = Pr_Pasp_Rows.N_Oper_Sm &#13;&#10;       LEFT JOIN Pr_Pasp_Status &#13;&#10;               ON Pr_Pasp.Key_Pasp_Status = Pr_Pasp_Status.Key_Pasp_Status &#13;&#10;       LEFT JOIN T_Oper &#13;&#10;               ON Pr_Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper&#13;&#10;WHERE                &#13;&#10;   (P_VKZ.Key_VKZ = :Key_VKZ )&#13;&#10;GROUP BY&#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       P_VKZ.Key_Predm, &#13;&#10;       Pr_Pasp.Cod_Pasp, &#13;&#10;       S_Subjects.Name_Sub, &#13;&#10;       Pr_Pasp_Status.Name_Pasp_Status, &#13;&#10;       Pr_Pasp_Rows.N_Oper_SM,&#13;&#10;       T_Oper.Name_K_Oper" PropData="05704C65667403B8000470546F7002180A506172616D657465727301010C24000000204E616D653D224B65795F564B5A222044617461547970653D226674556E6B6E6F776E220000"/>
