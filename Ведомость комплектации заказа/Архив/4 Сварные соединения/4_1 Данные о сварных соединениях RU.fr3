<TfrxReport Version="4.10.6" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="4_1 Äàííûå î ñâàðíûõ ñîåäèíåíèÿõ RU.fr3 ÂÊÇ ¹ 275" ReportOptions.LastChange="40634,6189423843" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';&#13;&#10;&#13;&#10;  &#13;&#10;var&#13;&#10;// OldY:extended;&#13;&#10;// MaxY:extended;&#13;&#10;&#13;&#10;  W1:extended;&#13;&#10;  W2:extended;&#13;&#10;  W3:extended;&#13;&#10;  W4:extended;&#13;&#10;&#13;&#10;    &#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  OldY:=Engine.CurY;&#13;&#10;  BigMemo.Visible:=MechSV.Eof;&#13;&#10;  MSvrFtr.Visible:=True;                                    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  Engine.CurY:=OldY;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData2OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  MaxY:=Engine.CurY;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Footer2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  If  Engine.CurY &#60; MaxY then Engine.CurY:=MaxY;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnAfterCalcHeight(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if TfrxMasterData(Sender).Height&#62;Engine.FreeSpace then&#13;&#10;    Engine.ShowBand(PageFtr);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;&#13;&#10;begin&#13;&#10;  MSvrFtr.Visible:=True;                                &#13;&#10;  Idx:=0;&#13;&#10;&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Isp1&#34;&#62; = 0 then&#13;&#10;    SertNaprMemo1.Lines.Text:=''&#13;&#10;  else&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Zakl1&#34;&#62; &#62; 0 then&#13;&#10;    SertNaprMemo1.Lines.Text:='[Ìåõàíèêà.&#34;Vid_Zakl1&#34;] ¹'#160'[Ìåõàíèêà.&#34;Num_Zakl1&#34;] îò'#160'[Ìåõàíèêà.&#34;Data_Zakl1&#34;]'&#13;&#10;  else&#13;&#10;    SertNaprMemo1.Lines.Text:='[Ìåõàíèêà.&#34;VidSert&#34;] ¹'#160'[Ìåõàíèêà.&#34;N_Sert&#34;] îò'#160'[Ìåõàíèêà.&#34;Date_Sert&#34;]';&#13;&#10;&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Isp2&#34;&#62; = 0 then&#13;&#10;    SertNaprMemo2.Lines.Text:=''&#13;&#10;  else&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Zakl2&#34;&#62; &#62; 0 then&#13;&#10;    SertNaprMemo2.Lines.Text:='[Ìåõàíèêà.&#34;Vid_Zakl2&#34;] ¹'#160'[Ìåõàíèêà.&#34;Num_Zakl2&#34;] îò'#160'[Ìåõàíèêà.&#34;Data_Zakl2&#34;]'&#13;&#10;  else&#13;&#10;    SertNaprMemo2.Lines.Text:='[Ìåõàíèêà.&#34;VidSert&#34;] ¹'#160'[Ìåõàíèêà.&#34;N_Sert&#34;] îò'#160'[Ìåõàíèêà.&#34;Date_Sert&#34;]';&#13;&#10;&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Isp3&#34;&#62; = 0 then&#13;&#10;    SertNaprMemo3.Lines.Text:=''&#13;&#10;  else&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Zakl3&#34;&#62; &#62; 0 then&#13;&#10;    SertNaprMemo3.Lines.Text:='[Ìåõàíèêà.&#34;Vid_Zakl3&#34;] ¹'#160'[Ìåõàíèêà.&#34;Num_Zakl3&#34;] îò'#160'[Ìåõàíèêà.&#34;Data_Zakl3&#34;]'&#13;&#10;  else&#13;&#10;    SertNaprMemo3.Lines.Text:='[Ìåõàíèêà.&#34;VidSert&#34;] ¹'#160'[Ìåõàíèêà.&#34;N_Sert&#34;] îò'#160'[Ìåõàíèêà.&#34;Date_Sert&#34;]';&#13;&#10;&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Isp4&#34;&#62; = 0 then&#13;&#10;    SertNaprMemo4.Lines.Text:=''&#13;&#10;  else&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62; &#62; 0 then&#13;&#10;    SertNaprMemo4.Lines.Text:='[Ìåõàíèêà.&#34;Vid_Zakl4&#34;] ¹'#160'[Ìåõàíèêà.&#34;Num_Zakl4&#34;] îò'#160'[Ìåõàíèêà.&#34;Data_Zakl4&#34;]'&#13;&#10;  else&#13;&#10;    SertNaprMemo4.Lines.Text:='[Ìåõàíèêà.&#34;VidSert&#34;] ¹'#160'[Ìåõàíèêà.&#34;N_Sert&#34;] îò'#160'[Ìåõàíèêà.&#34;Date_Sert&#34;]';&#13;&#10;&#13;&#10;  SertNaprMemo1.Visible:=True;&#13;&#10;  SertNaprMemo2.Visible:=True;&#13;&#10;  SertNaprMemo3.Visible:=True;&#13;&#10;  SertNaprMemo4.Visible:=True;&#13;&#10;&#13;&#10;&#13;&#10;  SertNaprMemo1.Width:=W1;&#13;&#10;  SertNaprMemo2.Width:=W2;&#13;&#10;  SertNaprMemo3.Width:=W3;&#13;&#10;  SertNaprMemo4.Width:=W4;&#13;&#10;&#13;&#10;  if &#60;Ìåõàíèêà.&#34;Isp1&#34;&#62; &#62;0 then&#13;&#10;  begin&#13;&#10;    if (&#60;Ìåõàíèêà.&#34;Isp2&#34;&#62; = 0) or (&#60;Ìåõàíèêà.&#34;Zakl1&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl2&#34;&#62;)  then&#13;&#10;    begin&#13;&#10;      SertNaprMemo2.Visible:=False;&#13;&#10;      SertNaprMemo1.Width:=SertNaprMemo1.Width+W2;&#13;&#10;      if   ((&#60;Ìåõàíèêà.&#34;Isp3&#34;&#62; &#62; 0)and (&#60;Ìåõàíèêà.&#34;Zakl3&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl1&#34;&#62;))&#13;&#10;         or((&#60;Ìåõàíèêà.&#34;Isp3&#34;&#62; = 0)and((&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;=0)or&#13;&#10;                                       ((&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;&#62;0)and(&#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl1&#34;&#62;))&#13;&#10;                                      ))   then&#13;&#10;      begin&#13;&#10;        SertNaprMemo3.Visible:=False;&#13;&#10;        SertNaprMemo1.Width:=SertNaprMemo1.Width+W3;&#13;&#10;        if (&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62; &#62; 0)and(&#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl1&#34;&#62;)or(&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;=0)  then&#13;&#10;        begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo1.Width:=SertNaprMemo1.Width+W4;&#13;&#10;        end;&#13;&#10;      end&#13;&#10;      else&#13;&#10;      if &#60;Ìåõàíèêà.&#34;Isp3&#34;&#62;&#60;&#62;0 then&#13;&#10;      begin&#13;&#10;        if (&#60;Ìåõàíèêà.&#34;Zakl3&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62;)or(&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;=0) then&#13;&#10;        begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo3.Width:=SertNaprMemo3.Width+W4;&#13;&#10;        end&#13;&#10;      end&#13;&#10;      else&#13;&#10;      if &#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;&#60;&#62;0 then&#13;&#10;      begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo3.Width:=SertNaprMemo3.Width+W4;&#13;&#10;          SertNaprMemo3.Lines.Text:=SertNaprMemo4.Lines.Text;&#13;&#10;      end&#13;&#10;&#13;&#10;    end&#13;&#10;    else&#13;&#10;    if (&#60;Ìåõàíèêà.&#34;Zakl2&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl3&#34;&#62;) or&#13;&#10;       ((&#60;Ìåõàíèêà.&#34;Isp3&#34;&#62; = 0)and(&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62; = 0)) then&#13;&#10;    begin&#13;&#10;        SertNaprMemo3.Visible:=False;&#13;&#10;        SertNaprMemo2.Width:=SertNaprMemo2.Width+W3;&#13;&#10;        if (&#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl2&#34;&#62;) or (&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62; = 0)   then&#13;&#10;        begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo2.Width:=SertNaprMemo2.Width+W4;&#13;&#10;        end;&#13;&#10;    end&#13;&#10;    else&#13;&#10;    begin&#13;&#10;        if     (&#60;Ìåõàíèêà.&#34;Isp3&#34;&#62;&#60;&#62;0) and&#13;&#10;               (&#13;&#10;                (&#60;Ìåõàíèêà.&#34;Zakl3&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62;)&#13;&#10;                OR (&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;=0)&#13;&#10;               )&#13;&#10;        then&#13;&#10;        begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo3.Width:=SertNaprMemo3.Width+W4;&#13;&#10;        end&#13;&#10;        else&#13;&#10;        if (&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62; &#60;&#62; 0) and (&#60;Ìåõàíèêà.&#34;Isp3&#34;&#62;=0)  then&#13;&#10;        begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo3.Lines.Text:=SertNaprMemo4.Lines.Text;&#13;&#10;          SertNaprMemo3.Width:=SertNaprMemo3.Width+W4;&#13;&#10;        end;&#13;&#10;    end&#13;&#10;  end&#13;&#10;  else&#13;&#10;  if (&#60;Ìåõàíèêà.&#34;Isp2&#34;&#62; &#62; 0) then&#13;&#10;  begin&#13;&#10;        SertNaprMemo2.Visible:=False;&#13;&#10;        SertNaprMemo1.Width:=SertNaprMemo1.Width+W2;&#13;&#10;        SertNaprMemo1.Lines.Text:=SertNaprMemo2.Lines.Text;&#13;&#10;&#13;&#10;&#13;&#10;        if &#60;Ìåõàíèêà.&#34;Isp3&#34;&#62;&#60;&#62;0 then&#13;&#10;        begin&#13;&#10;          if (&#60;Ìåõàíèêà.&#34;Zakl3&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62;)or(&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;=0) then&#13;&#10;          begin&#13;&#10;            SertNaprMemo4.Visible:=False;&#13;&#10;            SertNaprMemo3.Width:=SertNaprMemo3.Width+W4;&#13;&#10;          end&#13;&#10;        end&#13;&#10;        else&#13;&#10;        if &#60;Ìåõàíèêà.&#34;Isp4&#34;&#62;&#60;&#62;0 then&#13;&#10;        begin&#13;&#10;            SertNaprMemo4.Visible:=False;&#13;&#10;            SertNaprMemo3.Width:=SertNaprMemo3.Width+W4;&#13;&#10;            SertNaprMemo3.Lines.Text:=SertNaprMemo4.Lines.Text;&#13;&#10;        end&#13;&#10;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  if (&#60;Ìåõàíèêà.&#34;Isp3&#34;&#62; &#62; 0) then&#13;&#10;  begin&#13;&#10;    if (&#60;Ìåõàíèêà.&#34;Zakl3&#34;&#62; = &#60;Ìåõàíèêà.&#34;Zakl4&#34;&#62;)or (&#60;Ìåõàíèêà.&#34;Isp3&#34;&#62; = 0)  then&#13;&#10;    begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo3.Visible:=False;&#13;&#10;          SertNaprMemo2.Visible:=False;&#13;&#10;          SertNaprMemo1.Width:=SertNaprMemo1.Width+(W2+W3+W4);&#13;&#10;          SertNaprMemo1.Lines.Text:=SertNaprMemo3.Lines.Text;&#13;&#10;    end&#13;&#10;    else&#13;&#10;    begin&#13;&#10;      SertNaprMemo3.Visible:=False;&#13;&#10;      SertNaprMemo2.Width:=SertNaprMemo2.Width+W3;&#13;&#10;      SertNaprMemo2.Lines.Text:=SertNaprMemo3.Lines.Text;&#13;&#10;    end;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  if (&#60;Ìåõàíèêà.&#34;Isp4&#34;&#62; &#62; 0) then&#13;&#10;  begin&#13;&#10;          SertNaprMemo4.Visible:=False;&#13;&#10;          SertNaprMemo3.Visible:=False;&#13;&#10;          SertNaprMemo2.Visible:=False;&#13;&#10;          SertNaprMemo1.Width:=SertNaprMemo1.Width+(W2+W3+W4);&#13;&#10;          SertNaprMemo1.Lines.Text:=SertNaprMemo4.Lines.Text;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Idx:=Idx+1;&#13;&#10;  MSvrFtr.Visible:=False;                                  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MSvFooterOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DopKontrDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  AddAlist(&#60;ÄîïÈñï.&#34;VidKontr&#34;&#62;,&#13;&#10;               &#60;ÄîïÈñï.&#34;Name_TT&#34;&#62;)&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ParamsOnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MyRestoreString('Îò÷ÏàñïÊîëîíòèòóë', Kolontitul.Text);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ParamsOnDeactivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MySaveString('Îò÷ÏàñïÊîëîíòèòóë', Kolontitul.Text);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure MSvrFtrOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MSvrFtr.Visible:=True;                                &#13;&#10;end;&#13;&#10;&#13;&#10;procedure PrintPageNoOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    ListMemo.Visible:=PrintPageNo.Checked;                                          &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  ClearAList;&#13;&#10;  W1:=SertNaprMemo1.Width;&#13;&#10;  W2:=SertNaprMemo2.Width;&#13;&#10;  W3:=SertNaprMemo3.Width;&#13;&#10;  W4:=SertNaprMemo4.Width;&#13;&#10;end." StoreInDFM="False" PropData="">
