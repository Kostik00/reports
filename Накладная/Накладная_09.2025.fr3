    <TfrxERQuery Name="NaclStr" UserName="������" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  A_Nacl_Str.Key_Nacl_Str,&#13;&#10;  A_Nacl_Str.Key_Nacl,&#13;&#10;  A_Nacl_Str.Key_ID_Mat,&#13;&#10;  T_VPredm.Key_Predm,&#13;&#10;&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;  A_VID_Mat.VidSert,&#13;&#10;  A_VID_Mat.N_Sert,&#13;&#10;  A_VID_Mat.Date_Sert,&#13;&#10;  A_VID_Mat.Cod_Plavka,&#13;&#10;  A_VID_Mat.Party,&#13;&#10;  A_Nacl_Str.Kolvo,&#13;&#10;  A_Nacl_Str.Cod_Ed_Izm,&#13;&#10;  T_EdIzm.Name_K_Ed,&#13;&#10;  T_VPredm.Cod_Ed_Izm AS BaseCodEd,&#13;&#10;  T_VPredm.Name_K_Ed AS BaseEdizm,&#13;&#10;  A_Nacl_Str.KolvoInBaseEd,&#13;&#10;  A_Nacl_Str.Price,&#13;&#10;  A_Nacl_Str.PercNds,&#13;&#10;  A_Nacl_Str.Sm,&#13;&#10;  A_Nacl_Str.SmNDS,  &#13;&#10;    &#13;&#10;  T_SertPos.Key_ID_Mat Key_ID_Mat_From                     &#13;&#10;FROM&#13;&#10;  A_Nacl_Str&#13;&#10;  INNER JOIN A_VID_Mat&#13;&#10;    ON A_VID_Mat.Key_ID_Mat = A_Nacl_Str.Key_ID_Mat&#13;&#10;  INNER JOIN  T_VPredmSkl T_VPredm&#13;&#10;    ON T_VPredm.Key_Predm = A_VID_Mat.Key_Predm&#13;&#10;  INNER JOIN T_EdIzm&#13;&#10;    ON A_Nacl_Str.Cod_Ed_Izm = T_EdIzm.Cod_Ed_Izm&#13;&#10;  LEFT JOIN T_SertPos&#13;&#10;    ON T_SertPos.Key_Sert_Pos = A_VID_Mat. Key_Sert_Pos                                                             &#13;&#10;WHERE&#13;&#10;   A_Nacl_Str.Key_Nacl=:Key_Nacl" PropData="05704C656674023C0470546F7002140A506172616D657465727301010C25000000204E616D653D224B65795F4E61636C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="LimitQRY" UserName="LimitQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaclStr" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  A_Nacl_Str.Key_Nacl_Str,&#13;&#10;  A_LZK.Key_LZK,&#13;&#10;  A_Nacl_Str_LZK.Kolvo,&#13;&#10;  A_LZK.Cod_Zak,&#13;&#10;  A_LZK.Cod_Zak Cod_Zak1,&#13;&#10;  A_LZK.Key_ID_Mat,&#13;&#10;  A_LZK.Key_Sub_Ver Key_Sub_Ver,&#13;&#10;  A_LZK.Key_Sub_Ver_Poluch,&#13;&#10;  A_LZK.Ostatok&#13;&#10;FROM&#13;&#10;  A_Nacl_Str&#13;&#10;  CROSS JOIN A_LZK&#13;&#10;  INNER JOIN A_Nacl_Str_LZK&#13;&#10;    ON A_Nacl_Str_LZK.Key_LZK = A_LZK.Key_LZK&#13;&#10;    AND  A_Nacl_Str_LZK.Key_Nacl_Str=A_Nacl_Str.Key_Nacl_Str&#13;&#10;WHERE&#13;&#10;       A_Nacl_Str.Key_Nacl_Str=:Key_Nacl_Str&#13;&#10;  AND  A_LZK.Key_ID_Mat=:Key_Id_Mat&#13;&#10;  AND A_Nacl_Str_LZK.Kolvo &#62;0  &#13;&#10;   " PropData="05704C656674039C000470546F7002140A506172616D657465727301010C29000000204E616D653D224B65795F4E61636C5F537472222044617461547970653D226674556E6B6E6F776E2200010C27000000204E616D653D224B65795F49645F4D6174222044617461547970653D226674556E6B6E6F776E220000"/>
