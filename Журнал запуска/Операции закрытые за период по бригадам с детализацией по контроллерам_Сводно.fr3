    <TfrxERQuery Name="SwZ" UserName="ÑâÇàäàíèÿ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10; Pr_Pasp.Cod_Pasp,&#13;&#10; Pr_Pasp.PaspKolvo,                         &#13;&#10; S_Subjects.Key_Sub,                           &#13;&#10;	S_Subjects.Key_Class, &#13;&#10;	S_Subjects.Name_Sub, &#13;&#10;	S_SubVer.F_Name_Sub,&#13;&#10; S_SubVer.Key_Sub_Ver,&#13;&#10; T_Oper.Name_Oper,                               &#13;&#10;&#13;&#10;	Pr_Pasp.Cod_Zak, &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.OrderCod_Predm,&#13;&#10;  &#13;&#10;		SUM( Isnull(Pr_Pasp_Ac.AcKolvo*Pr_Pasp_Rows.TSm/Pr_Pasp.PaspKolvo,0)) AS Sm,&#13;&#10;&#13;&#10; Pr_Pasp_Ac.Ac_Date,&#13;&#10; Pr_Pasp_Ac.acuser SysAcUser,                       &#13;&#10;	S_Subjects_1.Name_Sub AS AcUser&#13;&#10;FROM         &#13;&#10;	S_Subjects &#13;&#10;	INNER JOIN S_SubVer ON S_Subjects.Key_Sub = S_SubVer.Key_Sub     AND   S_SubVer.Fl &#60;&#62; 1                                &#13;&#10;	INNER  JOIN 	Pr_Pasp_Ac &#13;&#10;       ON Pr_Pasp_Ac.Key_Sub_Ver = S_SubVer.Key_Sub_Ver&#13;&#10;      AND Pr_Pasp_Ac.AC_Date &#62;=  :DateFrom&#13;&#10;      AND Pr_Pasp_Ac.AC_Date &#60;=  :DateTo&#13;&#10;  &#13;&#10;         &#13;&#10;	LEFT JOIN Pr_Pasp_Rows ON Pr_Pasp_Ac.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows &#13;&#10;	LEFT JOIN Pr_Pasp ON Pr_Pasp_Rows.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;	LEFT JOIN T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	LEFT JOIN S_Subjects AS S_Subjects_1 ON Pr_Pasp_Ac.AcUser = S_Subjects_1.cod_sub&#13;&#10;&#13;&#10; LEFT JOIN T_Oper&#13;&#10;   ON  T_Oper.Cod_Oper = Pr_Pasp_Rows.Cod_Oper&#13;&#10;--WHERE&#13;&#10;--  T_VPredm.Cod_Predm like 'ÏÀ450.02.00.001%'                             &#13;&#10;--  AND ((Pr_Pasp_Rows.Cod_Oper like '02%') OR (Pr_Pasp_Rows.Cod_Oper like '03%'))                                                     &#13;&#10;GROUP BY &#13;&#10; Pr_Pasp.Cod_Pasp,&#13;&#10; Pr_Pasp.PaspKolvo,     &#13;&#10;  S_Subjects.Key_Sub,&#13;&#10;	S_Subjects.Key_Class, &#13;&#10;	S_Subjects.Name_Sub, &#13;&#10;	S_SubVer.F_Name_Sub,&#13;&#10; S_SubVer.Key_Sub_Ver,&#13;&#10; T_Oper.Name_Oper,       &#13;&#10;&#13;&#10;	Pr_Pasp.Cod_Zak,&#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.OrderCod_Predm,&#13;&#10; Pr_Pasp_Ac.Ac_Date,&#13;&#10;  Pr_Pasp_Ac.acuser,       &#13;&#10;	S_Subjects_1.Name_Sub&#13;&#10;HAVING      (S_Subjects.Key_Class = 1) &#13;&#10;--AND (S_Subjects.Name_Sub LIKE '1%')&#13;&#10;AND 		SUM( Isnull(Pr_Pasp_Ac.AcKolvo*Pr_Pasp_Rows.TSm/Pr_Pasp.PaspKolvo,0)) &#62; 0                               &#13;&#10;ORDER BY AcUser,       &#13;&#10;       S_Subjects.Name_Sub,	  S_Subjects.Key_Sub,     &#13;&#10;       S_SubVer.F_Name_Sub,   S_SubVer.Key_Sub_Ver,          &#13;&#10;       Cod_Zak, OrderCod_Predm,  Pr_Pasp.Cod_Pasp         &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;      " PropData=""/>
  </TfrxDataPage>
