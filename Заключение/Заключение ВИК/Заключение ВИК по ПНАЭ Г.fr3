    <TfrxERQuery Name="SvrDtMat" UserName="МатериалДт" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="NaprStrQRY" Left="252" Top="20" IgnoreDupParams="False" SQL.Text="exec Pr_GetSvrMat&#13;&#10;       @Key_PrSvr=:Key_PrSvr ,&#13;&#10;       @Num_Izdel = 1">
