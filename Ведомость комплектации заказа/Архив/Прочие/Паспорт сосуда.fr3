0;  A_VId_Mat.N_Sert,&#13;&#10;  A_VId_Mat.Date_Sert,&#13;&#10;  A_VId_Mat.Cod_Plavka,&#13;&#10;  A_VId_Mat.Party,&#13;&#10;  A_VId_Mat.Key_Sert_Pos,&#13;&#10;  A_VId_Mat.Key_Pasport PaspMat&#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ                       -- áåðåì  âñþ ÂÊÇ íà èçäåëèå&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet             -- ñìîòðèì äëÿ íåå êàêèå åñòü ïàñïîðòà&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  INNER JOIN PR_Pasp                -- áåðåì âñå ïàñïîðòà&#13;&#10;    ON  PR_Pasp.Key_Pasport=PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm       -- äàííûå î ñàìèõ ÄÑÅ&#13;&#10;    ON T_Predm.Key_Predm=PR_Pasp.Key_Predm&#13;&#10;  INNER JOIN T_SP                    -- òàêæå ïðîñìàòðèâàåì ñïåöèôèêàöèþ&#13;&#10;    ON T_SP.Key_SP=PR_Pasp.Key_SP&#13;&#10;  INNER JOIN Pr_SP                   -- Íó è ñìîòðèì òîëüêî òî, íà ÷òî åñòü ôàêòè÷åñêèé ìàòåðèàë&#13;&#10;    ON Pr_SP.Key_Pasport=PR_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_SPRows                 -- Èç ôàêòè÷åñêèõ ìàòåðèàëîâ íàñ èíòåðåñóåò òîëüêî òå, êîòîðûå îòíîñÿòñÿ ê îñíîâíûì ìàòåðèàëàì&#13;&#10;    ON  T_SPRows.Key_SPRow=Pr_SP.Key_SPRow&#13;&#10;    AND T_SPRows.SP_Position=0&#13;&#10;  INNER JOIN A_VId_Mat                -- Ýòî ìû ñìîòðèì ìàòåðèàë â èäåíòåôèêàòîðå&#13;&#10;    ON A_VId_Mat.Key_ID_Mat=Pr_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm FMat            -- À ýòî ñîáñòâåííî ãîâîðÿ è åñòü ñàì ìàòåðèàë&#13;&#10;    ON FMat.Key_Predm=A_VId_Mat.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_TP                    -- âûáèðàåì ïàðàìåòðû ÒÏ è ïðîâåðÿåì, ÷òî åãî íàäî âûäàâàòü â ïàñïîðò&#13;&#10;    ON T_TP.Key_TP=PR_Pasp.Key_TP&#13;&#10;    AND T_SP.InTB1=1&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  P_VKZ.Key_VKZ_Izdel=:Key_VKZ_Izdel&#13;&#10;  AND dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport ) &#62; 0&#13;&#10;  AND T_Predm.Cod_Prin &#60;&#62; '11'                                                 &#13;&#10;&#13;&#10;&#13;&#10;ORDER BY T_Predm.OrderCod_Predm" PropData=""/>
    <TfrxERQuery Name="ListDSE" UserName="ÂñåÄåòàëè" CloseDataSource="False" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Cod_Pasp=Cod_Pasp&#13;&#10;Key_SP=Key_SP&#13;&#10;Key_TP=Key_TP&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;OrderCod_Predm=OrderCod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;KolvoDet=KolvoDet&#13;&#10;SkipSert=SkipSert&#13;&#10;Cod_TP=Cod_TP&#13;&#10;Name_FMat=Name_FMat&#13;&#10;Sortam_FMat=Sortam_FMat&#13;&#10;Type_NTD_Sortam_Mat=Type_NTD_Sortam_Mat&#13;&#10;Name_NTD_Sortam_Mat=Name_NTD_Sortam_Mat&#13;&#10;Marka_FMat=Marka_FMat&#13;&#10;MarkaPrn_FMat=MarkaPrn_FMat&#13;&#10;Type_NTD_Marka_Mat=Type_NTD_Marka_Mat&#13;&#10;Name_NTD_Marka_Mat=Name_NTD_Marka_Mat&#13;&#10;Key_ID_Mat=Key_ID_Mat&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;Party=Party&#13;&#10;Key_Sert_Pos=Key_Sert_Pos&#13;&#10;PaspMat=PaspMat&#13;&#10;XimC=XimC&#13;&#10;XimSi=XimSi&#13;&#10;XimMn=XimMn&#13;&#10;XimS=XimS&#13;&#10;XimP=XimP&#13;&#10;XimCr=XimCr&#13;&#10;XimNi=XimNi&#13;&#10;XimCu=XimCu&#13;&#10;XimAs=XimAs&#13;&#10;XimAl=XimAl&#13;&#10;XimN=XimN&#13;&#10;XimMo=XimMo&#13;&#10;XimW=XimW&#13;&#10;XimV=XimV&#13;&#10;XimTi=XimTi&#13;&#10;Sootv=Sootv" Master="MainFrxDS" SQL.Text="SELECT DISTINCT&#13;&#10;&#13;&#10;  PR_Pasp.Key_Pasport,&#13;&#10;  PR_Pasp.Cod_Pasp,&#13;&#10;  PR_Pasp.Key_SP,&#13;&#10;  PR_Pasp.Key_TP,&#13;&#10;&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.OrderCod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam,&#13;&#10;&#13;&#10;  dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport ) KolvoDet,&#13;&#10;&#13;&#10;  T_TP.SkipSert,&#13;&#10;  T_TP.Cod_TP,&#13;&#10;&#13;&#10;  FMat.Name_Predm      Name_FMat,&#13;&#10;&#13;&#10;  FMat.Sortam          Sortam_FMat,&#13;&#10;  FMat.Type_NTD_Sortam Type_NTD_Sortam_Mat,&#13;&#10;  FMat.Name_NTD_Sortam Name_NTD_Sortam_Mat,&#13;&#10;&#13;&#10;  FMat.Marka           Marka_FMat,&#13;&#10;  FMat.MarkaPrn        MarkaPrn_FMat,&#13;&#10;  FMat.Type_NTD_Marka  Type_NTD_Marka_Mat,&#13;&#10;  FMat.Name_NTD_Marka  Name_NTD_Marka_Mat,&#13;&#10;&#13;&#10;  A_VId_Mat.Key_ID_Mat,&#13;&#10;  A_VId_Mat.VidSert,&#13;&#10;  A_VId_Mat.N_Sert,&#13;&#10;  A_VId_Mat.Date_Sert,&#13;&#10;  A_VId_Mat.Cod_Plavka,&#13;&#10;  A_VId_Mat.Party,&#13;&#10;  A_VId_Mat.Key_Sert_Pos,&#13;&#10;  A_VId_Mat.Key_Pasport PaspMat,&#13;&#10;&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'C')  XimC,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Si') XimSi,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Mn') XimMn,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'S')  XimS,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'P')  XimP,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Cr') XimCr,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Ni') XimNi,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Cu') XimCu,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'As') XimAs,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Al') XimAl,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'N')  XimN,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Mo')  XimMo,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'W')  XimW,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'V')  XimV,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Ti') XimTi,&#13;&#10;  dbo.Pr_XimSv(A_VId_Mat.Key_Sert_Pos,'Ñîîòâåòñòâóåò') Sootv           &#13;&#10;  &#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ                       -- áåðåì  âñþ ÂÊÇ íà èçäåëèå&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet             -- ñìîòðèì äëÿ íåå êàêèå åñòü ïàñïîðòà&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  INNER JOIN PR_Pasp                -- áåðåì âñå ïàñïîðòà&#13;&#10;    ON  PR_Pasp.Key_Pasport=PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm       -- äàííûå î ñàìèõ ÄÑÅ&#13;&#10;    ON T_Predm.Key_Predm=PR_Pasp.Key_Predm&#13;&#10;  INNER JOIN T_SP                    -- òàêæå ïðîñìàòðèâàåì ñïåöèôèêàöèþ&#13;&#10;    ON T_SP.Key_SP=PR_Pasp.Key_SP&#13;&#10;  INNER JOIN Pr_SP                   -- Íó è ñìîòðèì òîëüêî òî, íà ÷òî åñòü ôàêòè÷åñêèé ìàòåðèàë&#13;&#10;    ON Pr_SP.Key_Pasport=PR_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_SPRows                 -- Èç ôàêòè÷åñêèõ ìàòåðèàëîâ íàñ èíòåðåñóåò òîëüêî òå, êîòîðûå îòíîñÿòñÿ ê îñíîâíûì ìàòåðèàëàì&#13;&#10;    ON  T_SPRows.Key_SPRow=Pr_SP.Key_SPRow&#13;&#10;    AND T_SPRows.SP_Position=0&#13;&#10;  INNER JOIN A_VId_Mat                -- Ýòî ìû ñìîòðèì ìàòåðèàë â èäåíòåôèêàòîðå&#13;&#10;    ON A_VId_Mat.Key_ID_Mat=Pr_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm FMat            -- À ýòî ñîáñòâåííî ãîâîðÿ è åñòü ñàì ìàòåðèàë&#13;&#10;    ON FMat.Key_Predm=A_VId_Mat.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_TP                    -- âûáèðàåì ïàðàìåòðû ÒÏ è ïðîâåðÿåì, ÷òî åãî íàäî âûäàâàòü â ïàñïîðò&#13;&#10;    ON T_TP.Key_TP=PR_Pasp.Key_TP&#13;&#10;    AND T_SP.InTB1=1&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  P_VKZ.Key_VKZ_Izdel=:Key_VKZ_Izdel&#13;&#10;  AND dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport ) &#62; 0&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY T_Predm.OrderCod_Predm" PropData=""/>
    <TfrxERQuery Name="MechSvQry" UserName="Ìåõàíèêà" CloseDataSource="True" FieldAliases.Text="Key_Sert=Key_Sert&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Key_Sert_Pos=Key_Sert_Pos&#13;&#10;Cod_Isp=Cod_Isp&#13;&#10;Key_Zakl=Key_Zakl&#13;&#10;Vid_Zakl=Vid_Zakl&#13;&#10;Num_Zakl=Num_Zakl&#13;&#10;Data_Zakl=Data_Zakl&#13;&#10;Sv1_10=Sv1_10&#13;&#10;Sv1_20=Sv1_20&#13;&#10;Sv1_30=Sv1_30&#13;&#10;Sv1_40=Sv1_40&#13;&#10;Sv2_50=Sv2_50&#13;&#10;Sv2_60=Sv2_60&#13;&#10;Sv2_70=Sv2_70&#13;&#10;Sv3_50=Sv3_50&#13;&#10;Sv3_160=Sv3_160&#13;&#10;Sv3_70=Sv3_70" Master="ListDSE" SQL.Text="EXEC Pr_GetMechSV1  &#13;&#10;&#13;&#10;@Key_Pasport   = :Key_Pasport,&#13;&#10;@Key_Sert_Pos  = :Key_Sert_Pos,&#13;&#10;@Key_SP        = :Key_SP,&#13;&#10;@PaspMat       = :PaspMat,&#13;&#10;@SkipSert      = :SkipSert" PropData=""/>
    <TfrxERQuery Name="AdQRY" UserName="ÄîïÑâåä" CloseDataSource="True" FieldAliases.Text="Key_Sert=Key_Sert&#13;&#10;Key_Sert_Pos=Key_Sert_Pos&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_TT=Cod_TT&#13;&#10;Attr=Attr&#13;&#10;Key_NaprZakl=Key_NaprZakl&#13;&#10;Key_Sert_Attr=Key_Sert_Attr&#13;&#10;Attr_Val=Attr_Val&#13;&#10;Key_Zakl=Key_Zakl&#13;&#10;Vid_Zakl=Vid_Zakl&#13;&#10;Num_Zakl=Num_Zakl&#13;&#10;Data_Zakl=Data_Zakl&#13;&#10;VolKontr=VolKontr&#13;&#10;DopInfo=DopInfo&#13;&#10;Name_TT=Name_TT&#13;&#10;VidKontr=VidKontr" Master="ListDSE" SQL.Text="SELECT&#13;&#10;       T_Sert.Key_Sert,&#13;&#10;       T_SertPos.Key_Sert_Pos,&#13;&#10;       T_Sert.VidSert,&#13;&#10;       T_Sert.N_Sert,&#13;&#10;       T_Sert.Date_Sert,&#13;&#10;       T_Sert_Isp.Cod_TT,&#13;&#10;       T_Sert_Attr.Attr,&#13;&#10;       T_Sert_Isp.Key_NaprZakl,&#13;&#10;       T_Sert_Attr.Key_Sert_Attr,&#13;&#10;       T_Sert_Rez.Attr_Val,&#13;&#10;       Pr_NaprZakl.Key_Zakl,&#13;&#10;       Pr_NaprZakl.Vid_Zakl,&#13;&#10;       Pr_NaprZakl.Num_Zakl,&#13;&#10;       Pr_NaprZakl.Data_Zakl,&#13;&#10;       Pr_NaprZakl.VolKontr,&#13;&#10;       Pr_NaprZakl.DopInfo,&#13;&#10;       T_Sert_Isp.Key_Isp,&#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       T_TechTreb.VidKontr&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;       T_Sert&#13;&#10;       INNER JOIN T_SertPos&#13;&#10;               ON T_SertPos.Key_Sert = T_Sert.Key_Sert&#13;&#10;&#13;&#10;       INNER JOIN T_Sert_Isp&#13;&#10;               ON T_Sert_Isp.Key_Sert_Pos = T_SertPos.Key_Sert_Pos&#13;&#10;       INNER JOIN T_TechTreb&#13;&#10;               ON T_TechTreb.Cod_TT=T_Sert_Isp.Cod_TT&#13;&#10;&#13;&#10;       LEFT JOIN T_Sert_Rez&#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez.Key_Isp&#13;&#10;       LEFT JOIN T_Sert_Attr&#13;&#10;               ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr&#13;&#10;&#13;&#10;       LEFT JOIN Pr_VNaprZakl  Pr_NaprZakl&#13;&#10;               ON T_Sert_Isp.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;&#13;&#10;WHERE&#13;&#10;       T_SertPos.Key_Sert_Pos=:Key_Sert_Pos&#13;&#10;       AND (T_Sert_Attr.Key_Sert_Attr IS NULL)&#13;&#10;  AND  exists (select Cod_TT from T_SP_TT WHERE T_SP_TT.Key_SP=:Key_SP AND   T_SP_TT.Cod_TT LIKE T_Sert_Isp.Cod_TT+'%')&#13;&#10;&#13;&#10;  AND (&#13;&#10;     ((T_Sert_Isp.Key_NaprZakl is NULL) AND (dbo.Pr_SkipSertData(:PaspMat) = 0 ) AND (isnull(:SkipSert,0)=0))&#13;&#10;&#13;&#10;  OR ((T_Sert_Isp.Key_NaprZakl in (SELECT Key_NaprZakl FROM Pr_NaprZakl WHERE Key_Pasport=:Key_Pasport))AND(isnull(:SkipSert,0)=0))&#13;&#10;  OR (T_Sert_Isp.Key_NaprZakl in (SELECT Key_NaprZakl FROM Pr_NaprZakl WHERE Key_Pasport=:PaspMat))&#13;&#10;  )&#13;&#10;  AND T_Sert_Isp.Cod_TT not in ('201', '206', '211', '212', '231', '232', '241')&#13;&#10;&#13;&#10;ORDER BY&#13;&#10;&#13;&#10;       T_Sert.Key_Sert,&#13;&#10;       T_Sert.VidSert,&#13;&#10;       T_Sert.N_Sert,&#13;&#10;       T_Sert.Date_Sert,&#13;&#10;       T_Sert_Isp.Key_NaprZakl" PropData=""/>
    <TfrxERQuery Name="AdXIMQry" UserName="AdXIMQry" CloseDataSource="True" FieldAliases.Text="Key_Sert_Pos=Key_Sert_Pos&#13;&#10;Name_Elem=Name_Elem&#13;&#10;Val_Str=Val_Str&#13;&#10;Cod_TT=Cod_TT" Master="ListDSE" SQL.Text="SELECT&#13;&#10;       T_Sert_Isp.Key_Sert_Pos,&#13;&#10;       T_Sert_Attr.Attr Name_Elem,&#13;&#10;       T_Sert_Rez.Attr_Val Val_Str,&#13;&#10;       T_Sert_Isp.Cod_TT&#13;&#10;FROM&#13;&#10;       T_Sert_Isp&#13;&#10;       INNER JOIN T_Sert_Rez&#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez.Key_Isp&#13;&#10;       INNER JOIN T_Sert_Attr&#13;&#10;               ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr&#13;&#10;WHERE&#13;&#10;           T_Sert_Isp.Key_Sert_Pos=:Key_Sert_Pos&#13;&#10;       AND (T_Sert_Isp.Cod_TT = '101')&#13;&#10;       AND   T_Sert_Attr.Attr  not in ('C','Mn','Si','S','P','Cr','Ni','Cu','Mo', 'W','V','Ti', 'Ñîîòâåòñòâóåò')&#13;&#10;       AND T_Sert_Rez.Attr_Val&#60;&#62;'-'" PropData="05704C6566740328010470546F70034C010A506172616D657465727301010C29000000204E616D653D224B65795F536572745F506F73222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrSB" Description="Ñáîðêà" UserName="ÑâðÑÁ" CloseDataSource="False" FieldAliases.Text="Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;OrderCod_Predm=OrderCod_Predm&#13;&#10;Key_Pasport=Key_Pasport&#13;&#10;Cod_Pasp=Cod_Pasp&#13;&#10;Cod_TP=Cod_TP&#13;&#10;ZavNumFrom=ZavNumFrom&#13;&#10;ZavNumTo=ZavNumTo&#13;&#10;Key_PrSvr=Key_PrSvr&#13;&#10;Key_Svr=Key_Svr&#13;&#10;CatSvr=CatSvr&#13;&#10;NumSvr=NumSvr&#13;&#10;OrderNumSvr=OrderNumSvr&#13;&#10;AdNumSvr=AdNumSvr&#13;&#10;OrderAdNumSvr=OrderAdNumSvr&#13;&#10;Kolvo=Kolvo&#13;&#10;Key_Sposob=Key_Sposob&#13;&#10;SposobSvr=SposobSvr&#13;&#10;T_Met=T_Met&#13;&#10;T_Okr=T_Okr&#13;&#10;DateSvr=DateSvr&#13;&#10;EndDateSvr=EndDateSvr&#13;&#10;Key_Sub_Ver_Svr=Key_Sub_Ver_Svr&#13;&#10;Name_Sub_Svr=Name_Sub_Svr&#13;&#10;Kleimo=Kleimo&#13;&#10;Key_DT1=Key_DT1&#13;&#10;Cod_Predm1=Cod_Predm1&#13;&#10;Name_Predm1=Name_Predm1&#13;&#10;Key_DT2=Key_DT2&#13;&#10;Cod_Predm2=Cod_Predm2&#13;&#10;Name_Predm2=Name_Predm2&#13;&#10;Key_TP=Key_TP&#13;&#10;Cod_SvrTP=Cod_SvrTP" Master="MainFrxDS" SQL.Text="SELECT&#13;&#10;-- Ñáîðêà-----------------------&#13;&#10;  T_VPredm.Cod_Predm Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm Name_Predm,&#13;&#10;  T_VPredm.OrderCod_Predm OrderCod_Predm,&#13;&#10;&#13;&#10;-- Ïàñïîðò&#13;&#10;  Pr_Svr.Key_Pasport Key_Pasport,&#13;&#10;  Pr_Pasp.Cod_Pasp Cod_Pasp,&#13;&#10;&#13;&#10;--Ñáîðî÷íûé òåõïðîöåññ&#13;&#10;  T_TP.Cod_TP Cod_TP,&#13;&#10;&#13;&#10;-- Çàâîäñêèå íîìåðà èçäåëèÿ&#13;&#10;  Pr_Svr.ZavNumFrom ZavNumFrom,&#13;&#10;  Pr_Svr.ZavNumTo ZavNumTo,&#13;&#10;&#13;&#10;&#13;&#10;-- Ñâàðíîé øîâ&#13;&#10;  Pr_Svr.Key_PrSvr Key_PrSvr,&#13;&#10;  Pr_Svr.Key_Svr Key_Svr,&#13;&#10;&#13;&#10;  T_Svr.CatSvr,&#13;&#10;&#13;&#10;  T_Svr.NumSvr NumSvr,&#13;&#10;  dbo.T_OrderSortam(T_Svr.NumSvr)      OrderNumSvr,&#13;&#10;  Pr_Svr.AdNumSvr AdNumSvr,&#13;&#10;  dbo.T_OrderSortam(Pr_Svr.AdNumSvr)   OrderAdNumSvr,&#13;&#10;  Pr_Svr.Kolvo Kolvo,                          --Êîëè÷åñòâî øâîâ íà èçäåëèå&#13;&#10;&#13;&#10;  Pr_Svr.Key_Sposob,&#13;&#10;  T_SvrSposob.SposobSvr,&#13;&#10;  Pr_Svr.T_Met,&#13;&#10;  Pr_Svr.T_Okr,&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Svr.DateSvr  DateSvr,&#13;&#10;  Pr_Svr.EndDateSvr,&#13;&#10;&#13;&#10;  Pr_Svr.Key_Sub_Ver_Svr,&#13;&#10;  S_Subjects_Svr.Name_Sub AS Name_Sub_Svr,&#13;&#10;  dbo.S_GegSubVerAtrib(Pr_Svr.Key_Sub_Ver_Svr, 10) Kleimo,&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Svr.Key_DT1,&#13;&#10;  T_VPredm1.Cod_Predm Cod_Predm1,&#13;&#10;  T_VPredm1.Name_Predm Name_Predm1,&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Svr.Key_DT2,&#13;&#10;  T_VPredm2.Cod_Predm Cod_Predm2,&#13;&#10;  T_VPredm2.Name_Predm Name_Predm2,&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Svr.Key_TP,&#13;&#10;  T_SvrTP.Cod_TP  Cod_SvrTP&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ                                  -- áåðåì  âñþ ÂÊÇ íà èçäåëèå&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet                        -- ñìîòðèì äëÿ íåå êàêèå åñòü ïàñïîðòà&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;&#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport = PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN Pr_Svr                            -- Áåðåì ñâàðíûå øâû&#13;&#10;    ON Pr_Pasp.Key_Pasport = Pr_Svr.Key_Pasport&#13;&#10;&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm                          -- Ýòî ñìîòðèì ÷òî çà ÄÑÅ&#13;&#10;    ON T_VPredm.Key_Predm = Pr_Pasp.Key_Predm&#13;&#10;  INNER JOIN T_TP                              -- Ýòî ñáîðî÷íûé ÒÏ&#13;&#10;    ON T_TP.Key_TP = Pr_Pasp.Key_TP&#13;&#10;  INNER JOIN T_Svr                             -- Ýòî áåðåì øîâ&#13;&#10;    ON T_Svr.Key_Svr = Pr_Svr.Key_Svr&#13;&#10;&#13;&#10;  LEFT JOIN dbo.T_SvrSposob T_SvrSposob        -- Ñìîòðèì êàêèì ñïîñîáîì âàðèëè&#13;&#10;    ON T_SvrSposob.Key_Sposob= Pr_Svr.Key_Sposob&#13;&#10;&#13;&#10;  LEFT JOIN T_TP  T_SvrTP&#13;&#10;    ON T_SvrTP.Key_TP = Pr_Svr.Key_TP          -- Ýòî ñâàðî÷íûé ÒÏ&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp Pr_Pasp1                   -- Ýòî ñìîòðèì ïàñïîðò 1-é äåòàëè&#13;&#10;    ON Pr_Pasp1.Key_Pasport = Pr_Svr.Key_DT1&#13;&#10;  LEFT JOIN T_VPredm T_VPredm1                 -- Ýòî 1-ÿ äåòàëü&#13;&#10;    ON T_VPredm1.Key_Predm = Pr_Pasp1.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp Pr_Pasp2                   -- Ïàñïîðò 2-é äåòàëè&#13;&#10;    ON Pr_Pasp2.Key_Pasport = Pr_Svr.Key_DT2&#13;&#10;  LEFT JOIN T_VPredm T_VPredm2                 -- 2-ÿ äåòàëü&#13;&#10;    ON T_VPredm2.Key_Predm = Pr_Pasp2.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Svr             -- Ñâàðùèê&#13;&#10;    ON S_SubVer_Svr.Key_Sub_Ver = Pr_Svr.Key_Sub_Ver_Svr&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Svr&#13;&#10;    ON S_SubVer_Svr.Key_Sub = S_Subjects_Svr.Key_Sub&#13;&#10;&#13;&#10;WHERE&#13;&#10;  P_VKZ.Key_VKZ_Izdel=:Key_VKZ&#13;&#10;  AND dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Svr.Key_Pasport ) &#62; 0&#13;&#10;  AND dbo.Pr_ZavNumInIzdel(:Key_VKZ_Izdel, :Num_Izdel , PR_Svr.Key_Pasport , Pr_Svr.ZavNumFrom, Pr_Svr.ZavNumTo ) &#62; 0&#13;&#10;  AND T_Svr.InTB2=1&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY OrderNumSvr, T_VPredm.OrderCod_Predm" PropData=""/>
    <TfrxERQuery Name="DopIspQRY" UserName="ÄîïÈñï" CloseDataSource="True" FieldAliases.Text="" Master="SvrSB" SQL.Text="SELECT&#13;&#10;       Pr_Svr.Key_Pasport,&#13;&#10;       Pr_Svr.Key_Svr,&#13;&#10;       Pr_Napr.Num_Napr,&#13;&#10;       Pr_Napr.Data_Napr,&#13;&#10;       T_TechTreb.VidKontr,&#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       Pr_Zakl.Num_Zakl,&#13;&#10;       Pr_Zakl.Data_Zakl,&#13;&#10;       Pr_Zakl.Vid_Zakl,&#13;&#10;       Pr_NaprZakl.VolKontr&#13;&#10;FROM&#13;&#10;       Pr_Svr&#13;&#10;       INNER JOIN Pr_NaprSvr&#13;&#10;               ON Pr_Svr.Key_PrSvr = Pr_NaprSvr.Key_PrSvr&#13;&#10;       INNER JOIN Pr_NaprZakl&#13;&#10;               ON Pr_NaprSvr.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;       INNER JOIN T_TechTreb&#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;       INNER JOIN Pr_Napr&#13;&#10;               ON Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;       INNER JOIN  Pr_Zakl&#13;&#10;               ON Pr_NaprZakl.Key_Zakl = Pr_Zakl.Key_Zakl&#13;&#10;--       INNER JOIN T_Svr&#13;&#10;--               ON T_Svr.Key_Svr=Pr_Svr.Key_Svr&#13;&#10;       INNER JOIN T_SvrTT&#13;&#10;               ON T_SvrTT.Key_Svr=Pr_Svr.Key_Svr&#13;&#10;               AND T_SvrTT.Cod_TT=Pr_NaprZakl.Cod_TT&#13;&#10;WHERE&#13;&#10;       Pr_Svr.Key_PrSvr=:Key_PrSvr&#13;&#10;&#13;&#10;  AND dbo.Pr_ZavNumInIzdel(:Key_VKZ_Izdel, :Num_Izdel , PR_Svr.Key_Pasport , Pr_NaprZakl.ZavNumFrom, Pr_NaprZakl.ZavNumTo ) &#62; 0&#13;&#10;&#13;&#10;    --   AND T_TechTreb.Cod_TT not in ('201', '206', '211')&#13;&#10;ORDER BY  Pr_NaprZakl.Cod_TT, Pr_Zakl.Data_Zakl" PropData=""/>
    <TfrxMemoView Name="Memo21" Left="36" Top="212" Width="316" Height="96" DisplayFormat.DecimalSeparator="," Font.Charset="1" Font.Color="-16777208" Font.Height="-13" Font.Name="Arial" Font.Style="0" Frame.Typ="15" HAlign="haRight" ParentFont="False" Wysiwyg="False" VAlign="vaBottom" Text="Ð§Ð°ÑÑ‚ÑŒ 4"/>
    <TfrxERQuery Name="TOQry" UserName="ÒÎÄÒ" CloseDataSource="False" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Key_SP=Key_SP&#13;&#10;Key_TP=Key_TP&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;OrderCod_Predm=OrderCod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;KolvoDet=KolvoDet&#13;&#10;SkipSert=SkipSert&#13;&#10;Name_FMat=Name_FMat&#13;&#10;Sortam_FMat=Sortam_FMat&#13;&#10;Type_NTD_Sortam_Mat=Type_NTD_Sortam_Mat&#13;&#10;Name_NTD_Sortam_Mat=Name_NTD_Sortam_Mat&#13;&#10;Marka_FMat=Marka_FMat&#13;&#10;MarkaPrn_FMat=MarkaPrn_FMat&#13;&#10;Type_NTD_Marka_Mat=Type_NTD_Marka_Mat&#13;&#10;Name_NTD_Marka_Mat=Name_NTD_Marka_Mat&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;PaspMat=PaspMat&#13;&#10;Key_Zakl=Key_Zakl&#13;&#10;Vid_Zakl=Vid_Zakl&#13;&#10;Num_Zakl=Num_Zakl&#13;&#10;Data_Zakl=Data_Zakl" Master="MainFrxDS" SQL.Text="SELECT DISTINCT&#13;&#10;&#13;&#10;  PR_Pasp.Key_Pasport,&#13;&#10;  PR_Pasp.Key_SP,&#13;&#10;  PR_Pasp.Key_TP,&#13;&#10;&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.OrderCod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam,&#13;&#10;&#13;&#10;  dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport ) KolvoDet,&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  T_TP.SkipSert,&#13;&#10;&#13;&#10;  FMat.Name_Predm      Name_FMat,&#13;&#10;&#13;&#10;  FMat.Sortam          Sortam_FMat,&#13;&#10;  FMat.Type_NTD_Sortam Type_NTD_Sortam_Mat,&#13;&#10;  FMat.Name_NTD_Sortam Name_NTD_Sortam_Mat,&#13;&#10;&#13;&#10;  FMat.Marka           Marka_FMat,&#13;&#10;  FMat.MarkaPrn        MarkaPrn_FMat,&#13;&#10;  FMat.Type_NTD_Marka  Type_NTD_Marka_Mat,&#13;&#10;  FMat.Name_NTD_Marka  Name_NTD_Marka_Mat,&#13;&#10;&#13;&#10;         A_VId_Mat.VidSert,&#13;&#10;         A_VId_Mat.N_Sert,&#13;&#10;         A_VId_Mat.Date_Sert,&#13;&#10;         A_VId_Mat.Key_Pasport PaspMat,                                 &#13;&#10;&#13;&#10;         Pr_Zakl.Key_Zakl,&#13;&#10;         Pr_Zakl.Vid_Zakl,&#13;&#10;         Pr_Zakl.Num_Zakl,&#13;&#10;         Pr_Zakl.Data_Zakl&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ                       -- áåðåì  âñþ ÂÊÇ íà èçäåëèå&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet             -- ñìîòðèì äëÿ íåå êàêèå åñòü ïàñïîðòà&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  INNER JOIN PR_Pasp                -- áåðåì âñå ïàñïîðòà&#13;&#10;    ON  PR_Pasp.Key_Pasport=PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm       -- äàííûå î ñàìèõ ÄÑÅ&#13;&#10;    ON T_Predm.Key_Predm=PR_Pasp.Key_Predm&#13;&#10;  INNER JOIN T_SP                    -- òàêæå ïðîñìàòðèâàåì ñïåöèôèêàöèþ&#13;&#10;    ON T_SP.Key_SP=PR_Pasp.Key_SP&#13;&#10;  INNER JOIN Pr_SP                   -- Íó è ñìîòðèì òîëüêî òî, íà ÷òî åñòü ôàêòè÷åñêèé ìàòåðèàë&#13;&#10;    ON Pr_SP.Key_Pasport=PR_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_SPRows                 -- Èç ôàêòè÷åñêèõ ìàòåðèàëîâ íàñ èíòåðåñóåò òîëüêî òå, êîòîðûå îòíîñÿòñÿ ê îñíîâíûì ìàòåðèàëàì&#13;&#10;    ON  T_SPRows.Key_SPRow=Pr_SP.Key_SPRow&#13;&#10;    AND T_SPRows.SP_Position=0&#13;&#10;  INNER JOIN A_VId_Mat                -- Ýòî ìû ñìîòðèì ìàòåðèàë â èäåíòåôèêàòîðå&#13;&#10;    ON A_VId_Mat.Key_ID_Mat=Pr_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm FMat            -- À ýòî ñîáñòâåííî ãîâîðÿ è åñòü ñàì ìàòåðèàë&#13;&#10;    ON FMat.Key_Predm=A_VId_Mat.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_TP                    -- âûáèðàåì ïàðàìåòðû ÒÏ è ïðîâåðÿåì, ÷òî åãî íàäî âûäàâàòü â ïàñïîðò&#13;&#10;    ON T_TP.Key_TP=PR_Pasp.Key_TP&#13;&#10;    AND T_SP.InTB1=1&#13;&#10;&#13;&#10;  &#13;&#10;&#13;&#10;    INNER JOIN T_Sert_Isp&#13;&#10;       ON T_Sert_Isp.Key_Sert_Pos = A_VId_Mat.Key_Sert_Pos&#13;&#10;       AND  T_Sert_Isp.Cod_TT in ('411','412')                      &#13;&#10;&#13;&#10;    INNER JOIN Pr_VNaprZakl  Pr_NaprZakl&#13;&#10;       ON Pr_NaprZakl.Key_NaprZakl=T_Sert_Isp.Key_NaprZakl&#13;&#10;&#13;&#10;    INNER JOIN dbo.Pr_Zakl Pr_Zakl&#13;&#10;       ON Pr_NaprZakl.Key_Zakl=Pr_Zakl.Key_Zakl&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  P_VKZ.Key_VKZ_Izdel=:Key_VKZ_Izdel&#13;&#10;  AND dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport ) &#62; 0&#13;&#10;&#13;&#10;  &#13;&#10;&#13;&#10;ORDER BY T_Predm.OrderCod_Predm" PropData=""/>
    <TfrxERQuery Name="TermObrab" UserName="Òåðìîîáðàáîòêà" CloseDataSource="True" FieldAliases.Text="" Master="TOQry" SQL.Text="SELECT&#13;&#10;       Pr_Napr.Num_Napr,&#13;&#10;       Pr_Napr.Data_Napr,&#13;&#10;       Pr_Zakl.Vid_Zakl,&#13;&#10;       Pr_Zakl.Num_Zakl,&#13;&#10;       Pr_Zakl.Data_Zakl,&#13;&#10;       Pr_NaprZakl.Key_NaprZakl,&#13;&#10;       T_Sert_Isp.Cod_Isp,&#13;&#10;       T_Sert_Isp.Key_Isp&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  180) Isp180&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  181) Isp181&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  182) Isp182&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  183) Isp183&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  184) Isp184&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  185) Isp185&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  186) Isp186&#13;&#10;       ,dbo.Pr_MechSv  (T_Sert_Isp.Key_Isp,  187) Isp187&#13;&#10;  &#13;&#10;FROM         Pr_Napr&#13;&#10;               INNER JOIN Pr_NaprZakl&#13;&#10;                       ON Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;               INNER JOIN Pr_Zakl&#13;&#10;                       ON Pr_NaprZakl.Key_Zakl = Pr_Zakl.Key_Zakl&#13;&#10;               INNER JOIN T_Sert_Isp&#13;&#10;                       ON Pr_NaprZakl.Key_NaprZakl = T_Sert_Isp.Key_NaprZakl&#13;&#10;&#13;&#10;WHERE   (( PR_NaprZakl.Key_Pasport=:Key_Pasport) or (PR_NaprZakl.Key_Pasport=:PaspMat ))&#13;&#10;&#13;&#10; AND  (Pr_NaprZakl.Cod_TT IN ('411', '412'))&#13;&#10;ORDER BY  Pr_Zakl.Data_Zakl DESC, T_Sert_Isp.Cod_Isp" PropData="05704C6566740324020470546F70034C010A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E2200010C24000000204E616D653D22506173704D6174222044617461547970653D226674556E6B6E6F776E220000"/>
