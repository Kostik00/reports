<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41183,6439494097" ReportOptions.Description.Text="" ReportOptions.Name="Îñòàòîê òðóäîåìêîñòè.fr3 ÂÊÇ ¹ 810-Í02-2005" ReportOptions.LastChange="43218,3680658565" ScriptLanguage="PascalScript" ScriptText.Text="function MySmPercent( P, F :double ):double ;&#13;&#10;begin&#13;&#10;  Result :=0;&#13;&#10;  if  P &#62; 0 then&#13;&#10;    Result := F * 100 / P ;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
  <Datasets>
    <item DataSet="TrudQRY" DataSetName="TrudQRY"/>
    <item DataSet="VKZfrxDS" DataSetName="ÂÊÇ"/>
