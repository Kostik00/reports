        <item FieldName="Cod_Zak" FieldAlias="Cod_Zak" FieldType="fftString" Size="30"/>
        <item FieldName="Expr1" FieldAlias="Expr1" FieldType="fftString" Size="30"/>
        <item FieldName="Cod_TT" FieldAlias="Cod_TT" FieldType="fftString" Size="20"/>
        <item FieldName="VidKontr" FieldAlias="VidKontr" FieldType="fftString" Size="50"/>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldAlias="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="Name_NTD" FieldAlias="Name_NTD" FieldType="fftString" Size="500"/>
