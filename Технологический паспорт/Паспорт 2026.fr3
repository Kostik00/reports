    <TfrxERQuery Name="TPHDR" UserName="Заголовок_ТП" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="104" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  T_TP.Key_TP AS Key_TP,&#13;&#10;  T_SP.Key_SP AS Key_SP,&#13;&#10;  T_SP.SP_Version AS SP_Version,&#13;&#10;  T_Predm.Cod_Predm AS Cod_Predm,&#13;&#10;  T_SnPredm.Name_Predm AS Name_Predm,&#13;&#10;  T_TP.TP_Version AS TP_Version,&#13;&#10;  T_TP.Cod_TP AS Cod_TP,&#13;&#10;  T_TP.Cod_KTP AS Cod_KTP,&#13;&#10;  T_TP.DopInfo DopInfo,&#13;&#10;  T_Predm.Cod_Prin Cod_Prin,                                      &#13;&#10;&#13;&#10;  T_TP.UseInPasp,&#13;&#10;  T_TP.SkipSert,&#13;&#10;&#13;&#10;  dbo.S_GegSubVerAtrib(T_TP.Key_Sub_Ver_Razrab,9) RazrabD,&#13;&#10;  dbo.S_GegSubVerAtrib(T_TP.Key_Sub_Ver_Prov,9) ProvD,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Razrab,&#13;&#10;  S_Subjects_Razrab.Name_Sub AS Name_Sub_Razrab,&#13;&#10;  T_TP.Razrab_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Prov,&#13;&#10;  S_Subjects_Prov.Name_Sub AS Name_Sub_Prov,&#13;&#10;  T_TP.Prov_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_NKontr,&#13;&#10;  S_Subjects_NKontr.Name_Sub AS Name_Sub_NKontr,&#13;&#10;  T_TP.NKontr_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Utv,&#13;&#10;  S_Subjects_Utv.Name_Sub AS Name_Sub_Utv,&#13;&#10;  T_TP.Utv_Date,&#13;&#10;&#13;&#10;  T_TP.Key_Sub_Ver_Norm,&#13;&#10;  S_Subjects_Norm.Name_Sub AS Name_Sub_Norm,&#13;&#10;  T_TP.Norm_Date&#13;&#10;&#13;&#10;FROM&#13;&#10;--  Gr_VxodGr Gr_VxodGr&#13;&#10;--  INNER JOIN Gr_VxodPredm Gr_VxodPredm ON Gr_VxodPredm.Key_VidGr = Gr_VxodGr.Key_VidGr AND Gr_VxodPredm.Cod_Gr = Gr_VxodGr.Cod_Gr&#13;&#10;--  INNER JOIN&#13;&#10;  T_Predm T_Predm&#13;&#10;--  ON T_Predm.Key_Predm = Gr_VxodPredm.Key_Predm&#13;&#10;  INNER JOIN T_SnPredm T_SnPredm ON T_SnPredm.Key_SnPredm = T_Predm.Key_SnPredm&#13;&#10;  INNER JOIN T_Prinadl ON T_Predm.Cod_Prin = T_Prinadl.Cod_Prin&#13;&#10;  INNER JOIN T_SP ON T_Predm.Key_Predm = T_SP.Key_Predm&#13;&#10;  INNER JOIN T_TP ON T_SP.Key_SP = T_TP.Key_SP&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub_Ver = T_TP.Key_Sub_Ver_Razrab&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Razrab&#13;&#10;    ON S_SubVer_Razrab.Key_Sub = S_Subjects_Razrab.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub_Ver = T_TP.Key_Sub_Ver_Prov&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub = S_Subjects_Prov.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_NKontr&#13;&#10;    ON S_SubVer_NKontr.Key_Sub_Ver = T_TP.Key_Sub_Ver_NKontr&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_NKontr&#13;&#10;    ON S_SubVer_NKontr.Key_Sub = S_Subjects_NKontr.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub_Ver = T_TP.Key_Sub_Ver_Utv&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Utv&#13;&#10;    ON S_SubVer_Utv.Key_Sub = S_Subjects_Utv.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Norm&#13;&#10;    ON S_SubVer_Norm.Key_Sub_Ver = T_TP.Key_Sub_Ver_Norm&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Norm&#13;&#10;    ON S_SubVer_Norm.Key_Sub = S_Subjects_Norm.Key_Sub&#13;&#10;&#13;&#10;WHERE&#13;&#10;  T_TP.Key_TP=:Key_TP">
      <FieldDefs>
        <item FieldName="Key_TP" FieldAlias="Key_TP"/>
        <item FieldName="Key_SP" FieldAlias="Key_SP"/>
        <item FieldName="SP_Version" FieldAlias="SP_Version"/>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
