        <item FieldName="Name_NTD_Sortam" FieldAlias="Name_NTD_Sortam" FieldType="fftString" Size="254"/>
        <item FieldName="Marka" FieldAlias="Marka" FieldType="fftString" Size="150"/>
        <item FieldName="Type_NTD_Marka" FieldAlias="Type_NTD_Marka" FieldType="fftString"/>
        <item FieldName="Name_NTD_Marka" FieldAlias="Name_NTD_Marka" FieldType="fftString" Size="254"/>
        <item FieldName="TTSert" FieldAlias="TTSert" FieldType="fftString" Size="100"/>
        <item FieldName="TTZap" FieldAlias="TTZap" FieldType="fftString" Size="100"/>
        <item FieldName="TTPr" FieldAlias="TTPr" FieldType="fftString" Size="100"/>
        <item FieldName="InTB1"/>
