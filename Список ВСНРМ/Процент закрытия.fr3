<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="�� ���������" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="������� ��������.fr3 ������ �����" ReportOptions.LastChange="41666,7083026852" ScriptLanguage="PascalScript" ScriptText.Text="//Test&#13;&#10;&#13;&#10;function Percent1:double;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;  if ( &#60;WSNRMQry.&#34;CntPosOM&#34;&#62; &#62; 0 ) then&#13;&#10;  Result := 100*&#60;WSNRMQry.&#34;CntPosOMR&#34;&#62; / &#60;WSNRMQry.&#34;CntPosOM&#34;&#62;;                                                &#13;&#10;end;          &#13;&#10;&#13;&#10;function Percent2:double;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;  if ( &#60;WSNRMQry.&#34;CntPosP&#34;&#62; &#62; 0 ) then&#13;&#10;  Result := 100*&#60;WSNRMQry.&#34;CntPosPR&#34;&#62; / &#60;WSNRMQry.&#34;CntPosP&#34;&#62;;                                                &#13;&#10;end;          &#13;&#10;  &#13;&#10;      &#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2900000020446174615365743D224D61696E46727844532220446174615365744E616D653D224D61696E44532200010C2A00000020446174615365743D2257534E524D5172792220446174615365744E616D653D2257534E524D517279220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="WSNRMQry" UserName="WSNRMQry" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     P_WSNRM.Key_WSNRM, P_WSNRM.Cod_WSNRM, P_WSNRM.Name_WSNRM, T_VPredm.Cod_Predm, P_VKZ.Kolvo, P_VKZ.Cod_Zak, T_VPredm.Name_Predm, &#13;&#10;                      T_VPredm.OrderCod_Predm, T1.CntPosOM, T2.CntPosP, T3.CntPos, T4.CntPosOMR, T5.CntPosPR                                                    &#13;&#10;FROM         P_WSNRM INNER JOIN&#13;&#10;                      P_WSNRM_Izdel ON P_WSNRM.Key_WSNRM = P_WSNRM_Izdel.Key_WSNRM INNER JOIN&#13;&#10;                      P_VKZ ON P_WSNRM_Izdel.Key_VKZ = P_VKZ.Key_VKZ INNER JOIN&#13;&#10;                      T_VPredm ON P_VKZ.Key_Predm = T_VPredm.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;SELECT     P_VMZ.Key_WSNRM, COUNT(P_VMZ.Key_VMZ) AS CntPosOM    &#13;&#10;FROM         P_VMZ INNER JOIN&#13;&#10;                      T_SPRows ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;WHERE     (T_SPRows.SP_position = 0)&#13;&#10;GROUP BY P_VMZ.Key_WSNRM&#13;&#10;  &#13;&#10;) T1       &#13;&#10;ON T1.Key_WSNRM = P_WSNRM.Key_WSNRM                                           &#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;SELECT     P_VMZ.Key_WSNRM, COUNT(P_VMZ.Key_VMZ) AS CntPosP  &#13;&#10;FROM         P_VMZ INNER JOIN&#13;&#10;                      T_SPRows ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;WHERE     (T_SPRows.SP_position &#60;&#62; 0)&#13;&#10;GROUP BY P_VMZ.Key_WSNRM&#13;&#10;  &#13;&#10;) T2       &#13;&#10;ON T2.Key_WSNRM = P_WSNRM.Key_WSNRM  &#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;SELECT     P_VMZ.Key_WSNRM, COUNT(P_VMZ.Key_VMZ) AS CntPos  &#13;&#10;FROM         P_VMZ INNER JOIN&#13;&#10;                      T_SPRows ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;GROUP BY P_VMZ.Key_WSNRM&#13;&#10;  &#13;&#10;) T3       &#13;&#10;ON T3.Key_WSNRM = P_WSNRM.Key_WSNRM&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;SELECT     P_VMZ.Key_WSNRM, COUNT(P_VMZ.Key_VMZ) AS CntPosOMR    &#13;&#10;FROM         &#13;&#10;	P_VMZ &#13;&#10;	INNER JOIN T_SPRows &#13;&#10;		ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;	LEFT JOIN&#13;&#10;	(&#13;&#10;	SELECT     Key_VMZ, SUM(KolDT) AS Rezerv&#13;&#10;	FROM         A_Rezerv&#13;&#10;	GROUP BY Key_VMZ&#13;&#10;	) T01&#13;&#10;	ON T01.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;WHERE     (T_SPRows.SP_position = 0)&#13;&#10;	AND T01.Rezerv &#62;= P_VMZ.KolDSE&#13;&#10;GROUP BY P_VMZ.Key_WSNRM&#13;&#10;  &#13;&#10;) T4       &#13;&#10;ON T4.Key_WSNRM = P_WSNRM.Key_WSNRM    &#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;SELECT     P_VMZ.Key_WSNRM, COUNT(P_VMZ.Key_VMZ) AS CntPosPR    &#13;&#10;FROM         &#13;&#10;	P_VMZ &#13;&#10;	INNER JOIN T_SPRows &#13;&#10;		ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;	LEFT JOIN&#13;&#10;	(&#13;&#10;	SELECT     Key_VMZ, SUM(KolDT) AS Rezerv&#13;&#10;	FROM         A_Rezerv&#13;&#10;	GROUP BY Key_VMZ&#13;&#10;	) T01&#13;&#10;	ON T01.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;WHERE     (T_SPRows.SP_position &#60;&#62; 0)&#13;&#10;	AND T01.Rezerv &#62;= P_VMZ.KolDSE&#13;&#10;GROUP BY P_VMZ.Key_WSNRM&#13;&#10;  &#13;&#10;) T5       &#13;&#10;ON T5.Key_WSNRM = P_WSNRM.Key_WSNRM  &#13;&#10;&#13;&#10;&#13;&#10;   &#13;&#10;WHERE     (P_VKZ.Cod_SosZ = '�')&#13;&#10;ORDER BY P_VKZ.Cod_Zak, T_VPredm.OrderCod_Predm                                                           " PropData="05704C656674023C0470546F7002280A506172616D65746572730100"/>
  </TfrxDataPage>
