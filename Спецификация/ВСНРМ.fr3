    <TfrxERQuery Name="Primen" UserName="Примен" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="WSNRMQRY" Left="124" Top="20" IgnoreDupParams="False" SQL.Text="SET NOCOUNT ON&#13;&#10;   if object_id(N&#39;tempdb..#Tmp_Str_Sostav&#39;) is  null&#13;&#10;   BEGIN&#13;&#10;       CREATE TABLE #Tmp_Str_Sostav (&#13;&#10;               Key_STRSW integer identity(1,1),  -- ID&#13;&#10;               Key_STRSW_Master integer,         -- ID строчки предыдущего уровня&#13;&#10;               Key_STRSW_Master1 integer,        -- ID строчки верхнего уровня &#13;&#10;               Key_Master integer,               -- Key_Predm предыдущего уровня  &#13;&#10;               Key_Master1 integer,              -- Key_Predm верхнего уровня  &#13;&#10;               Key_Predm integer,                -- Сама деталь(материал)&#13;&#10;               Key_SP integer null,              -- СП (из чего состоит) ДСЕ&#13;&#10;               Key_SPRow integer NULL,           -- ИД записи в спецификации&#13;&#10;               KolvoMaster float,                -- Количество мастер сборок&#13;&#10;               KolvoMaster1 float,               -- Количество мастер сборок на 1 изделие&#13;&#10;               Kolvo  float,                     -- Количество  нормативное на 1 СБ&#13;&#10;               KolvoSm float,                    -- Количество через сборку на @Kolvo изделий&#13;&#10;               KolvoSm1 float,                   -- Количество через сборку на 1 изделие&#13;&#10;               Cod_Ed_Izm varchar(3),            -- ед. изм&#13;&#10;               Lvl integer,                      -- уровень вложености&#13;&#10;               OrderID varbinary(80)             -- ДЛЯ СОРТИРОВКИ (не возвращается)&#13;&#10;               , MassSm float null               -- для расчета веса&#13;&#10;       )&#13;&#10;   END&#13;&#10;SET NOCOUNT OFF&#13;&#10;&#13;&#10;&#13;&#10;SELECT T_Predm.Cod_Predm, Primen.Kolvo, SUM(Primen.KolvoSm) KolvoSm, SUM(Primen.KolvoSm1) KolvoSm1&#13;&#10;&#13;&#10;FROM&#13;&#10;    #Tmp_Str_Sostav Primen&#13;&#10;     INNER JOIN T_Predm&#13;&#10;      ON T_Predm.Key_Predm=Primen.Key_Master&#13;&#10;&#13;&#10;WHERE Primen.Key_Predm=:Key_Predm_Master&#13;&#10;GROUP BY&#13;&#10;  T_Predm.Cod_Predm, Primen.Kolvo">
      <FieldDefs>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Kolvo" FieldAlias="Kolvo"/>
        <item FieldName="KolvoSm" FieldAlias="KolvoSm"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Predm_Master" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="TMPTBL" UserName="TMPTBL" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Left="188" Top="20" IgnoreDupParams="False" SQL.Text="SET NOCOUNT ON&#13;&#10;       if object_id(N&#39;tempdb..#Tmp_Str_Sostav&#39;) is not  null&#13;&#10;       DROP TABLE  #Tmp_Str_Sostav&#13;&#10;&#13;&#10;       CREATE TABLE #Tmp_Str_Sostav (&#13;&#10;               Key_STRSW integer identity(1,1),  -- ID&#13;&#10;               Key_STRSW_Master integer,         -- ID строчки предыдущего уровня&#13;&#10;               Key_STRSW_Master1 integer,        -- ID строчки верхнего уровня &#13;&#10;               Key_Master integer,               -- Key_Predm предыдущего уровня  &#13;&#10;               Key_Master1 integer,              -- Key_Predm верхнего уровня  &#13;&#10;               Key_Predm integer,                -- Сама деталь(материал)&#13;&#10;               Key_SP integer null,              -- СП (из чего состоит) ДСЕ&#13;&#10;               Key_SPRow integer NULL,           -- ИД записи в спецификации&#13;&#10;               KolvoMaster float,                -- Количество мастер сборок&#13;&#10;               KolvoMaster1 float,               -- Количество мастер сборок на 1 изделие&#13;&#10;               Kolvo  float,                     -- Количество  нормативное на 1 СБ&#13;&#10;               KolvoSm float,                    -- Количество через сборку на @Kolvo изделий&#13;&#10;               KolvoSm1 float,                   -- Количество через сборку на 1 изделие&#13;&#10;               Cod_Ed_Izm varchar(3),            -- ед. изм&#13;&#10;               Lvl integer,                      -- уровень вложености&#13;&#10;               OrderID varbinary(80)             -- ДЛЯ СОРТИРОВКИ (не возвращается)&#13;&#10;               , MassSm float null               -- для расчета веса&#13;&#10;       )&#13;&#10;&#13;&#10;SET NOCOUNT OFF&#13;&#10;SELECT GetDate() AS Date">
      <FieldDefs>
        <item FieldName="Date" FieldType="fftDateTime"/>
      </FieldDefs>
    </TfrxERQuery>
    <TfrxERQuery Name="SmNRMQRY" UserName="СМНРМ" CloseDataSource="False" BCDToCurrency="False" DataSetOptions="0" Left="60" Top="148" IgnoreDupParams="False" SQL.Text="EXEC &#13;&#10;T_SW_NRM&#13;&#10;     @Key_SP= :Key_SP,&#13;&#10;     @Kolvo=:Kolvo, &#13;&#10;     @PrintRazdel = :PrintRazdel                       ">
