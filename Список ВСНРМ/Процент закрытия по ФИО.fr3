<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="�� ���������" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="������� �������� �� ���.fr3 ������ �����" ReportOptions.LastChange="43353,602322037" ScriptLanguage="PascalScript" ScriptText.Text="USES 'CommonRU.pas';&#13;&#10;&#13;&#10;&#13;&#10;//Test&#13;&#10;{&#13;&#10;function Percent1:double;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;  if ( &#60;WSNRMQry.&#34;CntPosOM&#34;&#62; &#62; 0 ) then&#13;&#10;  Result := 100*&#60;WSNRMQry.&#34;CntPosOMR&#34;&#62; / &#60;WSNRMQry.&#34;CntPosOM&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;function Percent001:double;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;  if ( &#60;WSNRMQry.&#34;CntPosOM&#34;&#62; &#62; 0 ) then&#13;&#10;  Result := 100*(&#60;WSNRMQry.&#34;CntPosOM&#34;&#62; - &#60;WSNRMQry.&#34;CntPosOMNZPR&#34;&#62; - &#60;WSNRMQry.&#34;CntPosOMNZRQ&#34;&#62;) / &#60;WSNRMQry.&#34;CntPosOM&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function Percent2:double;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;  if ( &#60;WSNRMQry.&#34;CntPosPrR&#34;&#62; &#62; 0 ) then&#13;&#10;  Result := 100*&#60;WSNRMQry.&#34;CntPosPrR&#34;&#62; / &#60;WSNRMQry.&#34;CntPosPr&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;function FnPercent(Cnt1,Cnt2:double):double;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;  if ( Cnt2 &#62; 0 ) then&#13;&#10;  Result := 100*Cnt1 / Cnt2;&#13;&#10;end;&#13;&#10;}&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
  <Datasets>
    <item DataSet="MainFrxDS" DataSetName="MainDS"/>
    <item DataSet="WSNRMQry" DataSetName="WSNRMQry"/>
  </Datasets>
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="WSNRMQry" UserName="WSNRMQry" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;	S_Subjects.Name_Sub,&#13;&#10;	TALL.Key_Sub,&#13;&#10;&#13;&#10;	P_WSNRM.Key_WSNRM, &#13;&#10;	P_WSNRM.Cod_WSNRM, &#13;&#10;	P_WSNRM.Name_WSNRM, &#13;&#10;	P_WSNRM_Izdel.Key_VKZ,&#13;&#10;	T_VPredm.Cod_Predm,&#13;&#10; T_VPredm.Name_Predm,                                                     &#13;&#10;	P_VKZ.Kolvo, &#13;&#10;	P_VKZ.Cod_Zak,&#13;&#10;&#13;&#10; P_VKZ.DataVip,                  &#13;&#10;  &#13;&#10;	T_VPredm.Name_Predm, &#13;&#10;	T_VPredm.OrderCod_Predm,&#13;&#10;&#13;&#10;&#13;&#10;	TALL.CntAllPos, &#13;&#10;  &#13;&#10;  &#13;&#10;	TOM.CntPosOM,&#13;&#10;	TOMZap.CntPosOmZap,&#13;&#10;	TOMR.CntPosOMR,&#13;&#10;&#13;&#10;	TOMNZ.CntPosOMNZ,&#13;&#10;	TOMNZR.CntPosOMNZR,&#13;&#10;	TOMNZPR.CntPosOMNZPR,&#13;&#10;	TOMNZRQ.CntPosOMNZRQ&#13;&#10;  &#13;&#10;	&#13;&#10;&#13;&#10;FROM         &#13;&#10;	P_WSNRM &#13;&#10;	INNER JOIN P_WSNRM_Izdel &#13;&#10;		ON P_WSNRM.Key_WSNRM = P_WSNRM_Izdel.Key_WSNRM &#13;&#10;	INNER JOIN P_VKZ &#13;&#10;		ON P_WSNRM_Izdel.Key_VKZ = P_VKZ.Key_VKZ &#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON P_VKZ.Key_Predm = T_VPredm.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;INNER JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntAllPos  &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;			&#13;&#10;&#13;&#10;&#13;&#10;	GROUP BY S_SubVer.Key_Sub,P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;) TALL       &#13;&#10;	ON  TALL.Key_WSNRM = P_WSNRM.Key_WSNRM  &#13;&#10;	AND TALL.Key_VKZ_Izdel = P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;LEFT JOIN S_Subjects&#13;&#10;	ON S_Subjects.Key_Sub = TALL.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntPosOM    &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;--	WHERE     (T_SPRows.SP_position = 0)&#13;&#10;	GROUP BY S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;) TOM             &#13;&#10;ON &#13;&#10;	TOM.Key_WSNRM = P_WSNRM.Key_WSNRM                                           &#13;&#10;	AND TOM.Key_VKZ_Izdel = P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	AND Isnull(TOM.Key_Sub,-1) = Isnull(TALL.Key_Sub,-1)&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntPosOmZap    &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;	WHERE     &#13;&#10;		--(T_SPRows.SP_position = 0) AND &#13;&#10;		(P_VMZ.VMZActive = 0)&#13;&#10;	GROUP BY S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;&#13;&#10;) TOMZap &#13;&#10;	ON	TOMZap.Key_WSNRM		= P_WSNRM.Key_WSNRM  &#13;&#10;	AND TOMZap.Key_VKZ_Izdel	= P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	AND Isnull(TOMZap.Key_Sub,-1) = Isnull(TALL.Key_Sub,-1)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntPosOMR    &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;		LEFT JOIN&#13;&#10;		(&#13;&#10;		SELECT     Key_VMZ, SUM(KolDT) AS Rezerv&#13;&#10;		FROM         A_Rezerv&#13;&#10;		GROUP BY Key_VMZ&#13;&#10;		) T01&#13;&#10;		ON T01.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;	WHERE     &#13;&#10;		--(T_SPRows.SP_position = 0) AND &#13;&#10;		T01.Rezerv &#62;= P_VMZ.KolDSE&#13;&#10;	GROUP BY S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;) TOMR       &#13;&#10;	ON  TOMR.Key_WSNRM = P_WSNRM.Key_WSNRM  &#13;&#10;	AND TOMR.Key_VKZ_Izdel = P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	AND Isnull(TOMR.Key_Sub,-1) = Isnull(TALL.Key_Sub,-1)&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntPosOMNZ    &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;	WHERE     &#13;&#10;		--(T_SPRows.SP_position = 0) AND &#13;&#10;		(P_VMZ.VMZActive=1)&#13;&#10;	GROUP BY S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;) TOMNZ             &#13;&#10;ON &#13;&#10;	TOMNZ.Key_WSNRM = P_WSNRM.Key_WSNRM                                           &#13;&#10;	AND TOMNZ.Key_VKZ_Izdel = P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	AND Isnull(TOMNZ.Key_Sub,-1) = Isnull(TALL.Key_Sub,-1)&#13;&#10;&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntPosOMNZR    &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;		LEFT JOIN&#13;&#10;		(&#13;&#10;		SELECT     Key_VMZ, SUM(KolDT) AS Rezerv&#13;&#10;		FROM         A_Rezerv&#13;&#10;		GROUP BY Key_VMZ&#13;&#10;		) T01&#13;&#10;		ON T01.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;	WHERE     &#13;&#10;		--(T_SPRows.SP_position = 0) AND &#13;&#10;		(P_VMZ.VMZActive=1)&#13;&#10;		AND T01.Rezerv &#62;= P_VMZ.KolDSE&#13;&#10;	GROUP BY S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;) TOMNZR       &#13;&#10;	ON  TOMNZR.Key_WSNRM = P_WSNRM.Key_WSNRM  &#13;&#10;	AND TOMNZR.Key_VKZ_Izdel = P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	AND Isnull(TOMNZR.Key_Sub,-1) = Isnull(TALL.Key_Sub,-1)&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntPosOMNZPR    &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;		LEFT JOIN&#13;&#10;		(&#13;&#10;		SELECT     Key_VMZ, SUM(KolDT) AS Rezerv&#13;&#10;		FROM         A_Rezerv&#13;&#10;		GROUP BY Key_VMZ&#13;&#10;		) T01&#13;&#10;		ON T01.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;	WHERE     &#13;&#10;		--(T_SPRows.SP_position = 0) AND &#13;&#10;		(P_VMZ.VMZActive=1) AND &#13;&#10;		(Isnull(P_VMZ.DatePostav,GetDate()) &#62; GetDate() )&#13;&#10;		AND Isnull(T01.Rezerv,0) &#60; P_VMZ.KolDSE&#13;&#10;	GROUP BY S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;) TOMNZPR       &#13;&#10;	ON  TOMNZPR.Key_WSNRM = P_WSNRM.Key_WSNRM  &#13;&#10;	AND TOMNZPR.Key_VKZ_Izdel = P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	AND Isnull(TOMNZPR.Key_Sub,-1) = Isnull(TALL.Key_Sub,-1)&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(    &#13;&#10;	SELECT     S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, COUNT(P_VMZ.Key_VMZ) AS CntPosOMNZRQ &#13;&#10;	FROM         &#13;&#10;		P_VMZ &#13;&#10;		INNER JOIN P_VKZ_Zap&#13;&#10;			ON P_VKZ_Zap.Key_VKZ_Zap = P_VMZ.Key_VKZ_Zap&#13;&#10;		INNER JOIN T_SPRows &#13;&#10;			ON P_VMZ.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;		LEFT JOIN S_SubVer&#13;&#10;			ON S_SubVer.Key_Sub_Ver = P_VMZ.Key_Sub_Ver&#13;&#10;		LEFT JOIN&#13;&#10;		(&#13;&#10;		SELECT     Key_VMZ, SUM(KolDT) AS Rezerv&#13;&#10;		FROM         A_Rezerv&#13;&#10;		GROUP BY Key_VMZ&#13;&#10;		) T01&#13;&#10;		ON T01.Key_VMZ = P_VMZ.Key_VMZ&#13;&#10;&#13;&#10;&#13;&#10;	WHERE     &#13;&#10;		--(T_SPRows.SP_position = 0) AND &#13;&#10;		(P_VMZ.VMZActive=1) AND (Isnull(P_VMZ.DatePostav,GetDate()) &#60;= GetDate() )&#13;&#10;		AND Isnull(T01.Rezerv,0) &#60; P_VMZ.KolDSE&#13;&#10;	GROUP BY S_SubVer.Key_Sub, P_VMZ.Key_WSNRM, P_VKZ_Zap.Key_VKZ_Izdel, P_VKZ_Zap.Key_VKZ_Izdel&#13;&#10;  &#13;&#10;) TOMNZRQ       &#13;&#10;	ON  TOMNZRQ.Key_WSNRM = P_WSNRM.Key_WSNRM  &#13;&#10;	AND TOMNZRQ.Key_VKZ_Izdel = P_WSNRM_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	AND Isnull(TOMNZRQ.Key_Sub,-1) = Isnull(TALL.Key_Sub,-1)&#13;&#10;&#13;&#10;   &#13;&#10;WHERE           (P_VKZ.Cod_SosZ in ('�', '�'))&#13;&#10;      &#13;&#10;&#13;&#10;ORDER BY S_Subjects.Name_Sub, TALL.Key_Sub, P_VKZ.DataVip, Key_WSNRM, P_VKZ.Cod_Zak, T_VPredm.OrderCod_Predm                                                           " PropData="05704C656674023C0470546F7002280A506172616D65746572730100"/>
  </TfrxDataPage>
