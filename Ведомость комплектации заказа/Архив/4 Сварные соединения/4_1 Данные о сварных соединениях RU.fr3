    <TfrxERQuery Name="SvrSB" Description="Ñáîðêà" UserName="ÑâðÑÁ" CloseDataSource="False" FieldAliases.Text="Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;OrderCod_Predm=OrderCod_Predm&#13;&#10;Key_Pasport=Key_Pasport&#13;&#10;Cod_Pasp=Cod_Pasp&#13;&#10;Cod_TP=Cod_TP&#13;&#10;ZavNumFrom=ZavNumFrom&#13;&#10;ZavNumTo=ZavNumTo&#13;&#10;Key_PrSvr=Key_PrSvr&#13;&#10;Key_Svr=Key_Svr&#13;&#10;CatSvr=CatSvr&#13;&#10;NumSvr=NumSvr&#13;&#10;OrderNumSvr=OrderNumSvr&#13;&#10;AdNumSvr=AdNumSvr&#13;&#10;OrderAdNumSvr=OrderAdNumSvr&#13;&#10;Kolvo=Kolvo&#13;&#10;Key_Sposob=Key_Sposob&#13;&#10;SposobSvr=SposobSvr&#13;&#10;T_Met=T_Met&#13;&#10;T_Okr=T_Okr&#13;&#10;DateSvr=DateSvr&#13;&#10;EndDateSvr=EndDateSvr&#13;&#10;Key_Sub_Ver_Svr=Key_Sub_Ver_Svr&#13;&#10;Name_Sub_Svr=Name_Sub_Svr&#13;&#10;Kleimo=Kleimo&#13;&#10;Key_DT1=Key_DT1&#13;&#10;Cod_Predm1=Cod_Predm1&#13;&#10;Name_Predm1=Name_Predm1&#13;&#10;Key_DT2=Key_DT2&#13;&#10;Cod_Predm2=Cod_Predm2&#13;&#10;Name_Predm2=Name_Predm2&#13;&#10;Key_TP=Key_TP&#13;&#10;Cod_SvrTP=Cod_SvrTP" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT  DISTINCT                &#13;&#10;-- Ñáîðêà-----------------------&#13;&#10;  T_VPredm.Cod_Predm Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm Name_Predm,&#13;&#10;  T_VPredm.OrderCod_Predm OrderCod_Predm,&#13;&#10;&#13;&#10;-- Ïàñïîðò&#13;&#10;  Pr_Svr.Key_Pasport Key_Pasport,&#13;&#10;  Pr_Pasp.Cod_Pasp Cod_Pasp,&#13;&#10;&#13;&#10;--Ñáîðî÷íûé òåõïðîöåññ&#13;&#10;  T_TP.Cod_TP Cod_TP,&#13;&#10;&#13;&#10;-- Çàâîäñêèå íîìåðà èçäåëèÿ&#13;&#10;  Pr_Svr.ZavNumFrom ZavNumFrom,&#13;&#10;  Pr_Svr.ZavNumTo ZavNumTo,&#13;&#10;&#13;&#10;&#13;&#10;-- Ñâàðíîé øîâ&#13;&#10;  Pr_Svr.Key_PrSvr Key_PrSvr,&#13;&#10;  Pr_Svr.Key_Svr Key_Svr,&#13;&#10;&#13;&#10;  T_Svr.CatSvr,&#13;&#10;&#13;&#10;  T_Svr.NumSvrPrn NumSvr,&#13;&#10;  dbo.T_OrderSortam(T_Svr.NumSvr)      OrderNumSvr,&#13;&#10;  Pr_Svr.AdNumSvr AdNumSvr,&#13;&#10;  dbo.T_OrderSortam(Pr_Svr.AdNumSvr)   OrderAdNumSvr,&#13;&#10;  Pr_Svr.Kolvo Kolvo,                          --Êîëè÷åñòâî øâîâ íà èçäåëèå&#13;&#10;&#13;&#10;  Pr_Svr.Key_Sposob,&#13;&#10;  T_SvrSposob.SposobSvr,&#13;&#10;  T_SvrSposob.SpSvr,&#13;&#10;  Pr_Svr.T_Met,&#13;&#10;  Pr_Svr.T_Okr,&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Svr.DateSvr  DateSvr,&#13;&#10;  Pr_Svr.EndDateSvr,&#13;&#10;&#13;&#10;  Pr_Svr.Key_Sub_Ver_Svr,&#13;&#10;  S_Subjects_Svr.Name_Sub AS Name_Sub_Svr,&#13;&#10;  dbo.S_GegSubVerAtrib(Pr_Svr.Key_Sub_Ver_Svr, 10) Kleimo,&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Svr.Key_TP,&#13;&#10;  T_SvrTP.Cod_TP  Cod_SvrTP&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ                                  -- áåðåì  âñþ ÂÊÇ íà èçäåëèå&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet                        -- ñìîòðèì äëÿ íåå êàêèå åñòü ïàñïîðòà&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;&#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;    ON Pr_Pasp.Key_Pasport = PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN Pr_Svr                            -- Áåðåì ñâàðíûå øâû&#13;&#10;    ON Pr_Pasp.Key_Pasport = Pr_Svr.Key_Pasport&#13;&#10;&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm                          -- Ýòî ñìîòðèì ÷òî çà ÄÑÅ&#13;&#10;    ON T_VPredm.Key_Predm = Pr_Pasp.Key_Predm&#13;&#10;  INNER JOIN T_TP                              -- Ýòî ñáîðî÷íûé ÒÏ&#13;&#10;    ON T_TP.Key_TP = Pr_Pasp.Key_TP&#13;&#10;  INNER JOIN T_Svr                             -- Ýòî áåðåì øîâ&#13;&#10;    ON T_Svr.Key_Svr = Pr_Svr.Key_Svr&#13;&#10;&#13;&#10;  LEFT JOIN dbo.T_SvrSposob T_SvrSposob        -- Ñìîòðèì êàêèì ñïîñîáîì âàðèëè&#13;&#10;    ON T_SvrSposob.Key_Sposob= Pr_Svr.Key_Sposob&#13;&#10;&#13;&#10;  LEFT JOIN T_TP  T_SvrTP&#13;&#10;    ON T_SvrTP.Key_TP = Pr_Svr.Key_TP          -- Ýòî ñâàðî÷íûé ÒÏ&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Svr             -- Ñâàðùèê&#13;&#10;    ON S_SubVer_Svr.Key_Sub_Ver = Pr_Svr.Key_Sub_Ver_Svr&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Svr&#13;&#10;    ON S_SubVer_Svr.Key_Sub = S_Subjects_Svr.Key_Sub&#13;&#10;&#13;&#10;WHERE&#13;&#10;  P_VKZ.Key_VKZ_Izdel=:Key_VKZ&#13;&#10;  AND dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Svr.Key_Pasport ) &#62; 0&#13;&#10;  AND dbo.Pr_ZavNumInIzdel(:Key_VKZ_Izdel, :Num_Izdel , PR_Svr.Key_Pasport , Pr_Svr.ZavNumFrom, Pr_Svr.ZavNumTo ) &#62; 0&#13;&#10;  AND T_Svr.InTB2=1&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY  OrderNumSvr, OrderAdNumSvr, Pr_Svr.Key_PrSvr, T_VPredm.OrderCod_Predm" PropData=""/>
    <TfrxERQuery Name="SvrDT" Description="Ñâàðèâàåìûå äåòàëè" UserName="ÑâðÄò" CloseDataSource="True" FieldAliases.Text="Key_Predm=Key_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;PrintFlag=PrintFlag&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;Cod_Prin=Cod_Prin&#13;&#10;Key_PredmMat=Key_PredmMat&#13;&#10;Name_PredmMat=Name_PredmMat&#13;&#10;Marka_Mat=Marka_Mat&#13;&#10;Type_NTD_Marka_Mat=Type_NTD_Marka_Mat&#13;&#10;Name_NTD_Marka_Mat=Name_NTD_Marka_Mat&#13;&#10;Type_NTD_Sortam_Mat=Type_NTD_Sortam_Mat&#13;&#10;Name_NTD_Sortam_Mat=Name_NTD_Sortam_Mat" BCDToCurrency="False" Master="SvrSB" IgnoreDupParams="False" SQL.Text="SELECT  DISTINCT&#13;&#10;&#13;&#10;  T_Predm.Key_Predm            Key_Predm,&#13;&#10;  T_Predm.Cod_Predm            Cod_Predm,&#13;&#10;  T_Predm.Name_Predm           Name_Predm,&#13;&#10;&#13;&#10;  T_Predm.PrintFlag            PrintFlag,&#13;&#10;  T_Predm.Sortam               Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS   Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS   Name_NTD_Sortam,&#13;&#10;  T_Predm.Marka                Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS    Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS    Name_NTD_Marka,&#13;&#10;  T_Predm.Cod_Prin             Cod_Prin,&#13;&#10;&#13;&#10;&#13;&#10;  T_Predm_Mat.Key_Predm Key_PredmMat,                                                                                        &#13;&#10;  T_Predm_Mat.Name_Predm       Name_PredmMat,&#13;&#10;--  T_Predm_Mat.Sortam           Sortam_Mat,&#13;&#10;  T_Predm_Mat.MarkaPrn         Marka_Mat,&#13;&#10;  isnull(Pr_SP.Type_NTD, T_Predm_Mat.Type_NTD_Marka)   Type_NTD_Marka_Mat,&#13;&#10;  isnull(Pr_SP.Name_NTD, T_Predm_Mat.Name_NTD_Marka)   Name_NTD_Marka_Mat,&#13;&#10;  T_Predm_Mat.Type_NTD_Sortam  Type_NTD_Sortam_Mat,&#13;&#10;  T_Predm_Mat.Name_NTD_Sortam  Name_NTD_Sortam_Mat&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10; Pr_Svr&#13;&#10; INNER JOIN T_Svr&#13;&#10;       ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;         &#13;&#10; INNER JOIN T_SvrDt    &#13;&#10;       ON  T_SvrDt.Key_Svr= T_Svr.Key_Svr&#13;&#10;         &#13;&#10; INNER JOIN Pr_SvrDT&#13;&#10;       ON  Pr_SvrDT.Key_PrSvr  = Pr_Svr.Key_PrSvr&#13;&#10;       AND Pr_SvrDT.Key_Svr    = T_Svr.Key_Svr&#13;&#10;       AND Pr_SvrDT.NumDT      = T_SvrDt.NumDT                                  &#13;&#10;&#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;       ON  &#13;&#10;               Pr_Pasp.Key_Pasport= Pr_SvrDT.Key_Pasport&#13;&#10;         &#13;&#10;  LEFT JOIN Pr_VSP  Pr_SP&#13;&#10;    ON  Pr_SP.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;    AND Pr_SP.SP_position=0&#13;&#10;&#13;&#10;  LEFT JOIN T_SP&#13;&#10;    ON Pr_Pasp.Key_SP = T_SP.Key_SP&#13;&#10;&#13;&#10;  LEFT JOIN A_VId_Mat&#13;&#10;    ON A_VId_Mat.Key_Id_Mat=Pr_SP.Key_Id_Mat&#13;&#10;&#13;&#10;  LEFT JOIN T_VPredm T_Predm_Mat&#13;&#10;    ON  T_Predm_Mat.Key_Predm = A_VId_Mat.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN T_TP&#13;&#10;    ON Pr_Pasp.Key_TP = T_TP.Key_TP&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm&#13;&#10;    ON  isnull(T_SvrDt.TB_Key_Predm, Pr_Pasp.Key_Predm) = T_Predm.Key_Predm&#13;&#10;    &#13;&#10;  &#13;&#10;WHERE&#13;&#10;  Pr_Svr.Key_PrSvr=:Key_PrSvr&#13;&#10;  AND  dbo.Pr_GetKolvoOnVKZ1(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport, Pr_SP.Key_PrSP )&#62;0  &#13;&#10;      " PropData=""/>
    <TfrxERQuery Name="SvrMat" UserName="ÑâðÌàò" CloseDataSource="True" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Key_SvrMat=Key_SvrMat&#13;&#10;Key_PrSvr=Key_PrSvr&#13;&#10;Key_Id_Mat=Key_Id_Mat&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;Party=Party&#13;&#10;Polojenie=Polojenie&#13;&#10;Tok=Tok&#13;&#10;Polyarn=Polyarn&#13;&#10;Napr=Napr&#13;&#10;DopInfo=DopInfo&#13;&#10;Sila=Sila&#13;&#10;Skor=Skor&#13;&#10;Podacha=Podacha" BCDToCurrency="False" Master="SvrSB" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr.Key_Pasport,&#13;&#10;  Pr_Svr_Mat.Key_SvrMat,&#13;&#10;  Pr_Svr_Mat.Key_PrSvr,&#13;&#10;  Pr_Svr_Mat.Key_Id_Mat,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;  A_VID_Mat.VidSert,&#13;&#10;  A_VID_Mat.N_Sert,&#13;&#10;  A_VID_Mat.Date_Sert,&#13;&#10;  A_VID_Mat.Cod_Plavka,&#13;&#10;  A_VID_Mat.Party ,&#13;&#10;&#13;&#10;  Pr_Svr_Mat.Polojenie,&#13;&#10;  Pr_Svr_Mat.Tok,&#13;&#10;  Pr_Svr_Mat.Polyarn,&#13;&#10;  Pr_Svr_Mat.Napr,&#13;&#10;  Pr_Svr_Mat.DopInfo,&#13;&#10;  Pr_Svr_Mat.Sila,&#13;&#10;  Pr_Svr_Mat.Skor,&#13;&#10;  Pr_Svr_Mat.Podacha&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Svr&#13;&#10;  INNER JOIN Pr_Svr_Mat&#13;&#10;    ON Pr_Svr_Mat.Key_PrSvr=  Pr_Svr.Key_PrSvr&#13;&#10;  INNER JOIN A_VID_Mat&#13;&#10;    ON Pr_Svr_Mat.Key_Id_Mat = A_VID_Mat.Key_ID_Mat&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE&#13;&#10;  Pr_Svr.Key_PrSvr = :Key_PrSvr&#13;&#10;ORDER BY Pr_Svr_Mat.Key_Id_Mat" PropData="05704C65667403BC000470546F7002140A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="MechSV" UserName="Ìåõàíèêà" CloseDataSource="True" FieldAliases.Text="VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cnt=Cnt&#13;&#10;Cod_Isp=Cod_Isp&#13;&#10;Key_Sert_Pos=Key_Sert_Pos&#13;&#10;Zakl1=Zakl1&#13;&#10;Key_Sert_Pos1=Key_Sert_Pos1&#13;&#10;Vid_Zakl1=Vid_Zakl1&#13;&#10;Num_Zakl1=Num_Zakl1&#13;&#10;Data_Zakl1=Data_Zakl1&#13;&#10;Zakl2=Zakl2&#13;&#10;Key_Sert_Pos2=Key_Sert_Pos2&#13;&#10;Vid_Zakl2=Vid_Zakl2&#13;&#10;Num_Zakl2=Num_Zakl2&#13;&#10;Data_Zakl2=Data_Zakl2&#13;&#10;Zakl3=Zakl3&#13;&#10;Key_Sert_Pos3=Key_Sert_Pos3&#13;&#10;Vid_Zakl3=Vid_Zakl3&#13;&#10;Num_Zakl3=Num_Zakl3&#13;&#10;Data_Zakl3=Data_Zakl3&#13;&#10;Zakl4=Zakl4&#13;&#10;Key_Sert_Pos4=Key_Sert_Pos4&#13;&#10;Vid_Zakl4=Vid_Zakl4&#13;&#10;Num_Zakl4=Num_Zakl4&#13;&#10;Data_Zakl4=Data_Zakl4&#13;&#10;Isp1=Isp1&#13;&#10;Isp2=Isp2&#13;&#10;Isp3=Isp3&#13;&#10;Isp4=Isp4&#13;&#10;Pr10=Pr10&#13;&#10;Pr20=Pr20&#13;&#10;Pr30=Pr30&#13;&#10;Pr40=Pr40&#13;&#10;Pr10_1=Pr10_1&#13;&#10;Pr20_1=Pr20_1&#13;&#10;Pr30_1=Pr30_1&#13;&#10;Pr40_1=Pr40_1&#13;&#10;Pr160_1=Pr160_1&#13;&#10;Pr50_2=Pr50_2&#13;&#10;Pr160_2=Pr160_2&#13;&#10;Pr50_3=Pr50_3&#13;&#10;Pr160_3=Pr160_3" BCDToCurrency="False" Master="SvrMat" IgnoreDupParams="False" SQL.Text="exec Pr_GetSvrMSV&#13;&#10;&#13;&#10;@Key_Pasport   =:Key_Pasport,&#13;&#10;@Key_Id_Mat    =:Key_Id_Mat,&#13;&#10;@Key_VKZ_Izdel =:Key_VKZ_Izdel" PropData=""/>
    <TfrxERQuery Name="DopIspQRY" UserName="ÄîïÈñï" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvrSB" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;       Pr_Svr.Key_Pasport,&#13;&#10;       Pr_Svr.Key_Svr,&#13;&#10;       Pr_Napr.Num_Napr,&#13;&#10;       Pr_Napr.Data_Napr,&#13;&#10;       T_TechTreb.VidKontr,&#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       Pr_Zakl.Num_Zakl,&#13;&#10;       Pr_Zakl.Data_Zakl,&#13;&#10;       Pr_Zakl.Vid_Zakl,&#13;&#10;       Pr_NaprZakl.VolKontr&#13;&#10;FROM&#13;&#10;       Pr_Svr&#13;&#10;       INNER JOIN Pr_NaprSvr&#13;&#10;               ON Pr_Svr.Key_PrSvr = Pr_NaprSvr.Key_PrSvr&#13;&#10;       INNER JOIN Pr_NaprZakl&#13;&#10;               ON Pr_NaprSvr.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;       INNER JOIN T_TechTreb&#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;       INNER JOIN Pr_Napr&#13;&#10;               ON Pr_NaprZakl.Key_Napr = Pr_Napr.Key_Napr&#13;&#10;       INNER JOIN  Pr_Zakl&#13;&#10;               ON Pr_NaprZakl.Key_Zakl = Pr_Zakl.Key_Zakl&#13;&#10;--       INNER JOIN T_Svr&#13;&#10;--               ON T_Svr.Key_Svr=Pr_Svr.Key_Svr&#13;&#10;       INNER JOIN T_SvrTT&#13;&#10;               ON T_SvrTT.Key_Svr=Pr_Svr.Key_Svr&#13;&#10;               AND T_SvrTT.Cod_TT=Pr_NaprZakl.Cod_TT&#13;&#10;WHERE&#13;&#10;       Pr_Svr.Key_PrSvr=:Key_PrSvr&#13;&#10;&#13;&#10;  AND dbo.Pr_ZavNumInIzdel(:Key_VKZ_Izdel, :Num_Izdel , PR_Svr.Key_Pasport , Pr_NaprZakl.ZavNumFrom, Pr_NaprZakl.ZavNumTo ) &#62; 0&#13;&#10;&#13;&#10;    --   AND T_TechTreb.Cod_TT not in ('201', '206', '211')&#13;&#10;ORDER BY  Pr_NaprZakl.Cod_TT, Pr_Zakl.Data_Zakl" PropData=""/>
    <TfrxERQuery Name="MKKQry" UserName="ÌÊÊ" CloseDataSource="True" FieldAliases.Text="Key_Sert_Pos=Key_Sert_Pos&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Key_Zakl=Key_Zakl&#13;&#10;Vid_Zakl=Vid_Zakl&#13;&#10;Num_Zakl=Num_Zakl&#13;&#10;Data_Zakl=Data_Zakl&#13;&#10;Key_Isp=Key_Isp&#13;&#10;Cod_TT=Cod_TT&#13;&#10;Attr_Val=Attr_Val" BCDToCurrency="False" Master="SvrMat" IgnoreDupParams="False" SQL.Text="exec dbo.Pr_PaspGetSvrMTTDetail&#13;&#10;&#13;&#10;  @Key_Pasport=:Key_Pasport,&#13;&#10;  @Key_Id_Mat =:Key_Id_Mat,&#13;&#10;  @Key_VKZ_Izdel=:Key_VKZ_Izdel,&#13;&#10;&#13;&#10;  @SkipSert   =0,&#13;&#10;  @Cod_TT     ='241',&#13;&#10;  @Key_Sert_Attr= null" PropData=""/>
