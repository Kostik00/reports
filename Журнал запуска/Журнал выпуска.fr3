    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT &#13;&#10;       P.Cod_Pasp, &#13;&#10;       T.Cod_Predm, &#13;&#10;       T.Name_Predm, &#13;&#10;       P.Date_Vip, &#13;&#10;       ROUND (cast (P.Date_Vip as float), 0, 1) D,&#13;&#10;       P.Key_Pasport,&#13;&#10;	      S.Name_Pasp_Status&#13;&#10;FROM&#13;&#10;    Pr_Pasp P&#13;&#10;    INNER JOIN T_VPredm T ON (P.Key_Predm=T.Key_Predm)&#13;&#10;    INNER JOIN dbo.Pr_Pasp_Status   S ON  S.Key_Pasp_Status = P.Key_Pasp_Status                         &#13;&#10;WHERE&#13;&#10;    P.Date_Vip IS NOT NULL&#13;&#10;AND P.Date_Vip &#62;=:EndDate  &#13;&#10;      &#13;&#10;ORDER BY  S.Name_Pasp_Status,  D DESC, Cod_Predm" SQLSchema="eAFtT88KgjAYvw/2Dj7Ad9jmnF12qSAisYWrQxJj4Q5SpqiX3r6pGAbxfbff/3xre7u2nbthlJ0SyVgcCyIoERjl2t6frvOIkqo1ynYN0Gh4HhFggmOkpTYX1bqiAhZBGAvgUQh05aF815aF1xK5qYtJPJsooEDGw4hO8Gjx9dILApOprZyZQv4yQulHOHO1DSwT2Jiwz4L0qIP0nCQBRlwe3HssU7f9D3vukyfl6zFsJpJ7Azo1wegDzzdPlw==" PropData="05704C656674023C0470546F7002280A506172616D657465727301010C41000000204E616D653D22456E6444617465222044617461547970653D2266744461746554696D65222045787072657373696F6E3D224461746545646974312E44617465220000"/>
