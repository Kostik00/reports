    <TfrxERQuery Name="PrOper" UserName="Ìàðøðóò" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Pasp_Rows.Key_Pasp_Rows,&#13;&#10;  Pr_Pasp_Rows.Key_Pasport,&#13;&#10;  Pr_Pasp_Rows.N_Oper,&#13;&#10;  Pr_Pasp_Rows.N_Oper_Sm,&#13;&#10;  Pr_Pasp_Rows.Key_Master_Row,&#13;&#10;  Pr_Pasp_Rows.Key_TP,&#13;&#10;  Pr_Pasp_Rows.Key_V_TP,&#13;&#10;  Pr_Pasp_Rows.Lvl,&#13;&#10;  Pr_Pasp_Rows.Cod_Oper,&#13;&#10;  Pr_Pasp_Rows.Ad_Info,&#13;&#10;  Pr_Pasp_Rows.Tpz,&#13;&#10;  Pr_Pasp_Rows.TSht,&#13;&#10;  Pr_Pasp_Rows.Tsm,&#13;&#10;  Pr_Pasp_Rows.Status_Oper,&#13;&#10;  Pr_Pasp_Rows.Row_Src,&#13;&#10;  Pr_Status_Oper.Name_Status_Oper,&#13;&#10;  T_Oper.Name_Oper,&#13;&#10;  S_Subjects.Name_Sub,&#13;&#10;  Pr_Pasp_Rows.Edit_Date,&#13;&#10;  dbo.Pr_Get_Mk_KolvoZap(Pr_Pasp_Rows.Key_Pasp_Rows) KolvoZap,&#13;&#10;  dbo.Pr_Get_Mk_KolvoFakt(Pr_Pasp_Rows.Key_Pasp_Rows) KolvoFakt,&#13;&#10;  dbo.Pr_Get_Mk_TZap(Pr_Pasp_Rows.Key_Pasp_Rows) TZap,&#13;&#10;&#13;&#10;  Pr_Pasp_Rows.Key_Sub_Otv,&#13;&#10;  Pr_Pasp_Rows.PlnDate,&#13;&#10;  Pr_Pasp_Rows.PlnSmDay,&#13;&#10;  Pr_Pasp_Rows.PlnSmTrud,&#13;&#10;  Otv.Name_Sub Name_Sub_Otv,&#13;&#10;&#13;&#10;  Pr_Pasp_Rows.FixNorm,&#13;&#10;&#13;&#10;  Pr_Pasp_Rows.Key_PaspR_Pln,&#13;&#10;  Pr_Pasp_Rows.Dt_PaspR_Pln,&#13;&#10;&#13;&#10;  TAc.*              &#13;&#10;&#13;&#10;FROM&#13;&#10;    Pr_Pasp_Rows&#13;&#10;    INNER JOIN T_Oper&#13;&#10;      ON Pr_Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper&#13;&#10;    LEFT JOIN S_Subjects&#13;&#10;      ON  S_Subjects.Cod_Sub=Pr_Pasp_Rows.Usr&#13;&#10;    LEFT JOIN  dbo.Pr_Status_Oper Pr_Status_Oper&#13;&#10;      ON  Pr_Status_Oper.Status_Oper =  Pr_Pasp_Rows.Status_Oper&#13;&#10;	LEFT JOIN S_Subjects Otv&#13;&#10;	  ON Otv.Key_Sub = Pr_Pasp_Rows.Key_Sub_Otv&#13;&#10;&#13;&#10;LEFT JOIN&#13;&#10;(&#13;&#10;SELECT&#13;&#10;  Pr_Pasp_Ac.Key_Pasp_Rows,&#13;&#10;  Pr_Pasp_Ac.Key_Sub_Ver,&#13;&#10;  Pr_Pasp_Ac.AcKolvo,&#13;&#10;  Pr_Pasp_Ac.AC_Date,&#13;&#10;  Pr_Pasp_Ac.AcUser,&#13;&#10;  S_SubVer.F_Name_Sub,&#13;&#10;  S_Subjects.Name_Sub Name_Sub_AC,&#13;&#10;  T1.Name_Sub  Kontr&#13;&#10;FROM&#13;&#10;  Pr_Pasp_Rows T00  &#13;&#10;  INNER JOIN Pr_Pasp_Ac&#13;&#10;       ON  Pr_Pasp_Ac.Key_Pasp_Rows = T00.Key_Pasp_Rows&#13;&#10;         &#13;&#10;  LEFT JOIN S_SubVer&#13;&#10;    ON Pr_Pasp_Ac.Key_Sub_Ver = S_SubVer.Key_Sub_Ver&#13;&#10;  LEFT JOIN S_Subjects&#13;&#10;    ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN S_Subjects T1&#13;&#10;    ON T1.Cod_Sub= Pr_Pasp_Ac.AcUser&#13;&#10;WHERE &#13;&#10;        T00.KEY_PASPORT =  :Key_Pasport                         &#13;&#10;&#13;&#10;&#13;&#10;) TAC&#13;&#10;  ON TAc.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows                                                   &#13;&#10;	&#13;&#10;WHERE Pr_Pasp_Rows.KEY_PASPORT=:Key_Pasport&#13;&#10;ORDER BY N_OPER_SM&#13;&#10;&#13;&#10;  " PropData="05704C65667402500470546F7002540A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E220000"/>
