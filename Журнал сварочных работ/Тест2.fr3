    <TfrxERQuery Name="ERQuery1" UserName="ÐåàëüíûåÑâàðùèêè" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT        Key_id, Key_PrSvr, FIO, KeyTP,Date                  &#13;&#10;FROM            Weldor_fact AS W&#13;&#10;ORDER BY FIO,Date, Key_PrSvr                                                    " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI1NjQ1MTQ0MOXlig5JTMpJLQbKhNuGp+ak5BfFpyUml+gYmoKQkYEBkDIAKnMvykwBKjKw9U6tjM9M0UFWG65jqGMAhrxchmAFAUXBZUU41RjZunn645SN9snMywY5CACbijN1" PropData="05704C65667402380470546F7002380A506172616D65746572730100"/>
    <TfrxERQuery Name="Kontroli" UserName="Êîíòðîëè" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="      SELECT&#13;&#10;        T_Svr_TPRows.Key_Svr_TPRows,&#13;&#10;        T_Svr_TPRows.Key_TPRows Key_TPRows,&#13;&#10;        T_Svr_TPRows.Key_Svr    Key_Svr,      &#13;&#10;        T_Svr.NumSvr            NumSvr,&#13;&#10;        T_Svr.Ssvr              Ssvr,&#13;&#10;        T_Svr_TPRows.TSvr       TSvr,&#13;&#10;        T_Svr_TPRows.LSvr       LSvr,      &#13;&#10;        T_Svr.Szach             Szach,&#13;&#10;        T_Svr_TPRows.PZach      PZach,      &#13;&#10;        T_Svr_TPRows.UFl,      &#13;&#10;        T_SvrSposob.SposobSvr,      &#13;&#10;        T_TPMat.Polojenie,&#13;&#10;        T_TPMat.Tok,&#13;&#10;        T_TPMat.Polyarn,&#13;&#10;        T_TPMat.Sila,&#13;&#10;      &#13;&#10;        T_TPMat.Napr,&#13;&#10;        T_TPMat.Skor,&#13;&#10;        T_TPMat.Podacha,&#13;&#10;        T_TPMat.DopInfo,&#13;&#10;      &#13;&#10;        T_SPRows.Key_Predm,&#13;&#10;        T_VPredm.Cod_Predm,&#13;&#10;        T_VPredm.Name_Predm,&#13;&#10;        T_VPredm.Sortam,&#13;&#10;        T_VPredm.Type_NTD_Sortam,&#13;&#10;        T_VPredm.Name_NTD_Sortam,&#13;&#10;        T_VPredm.Marka,&#13;&#10;        T_VPredm.Type_NTD_Marka,&#13;&#10;        T_VPredm.Name_NTD_Marka,      &#13;&#10;          T_Svr.SSvr * Isnull(T_Svr_TPRows.Lsvr, T_Svr.LSvr) * T_Svr_Rejim.Ro * T_Svr_Rejim.KIM/1000   SmM,      &#13;&#10;        Isnull(T_Svr_TPRows.Key_TPMat*0+1,0)  Key_TPMat&#13;&#10;      FROM&#13;&#10;        T_Svr_TPRows&#13;&#10;        INNER JOIN    T_Svr&#13;&#10;          ON T_Svr_TPRows.Key_Svr = T_Svr.Key_Svr&#13;&#10;      &#13;&#10;        LEFT JOIN T_TPMat&#13;&#10;          ON T_TPMat.Key_TPMat=T_Svr_TPRows.Key_TPMat&#13;&#10;        LEFT JOIN T_SPRows&#13;&#10;          ON T_TPMat.Key_SPRow = T_SPRows.Key_SPRow&#13;&#10;        LEFT JOIN T_VPredm&#13;&#10;          ON T_SPRows.Key_Predm = T_VPredm.Key_Predm&#13;&#10;        LEFT JOIN T_SvrSposob&#13;&#10;          ON T_SvrSposob.Key_Sposob=T_TPMat.Key_Sposob&#13;&#10;        LEFT JOIN T_Svr_Rejim &#13;&#10;        ON  T_Svr_Rejim.Key_Sposob = T_SvrSposob.Key_Sposob  &#13;&#10;        AND T_Svr_Rejim.Key_Predm = T_SPRows.Key_Predm&#13;&#10;        AND T_Svr_Rejim.Polojenie = T_TPMat.Polojenie&#13;&#10;      &#13;&#10;      WHERE&#13;&#10;          T_Svr_TPRows.Key_TPRows  in (SELECT        T_TPRows.Key_TPRows    &#13;&#10;FROM             T_TPRows INNER JOIN&#13;&#10;                         T_TP ON  T_TPRows.Key_TP = T_TP.Key_TP&#13;&#10;WHERE        ( T_TPRows.Cod_Oper LIKE '91%') AND ( T_TPRows.Key_TP =:Key_TP))&#13;&#10;		 and &#13;&#10;		  T_Svr_TPRows.Key_Svr =:Key_Svr      &#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;                                  " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI3NLAwM7MwMuTlig5JTMpJLQbKhNiGxAeXFcWHBATllxfrGJqCkJGBAZAyAKpzL8pMAaoysPVOrYSpQdEQomOoYwCGvFyGYFVA03RwKon2yczLBtkLAOV+LLY=" PropData=""/>
    <TfrxERQuery Name="Test" UserName="Òåñò" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvarShovList" IgnoreDupParams="False" SQL.Text="       SELECT&#13;&#10;	        Pr_Svr.Key_PrSvr Key_PrSvr,      &#13;&#10;	        Pr_Svr.Key_Pasport Key_Pasport,&#13;&#10;	        T_VPredm.Cod_Predm Cod_Predm,&#13;&#10;	        T_VPredm.Name_Predm Name_Predm,&#13;&#10;	        Pr_Svr.ZavNumFrom ZavNumFrom,&#13;&#10;	        Pr_Svr.ZavNumTo ZavNumTo,&#13;&#10;	        Pr_Svr.Kolvo Kolvo,      &#13;&#10;	        Pr_Pasp.Cod_Pasp Cod_Pasp,&#13;&#10;	        Pr_Pasp.Cod_Zak Cod_Zak,&#13;&#10;	        T_TP.Cod_TP Cod_TP,      &#13;&#10;	        Pr_Svr.Key_Svr Key_Svr,&#13;&#10;	        T_Svr.NumSvr NumSvr,&#13;&#10;	        dbo.T_OrderSortam(T_Svr.NumSvr) OrderNumSvr,&#13;&#10;         dbo.Pr_Get_PrSvr_SvrSposob(Pr_Svr.Key_PrSvr) SposobSvr,                                                            &#13;&#10;	        Pr_Svr.AdNumSvr AdNumSvr,&#13;&#10;	        Pr_Svr.DateSvr  DateSvr,      &#13;&#10;	        Pr_Svr.Key_DT1,&#13;&#10;	        Pr_Svr.Key_DT2,&#13;&#10;	        Pr_Svr.Key_DT3,      &#13;&#10;	        Pr_Svr.T_Met,&#13;&#10;	        Pr_Svr.T_Okr,&#13;&#10;	        Pr_Svr.EndDateSvr,&#13;&#10;	        T_VPredm1.Cod_Predm Cod_Predm1,&#13;&#10;	        T_VPredm2.Cod_Predm Cod_Predm2,&#13;&#10;	        T_VPredm3.Cod_Predm Cod_Predm3,&#13;&#10;	        Pr_Svr.Key_TP,&#13;&#10;	        T_SvrTP.Cod_TP  Cod_SvrTP&#13;&#10;	      &#13;&#10;	      	FROM&#13;&#10;	        Pr_Svr&#13;&#10;	        INNER JOIN Pr_Pasp&#13;&#10;	          ON Pr_Pasp.Key_Pasport = Pr_Svr.Key_Pasport&#13;&#10;	        INNER JOIN T_VPredm&#13;&#10;	          ON T_VPredm.Key_Predm = Pr_Pasp.Key_Predm&#13;&#10;	        INNER JOIN T_TP&#13;&#10;	          ON T_TP.Key_TP = Pr_Pasp.Key_TP&#13;&#10;	        INNER JOIN T_Svr&#13;&#10;	          ON T_Svr.Key_Svr = Pr_Svr.Key_Svr          &#13;&#10;	        LEFT JOIN T_TP  T_SvrTP&#13;&#10;	          ON T_SvrTP.Key_TP = Pr_Svr.Key_TP&#13;&#10;	        LEFT JOIN Pr_Pasp Pr_Pasp1&#13;&#10;	          ON Pr_Pasp1.Key_Pasport = Pr_Svr.Key_DT1&#13;&#10;	        LEFT JOIN T_VPredm T_VPredm1&#13;&#10;	          ON T_VPredm1.Key_Predm = Pr_Pasp1.Key_Predm&#13;&#10;	        LEFT JOIN Pr_Pasp Pr_Pasp2&#13;&#10;	          ON Pr_Pasp2.Key_Pasport = Pr_Svr.Key_DT2&#13;&#10;	        LEFT JOIN T_VPredm T_VPredm2&#13;&#10;	          ON T_VPredm2.Key_Predm = Pr_Pasp2.Key_Predm&#13;&#10;	        LEFT JOIN Pr_Pasp Pr_Pasp3&#13;&#10;	          ON Pr_Pasp3.Key_Pasport = Pr_Svr.Key_DT3&#13;&#10;	        LEFT JOIN T_VPredm T_VPredm3&#13;&#10;	          ON T_VPredm3.Key_Predm = Pr_Pasp3.Key_Predm&#13;&#10;	      &#13;&#10;	      WHERE&#13;&#10;		    Pr_Svr.Key_TP  =:Key_TP&#13;&#10;and&#13;&#10;Pr_Svr.Key_PrSvr =:Key_PrSvr               " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI1NjQ1MTQ0MOXlig5JTMpJLQbKhNuGp+ak5BfFpyUml+gYmoKQkYEBkDIAKnMvykwBKjKw9U6tjM9M0UFWG65jqGMAhrxchmAFAUXBZUU41RjZunn645SN9snMywY5CACbijN1" PropData=""/>
    <TfrxERQuery Name="SvarShovList" UserName="ÑïèñîêÑâàðíûõØâîâ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT     DISTINCT    Key_PrSvr, KeyTP&#13;&#10;FROM            Weldor_fact AS W&#13;&#10;ORDER BY   Key_PrSvr                                                      " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI1NjQ1MTQ0MOXlig5JTMpJLQbKhNuGp+ak5BfFpyUml+gYmoKQkYEBkDIAKnMvykwBKjKw9U6tjM9M0UFWG65jqGMAhrxchmAFAUXBZUU41RjZunn645SN9snMywY5CACbijN1" PropData="05704C6566740360010470546F7002400A506172616D65746572730100"/>
    <TfrxERQuery Name="VIK" UserName="ÂÈÊ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvarShovList" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;		&#13;&#10;		&#13;&#10;		Pr_VSvrKontr.Key_Zakl     Key_Zakl, &#13;&#10;			Pr_VSvrKontr.Num_Zakl     Num_Zakl, &#13;&#10;		Pr_VSvrKontr.Data_Zakl     Data_Zakl, &#13;&#10;		isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) Cod_TT, &#13;&#10;		isnull(Pr_VSvrKontr.TotalFillet, 0)  TotalFillet,&#13;&#10;		isnull(Pr_VSvrKontr.TotalUngraded, 0)  TotalUngraded	&#13;&#10;		FROM         Pr_VSvrTT &#13;&#10;		FULL OUTER JOIN Pr_VSvrKontr &#13;&#10;		ON Pr_VSvrTT.Key_PrSvr = Pr_VSvrKontr.Key_PrSvr &#13;&#10;		AND Pr_VSvrTT.Cod_TT = Pr_VSvrKontr.Cod_TT &#13;&#10;		AND Pr_VSvrTT.Key_Svr = Pr_VSvrKontr.Key_Svr&#13;&#10;		WHERE&#13;&#10;		(Pr_VSvrKontr.Key_PrSvr =:Key_PrSvr      &#13;&#10;		OR Pr_VSvrTT.Key_PrSvr =:Key_PrSvr)&#13;&#10;		and (isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) like '301%')&#13;&#10;&#13;&#10;&#13;&#10;                                  " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI3NLAwM7MwMuTlig5JTMpJLQbKhNiGxAeXFcWHBATllxfrGJqCkJGBAZAyAKpzL8pMAaoysPVOrYSpQdEQomOoYwCGvFyGYFVA03RwKon2yczLBtkLAOV+LLY=" PropData="05704C65667403E8010470546F7002340A506172616D657465727301010C63000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E222045787072657373696F6E3D22262336303BD1EFE8F1EEEAD1E2E0F0EDFBF5D8E2EEE22E262333343B4B65795F5072537672262333343B262336323B220000"/>
    <TfrxERQuery Name="UZK" UserName="ÓÇÊ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvarShovList" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;		&#13;&#10;		&#13;&#10;		Pr_VSvrKontr.Key_Zakl     Key_Zakl, &#13;&#10;			Pr_VSvrKontr.Num_Zakl     Num_Zakl, &#13;&#10;		Pr_VSvrKontr.Data_Zakl     Data_Zakl, &#13;&#10;		isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) Cod_TT, &#13;&#10;		isnull(Pr_VSvrKontr.TotalFillet, 0)  TotalFillet,&#13;&#10;		isnull(Pr_VSvrKontr.TotalUngraded, 0)  TotalUngraded	&#13;&#10;		FROM         Pr_VSvrTT &#13;&#10;		FULL OUTER JOIN Pr_VSvrKontr &#13;&#10;		ON Pr_VSvrTT.Key_PrSvr = Pr_VSvrKontr.Key_PrSvr &#13;&#10;		AND Pr_VSvrTT.Cod_TT = Pr_VSvrKontr.Cod_TT &#13;&#10;		AND Pr_VSvrTT.Key_Svr = Pr_VSvrKontr.Key_Svr&#13;&#10;		WHERE&#13;&#10;		(Pr_VSvrKontr.Key_PrSvr =:Key_PrSvr      &#13;&#10;		OR Pr_VSvrTT.Key_PrSvr =:Key_PrSvr)&#13;&#10;		and ((isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) like '322%')&#13;&#10;or (isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) like '323%'))                     &#13;&#10;&#13;&#10;&#13;&#10;                                  " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI3NLAwM7MwMuTlig5JTMpJLQbKhNiGxAeXFcWHBATllxfrGJqCkJGBAZAyAKpzL8pMAaoysPVOrYSpQdEQomOoYwCGvFyGYFVA03RwKon2yczLBtkLAOV+LLY=" PropData="05704C65667403E8010470546F7002740A506172616D657465727301010C63000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E222045787072657373696F6E3D22262336303BD1EFE8F1EEEAD1E2E0F0EDFBF5D8E2EEE22E262333343B4B65795F5072537672262333343B262336323B220000"/>
    <TfrxERQuery Name="KK" UserName="KK" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvarShovList" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;		&#13;&#10;		&#13;&#10;		Pr_VSvrKontr.Key_Zakl     Key_Zakl, &#13;&#10;			Pr_VSvrKontr.Num_Zakl     Num_Zakl, &#13;&#10;		Pr_VSvrKontr.Data_Zakl     Data_Zakl, &#13;&#10;		isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) Cod_TT, &#13;&#10;		isnull(Pr_VSvrKontr.TotalFillet, 0)  TotalFillet,&#13;&#10;		isnull(Pr_VSvrKontr.TotalUngraded, 0)  TotalUngraded	&#13;&#10;		FROM         Pr_VSvrTT &#13;&#10;		FULL OUTER JOIN Pr_VSvrKontr &#13;&#10;		ON Pr_VSvrTT.Key_PrSvr = Pr_VSvrKontr.Key_PrSvr &#13;&#10;		AND Pr_VSvrTT.Cod_TT = Pr_VSvrKontr.Cod_TT &#13;&#10;		AND Pr_VSvrTT.Key_Svr = Pr_VSvrKontr.Key_Svr&#13;&#10;		WHERE&#13;&#10;		(Pr_VSvrKontr.Key_PrSvr =:Key_PrSvr      &#13;&#10;		OR Pr_VSvrTT.Key_PrSvr =:Key_PrSvr)&#13;&#10;		and (isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) like '341%')&#13;&#10;                     &#13;&#10;&#13;&#10;&#13;&#10;                                  " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI3NLAwM7MwMuTlig5JTMpJLQbKhNiGxAeXFcWHBATllxfrGJqCkJGBAZAyAKpzL8pMAaoysPVOrYSpQdEQomOoYwCGvFyGYFVA03RwKon2yczLBtkLAOV+LLY=" PropData="05704C65667403E8010470546F7003BC000A506172616D657465727301010C63000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E222045787072657373696F6E3D22262336303BD1EFE8F1EEEAD1E2E0F0EDFBF5D8E2EEE22E262333343B4B65795F5072537672262333343B262336323B220000"/>
    <TfrxERQuery Name="RGD" UserName="RGD" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvarShovList" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;		&#13;&#10;		&#13;&#10;		Pr_VSvrKontr.Key_Zakl     Key_Zakl, &#13;&#10;			Pr_VSvrKontr.Num_Zakl     Num_Zakl, &#13;&#10;		Pr_VSvrKontr.Data_Zakl     Data_Zakl, &#13;&#10;		isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) Cod_TT, &#13;&#10;		isnull(Pr_VSvrKontr.TotalFillet, 0)  TotalFillet,&#13;&#10;		isnull(Pr_VSvrKontr.TotalUngraded, 0)  TotalUngraded	&#13;&#10;		FROM         Pr_VSvrTT &#13;&#10;		FULL OUTER JOIN Pr_VSvrKontr &#13;&#10;		ON Pr_VSvrTT.Key_PrSvr = Pr_VSvrKontr.Key_PrSvr &#13;&#10;		AND Pr_VSvrTT.Cod_TT = Pr_VSvrKontr.Cod_TT &#13;&#10;		AND Pr_VSvrTT.Key_Svr = Pr_VSvrKontr.Key_Svr&#13;&#10;		WHERE&#13;&#10;		(Pr_VSvrKontr.Key_PrSvr =:Key_PrSvr      &#13;&#10;		OR Pr_VSvrTT.Key_PrSvr =:Key_PrSvr)&#13;&#10;		and (isnull(Pr_VSvrKontr.Cod_TT ,Pr_VSvrTT.Cod_TT) like '312%')&#13;&#10;                     &#13;&#10;&#13;&#10;&#13;&#10;                                  " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI3NLAwM7MwMuTlig5JTMpJLQbKhNiGxAeXFcWHBATllxfrGJqCkJGBAZAyAKpzL8pMAaoysPVOrYSpQdEQomOoYwCGvFyGYFVA03RwKon2yczLBtkLAOV+LLY=" PropData="05704C65667403E8010470546F7003F8000A506172616D657465727301010C63000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E222045787072657373696F6E3D22262336303BD1EFE8F1EEEAD1E2E0F0EDFBF5D8E2EEE22E262333343B4B65795F5072537672262333343B262336323B220000"/>
    <TfrxERQuery Name="VseKontroli" UserName="ERQuery2" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvarShovList" IgnoreDupParams="False" SQL.Text="SELECT        &#13;&#10; CASE WHEN isnull(Pr_VSvrKontr.Cod_TT, Pr_VSvrTT.Cod_TT) LIKE '301%' THEN&#13;&#10; Pr_VSvrKontr.Num_Zakl &#13;&#10; ELSE '' &#13;&#10; END AS Num_Zakl_VIK,&#13;&#10; &#13;&#10; CASE WHEN isnull(Pr_VSvrKontr.Cod_TT, Pr_VSvrTT.Cod_TT) LIKE '322%' THEN &#13;&#10; Pr_VSvrKontr.Num_Zakl &#13;&#10; WHEN isnull(Pr_VSvrKontr.Cod_TT, Pr_VSvrTT.Cod_TT) LIKE '323%' THEN&#13;&#10; Pr_VSvrKontr.Num_Zakl &#13;&#10; ELSE ''&#13;&#10; END AS Num_Zakl_UZK,&#13;&#10; &#13;&#10; CASE WHEN isnull(Pr_VSvrKontr.Cod_TT, Pr_VSvrTT.Cod_TT) LIKE '341%' THEN &#13;&#10; Pr_VSvrKontr.Num_Zakl &#13;&#10; ELSE '' &#13;&#10; END AS Num_Zakl_KK,&#13;&#10; &#13;&#10; CASE WHEN isnull(Pr_VSvrKontr.Cod_TT, Pr_VSvrTT.Cod_TT) LIKE '312' THEN &#13;&#10; Pr_VSvrKontr.Num_Zakl &#13;&#10; ELSE '' &#13;&#10; END AS Num_Zakl_RGD,&#13;&#10; &#13;&#10;  Pr_VSvrKontr.Key_Zakl,&#13;&#10;  ISNULL(Pr_VSvrKontr.TotalFillet, 0) AS TotalFillet,&#13;&#10;  ISNULL(Pr_VSvrKontr.TotalUngraded, 0) AS TotalUngraded&#13;&#10;&#13;&#10;FROM            Pr_VSvrTT FULL OUTER JOIN&#13;&#10;                         Pr_VSvrKontr ON Pr_VSvrTT.Key_PrSvr = Pr_VSvrKontr.Key_PrSvr AND Pr_VSvrTT.Cod_TT = Pr_VSvrKontr.Cod_TT AND Pr_VSvrTT.Key_Svr = Pr_VSvrKontr.Key_Svr&#13;&#10;WHERE       ( Pr_VSvrKontr.Key_PrSvr =:Key_PrSvr&#13;&#10; OR Pr_VSvrTT.Key_PrSvr =:Key_PrSvr)  " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTI3NLAwM7MwMuTlig5JTMpJLQbKhNiGxAeXFcWHBATllxfrGJqCkJGBAZAyAKpzL8pMAaoysPVOrYSpQdEQomOoYwCGvFyGYFVA03RwKon2yczLBtkLAOV+LLY=" PropData="05704C6566740344010470546F7003F0000A506172616D657465727301010C63000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E222045787072657373696F6E3D22262336303BD1EFE8F1EEEAD1E2E0F0EDFBF5D8E2EEE22E262333343B4B65795F5072537672262333343B262336323B220000"/>
    <TfrxERQuery Name="Svar" UserName="Svar" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvarShovList" IgnoreDupParams="False" SQL.Text="SELECT W.FIO&#13;&#10;FROM&#13;&#10;    Weldor_fact W&#13;&#10;where&#13;&#10;&#13;&#10; W.Key_PrSvr =:Key_PrSvr and W.KeyTP=:KeyTP          &#13;&#10;  " SQLSchema="eAGLdkksSXRKLE6N5eUKDvSxNTUyNLEwsrA05OWKDklMykktBkqE24an5qTkF8WnJSaX6JiYWOiYG5voGBkY6BiaGgAVuhdlpgCVGdi6efrrICsN1zHUMQBDXi5DW+/UyviAouCyIpxqjEBqQgJwykf7ZOZlg1wEAHQhMzw=" PropData=""/>
