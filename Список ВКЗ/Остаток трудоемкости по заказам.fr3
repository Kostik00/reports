      <TfrxMemoView Name="Memo9" ShiftMode="smDontShift" Left="850,39425" Top="0" Width="94,48825" Height="41,57483" StretchMode="smMaxHeight" AllowHTMLTags="True" DisplayFormat.DecimalSeparator="," DisplayFormat.FormatStr="%2.2f" DisplayFormat.Kind="fkNumeric" Font.Charset="1" Font.Color="0" Font.Height="-13" Font.Name="Arial" Font.Style="1" Frame.Typ="15" Fill.BackColor="4643583" HAlign="haCenter" ParentFont="False" VAlign="vaCenter" Text="[SUM(&#60;TrudQRY.&#34;SMTrudTP&#34;&#62; - &#60;TrudQRY.&#34;SMTrudByPaspF&#34;&#62;)]"/>
