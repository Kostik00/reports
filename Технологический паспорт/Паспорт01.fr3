;  if pos('*',S)&#62;0 then&#13;&#10;   Result:=Copy(S,1,pos('*',S)-1);&#13;&#10;&#13;&#10;  if ((&#60;ÄÑÅ.&#34;PrintFlag&#34;&#62; and 1) = 1) then&#13;&#10;    Result:=&#60;ÄÑÅ.&#34;Sortam&#34;&#62;+' '+&#60;ÄÑÅ.&#34;Type_NTD_Sortam&#34;&#62;+' '+&#60;ÄÑÅ.&#34;Name_NTD_Sortam&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function fnSortam(S:string):string;&#13;&#10;begin&#13;&#10;  Result:=S;&#13;&#10;//  if pos(Chr(160),S)&#62;0 then&#13;&#10;//   Result:=Copy(S,1,pos(Chr(160),S)-1);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DrawPageFtr;&#13;&#10;begin&#13;&#10;&#13;&#10;//  if Engine.FreeSpace &#60;=2 then&#13;&#10;//    exit;&#13;&#10;&#13;&#10;//  EmptyStrMemo.Height:=Engine.FreeSpace-1;&#13;&#10;&#13;&#10;//  Engine.ShowBand(EmptyStr);&#13;&#10;//  EmptyStrMemo.Height:=0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure FillEmptyPage;&#13;&#10;begin&#13;&#10;   while Engine.FreeSpace &#62; (K * EmptyStr.Height) do&#13;&#10;     Engine.ShowBand(EmptyStr);&#13;&#10;//   Engine.NewPage;&#13;&#10;&#13;&#10;{&#13;&#10;  if Engine.FreeSpace &#60;=2 then&#13;&#10;    exit;&#13;&#10;  while (Engine.FreeSpace&#62;(TPOperFtr.Height*K)) do&#13;&#10;  begin&#13;&#10;    EmptyStrMemo.Height:=TPOperFtr.Height;&#13;&#10;    Engine.ShowBand(EmptyStr);&#13;&#10;    EmptyStrMemo.Height:=0;&#13;&#10;  end;&#13;&#10;  DrawPageFtr;&#13;&#10;  }&#13;&#10;end;&#13;&#10;&#13;&#10;function CheckFreeSpace1(CheckHeigh:double = 0):boolean;&#13;&#10;begin&#13;&#10;  Result:=False;&#13;&#10;  if CheckHeigh=0 then CheckHeigh:=StrH;&#13;&#10;  if (Engine.FreeSpace &#60; CheckHeigh) then&#13;&#10;  begin&#13;&#10;    DrawPageFtr;&#13;&#10;    Result:=True;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function CheckFreeSpace(CheckHeigh:double = 0):boolean;&#13;&#10;begin&#13;&#10;  Result:=False;&#13;&#10;  if CheckHeigh=0 then CheckHeigh:=StrH;&#13;&#10;  if (Engine.FreeSpace &#60; CheckHeigh) then&#13;&#10;  begin&#13;&#10;    FillEmptyPage;&#13;&#10;    Result:=True;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure NameHeaderOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  StrSm00:=''; // Ñóììà íàèìåíîâàíèé&#13;&#10;  StrSm01:=''; // Ñóììà îáîçíà÷åíèé&#13;&#10;  StrSm02:=''; // Ñóììà êîëè÷åñòâ èçäåëèé&#13;&#10;  StrSm03:=''; // Ñóììà êîëè÷åñòâà äåòàëåé&#13;&#10;end;&#13;&#10;&#13;&#10;procedure NameDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if StrSm03&#60;&#62;'' then&#13;&#10;  begin&#13;&#10;    StrSm03:=StrSm03+' + ';&#13;&#10;&#13;&#10;  end;&#13;&#10;&#13;&#10;  StrSm03:=StrSm03+FloatToStr(&#60;Ïðèìåíÿåìîñòü.&#34;KolvoSM&#34;&#62;);&#13;&#10;  if &#60;Ïðèìåíÿåìîñòü.&#34;KolvoSM&#34;&#62; &#60;&#62;  &#60;Ïðèìåíÿåìîñòü.&#34;KolvoDT&#34;&#62;  then&#13;&#10;   StrSm03:=StrSm03 +' (' +FloatToStr(&#60;Ïðèìåíÿåìîñòü.&#34;KolvoDT&#34;&#62;)+')';&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  if (&#60;Ïðèìåíÿåìîñòü.&#34;Cod_Predm&#34;&#62; = &#60;IzdelQRY.&#34;Cod_Predm&#34;&#62;)AND(PrintSB.Checked) then&#13;&#10;    exit;&#13;&#10;  if StrSm01&#60;&#62;'' then&#13;&#10;  begin&#13;&#10;    StrSm00:=StrSm00+' + ';&#13;&#10;    StrSm01:=StrSm01+' + ';&#13;&#10;    StrSm02:=StrSm02+' + ';&#13;&#10;  end;&#13;&#10;  StrSm00:=StrSm00+&#60;Ïðèìåíÿåìîñòü.&#34;Name_Predm&#34;&#62;;&#13;&#10;  StrSm01:=StrSm01+&#60;Ïðèìåíÿåìîñòü.&#34;Cod_Predm&#34;&#62;;&#13;&#10;  StrSm02:=StrSm02+FloatToStr(&#60;Ïðèìåíÿåìîñòü.&#34;Kolvo&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure MasterDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  // Ïðîâåðÿåì íåîáõîäèìîñòü ïå÷àòè ðàñøèðåííîãî îïèñàíèÿ&#13;&#10;&#13;&#10; // AdInfoPasp.Visible:=False;&#13;&#10; // AdInfoTP.Visible:=False;&#13;&#10;&#13;&#10;  if not (TPQry.FieldByName('Ad_Info').isnull)   then&#13;&#10;    AdInfoTP.Visible:=True&#13;&#10;  else&#13;&#10;    AdInfoTP.Visible:=False;&#13;&#10;&#13;&#10;  if not (TPQry.FieldByName('Ad_Info_Pasp').isnull)  then&#13;&#10;    AdInfoPasp.Visible:=True&#13;&#1