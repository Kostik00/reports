    <TfrxERQuery Name="EmptySvrMQRY" UserName="ПустыеСВМ" CloseDataSource="False" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="224" Top="288" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       T_SPRows.Key_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Sortam, &#13;&#10;       T_VPredm.Type_NTD_Sortam,&#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       P_SvrM_TT.Cod_TT&#13;&#10;FROM         &#13;&#10;       Pr_Pasp &#13;&#10;       INNER JOIN T_SPRows &#13;&#10;               ON Pr_Pasp.Key_SP = T_SPRows.Key_SP&#13;&#10;              -- and T_SPRows.SP_position &#60; 0                                                              &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON T_SPRows.Key_Predm = T_VPredm.Key_Predm&#13;&#10;                AND T_VPredm.Cod_Prin = &#39;51&#39;                   &#13;&#10;       INNER JOIN Pr_PaspDet &#13;&#10;               ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport&#13;&#10;       INNER JOIN P_VKZ &#13;&#10;               ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;       INNER JOIN P_SvrM &#13;&#10;               ON ((isnull(P_VKZ.Key_VKZ_IZDEL,P_VKZ.Key_VKZ)  = P_SvrM.Key_VKZ_Izdel))                &#13;&#10;               AND T_VPredm.Key_Predm = P_SvrM.Key_Predm &#13;&#10;       INNER JOIN P_SvrM_TT &#13;&#10;               ON P_SvrM.Key_P_SvrM = P_SvrM_TT.Key_P_SvrM&#13;&#10;               AND P_SvrM_TT.Cod_TT=&#39;102&#39;&#13;&#10;WHERE      (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10;          -- AND :Cod_Oper = &#39;0200&#39;                   &#13;&#10;GROUP BY &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       T_SPRows.Key_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Sortam, &#13;&#10;       T_VPredm.Type_NTD_Sortam,&#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       P_SvrM_TT.Cod_TT&#13;&#10;         &#13;&#10;HAVING      (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10;          -- AND :Cod_Oper = &#39;0200&#39;                                               &#13;&#10;                                                                    &#13;&#10;                                       &#13;&#10;ORDER BY T_VPredm.Name_Predm, T_VPredm.Sortam, T_SPRows.Key_Predm, P_SvrM_TT.Cod_TT&#13;&#10;OPTION (FORCE ORDER)">
      <FieldDefs>
        <item FieldName="Key_Pasport"/>
        <item FieldName="Key_Predm"/>
        <item FieldName="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="Sortam" FieldType="fftString" Size="150"/>
        <item FieldName="Type_NTD_Sortam" FieldType="fftString"/>
        <item FieldName="Name_NTD_Sortam" FieldType="fftString" Size="254"/>
        <item FieldName="Marka" FieldType="fftString" Size="150"/>
        <item FieldName="Type_NTD_Marka" FieldType="fftString"/>
        <item FieldName="Name_NTD_Marka" FieldType="fftString" Size="254"/>
        <item FieldName="Cod_TT" FieldType="fftString" Size="20"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Pasport" DataType="ftUnknown"/>
        <item Name="Cod_Oper" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="IzdelQRY" UserName="IzdelQRY" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspFrxDS" Left="100" Top="380" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      P_VKZ_1.Kolvo  AS Kolvo,&#13;&#10;      sum(P_VKZ.Kolvo) AS KolvoDT,&#13;&#10;      sum(Pr_PaspDet.KolvoZap) KolvoSM&#13;&#10;FROM&#13;&#10;    P_VKZ&#13;&#10;    LEFT JOIN P_VKZ P_VKZ_1&#13;&#10;          ON isnull(P_VKZ.Key_VKZ_Izdel,P_VKZ.Key_VKZ) = P_VKZ_1.Key_VKZ&#13;&#10;    LEFT JOIN T_VPredm T_Predm&#13;&#10;          ON T_Predm.Key_Predm = P_VKZ_1.Key_Predm&#13;&#10;    LEFT JOIN dbo.Pr_PaspDet Pr_PaspDet&#13;&#10;          ON  Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;&#13;&#10;WHERE&#13;&#10;        Pr_PaspDet.Key_Pasport=:Key_Pasport&#13;&#10;  AND  P_VKZ.Key_Predm=:Key_Predm&#13;&#10;GROUP BY&#13;&#10;      T_Predm.OrderCod_Predm,&#13;&#10;      T_Predm.Cod_Predm,&#13;&#10;      T_Predm.Name_Predm,&#13;&#10;      P_VKZ_1.Kolvo          &#13;&#10;    &#13;&#10;ORDER BY       T_Predm.OrderCod_Predm                           ">
      <FieldDefs>
        <item FieldName="OrderCod_Predm" FieldAlias="OrderCod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Cod_Predm" FieldAlias="Cod_Predm" FieldType="fftString" Size="100"/>
        <item FieldName="Name_Predm" FieldAlias="Name_Predm" FieldType="fftString" Size="254"/>
        <item FieldName="Kolvo" FieldAlias="Kolvo"/>
        <item FieldName="KolvoDT" FieldAlias="KolvoDT"/>
        <item FieldName="KolvoSM" FieldAlias="KolvoSM"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_Pasport" DataType="ftUnknown"/>
        <item Name="Key_Predm" DataType="ftUnknown"/>
      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="WSIQRY" UserName="ВСИ" CloseDataSource="False" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="36" Top="460" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_VPredm.Cod_Predm AS Cod_Predm_Master, &#13;&#10;       T_VPredm.Name_Predm AS Name_Predm_Master,&#13;&#10;         &#13;&#10;       P_VKZ.Kolvo AS KolvoDSE, &#13;&#10;       P_VKZ.Kolvo_On_Izdel AS Kolvo_On_Izdel,&#13;&#10;         &#13;&#10;       T_VPredm.Key_Predm,                                 &#13;&#10;       T_VPredm.PrintFlag,&#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam,&#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       T_VPredm.Cod_Prin, &#13;&#10;       T_VPredm.Name_Prin, &#13;&#10;       T_VPredm.Sortam ,&#13;&#10;       T_VPredm.Cod_Postav Cod_Postav, &#13;&#10;       T_VPredm.Name_Postav,&#13;&#10;&#13;&#10;       T_SPRows.Kolvo,&#13;&#10;       dbo.P_VKZ_GetPaspList(P_VKZ.Key_VKZ)   PaspList                                               &#13;&#10;         &#13;&#10;FROM         &#13;&#10;       P_VKZ AS P_VKZ &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON T_VPredm.Key_Predm = P_VKZ.Key_Predm&#13;&#10;       INNER JOIN T_SPRows &#13;&#10;               ON T_SPRows.Key_SpRow = P_VKZ.Key_SpRow             &#13;&#10;                          &#13;&#10;&#13;&#10;WHERE     (P_VKZ.Key_VKZ_Master = (Select top 1 Key_VKZ from Pr_PaspDet where Pr_PaspDet.Key_Pasport= :Key_Pasport ))&#13;&#10;&#13;&#10;ORDER BY    Cod_Postav, Cod_Prin, T_VPredm.OrderCod_Predm                                                                                   &#13;&#10;&#13;&#10;    ">
      <FieldDefs>
