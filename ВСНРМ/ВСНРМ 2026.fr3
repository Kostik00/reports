<TfrxReport Version="2026.2.4" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="ВСНРМ.fr3 ВСНРМ 6016 от 30.09.2026" ReportOptions.LastChange="46333,0198124884" ScriptLanguage="PascalScript" ScriptText.Text="Uses &#39;CommonRU.pas&#39;;&#13;&#10;var&#13;&#10;  Cnt:integer;&#13;&#10;  Massa:double;&#13;&#10;&#13;&#10;&#13;&#10;procedure WSNRMDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.Freespace &#60; 2*WSNRMData.Height then&#13;&#10;    Engine.NewPage;&#13;&#10;  Cnt:=Cnt+1;&#13;&#10;  PredmFtr.Visible:=Cnt&#60;&#62;1;&#13;&#10;&#13;&#10;  KimData.Visible := ( &#60;ВСНРМ.&#34;Massa&#34;&#62; &#62; 0) and ( &#60;ВСНРМ.&#34;KolvoinKG&#34;&#62; &#62; 0)  and (&#60;ВСНРМ.&#34;Sp_Position&#34;&#62; = 0);&#13;&#10;&#13;&#10;  MDTData.Visible := ((GetKim &#62; 1) or  (GetKim &#60; 0.7)) and  (&#60;ВСНРМ.&#34;Sp_Position&#34;&#62; = 0);&#13;&#10;&#13;&#10;&#13;&#10;  if &#60;ВСНРМ.&#34;Massa&#34;&#62; &#60;= 0 then&#13;&#10;    MM1.Color := $008080FF&#13;&#10;  else&#13;&#10;    MM1.Color := clNone;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PredmHDROnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Cnt:=0;&#13;&#10;  Engine.AddAnchor(&#60;ВСНРМ.&#34;Cod_Predm&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo101OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Massa:=SUM(&#60;Изделия.&#34;Kolvo&#34;&#62;*&#60;Изделия.&#34;Massa&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;function GetKim:double;&#13;&#10;begin&#13;&#10;  if &#60;ВСНРМ.&#34;KolvoinKG&#34;&#62; &#62; 0 then&#13;&#10;     Result:= &#60;ВСНРМ.&#34;Massa&#34;&#62;*&#60;ВСНРМ.&#34;KolDSE&#34;&#62; / &#60;ВСНРМ.&#34;KolvoinKG&#34;&#62;&#13;&#10;  else&#13;&#10;    result:=0;&#13;&#10;  //  Result:=5123;&#13;&#10;end;&#13;&#10;procedure KimDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  if  (GetKim &#62; 1)  then&#13;&#10;    KimMemo.Color := $008080FF&#13;&#10;  else&#13;&#10;    KimMemo.Color := clNone;&#13;&#10;&#13;&#10;  if   (GetKim &#60; 0.7) then&#13;&#10;    KimMemo.Font.Color := clRed&#13;&#10;  else&#13;&#10;    KimMemo.Font.Color := clWindowText;&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure TitlePageOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  fl:boolean;&#13;&#10;begin&#13;&#10;  FL:= MyReadProp(&#39;ВСНРМУДолжн&#39;)&#60;&#62;&#39;&#39;;&#13;&#10;  UtvMemo1.Visible:=Fl;&#13;&#10;  UtvMemo2.Visible:=Fl;&#13;&#10;  UtvMemo3.Visible:=Fl;&#13;&#10;  UtvMemo4.Visible:=Fl;&#13;&#10;  UtvMemo5.Visible:=Fl;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
