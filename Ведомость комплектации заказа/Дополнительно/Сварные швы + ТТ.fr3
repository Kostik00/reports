<TfrxReport Version="4.11.16" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="Ñâàðíûå øâû + ÒÒ.fr3 ÂÊÇ ¹ 515-Ê08" ReportOptions.LastChange="40886,5788408565" ScriptLanguage="PascalScript" ScriptText.Text="//Test&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;  &#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MyRestoreString('ÍîìåðÎòãðóçêè', NumOtgr.Text);&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnDeactivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MySaveString('ÍîìåðÎòãðóçêè', NumOtgr.Text);&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="SvrList" UserName="SvrList" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       Pr_Pasp.Cod_Pasp, &#13;&#10;       Pr_Pasp.Key_Predm, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_Svr.NumSvr, &#13;&#10;       dbo.T_OrderSortam(T_Svr.NumSvr) AS OrderNumSvr, &#13;&#10;       Pr_Svr.AdNumSvr, &#13;&#10;       Pr_Svr.Key_PrSvr,&#13;&#10;       T_Svr.Key_Svr,&#13;&#10;       Pr_Svr.DateSvr, &#13;&#10;       Pr_Svr.ZavNumFrom, &#13;&#10;       Pr_Svr.ZavNumTo&#13;&#10;FROM         &#13;&#10;    Pr_Otgr Pr_Otgr&#13;&#10;    INNER JOIN P_VKZ  ON (Pr_Otgr.Key_VKZ=P_VKZ.Key_VKZ_Izdel)  INNER JOIN&#13;&#10;      &#13;&#10;                      Pr_PaspDet ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ INNER JOIN&#13;&#10;                      Pr_Pasp ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport INNER JOIN&#13;&#10;                      T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm INNER JOIN&#13;&#10;                      T_Svr ON Pr_Pasp.Key_SP = T_Svr.Key_SP LEFT OUTER JOIN&#13;&#10;                      Pr_Svr ON Pr_Pasp.Key_Pasport = Pr_Svr.Key_Pasport AND T_Svr.Key_Svr = Pr_Svr.Key_Svr&#13;&#10;WHERE     (Pr_Otgr.NumOtgr = :NumOtgr)&#13;&#10;ORDER BY OrderNumSvr  " PropData="05704C65667402780470546F7003BC000A506172616D657465727301010C3D000000204E616D653D224E756D4F746772222044617461547970653D226674537472696E67222045787072657373696F6E3D224E756D4F7467722E54657874220000"/>
    <TfrxERQuery Name="TTQry" UserName="TTQry" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SvrList" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT                     &#13;&#10;	Pr_VSvrKontr.Key_PrSvr	Key_PrSvr, &#13;&#10;	Pr_VSvrKontr.Key_Svr 	Key_Svr,  &#13;&#10;	Pr_VSvrKontr.Key_NaprZakl 				Key_NaprZakl,&#13;&#10;	Pr_VSvrKontr.Key_Napr					Key_Napr, &#13;&#10;	Pr_VSvrKontr.Num_Napr					Num_Napr, &#13;&#10;	Pr_VSvrKontr.Data_Napr					Data_Napr, &#13;&#10;	Pr_VSvrKontr.Key_Zakl					Key_Zakl, &#13;&#10;	Pr_VSvrKontr.Vid_Zakl					Vid_Zakl, &#13;&#10;	Pr_VSvrKontr.Num_Zakl					Num_Zakl, &#13;&#10;	Pr_VSvrKontr.Data_Zakl					Data_Zakl, &#13;&#10;	isnull(Pr_VSvrKontr.Cod_TT	,Pr_VSvrTT.Cod_TT) 	Cod_TT,&#13;&#10;  &#13;&#10;	isnull(Pr_VSvrKontr.Name_TT	,Pr_VSvrTT.Name_TT) 	Name_TT, &#13;&#10;	isnull(Pr_VSvrKontr.VolKontr	,Pr_VSvrTT.VolKontr) 	VolKontr, &#13;&#10;	isnull(Pr_VSvrKontr.ParamKontr 	,Pr_VSvrTT.ParamKontr) 	ParamKontr, &#13;&#10;	isnull(Pr_VSvrKontr.Name_NTD	,Pr_VSvrTT.Name_NTD)	Name_NTD, &#13;&#10;	Pr_VSvrKontr.ZavNumFrom 	ZavNumFrom, &#13;&#10;	Pr_VSvrKontr.ZavNumTo 	ZavNumTo&#13;&#10;  &#13;&#10;FROM         &#13;&#10;   Pr_VSvrTT1 Pr_VSvrTT&#13;&#10;  &#13;&#10;  FULL OUTER JOIN  Pr_VSvrKontr&#13;&#10;  ON     &#13;&#10;		    Pr_VSvrTT.Cod_TT = Pr_VSvrKontr.Cod_TT &#13;&#10;		AND Pr_VSvrTT.Key_Svr = Pr_VSvrKontr.Key_Svr&#13;&#10;  AND  Pr_VSvrKontr.Key_PrSvr = :Key_PrSvr       &#13;&#10; &#13;&#10;&#13;&#10;WHERE&#13;&#10;      Pr_VSvrTT.Key_Svr = :Key_Svr&#13;&#10; OR Pr_VSvrKontr.Key_PrSvr = :Key_PrSvr  &#13;&#10;    &#13;&#10;ORDER BY Cod_TT&#13;&#10;&#13;&#10;&#13;&#10;  " PropData="05704C656674039C000470546F700308010A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E2200010C24000000204E616D653D224B65795F537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="IzdelQRY" UserName="IzdelQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT T.Cod_Predm, T.Name_Predm, P.NumOtgr&#13;&#10;FROM&#13;&#10;    Pr_Otgr P&#13;&#10;    INNER JOIN Pr_PaspDet P1 ON (P.Key_VKZ=P1.Key_VKZ)&#13;&#10;    INNER JOIN Pr_Pasp P2 ON (P1.Key_Pasport=P2.Key_Pasport)&#13;&#10;    INNER JOIN T_VPredm T ON (P2.Key_Predm=T.Key_Predm)&#13;&#10;WHERE&#13;&#10;    P.NumOtgr =:NumOtgr" SQLSchema="eAF9j0FrwzAMhe8G/xMdbCl2koIuW2CXkHks7BJKcIkZYUs7kvT/127a0tPQxfL3pKfXVX71L34Jeyk+P2omKi2ZXFsjRdf6w29YInHs5v59/Z4BM0ALqBRoo6RwOhHnl78qrGAJKMufKN4pFBYsIlBh4jxJ0XLbf7k5DBMUOZSFgsyUQHnc2b3N4xBNFb+ehn7TPMQtaFDXkkJz46fwnwK5OU/Xu+/3u8c8724sBq3H40/KqTht15smGWB8asBkKAVyDB8/aGsvJVBQJw==" PropData="05704C65667402780470546F7002400A506172616D657465727301010C3D000000204E616D653D224E756D4F746772222044617461547970653D226674537472696E67222045787072657373696F6E3D224E756D4F7467722E54657874220000"/>
