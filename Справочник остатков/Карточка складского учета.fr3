  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;  A_Ostatok_Mat.Key_Sub_Ver,&#13;&#10;  A_Ostatok_Mat.Key_ID_Mat,&#13;&#10;  A_Nacl.Key_Nacl,&#13;&#10;  A_Nacl.Num_Nacl,&#13;&#10;  A_Nacl.Data_Nacl,&#13;&#10;  A_Nacl.Osnovanie,&#13;&#10;  A_Nacl.Sost,&#13;&#10;  A_Nacl_Str.KolvoInBaseEd                                        &#13;&#10;FROM&#13;&#10;  A_Ostatok_Mat&#13;&#10;  INNER JOIN A_Nacl&#13;&#10;    ON   ((A_Ostatok_Mat.Key_Sub_Ver = A_Nacl.Key_Sub_Ver_From)&#13;&#10;      OR (A_Ostatok_Mat.Key_Sub_Ver = A_Nacl.Key_Sub_Ver_To))&#13;&#10;  INNER JOIN A_Nacl_Str&#13;&#10;    ON A_Nacl.Key_Nacl = A_Nacl_Str.Key_Nacl&#13;&#10;    AND A_Ostatok_Mat.Key_ID_Mat = A_Nacl_Str.Key_ID_Mat&#13;&#10;&#13;&#10;WHERE&#13;&#10;      A_Ostatok_Mat.Key_Sub_Ver=:Key_Sub_Ver               &#13;&#10;  AND A_Ostatok_Mat.Key_ID_Mat=:Key_ID_Mat&#13;&#10;&#13;&#10;ORDER BY&#13;&#10;  A_Nacl.Data_Nacl&#13;&#10;    " PropData="05704C65667402540470546F70022C0A506172616D657465727301010C28000000204E616D653D224B65795F5375625F566572222044617461547970653D226674556E6B6E6F776E2200010C27000000204E616D653D224B65795F49445F4D6174222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="ERQuery2" UserName="ERQuery2" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT     A_VMPrimen.Key_Pasport, A_VMPrimen.Cod_Pasp, A_VMPrimen.Key_ID_Mat, A_VMPrimen.Cod_Zak, A_VMPrimen.Cod_Predm, A_VMPrimen.Name_Predm, &#13;&#10;                      A_VMPrimen.Sortam, T_Zagotov.Name_Zagotov, Pr_SPDetail.ProfRazm, Pr_SPDetail.M_Zag, Pr_SPDetail.Kolvo&#13;&#10;FROM         Pr_SPDetail INNER JOIN&#13;&#10;                      Pr_SP ON Pr_SPDetail.Key_PrSp = Pr_SP.Key_PrSP INNER JOIN&#13;&#10;                      A_VMPrimen ON Pr_SP.Key_Pasport = A_VMPrimen.Key_Pasport INNER JOIN&#13;&#10;                      T_Zagotov ON Pr_SPDetail.Cod_Zagotov = T_Zagotov.Cod_Zagotov&#13;&#10;WHERE     (A_VMPrimen.Key_ID_Mat = :Key_ID_Mat )  " PropData="05704C65667402540470546F7002780A506172616D657465727301010C27000000204E616D653D224B65795F49445F4D6174222044617461547970653D226674556E6B6E6F776E220000"/>
