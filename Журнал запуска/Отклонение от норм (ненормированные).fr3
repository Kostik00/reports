<TfrxReport Version="4.11.16" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40900,9961904861" ReportOptions.Description.Text="" ReportOptions.Name="Îòêëîíåíèå îò íîðì (íåíîðìèðîâàííûå).fr3 Æóðíàë çàïóñêà" ReportOptions.LastChange="40963,5358183912" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2A00000020446174615365743D224B6F6E74725152592220446174615365744E616D653D22CAEEEDF2F0EEEBFC2200010C3000000020446174615365743D224B6F6E747244657461696C2220446174615365744E616D653D22C4E5F2E0EBE8CAEEEDF2F0220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="KontrQRY" UserName="Êîíòðîëü" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT Pr_Pasp.Key_Pasport,&#13;&#10;       Pr_Pasp.Cod_Pasp,&#13;&#10;       Pr_Pasp_Rows.N_Oper_Sm, &#13;&#10;       T_Oper.Name_K_Oper,&#13;&#10;         &#13;&#10;       SUM(Pr_Tabel_MK.Tzap) AS TZap, &#13;&#10;       Pr_Pasp_Rows.Tsm ,&#13;&#10;		T_VPredm.Cod_Predm,&#13;&#10;		T_VPredm.Name_Predm,&#13;&#10;		T_VPredm.OrderCod_Predm,&#13;&#10;  Pr_Pasp.Cod_Zak                                      &#13;&#10;        &#13;&#10; &#13;&#10;       &#13;&#10;FROM         &#13;&#10;	Pr_Tabel &#13;&#10;	INNER JOIN Pr_Tabel_MK &#13;&#10;		ON Pr_Tabel.Key_Tabel = Pr_Tabel_MK.Key_Tabel &#13;&#10;	INNER JOIN Pr_Pasp_Rows &#13;&#10;		ON Pr_Tabel_MK.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows &#13;&#10;	INNER JOIN Pr_Pasp &#13;&#10;		ON Pr_Pasp_Rows.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;	INNER JOIN T_Oper &#13;&#10;		ON Pr_Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper&#13;&#10;	INNER JOIN T_VPredm&#13;&#10;		ON T_VPredm.Key_Predm=Pr_Pasp.Key_Predm&#13;&#10;GROUP BY &#13;&#10;	Pr_Pasp_Rows.Tsm, &#13;&#10;	Pr_Pasp.Cod_Pasp, &#13;&#10;	Pr_Pasp_Rows.N_Oper_Sm, &#13;&#10;	T_Oper.Name_K_Oper, &#13;&#10;	Pr_Pasp.Key_Pasport,&#13;&#10;		T_VPredm.Cod_Predm,&#13;&#10;		T_VPredm.Name_Predm,&#13;&#10;		T_VPredm.OrderCod_Predm,&#13;&#10;  Pr_Pasp.Cod_Zak  &#13;&#10;HAVING      &#13;&#10;		(SUM(Pr_Tabel_MK.Tzap) &#62; isnull(Pr_Pasp_Rows.Tsm,0))   &#13;&#10;	AND (isnull(Pr_Pasp_Rows.Tsm,0) &#60; 0.001)&#13;&#10;&#13;&#10;&#13;&#10;ORDER BY&#13;&#10;&#13;&#10;  Pr_Pasp.Cod_Zak,         &#13;&#10;		T_VPredm.OrderCod_Predm                                        " PropData="05704C65667402400470546F7002340A506172616D65746572730100"/>
    <TfrxERQuery Name="KontrDetail" UserName="ÄåòàëèÊîíòð" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="KontrQRY" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       Pr_Pasp_Rows.N_Oper_Sm, &#13;&#10;       S_SubVer.F_Name_Sub, &#13;&#10;       Pr_Tabel_MK.Tzap, &#13;&#10;       Pr_Tabel.Date_Tabel&#13;&#10;FROM         &#13;&#10;       Pr_Pasp &#13;&#10;       INNER JOIN Pr_Pasp_Rows &#13;&#10;               ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport &#13;&#10;       INNER JOIN Pr_Tabel_MK &#13;&#10;               ON Pr_Pasp_Rows.Key_Pasp_Rows = Pr_Tabel_MK.Key_Pasp_Rows &#13;&#10;       INNER JOIN Pr_Tabel &#13;&#10;               ON Pr_Tabel_MK.Key_Tabel = Pr_Tabel.Key_Tabel &#13;&#10;       INNER JOIN S_SubVer &#13;&#10;               ON Pr_Tabel.Key_Sub_Ver = S_SubVer.Key_Sub_Ver&#13;&#10;WHERE     &#13;&#10;           (Pr_Pasp.Key_Pasport = :Key_Pasport) &#13;&#10;       AND (Pr_Pasp_Rows.N_Oper_Sm = :N_Oper_Sm)" PropData="05704C6566740398000470546F7002340A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E2200010C26000000204E616D653D224E5F4F7065725F536D222044617461547970653D226674556E6B6E6F776E220000"/>
