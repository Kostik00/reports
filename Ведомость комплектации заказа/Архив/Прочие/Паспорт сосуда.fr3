    <TfrxERQuery Name="ListDSE1" UserName="Äåòàëè" CloseDataSource="False" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Cod_Pasp=Cod_Pasp&#13;&#10;Key_SP=Key_SP&#13;&#10;Key_TP=Key_TP&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;OrderCod_Predm=OrderCod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;KolvoDet=KolvoDet&#13;&#10;SkipSert=SkipSert&#13;&#10;Cod_TP=Cod_TP&#13;&#10;Name_FMat=Name_FMat&#13;&#10;Sortam_FMat=Sortam_FMat&#13;&#10;Type_NTD_Sortam_Mat=Type_NTD_Sortam_Mat&#13;&#10;Name_NTD_Sortam_Mat=Name_NTD_Sortam_Mat&#13;&#10;Marka_FMat=Marka_FMat&#13;&#10;MarkaPrn_FMat=MarkaPrn_FMat&#13;&#10;Type_NTD_Marka_Mat=Type_NTD_Marka_Mat&#13;&#10;Name_NTD_Marka_Mat=Name_NTD_Marka_Mat&#13;&#10;Key_ID_Mat=Key_ID_Mat&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;Party=Party&#13;&#10;Key_Sert_Pos=Key_Sert_Pos&#13;&#10;PaspMat=PaspMat" Master="MainFrxDS" SQL.Text="SELECT DISTINCT&#13;&#10;&#13;&#10;  PR_Pasp.Key_Pasport,&#13;&#10;  PR_Pasp.Cod_Pasp,&#13;&#10;  PR_Pasp.Key_SP,&#13;&#10;  PR_Pasp.Key_TP,&#13;&#10;&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.OrderCod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam,&#13;&#10;&#13;&#10;  dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport ) KolvoDet,&#13;&#10;&#13;&#10;  T_TP.SkipSert,&#13;&#10;  T_TP.Cod_TP,&#13;&#10;&#13;&#10;  FMat.Name_Predm      Name_FMat,&#13;&#10;&#13;&#10;  FMat.Sortam          Sortam_FMat,&#13;&#10;  FMat.Type_NTD_Sortam Type_NTD_Sortam_Mat,&#13;&#10;  FMat.Name_NTD_Sortam Name_NTD_Sortam_Mat,&#13;&#10;&#13;&#10;  FMat.Marka           Marka_FMat,&#13;&#10;  FMat.MarkaPrn        MarkaPrn_FMat,&#13;&#10;  FMat.Type_NTD_Marka  Type_NTD_Marka_Mat,&#13;&#10;  FMat.Name_NTD_Marka  Name_NTD_Marka_Mat,&#13;&#10;&#13;&#10;  A_VId_Mat.Key_ID_Mat,&#13;&#10;  A_VId_Mat.N_Sert,&#13;&#10;  A_VId_Mat.Date_Sert,&#13;&#10;  A_VId_Mat.Cod_Plavka,&#13;&#10;  A_VId_Mat.Party,&#13;&#10;  A_VId_Mat.Key_Sert_Pos,&#13;&#10;  A_VId_Mat.Key_Pasport PaspMat&#13;&#10;&#13;&#10;FROM&#13;&#10;  P_VKZ P_VKZ                       -- áåðåì  âñþ ÂÊÇ íà èçäåëèå&#13;&#10;&#13;&#10;  INNER JOIN PR_PaspDet             -- ñìîòðèì äëÿ íåå êàêèå åñòü ïàñïîðòà&#13;&#10;    ON PR_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  INNER JOIN PR_Pasp                -- áåðåì âñå ïàñïîðòà&#13;&#10;    ON  PR_Pasp.Key_Pasport=PR_PaspDet.Key_Pasport&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm       -- äàííûå î ñàìèõ ÄÑÅ&#13;&#10;    ON T_Predm.Key_Predm=PR_Pasp.Key_Predm&#13;&#10;  INNER JOIN T_SP                    -- òàêæå ïðîñìàòðèâàåì ñïåöèôèêàöèþ&#13;&#10;    ON T_SP.Key_SP=PR_Pasp.Key_SP&#13;&#10;  INNER JOIN Pr_SP                   -- Íó è ñìîòðèì òîëüêî òî, íà ÷òî åñòü ôàêòè÷åñêèé ìàòåðèàë&#13;&#10;    ON Pr_SP.Key_Pasport=PR_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_SPRows                 -- Èç ôàêòè÷åñêèõ ìàòåðèàëîâ íàñ èíòåðåñóåò òîëüêî òå, êîòîðûå îòíîñÿòñÿ ê îñíîâíûì ìàòåðèàëàì&#13;&#10;    ON  T_SPRows.Key_SPRow=Pr_SP.Key_SPRow&#13;&#10;    AND T_SPRows.SP_Position=0&#13;&#10;  INNER JOIN A_VId_Mat                -- Ýòî ìû ñìîòðèì ìàòåðèàë â èäåíòåôèêàòîðå&#13;&#10;    ON A_VId_Mat.Key_ID_Mat=Pr_SP.Key_ID_Mat&#13;&#10;  LEFT JOIN T_VPredm FMat            -- À ýòî ñîáñòâåííî ãîâîðÿ è åñòü ñàì ìàòåðèàë&#13;&#10;    ON FMat.Key_Predm=A_VId_Mat.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_TP                    -- âûáèðàåì ïàðàìåòðû ÒÏ è ïðîâåðÿåì, ÷òî åãî íàäî âûäàâàòü â ïàñïîðò&#13;&#10;    ON T_TP.Key_TP=PR_Pasp.Key_TP&#13;&#10;    AND T_SP.InTB1=1&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  P_VKZ.Key_VKZ_Izdel=:Key_VKZ_Izdel&#13;&#10;  AND dbo.Pr_GetKolvoOnVKZ(:Key_VKZ_Izdel, :Num_Izdel , PR_Pasp.Key_Pasport ) &#62; 0&#13;&#10;  AND T_Predm.Cod_Prin='11'                                                 &#13;&#10;&#13;&#10;&#13;&#10;ORDER BY T_Predm.OrderCod_Predm" PropData=""/>
    <TfrxERQuery Name="SvrQRY" UserName="Ñâàðêà" CloseDataSource="True" FieldAliases.Text="" Master="ListDSE1" SQL.Text="SELECT     &#13;&#10;       Pr_Svr.Key_PrSvr, &#13;&#10;       Pr_Svr.DateSvr, &#13;&#10;       Pr_Svr.Key_Pasport, &#13;&#10;       T_SvrSposob.SpSvr, &#13;&#10;       T_VPredm.PrintFlag, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Sortam,&#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka&#13;&#10;FROM         &#13;&#10;       Pr_Svr &#13;&#10;       INNER JOIN T_Svr &#13;&#10;               ON Pr_Svr.Key_Svr = T_Svr.Key_Svr &#13;&#10;       INNER JOIN T_SvrSposob &#13;&#10;               ON Pr_Svr.Key_Sposob = T_SvrSposob.Key_Sposob&#13;&#10;       INNER JOIN Pr_Svr_Mat &#13;&#10;               ON Pr_Svr.Key_PrSvr = Pr_Svr_Mat.Key_PrSvr&#13;&#10;       INNER JOIN A_VID_Mat &#13;&#10;               ON Pr_Svr_Mat.Key_Id_Mat = A_VID_Mat.Key_ID_Mat&#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE     (Pr_Svr.Key_Pasport = :Key_Pasport)                              " PropData="05704C6566740380000470546F7002140A506172616D657465727301010C28000000204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E220000"/>
