<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="43199,6893315162" ReportOptions.Description.Text="" ReportOptions.Name="Ðàñõîä ÎÌ íà èçäåëèå.fr3 Ñïðàâî÷íèê èçäåëèé" ReportOptions.LastChange="43202,6683698958" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';&#13;&#10;&#13;&#10;function PmNamePredm:string;&#13;&#10;begin&#13;&#10;  Result := PrintPredm  (&#60;ERQuery1.&#34;PrintFlag_Plan_Mat&#34;&#62;,&#60;ERQuery1.&#34;Cod_Predm_Plan_Mat&#34;&#62;,&#60;ERQuery1.&#34;Name_Predm_Plan_Mat&#34;&#62;,&#13;&#10;                         &#60;ERQuery1.&#34;Sortam_Plan_Mat&#34;&#62;,   &#60;ERQuery1.&#34;Type_NTD_Sortam_Plan_Mat&#34;&#62;, &#60;ERQuery1.&#34;Name_NTD_Sortam_Plan_Mat&#34;&#62;,&#13;&#10;                         &#60;ERQuery1.&#34;Marka_Plan_Mat&#34;&#62;,    &#60;ERQuery1.&#34;Type_NTD_Marka_Plan_Mat&#34;&#62;,  &#60;ERQuery1.&#34;Name_NTD_Marka_Plan_Mat&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function FmNamePredm:string;&#13;&#10;begin&#13;&#10;Result := PrintPredm  (&#60;ERQuery1.&#34;PrintFlag_Fakt_Mat&#34;&#62;,&#60;ERQuery1.&#34;Cod_Predm_Fakt_Mat&#34;&#62;,&#60;ERQuery1.&#34;Name_Predm_Fakt_Mat&#34;&#62;,&#13;&#10;                         &#60;ERQuery1.&#34;Sortam_Fakt_Mat&#34;&#62;,   &#60;ERQuery1.&#34;Type_NTD_Sortam_Fakt_Mat&#34;&#62;, &#60;ERQuery1.&#34;Name_NTD_Sortam_Fakt_Mat&#34;&#62;,&#13;&#10;                         &#60;ERQuery1.&#34;Marka_Fakt_Mat&#34;&#62;,    &#60;ERQuery1.&#34;Type_NTD_Marka_Fakt_Mat&#34;&#62;,  &#60;ERQuery1.&#34;Name_NTD_Marka_Fakt_Mat&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;function PrintKolvo:double;&#13;&#10;var&#13;&#10;  TmpKolvo:double;&#13;&#10;  Tmp:double;&#13;&#10;begin&#13;&#10;  Result :=0;&#13;&#10;       //PrintPredm ( &#60;ERQuery1.&#34;T_SPRows_Kolvo&#34;&#62;/&#60;ERQuery1.&#34;T_SPRows_KolvoParty&#34;&#62;*&#60;ERQuery1.&#34;T_SPRows_Massa_One&#34;&#62;);&#13;&#10;  if (&#60;ERQuery1.&#34;T_SPRows_Use_Zagotov&#34;&#62; = 1) then&#13;&#10;  begin&#13;&#10;    TmpKolvo:= Trunc(&#60;ERQuery1.&#34;PaspKolvo&#34;&#62; *1.0 /&#60;ERQuery1.&#34;T_SPRows_EdNorm&#34;&#62;);&#13;&#10;    if Frac(&#60;ERQuery1.&#34;PaspKolvo&#34;&#62; *1.0 /&#60;ERQuery1.&#34;T_SPRows_EdNorm&#34;&#62;) &#62; 0 then  TmpKolvo:=TmpKolvo+1;&#13;&#10;&#13;&#10;    Result:=  TmpKolvo* &#60;ERQuery1.&#34;T_SPRows_Massa_One&#34;&#62;;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;     TmpKolvo:= Trunc(&#60;ERQuery1.&#34;T_SPRows_Kolvo&#34;&#62; *1.0 * &#60;ERQuery1.&#34;PaspKolvo&#34;&#62;);&#13;&#10;     Tmp:= Trunc(&#60;ERQuery1.&#34;T_SPRows_KolvoParty&#34;&#62; *1.0 * (&#60;ERQuery1.&#34;T_SPRows_Kolvo&#34;&#62;  / &#60;ERQuery1.&#34;T_SPRows_EdNorm&#34;&#62;));&#13;&#10;      if Frac (&#60;ERQuery1.&#34;T_SPRows_Kolvo&#34;&#62; *1.0 * &#60;ERQuery1.&#34;PaspKolvo&#34;&#62;) &#62; 0 then  TmpKolvo:=TmpKolvo+1;&#13;&#10;&#13;&#10;    Result:=  TmpKolvo + Tmp;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
  <Datasets>
    <item DataSet="ERQuery1" DataSetName="ERQuery1"/>
    <item DataSet="MainFrxDS" DataSetName="MainDS"/>
  </Datasets>
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT         Pr_Pasp.Cod_Pasp,                                                 &#13;&#10;               P_VKZ.Key_VKZ_Izdel, &#13;&#10;               Pr_PaspDet.KolvoZap,&#13;&#10;               Pr_PaspDet.KolFakt,  &#13;&#10;               &#13;&#10;               T_SPRows.Massa_One as T_SPRows_Massa_One,&#13;&#10;               T_SPRows.Kolvo as T_SPRows_Kolvo,&#13;&#10;               T_SPRows.KolvoParty as T_SPRows_KolvoParty,&#13;&#10;               T_SPRows.KolZag as T_SPRows_KolZag,&#13;&#10;               T_SPRows.UseZagotov as T_SPRows_Use_Zagotov,&#13;&#10;               T_SPRows.EdNorm as T_SPRows_EdNorm,                                                                                                   &#13;&#10;                 &#13;&#10;               A_VID_Mat.Key_Sert, &#13;&#10;               A_VID_Mat.N_Sert, &#13;&#10;               A_VID_Mat.VidSert, &#13;&#10;               A_VID_Mat.Date_Sert, &#13;&#10;               A_VID_Mat.Party, &#13;&#10;               A_VID_Mat.Cod_Plavka, &#13;&#10;               A_VID_Mat.N_SertPos,&#13;&#10;                 &#13;&#10;               Pr_Pasp.Date_Pasp, &#13;&#10;               Pr_Pasp.Key_Pasp_Status,&#13;&#10;               Pr_Pasp.Key_Sub_Master, &#13;&#10;               Pr_Pasp.PaspKolvo, &#13;&#10;               Pr_Pasp.Key_Pasp_Ev, &#13;&#10;               Pr_Pasp.Date_Pasp_Status,  &#13;&#10;                                    &#13;&#10;                                                                                                &#13;&#10;               DSE.Sortam AS Sortam_DSE, &#13;&#10;               DSE.Type_NTD_Sortam AS Type_NTD_Sortam_DSE,&#13;&#10;               DSE.Name_NTD_Sortam AS Name_NTD_Sortam_DSE, &#13;&#10;               DSE.Marka AS Marka_DSE, &#13;&#10;               DSE.Type_NTD_Marka AS Type_NTD_Marka_DSE, &#13;&#10;               DSE.Name_NTD_Marka AS Name_NTD_Marka_DSE,&#13;&#10;                                                                                    &#13;&#10;&#13;&#10;               Plan_mat.Cod_Predm as Cod_Predm_Plan_Mat,                                                                                                     &#13;&#10;               Plan_Mat.Name_Predm as Name_Predm_Plan_Mat,&#13;&#10;               Plan_Mat.PrintFlag as PrintFlag_Plan_Mat,                                                                                                     &#13;&#10;               Plan_Mat.Sortam AS Sortam_Plan_Mat,                        &#13;&#10;               Plan_Mat.Type_NTD_Sortam AS Type_NTD_Sortam_Plan_Mat, &#13;&#10;               Plan_Mat.Name_NTD_Sortam AS Name_NTD_Sortam_Plan_Mat, &#13;&#10;               Plan_Mat.Marka AS Marka_Plan_Mat,                         &#13;&#10;               Plan_Mat.Type_NTD_Marka AS Type_NTD_Marka_Plan_Mat, &#13;&#10;               Plan_Mat.Name_NTD_Marka AS Name_NTD_Marka_Plan_Mat,&#13;&#10;&#13;&#10;&#13;&#10;               Fakt_mat.Cod_Predm as Cod_Predm_Fakt_Mat,                                                                                                     &#13;&#10;               Fakt_Mat.Name_Predm as Name_Predm_Fakt_Mat,&#13;&#10;               Fakt_Mat.PrintFlag as PrintFlag_Fakt_Mat,                     &#13;&#10;               Fakt_Mat.Sortam AS Sortam_Fakt_Mat, &#13;&#10;               Fakt_Mat.Type_NTD_Sortam AS Type_NTD_Sortam_Fakt_Mat,                         &#13;&#10;               Fakt_Mat.Name_NTD_Sortam AS Name_NTD_Sortam_Fakt_Mat, &#13;&#10;               Fakt_Mat.Marka AS Marka_Fakt_Mat, &#13;&#10;               Fakt_Mat.Type_NTD_Marka AS Type_NTD_Marka_Fakt_Mat, &#13;&#10;               Fakt_Mat.Name_NTD_Marka AS Name_NTD_Marka_Fakt_Mat&#13;&#10;                 &#13;&#10;               , TSM.FaktSm,&#13;&#10;               TMS.Kolvo11                                               &#13;&#10;              &#13;&#10;FROM     Pr_Pasp &#13;&#10;                                &#13;&#10;               INNER JOIN&#13;&#10;                Pr_SP &#13;&#10;                       ON &#13;&#10;                       Pr_Pasp.Key_Pasport = Pr_SP.Key_Pasport &#13;&#10;&#13;&#10;				INNER JOIN &#13;&#10;				(&#13;&#10;					SELECT         Key_PrSP, sum(Kolvo * M_Zag) as FaktSm&#13;&#10;					FROM            Pr_SPDetail&#13;&#10;					GROUP BY Key_PrSP&#13;&#10;				) AS  TSM&#13;&#10;				ON TSM.Key_PrSP = Pr_SP.Key_PrSP&#13;&#10;&#13;&#10;   INNER JOIN&#13;&#10;   (SELECT Pr_Pasp.Key_Pasport, count(Pr_SP.Key_PrSp) as Kolvo11                        &#13;&#10;        FROM            Pr_Pasp &#13;&#10;        INNER JOIN  Pr_SP &#13;&#10;        ON Pr_Pasp.Key_Pasport = Pr_SP.Key_Pasport &#13;&#10;		group by Pr_Pasp.Key_Pasport&#13;&#10;	   ) as TMS&#13;&#10;       ON TMS.Key_Pasport = PR_SP.Key_Pasport                                                                                          &#13;&#10;         &#13;&#10;               INNER JOIN&#13;&#10;                T_VPredm AS DSE &#13;&#10;                       ON &#13;&#10;                       Pr_Pasp.Key_Predm = DSE.Key_Predm &#13;&#10;               INNER JOIN&#13;&#10;                T_SPRows &#13;&#10;                       ON &#13;&#10;                       Pr_SP.Key_SPRow = T_SPRows.Key_SPRow &#13;&#10;					   AND Pr_Pasp.Key_SP = T_SPRows.Key_SP &#13;&#10;               INNER JOIN&#13;&#10;                T_VPredm AS Plan_Mat &#13;&#10;                       ON &#13;&#10;                       T_SPRows.Key_Predm = Plan_Mat.Key_Predm &#13;&#10;               INNER JOIN&#13;&#10;                A_VID_Mat &#13;&#10;                       ON Pr_SP.Key_ID_Mat = A_VID_Mat.Key_ID_Mat &#13;&#10;               INNER JOIN&#13;&#10;                T_VPredm AS Fakt_Mat &#13;&#10;                       ON &#13;&#10;                       A_VID_Mat.Key_Predm = Fakt_Mat.Key_Predm&#13;&#10;               INNER JOIN&#13;&#10;                       Pr_PaspDet&#13;&#10;                       ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport &#13;&#10;               INNER JOIN&#13;&#10;                       P_VKZ &#13;&#10;                       ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;               &#13;&#10;                                           &#13;&#10; where &#13;&#10;	PR_Pasp.Key_Pasport in (SELECT  distinct  Pr_PaspDet.Key_Pasport&#13;&#10;                            FROM     Pr_PaspDet         &#13;&#10;                                       INNER JOIN   P_VKZ&#13;&#10;                                         ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;							WHERE P_VKZ.Key_VKZ_Izdel = :Key_VKZ_Izdel  &#13;&#10;							)&#13;&#10;                         &#13;&#10;ORDER BY        Fakt_Mat.Name_Predm, Fakt_Mat.Marka, Fakt_Mat.Sortam, Fakt_Mat.Cod_Predm                                                                                                                      &#13;&#10; &#13;&#10;                         &#13;&#10;                                                                        " PropData="05704C65667402280470546F7002640A506172616D657465727301010C2A000000204E616D653D224B65795F564B5A5F497A64656C222044617461547970653D226674556E6B6E6F776E220000"/>
  </TfrxDataPage>
