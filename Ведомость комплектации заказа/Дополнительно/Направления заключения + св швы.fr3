  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="ERQuery1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT &#13;&#10;       P.NumOtgr, &#13;&#10;--       P.Key_VKZ, &#13;&#10;       P3.Num_Napr, &#13;&#10;       P3.Data_Napr, &#13;&#10;       P3.Cod_TT,&#13;&#10;       P3.Key_Napr,&#13;&#10;    --   P3.Key_NaprZakl,                                           &#13;&#10;       P5.Vid_Zakl, &#13;&#10;       P5.Num_Zakl, &#13;&#10;       P5.Data_Zakl &#13;&#10;&#13;&#10;FROM&#13;&#10;    Pr_Otgr P&#13;&#10;    INNER JOIN P_VKZ P1 ON (P.Key_VKZ=P1.Key_VKZ_Izdel)&#13;&#10;    INNER JOIN Pr_PaspDet P2 ON (P1.Key_VKZ=P2.Key_VKZ)&#13;&#10;      &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;    LEFT JOIN Pr_VNaprZakl P3 &#13;&#10;       ON (P2.Key_Pasport=P3.Key_Pasport)&#13;&#10;       AND P3.Cod_TT not in ('301','301ï','401')           &#13;&#10;    LEFT JOIN Pr_Zakl P5 ON (P3.Key_Zakl=P5.Key_Zakl)&#13;&#10;WHERE&#13;&#10;    P.NumOtgr =:NumOtgr              &#13;&#10;                                            &#13;&#10;ORDER BY&#13;&#10;       P3.Cod_TT, P3.Num_Napr       &#13;&#10;     " SQLSchema="" PropData="05704C65667402780470546F7003E0000A506172616D657465727301010C3D000000204E616D653D224E756D4F746772222044617461547970653D226674537472696E67222045787072657373696F6E3D224E756D4F7467722E54657874220000"/>
    <TfrxERQuery Name="IzdelQRY" UserName="IzdelQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT T.Cod_Predm, T.Name_Predm, P.NumOtgr&#13;&#10;FROM&#13;&#10;    Pr_Otgr P&#13;&#10;    INNER JOIN Pr_PaspDet P1 ON (P.Key_VKZ=P1.Key_VKZ)&#13;&#10;    INNER JOIN Pr_Pasp P2 ON (P1.Key_Pasport=P2.Key_Pasport)&#13;&#10;    INNER JOIN T_VPredm T ON (P2.Key_Predm=T.Key_Predm)&#13;&#10;WHERE&#13;&#10;    P.NumOtgr =:NumOtgr" SQLSchema="eAF9j0FrwzAMhe8G/xMdbCl2koIuW2CXkHks7BJKcIkZYUs7kvT/127a0tPQxfL3pKfXVX71L34Jeyk+P2omKi2ZXFsjRdf6w29YInHs5v59/Z4BM0ALqBRoo6RwOhHnl78qrGAJKMufKN4pFBYsIlBh4jxJ0XLbf7k5DBMUOZSFgsyUQHnc2b3N4xBNFb+ehn7TPMQtaFDXkkJz46fwnwK5OU/Xu+/3u8c8724sBq3H40/KqTht15smGWB8asBkKAVyDB8/aGsvJVBQJw==" PropData="05704C65667402780470546F7002480A506172616D657465727301010C3D000000204E616D653D224E756D4F746772222044617461547970653D226674537472696E67222045787072657373696F6E3D224E756D4F7467722E54657874220000"/>
    <TfrxERQuery Name="ERQuery2" UserName="ERQuery2" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="ERQuery1" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_NaprZakl.Key_Napr, &#13;&#10;       Pr_NaprSvr.Key_NaprZakl, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_Svr.NumSvr, &#13;&#10;       Pr_Svr.AdNumSvr, &#13;&#10;       Pr_Svr.ZavNumFrom, &#13;&#10;       Pr_Svr.ZavNumTo, &#13;&#10;       Pr_NaprZakl.VolKontr&#13;&#10;FROM         Pr_NaprSvr INNER JOIN&#13;&#10;                      Pr_Svr ON Pr_NaprSvr.Key_PrSvr = Pr_Svr.Key_PrSvr INNER JOIN&#13;&#10;                      Pr_Pasp ON Pr_Svr.Key_Pasport = Pr_Pasp.Key_Pasport INNER JOIN&#13;&#10;                      T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm INNER JOIN&#13;&#10;                      T_Svr ON Pr_Svr.Key_Svr = T_Svr.Key_Svr INNER JOIN&#13;&#10;                      Pr_NaprZakl ON Pr_NaprSvr.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;WHERE&#13;&#10;  Pr_NaprZakl.Key_Napr=:Key_Napr&#13;&#10;ORDER BY T_VPredm.OrderCod_Predm                            " PropData="05704C65667403A4000470546F700338010A506172616D657465727301010C25000000204E616D653D224B65795F4E617072222044617461547970653D226674556E6B6E6F776E220000"/>
