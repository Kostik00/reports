    <TfrxERQuery Name="NaprQRY" UserName="Заключение" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="60" Top="20" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT &#13;&#10;                         Pr_Zakl.Key_Zakl, &#13;&#10;                         Pr_Zakl.Vid_Zakl, &#13;&#10;                         Pr_Zakl.Num_Zakl, &#13;&#10;                         Pr_Zakl.Data_Zakl, &#13;&#10;                         T_TP.Cod_TP, &#13;&#10;                         P_VKZ.Cod_Zak, &#13;&#10;                         P_VKZ.Cod_Zak AS Expr1, &#13;&#10;                         Pr_NaprZakl.Cod_TT, &#13;&#10;                         T_TechTreb.VidKontr, &#13;&#10;                         T_VPredm.Cod_Predm,&#13;&#10;                         T_VPredm.Name_Predm, &#13;&#10;                         Pr_NaprZakl.Name_NTD, &#13;&#10;                         Pr_NaprZakl.Kolvo,&#13;&#10;                         -- --------------------------&#13;&#10;                         Pr_NaprZakl.ZavNumTo,&#13;&#10;                         Pr_NaprZakl.ZavNumFrom,  &#13;&#10;                         -- --------------------------                                                                                          &#13;&#10;                         T_VPredm_Izdel.Cod_Predm as Cod_Izdel, &#13;&#10;                         T_VPredm_Izdel.Name_Predm as Name_Izdel                            &#13;&#10;FROM            Pr_Zakl LEFT OUTER JOIN&#13;&#10;                         Pr_NaprZakl ON Pr_NaprZakl.Key_Zakl = Pr_Zakl.Key_Zakl &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         Pr_Pasp ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         T_TP ON T_TP.Key_TP = Pr_Pasp.Key_TP &#13;&#10;                         INNER JOIN&#13;&#10;                         T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         Pr_PaspDet ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         P_VKZ ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         P_VKZ AS Pr_VKZIzdel ON Pr_VKZIzdel.Key_VKZ = P_VKZ.Key_VKZ_Master &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         T_VPredm AS T_VPredm_Izdel ON T_VPredm_Izdel.Key_Predm = Pr_VKZIzdel.Key_Predm &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         T_TechTreb ON T_TechTreb.Cod_TT = Pr_NaprZakl.Cod_TT&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Zakl.Key_Zakl=:Key_Zakl">
