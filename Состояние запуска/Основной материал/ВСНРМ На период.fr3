<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41295,0680531829" ReportOptions.Description.Text="" ReportOptions.Name="ÂÑÍÐÌ Íà ïåðèîä.fr3 Ñîñòîÿíèå çàïóñêà" ReportOptions.LastChange="41751,6778025579" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';&#13;&#10;&#13;&#10;&#13;&#10;function FnNamePredm:string;&#13;&#10;begin&#13;&#10;  Result := PrintPredm  (&#60;PlnQRY.&#34;PrintFlagM&#34;&#62;,&#60;PlnQRY.&#34;Cod_PredmM&#34;&#62;,       &#60;PlnQRY.&#34;Name_PredmM&#34;&#62;,&#13;&#10;                         &#60;PlnQRY.&#34;SortamM&#34;&#62;,   &#60;PlnQRY.&#34;Type_NTD_SortamM&#34;&#62;, &#60;PlnQRY.&#34;Name_NTD_SortamM&#34;&#62;,&#13;&#10;                         &#60;PlnQRY.&#34;MarkaM&#34;&#62;,    &#60;PlnQRY.&#34;Type_NTD_MarkaM&#34;&#62;,  &#60;PlnQRY.&#34;Name_NTD_MarkaM&#34;&#62;);      &#13;&#10;end;          &#13;&#10;  &#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('StartDate',Str);        &#13;&#10;  DateFrom.Date:= StrToDate( Str );  &#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('EndDate',Str);        &#13;&#10;  DateTO.Date:= StrToDate( Str );&#13;&#10;&#13;&#10;  DatePrice.Date:=Date;&#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnDeactivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:=DateToStr(DateFrom.Date);&#13;&#10;  MySaveString('StartDate',Str);        &#13;&#10;  Str:=DateToStr(DateTo.Date);&#13;&#10;  MySaveString('EndDate',Str);        &#13;&#10;end;&#13;&#10;&#13;&#10;Function Price:double;&#13;&#10;begin&#13;&#10;&#13;&#10; if &#60;PlnQRY.&#34;PriceSkl&#34;&#62; &#62; 0 then  &#13;&#10;    Result := &#60;PlnQRY.&#34;PriceSkl&#34;&#62;                 &#13;&#10;  else&#13;&#10;    Result := &#60;PlnQRY.&#34;PriceKG&#34;&#62;;                                         &#13;&#10;end;&#13;&#10;&#13;&#10;function PriceEdizm:string;&#13;&#10;begin&#13;&#10;&#13;&#10;  if &#60;PlnQRY.&#34;PriceSkl&#34;&#62; &#62; 0 then                                  &#13;&#10;    Result:= &#60;PlnQRY.&#34;Name_K_Ed_Skl&#34;&#62;&#13;&#10;  else&#13;&#10;    Result:= 'ÊÃ';               &#13;&#10;end;&#13;&#10;&#13;&#10;function PriceData: double;&#13;&#10;begin&#13;&#10;   &#13;&#10;   if &#60;PlnQRY.&#34;PriceSkl&#34;&#62; &#62; 0 then                                  &#13;&#10;    Result:= &#60;PlnQRY.&#34;DatePriceSkl&#34;&#62;   &#13;&#10;  else&#13;&#10;    Result:= &#60;PlnQRY.&#34;DatePriceKG&#34;&#62;;               &#13;&#10;end;&#13;&#10;  &#13;&#10;function PriceSrc:string;&#13;&#10;begin&#13;&#10;&#13;&#10;  if &#60;PlnQRY.&#34;PriceSkl&#34;&#62; &#62; 0 then                                  &#13;&#10;    Result:= &#60;PlnQRY.&#34;PriceSrcSkl&#34;&#62;   &#13;&#10;  else&#13;&#10;    Result:= &#60;PlnQRY.&#34;PriceSrcKG&#34;&#62;;               &#13;&#10;end;    &#13;&#10;&#13;&#10;Function PriceSM:double;&#13;&#10;begin&#13;&#10;  if &#60;PlnQRY.&#34;PriceSkl&#34;&#62; &#62; 0 then  &#13;&#10;    Result := &#60;PlnQRY.&#34;PriceSkl&#34;&#62; *&#60;PlnQRY.&#34;KolvoInSkl&#34;&#62;                     &#13;&#10;  else&#13;&#10;    Result := &#60;PlnQRY.&#34;PriceKG&#34;&#62; * &#60;PlnQRY.&#34;KolvoinKG&#34;&#62;;                                         &#13;&#10;end;&#13;&#10;    &#13;&#10;&#13;&#10;&#13;&#10;procedure Memo6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;PlnQRY.&#34;TT&#34;&#62; = '' then&#13;&#10;    TTMemo.Visible:=False&#13;&#10;  else&#13;&#10;    TTMemo.Visible:=True;                                               &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2900000020446174615365743D224D61696E46727844532220446174615365744E616D653D224D61696E44532200010C2600000020446174615365743D22506C6E5152592220446174615365744E616D653D22506C6E515259220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="PlnQRY" UserName="PlnQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;	P_VMZ.Key_VMZ, &#13;&#10;	P_VKZ.Key_VKZ, &#13;&#10;	P_VKZ_VMZ.KolvoDT, &#13;&#10;	P_VMZ.KolDSE,&#13;&#10;&#13;&#10;&#13;&#10;                  &#13;&#10;-- P_VMZ.KolvoInBaseEd_BySP *dbo.T_GetKoefTo( PredmM.Key_Predm, PredmM.Sklad_Ed_Izm , PredmM.Cod_Ed_Izm ) AS KolvoinEdizm,&#13;&#10; P_VMZ.Kolvo_BySP                                                                                       AS KolvoinEdizm,       &#13;&#10; P_Vmz.KolvoInBaseEd_BySP                                                                               AS KolvoInSkl,&#13;&#10; P_VMZ.KolvoInBaseEd_BySP * dbo.T_GetKoefTo( PredmM.Key_Predm,PredmM.Sklad_Ed_Izm , '166' )             AS KolvoinKG,&#13;&#10;&#13;&#10;		dbo.C_FnGetPredmPrice    (PredmM.Key_Predm, :DatePrice, :PriceNum, PredmM.Cod_Ed_Izm)   AS PriceEdizm,&#13;&#10;		dbo.C_FnGetPredmPrice    (PredmM.Key_Predm, :DatePrice, :PriceNum, PredmM.Sklad_Ed_Izm) AS PriceSkl,&#13;&#10;  dbo.C_FnGetPredmPrice    (PredmM.Key_Predm, :DatePrice, :PriceNum, '166')               AS PriceKG,&#13;&#10;    &#13;&#10;		dbo.C_FnGetPredmPriceDate(PredmM.Key_Predm, :DatePrice, :PriceNum, PredmM.Cod_Ed_Izm) AS DatePriceEdizm ,            &#13;&#10;		dbo.C_FnGetPredmPriceSrc (PredmM.Key_Predm, :DatePrice, :PriceNum, PredmM.Cod_Ed_Izm) AS PriceSrcEdizm,&#13;&#10;&#13;&#10;		dbo.C_FnGetPredmPriceDate(PredmM.Key_Predm, :DatePrice, :PriceNum, PredmM.Sklad_Ed_Izm) AS DatePriceSkl,            &#13;&#10;		dbo.C_FnGetPredmPriceSrc (PredmM.Key_Predm, :DatePrice, :PriceNum, PredmM.Sklad_Ed_Izm) AS PriceSrcSkl,&#13;&#10;    &#13;&#10;		dbo.C_FnGetPredmPriceDate(PredmM.Key_Predm, :DatePrice, :PriceNum, '166')               AS DatePriceKG,              &#13;&#10;		dbo.C_FnGetPredmPriceSrc (PredmM.Key_Predm, :DatePrice, :PriceNum,  '166')              AS PriceSrcKG,                                                                                                                                  &#13;&#10;        &#13;&#10;   &#13;&#10;       T_VPredm_Izdel.Cod_Predm AS Cod_PredmIzdel, &#13;&#10;       P_VKZ_Izdel.Cod_Zak, &#13;&#10;       P_VKZ.DataZap, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Cod_Prin,&#13;&#10;       T_VPredm.Name_K_Prin,&#13;&#10;	      Convert (varchar,P_VKZ.DataZap,112) DateStr,&#13;&#10;&#13;&#10;        T_VPredm_SB.Cod_Predm 	AS Cod_PredmSb,&#13;&#10;        T_VPredm_SB.Name_Predm 	AS Name_PredmSb,&#13;&#10;&#13;&#10;        PredmM.Cod_Postav AS Cod_PostavM,&#13;&#10;        PredmM.Cod_Prin AS Cod_PrinM,&#13;&#10;            &#13;&#10;        PredmM.Cod_Predm 	AS Cod_PredmM,&#13;&#10;        PredmM.Name_Predm 	AS Name_PredmM,&#13;&#10;        PredmM.PrintFlag AS PrintFlagM,                                                                &#13;&#10;&#13;&#10;        PredmM.Sortam SortamM,&#13;&#10;        PredmM.OrderSortam OrderSortamM,&#13;&#10;            &#13;&#10;        PredmM.Type_NTD_Sortam AS Type_NTD_SortamM,&#13;&#10;        PredmM.Name_NTD_Sortam AS Name_NTD_SortamM,&#13;&#10;          &#13;&#10;        PredmM.Marka MarkaM,&#13;&#10;        PredmM.Type_NTD_Marka AS Type_NTD_MarkaM,&#13;&#10;        PredmM.Name_NTD_Marka AS Name_NTD_MarkaM,&#13;&#10;        P_VMZ.Prof_Razm,&#13;&#10;          &#13;&#10;        Gr_VxodPredm.Cod_Gr Cod_GrM,      &#13;&#10;        Gr_Groups.Name_Gr Name_GrM, &#13;&#10;&#13;&#10;        Gr_Groups.FullNameGr FullNameGrM,&#13;&#10;            &#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_ZapP(P_VKZ.Key_VKZ) Kolvo_ZapP,&#13;&#10;            &#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_Zap(P_VKZ.Key_VKZ) Kolvo_Zap,&#13;&#10;        P_VKZ.Kolvo,  &#13;&#10;        T_EDIZM.Name_K_Ed,                                    &#13;&#10;        T_EDIZMSKL.Name_K_Ed     Name_K_Ed_Skl,&#13;&#10;        T_SPRows.SpNotes,&#13;&#10;        dbo.T_SpTT_Descr(T_SPRows.Key_SpRow) TT            &#13;&#10;&#13;&#10;FROM         &#13;&#10;	P_VKZ &#13;&#10;	INNER JOIN P_VKZ_VMZ &#13;&#10;		ON P_VKZ.Key_VKZ = P_VKZ_VMZ.Key_VKZ &#13;&#10;	INNER JOIN P_VMZ &#13;&#10;		ON P_VKZ_VMZ.Key_VMZ = P_VMZ.Key_VMZ &#13;&#10;	INNER JOIN T_VPredm AS PredmM &#13;&#10;		ON P_VMZ.Key_Predm_BySP  = PredmM.Key_Predm&#13;&#10;&#13;&#10; LEFT JOIN T_SPRows                                           &#13;&#10;  ON T_SPRows.Key_SPRow = P_VKZ_VMZ.Key_SPRow                       &#13;&#10;  &#13;&#10;	INNER JOIN T_VPredm AS T_VPredm &#13;&#10;		ON P_VKZ.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	INNER JOIN P_VKZ AS P_VKZ_Izdel &#13;&#10;		ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ &#13;&#10;	INNER JOIN T_VPredm AS T_VPredm_Izdel &#13;&#10;		ON P_VKZ_Izdel.Key_Predm = T_VPredm_Izdel.Key_Predm&#13;&#10;&#13;&#10; LEFT JOIN P_VKZ AS P_VKZ_SB       &#13;&#10;		ON P_VKZ_SB.Key_VKZ = IsNull(P_VKZ.Key_VKZ_Master,P_VKZ.Key_VKZ)                            &#13;&#10;	LEFT JOIN T_VPredm AS T_VPredm_SB   &#13;&#10;		ON P_VKZ_SB.Key_Predm = T_VPredm_SB.Key_Predm&#13;&#10;      &#13;&#10;&#13;&#10;	INNER JOIN Gr_VxodPredm &#13;&#10;		   ON PredmM.Key_Predm = Gr_VxodPredm.Key_Predm &#13;&#10;	INNER JOIN Gr_Groups &#13;&#10;		   ON Gr_VxodPredm.Key_VidGr = Gr_Groups.Key_VidGr &#13;&#10;		   AND Gr_VxodPredm.Cod_Gr = Gr_Groups.Cod_Gr&#13;&#10;&#13;&#10;&#13;&#10;       LEFT JOIN T_EDIZM&#13;&#10;               ON T_EDIZM.Cod_Ed_Izm = P_VMZ.Cod_Ed_Izm_BySP&#13;&#10;    &#13;&#10;       LEFT JOIN T_EDIZM  T_EDIZMNRM        &#13;&#10;               ON T_EDIZMNRM.Cod_Ed_Izm = P_VMZ.Cod_Ed_Izm&#13;&#10;                 &#13;&#10;       LEFT JOIN T_EDIZM   T_EDIZMSKL        &#13;&#10;               ON T_EDIZMSKL.Cod_Ed_Izm = PredmM.Sklad_Ed_Izm    &#13;&#10;                 &#13;&#10;WHERE     &#13;&#10;           P_VKZ.DataZap     &#62;= :DateFrom                                    &#13;&#10;       AND P_VKZ.DataZap &#60;= :DateTo&#13;&#10;       AND P_VKZ.Cod_Postav = '1'                                             &#13;&#10;       AND  ((IsNull(dbo.Pr_VKZ_Get_Kolvo_Zap (P_VKZ.Key_VKZ),0) &#60; P_VKZ.Kolvo) or (:PrintZap  = 0))                                                                  &#13;&#10;       AND  ((IsNull(dbo.Pr_VKZ_Get_Kolvo_ZapP(P_VKZ.Key_VKZ),0) &#60; P_VKZ.Kolvo) or (:PrintZapP = 0))&#13;&#10;       AND P_VKZ_Izdel.Cod_SosZ='Ä'&#13;&#10; --      AND P_VKZ_Izdel.LockDT = '1'                                                                                      &#13;&#10;           &#13;&#10;ORDER BY    &#13;&#10;		Cod_PostavM, &#13;&#10;		Cod_PrinM, &#13;&#10;		Cod_GrM,&#13;&#10;		Name_PredmM,&#13;&#10;		OrderSortamM,&#13;&#10;		SortamM,&#13;&#10;		MarkaM,&#13;&#10;  Cod_Predm                           &#13;&#10;    " PropData=""/>
  </TfrxDataPage>
