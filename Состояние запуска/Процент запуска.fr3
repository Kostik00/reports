<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41718,6706432523" ReportOptions.Description.Text="" ReportOptions.Name="Процент запуска.fr3 Состояние запуска" ReportOptions.LastChange="41718,694089838" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2A00000020446174615365743D22497A64656C5152592220446174615365744E616D653D22497A64656C515259220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="IzdelQRY" UserName="IzdelQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;	P_VKZ_Izdel.Key_VKZ_Izdel, &#13;&#10;	P_VKZ_Izdel.Cod_Zak, &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm,&#13;&#10;	T0.Cnt,&#13;&#10;	T1.Cnt CntZ,&#13;&#10; P_VKZ_Izdel.DataVip             &#13;&#10;FROM         &#13;&#10;	P_VKZ P_VKZ_Izdel&#13;&#10;	INNER JOIN  T_VPredm ON P_VKZ_Izdel.Key_Predm = T_VPredm.Key_Predm&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24') &#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;--				AND dbo.Pr_VKZ_Get_Kolvo_Z0(Key_VKZ)  &#60;&#62;  0&#13;&#10;				&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;			&#13;&#10;&#13;&#10;		) T0&#13;&#10;	ON T0.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;	LEFT JOIN&#13;&#10;		(&#13;&#10;&#13;&#10;			select &#13;&#10;				P_VKZ.Key_VKZ_Izdel,&#13;&#10;				count(P_VKZ.Key_VKZ) Cnt, &#13;&#10;				SUM(P_VKZ.Kolvo) Sm&#13;&#10;				&#13;&#10;			FROM P_VKZ&#13;&#10;				INNER JOIN T_VPredm&#13;&#10;					ON T_VPredm.Key_Predm=P_VKZ.Key_Predm&#13;&#10;			WHERE &#13;&#10;					Cod_Prin in ('10', '12', '14', '22', '23', '24')&#13;&#10;				AND P_VKZ.Cod_Postav  &#60; 2&#13;&#10;				AND dbo.Pr_VKZ_Get_Kolvo_Z0(Key_VKZ) &#62;= P_VKZ.Kolvo&#13;&#10;			GROUP BY &#13;&#10;				P_VKZ.Key_VKZ_Izdel&#13;&#10;&#13;&#10;		) T1&#13;&#10;	ON T1.Key_VKZ_Izdel=P_VKZ_Izdel.Key_VKZ&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE     (P_VKZ_Izdel.Key_VKZ_Master IS NULL) AND (P_VKZ_Izdel.Cod_SosZ = 'Д')&#13;&#10;       AND P_VKZ_Izdel.DataZap is not null&#13;&#10;       AND T0.Cnt &#62; 0                              &#13;&#10;         &#13;&#10;ORDER BY P_VKZ_Izdel.DataVip, P_VKZ_Izdel.Cod_Zak  " PropData="05704C65667402440470546F7002400A506172616D65746572730100"/>
  </TfrxDataPage>
