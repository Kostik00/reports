      </Parameters>
    </TfrxERQuery>
    <TfrxERQuery Name="FMat" UserName="МатериалФакт" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="PaspFrxDS" Left="248" Top="84" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Pasp.Key_Pasport,&#13;&#10;  T_SPRows.Key_SP,&#13;&#10;  T_SPRows.Key_SPRow,&#13;&#10;  Pr_SP.Key_PrSP,&#13;&#10;  Pr_SP.Key_ID_Mat,&#13;&#10;  Pr_SP.Zamena_Docum,&#13;&#10;  Isnull(Pr_SP.F_Pokovka,A_ID_Mat.Pokovka) F_Pokovka,                                &#13;&#10;    &#13;&#10;  Pr_SPDetail.ProfRazm,&#13;&#10;  Pr_SPDetail.Kolvo,&#13;&#10;  Pr_SPDetail.NumP,&#13;&#10;&#13;&#10;    &#13;&#10;&#13;&#10;  A_ID_Mat.N_Sert,&#13;&#10;  A_ID_Mat.Date_Sert,&#13;&#10;  A_ID_Mat.Cod_Plavka,&#13;&#10;  A_ID_Mat.VidPostav,&#13;&#10;  A_ID_Mat.N_SertPos,&#13;&#10;  A_ID_Mat.Party,&#13;&#10;  A_ID_Mat.Pokovka,&#13;&#10;  A_ID_Mat.AdInfo,&#13;&#10;&#13;&#10;  A_ID_Mat.Key_Predm,&#13;&#10;&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS Name_NTD_Sortam,&#13;&#10;&#13;&#10;&#13;&#10;  T_Predm.Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS Name_NTD_Marka,&#13;&#10;&#13;&#10;  Pr_SPD_Razdel.Key_Razdel,&#13;&#10;  Pr_SPD_Razdel.Razdel_Name                              &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Pasp&#13;&#10;  INNER JOIN T_SP T_SP&#13;&#10;    ON Pr_Pasp.Key_SP=T_SP.Key_SP&#13;&#10;  INNER JOIN T_SPRows T_SPRows&#13;&#10;    ON T_SPRows.Key_SP=T_SP.Key_SP&#13;&#10;&#13;&#10;  LEFT JOIN Pr_SP&#13;&#10;    ON  Pr_SP.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;    AND PR_SP.Key_SP      = Pr_Pasp.Key_SP&#13;&#10;    AND Pr_SP.Key_SPRow   = T_SPRows.Key_SPRow&#13;&#10;      &#13;&#10;  LEFT JOIN Pr_SPDetail&#13;&#10;    ON Pr_SPDetail.Key_PrSP =Pr_SP.Key_PrSP&#13;&#10;      &#13;&#10;  LEFT JOIN Pr_SPD_Razdel&#13;&#10;    ON Pr_SPD_Razdel.Key_Razdel = Pr_SPDetail.Key_Razdel                                                                         &#13;&#10;&#13;&#10;  LEFT JOIN A_VID_Mat A_ID_Mat&#13;&#10;    ON  A_ID_Mat.Key_ID_Mat=PR_SP.Key_ID_Mat&#13;&#10;&#13;&#10;  LEFT JOIN T_VPredm T_Predm&#13;&#10;    ON  A_ID_Mat.Key_Predm = T_Predm.Key_Predm&#13;&#10;&#13;&#10;WHERE&#13;&#10;  (Pr_Pasp.Key_Pasport = :Key_Pasport)&#13;&#10;  AND Pr_SP.Key_ID_Mat IS NOT NULL                                            &#13;&#10;-- AND T_SPRows.SP_position=0&#13;&#10;ORDER BY A_ID_Mat.Key_Predm, Pr_SP.Key_ID_Mat, Pr_SPD_Razdel.Key_Razdel                                                                 ">
      <FieldDefs>
        <item FieldName="Key_Pasport" FieldAlias="Key_Pasport"/>
        <item FieldName="Key_SP" FieldAlias="Key_SP"/>
        <item FieldName="Key_SPRow" FieldAlias="Key_SPRow"/>
