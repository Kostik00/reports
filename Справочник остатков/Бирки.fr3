<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="TSC TC300" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="Áèðêè.fr3 Ñïðàâî÷íèê îñòàòêîâ" ReportOptions.LastChange="43138,6312851273" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;function PrintPredm(PrintFlag:integer; Cod_Predm, Name_Predm,&#13;&#10;                                       Sortam, Type_NTD_Sortam, Name_NTD_Sortam,&#13;&#10;                                       Marka,  Type_NTD_Marka,  Name_NTD_Marka:string):string;&#13;&#10;begin&#13;&#10;  Result:='';&#13;&#10;  if ((PrintFlag and 2)=2) and ((PrintFlag and 1)=0) then&#13;&#10;  begin&#13;&#10;    Result:=Name_Predm +' ' +Sortam+ ' ' + Cod_Predm;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Result:=Name_Predm + ' ' + Sortam + ' ';&#13;&#10;&#13;&#10;    if Trim(Type_NTD_Marka)='' then&#13;&#10;      Result:=Result + Marka + ' ';&#13;&#10;&#13;&#10;//    if Type_NTD_Sortam&#60;&#62;'' then&#13;&#10;      Result:=Result               + Type_NTD_Sortam + CHR(160) + Name_NTD_Sortam + ' ';&#13;&#10;&#13;&#10;    if ((Trim(Type_NTD_Marka)&#60;&#62;'')OR(Trim(Name_NTD_Marka)&#60;&#62;'')) then&#13;&#10;      Result:=Result +#13#10+ Marka + ' ' + Type_NTD_Marka  + CHR(160) + Name_NTD_Marka;&#13;&#10;&#13;&#10;    Result:=Trim(Result);&#13;&#10;&#13;&#10; {&#13;&#10;    if ((PrintFlag and 2)=2) then&#13;&#10;    begin&#13;&#10;      Result:= Result + ' (' + Cod_Predm+')';&#13;&#10;    end;&#13;&#10;  }&#13;&#10;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function FnCode:string;&#13;&#10;begin&#13;&#10; // Result := '444';&#13;&#10; // exit;&#13;&#10;  if &#60;Ñòðîêè.&#34;Key_Nacl_Str_Sost&#34;&#62; &#60;&#62; 0 then&#13;&#10;    Result:='1 8 '+IntToStr(&#60;Ñòðîêè.&#34;Key_Nacl_Str_Sost&#34;&#62;)&#13;&#10;  else&#13;&#10;    Result:='1 7 '+IntToStr(&#60;Ñòðîêè.&#34;Key_Nacl_Str&#34;&#62;);&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SrokGodnostiMemo.Visible:= &#60;Ñòðîêè.&#34;SrokGodn&#34;&#62; &#62; 0 ;&#13;&#10;  PrimenMemo.Visible := FnPrimen &#60;&#62; '';&#13;&#10;end;&#13;&#10;&#13;&#10;function FnPrimen:string;&#13;&#10;begin&#13;&#10;  Result:=&#60;Ñòðîêè.&#34;Primen&#34;&#62;;&#13;&#10;  if Result = '' then&#13;&#10;    Result:=&#60;Ñòðîêè.&#34;PrimenSkl&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
