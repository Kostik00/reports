<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="Приход инструмента за период (измененый).fr3 Список накладных" ReportOptions.LastChange="45890,5015136227" ScriptLanguage="PascalScript" ScriptText.Text="USES 'CommonRU.pas'  ;&#13;&#10;&#13;&#10;function StrFn00:string;&#13;&#10;begin&#13;&#10;  Result:=PrintPredm(&#60;Инструменты.&#34;PrintFlag&#34;&#62; , &#60;Инструменты.&#34;Cod_Predm&#34;&#62;, &#60;Инструменты.&#34;Name_Predm&#34;&#62;,&#13;&#10;           &#60;Инструменты.&#34;Sortam&#34;&#62;, &#60;Инструменты.&#34;Type_NTD_Sortam&#34;&#62;, &#60;Инструменты.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;           &#60;Инструменты.&#34;Marka&#34;&#62;, &#60;Инструменты.&#34;Type_NTD_Marka&#34;&#62;, &#60;Инструменты.&#34;Name_NTD_Marka&#34;&#62;)&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;function StrFn01:string;&#13;&#10;begin&#13;&#10;  Result:=PrintPredm(&#60;Vidano.&#34;PrintFlag&#34;&#62; , &#60;Vidano.&#34;Cod_Predm&#34;&#62;, &#60;Vidano.&#34;Name_Predm&#34;&#62;,&#13;&#10;           &#60;Vidano.&#34;Sortam&#34;&#62;, &#60;Vidano.&#34;Type_NTD_Sortam&#34;&#62;, &#60;Vidano.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;           &#60;Vidano.&#34;Marka&#34;&#62;, &#60;Vidano.&#34;Type_NTD_Marka&#34;&#62;, &#60;Vidano.&#34;Name_NTD_Marka&#34;&#62;)&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DateFrom.Date:=Date;&#13;&#10;  DateTo.Date  :=Date;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end.&#13;&#10;" StoreInDFM="False">
  <Datasets>
    <item DataSet="MainFrxDS" DataSetName="MainDS"/>
    <item DataSet="InstrumQRY" DataSetName="Инструменты"/>
