<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41449,6830513773" ReportOptions.Description.Text="" ReportOptions.Name="Ñâîäíàÿ ïî çàãðóçêå íà çàêàç.fr3 ÂÊÇ ¹ 662-À11" ReportOptions.LastChange="41568,6992276389" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';&#13;&#10;&#13;&#10;  &#13;&#10;procedure PrintAllOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupHeader2OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  Engine.CurY := Engine.CurY - GroupHeader2.Height                                             &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end.                         " StoreInDFM="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="OstQRY" UserName="Îñòàòîê1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="VKZfrxDS" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       D_Zakaz.Cod_Zak,&#13;&#10;       VKZ_Izdel.Key_VKZ Key_VKZ_Izdel,                                                  &#13;&#10;       Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;       Izdel.Name_Predm AS Name_Predm_Izdel,&#13;&#10;       P_VKZ.Key_VKZ,                 &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm,&#13;&#10;       Pr_PaspDet.KolvoZap, &#13;&#10;       Pr_Pasp.PaspKolvo, &#13;&#10;       T_Oper.Name_K_Oper, &#13;&#10;       Pr_Pasp.Cod_Pasp,                        &#13;&#10;       Pr_Pasp_Rows.Tpz, &#13;&#10;       Pr_Pasp_Rows.Tsht,&#13;&#10;       Pr_Pasp_Rows.N_Oper_Sm,&#13;&#10;       DatePart(yy,P_VKZ.DataVip)   Y, &#13;&#10;       DatePart(qq,P_VKZ.DataVip)   Q, &#13;&#10;       DatePart(mm,P_VKZ.DataVip)   M,&#13;&#10;       dbo.Sys_GetDecade(P_VKZ.DataVip)   Dec,                                                           &#13;&#10;       P_VKZ.DataVip   D,&#13;&#10;&#13;&#10;       PredmM.Cod_Predm        Cod_PredmM, &#13;&#10;       PredmM.Name_Predm       Name_PredmM, &#13;&#10;       PredmM.Sortam           SortamM, &#13;&#10;       PredmM.Type_NTD_Sortam  Type_NTD_SortamM, &#13;&#10;       PredmM.Name_NTD_Sortam  Name_NTD_SortamM, &#13;&#10;       PredmM.Marka            MarkaM, &#13;&#10;       PredmM.Type_NTD_Marka   Type_NTD_MarkaM,&#13;&#10;       PredmM.Name_NTD_Marka   Name_NTD_MarkaM, &#13;&#10;       PredmM.PrintFlag        PrintFlagM                &#13;&#10;&#13;&#10;       ,T_Obor.Cod_Obor&#13;&#10;       ,T_Obor.Name_K_Obor&#13;&#10;       ,T_Obor.Name_Obor                             &#13;&#10;           &#13;&#10;&#13;&#10;         &#13;&#10;  &#13;&#10;FROM         &#13;&#10;       D_Zakaz &#13;&#10;       INNER JOIN P_VKZ AS VKZ_Izdel&#13;&#10;               ON D_Zakaz.Cod_Zak = VKZ_Izdel.Cod_Zak &#13;&#10;       INNER JOIN T_VPredm AS Izdel &#13;&#10;               ON VKZ_Izdel.Key_Predm = Izdel.Key_Predm&#13;&#10;       INNER JOIN P_VKZ &#13;&#10;               ON VKZ_Izdel.Key_VKZ = P_VKZ.Key_VKZ_Izdel &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON P_VKZ.Key_Predm = T_VPredm.Key_Predm&#13;&#10;       INNER JOIN Pr_PaspDet &#13;&#10;               ON P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;       INNER JOIN Pr_Pasp &#13;&#10;               ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;       INNER JOIN Pr_Pasp_Rows &#13;&#10;               ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport &#13;&#10;       INNER JOIN T_Oper &#13;&#10;               ON Pr_Pasp_Rows.Cod_Oper = T_Oper.Cod_Oper&#13;&#10;&#13;&#10;       INNER JOIN T_TPRows&#13;&#10;               ON T_TPRows.Key_TPRows  =   Pr_Pasp_Rows.Key_TPRows&#13;&#10;       INNER JOIN T_TPRows_Obor&#13;&#10;               ON T_TPRows_Obor.Key_TPRows= T_TPRows_Obor.Key_TPRows                                                   &#13;&#10;       INNER JOIN T_Obor&#13;&#10;               ON T_Obor.Cod_Obor =  T_TPRows_Obor.Cod_Obor                                                                       &#13;&#10;                 &#13;&#10;       LEFT JOIN&#13;&#10;       (&#13;&#10;          SELECT     Pr_Pasp.Key_Pasport, Min(A_ID_Mat.Key_Predm) Key_Predm&#13;&#10;          FROM         Pr_Pasp INNER JOIN&#13;&#10;                                Pr_SP ON Pr_Pasp.Key_Pasport = Pr_SP.Key_Pasport INNER JOIN&#13;&#10;                                T_SPRows ON Pr_SP.Key_SPRow = T_SPRows.Key_SPRow INNER JOIN&#13;&#10;                                A_ID_Mat ON Pr_SP.Key_ID_Mat = A_ID_Mat.Key_ID_Mat&#13;&#10;          WHERE     (T_SPRows.SP_position = 0)&#13;&#10;          GROUP BY Pr_Pasp.Key_Pasport&#13;&#10;       ) T1&#13;&#10;               ON T1.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;       LEFT JOIN T_VPredm   PredmM&#13;&#10;               ON  PredmM.Key_Predm = T1.Key_Predm                                                                       &#13;&#10;             &#13;&#10;                 &#13;&#10;WHERE     &#13;&#10;       (D_Zakaz.Cod_SosZ = 'Ä') &#13;&#10;       AND (VKZ_Izdel.Cod_SosZ = 'Ä') &#13;&#10;       AND (T_Obor.Name_Obor like :CodOper ) &#13;&#10;       AND (Pr_Pasp_Rows.Status_Oper &#60; 2)&#13;&#10;       AND  Pr_Pasp.Key_Pasp_Status &#60; 6                                                                      &#13;&#10;      AND D_Zakaz.Cod_Zak = :Cod_Zak                                     &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;UNION&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;SELECT     &#13;&#10;                                    &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;	D_Zakaz.Cod_Zak, &#13;&#10;    VKZ_Izdel.Key_VKZ Key_VKZ_Izdel,&#13;&#10;	Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;	Izdel.Name_Predm AS Name_Predm_Izdel, &#13;&#10;    P_VKZ.Key_VKZ,  &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm,&#13;&#10;&#13;&#10;	dbo.Pr_VKZ_Get_Kolvo_NZ(P_VKZ.Key_VKZ) KolvoZap,&#13;&#10;	0 PaspKolvo,&#13;&#10;	T_Oper.Name_K_Oper, &#13;&#10;	T_TP.Cod_TP, &#13;&#10;&#13;&#10;	&#13;&#10;	T_TPRows.Tpz, &#13;&#10;	T_TPRows.Tsht, &#13;&#10;	&#13;&#10;	T_TPRows.N_OPER_MK,&#13;&#10;       DatePart(yy,P_VKZ.DataVip)   Y, &#13;&#10;       DatePart(qq,P_VKZ.DataVip)   Q, &#13;&#10;       DatePart(mm,P_VKZ.DataVip)   M,&#13;&#10;       dbo.Sys_GetDecade(P_VKZ.DataVip)   Dec,  &#13;&#10;       P_VKZ.DataVip   D ,&#13;&#10;&#13;&#10;       PredmM.Cod_Predm        Cod_PredmM, &#13;&#10;       PredmM.Name_Predm       Name_PredmM, &#13;&#10;       PredmM.Sortam           SortamM, &#13;&#10;       PredmM.Type_NTD_Sortam  Type_NTD_SortamM, &#13;&#10;       PredmM.Name_NTD_Sortam  Name_NTD_SortamM, &#13;&#10;       PredmM.Marka            MarkaM, &#13;&#10;       PredmM.Type_NTD_Marka   Type_NTD_MarkaM,&#13;&#10;       PredmM.Name_NTD_Marka   Name_NTD_MarkaM, &#13;&#10;       PredmM.PrintFlag        PrintFlagM&#13;&#10;&#13;&#10;       ,T_Obor.Cod_Obor&#13;&#10;       ,T_Obor.Name_K_Obor&#13;&#10;       ,T_Obor.Name_Obor                             &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;&#13;&#10;FROM&#13;&#10;    D_Zakaz         &#13;&#10;	INNER JOIN P_VKZ AS VKZ_Izdel &#13;&#10;		ON D_Zakaz.Cod_Zak = VKZ_Izdel.Cod_Zak &#13;&#10;	INNER JOIN T_VPredm AS Izdel &#13;&#10;		ON VKZ_Izdel.Key_Predm = Izdel.Key_Predm &#13;&#10;	INNER JOIN P_VKZ &#13;&#10;		ON VKZ_Izdel.Key_VKZ = P_VKZ.Key_VKZ_Izdel &#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON P_VKZ.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	INNER JOIN T_SP &#13;&#10;		ON T_SP.SP_Version = T_VPredm.SP_Version &#13;&#10;		AND T_SP.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	INNER JOIN T_TP &#13;&#10;		ON T_TP.Key_TP = T_SP.Key_TP &#13;&#10;	INNER JOIN T_TPRows &#13;&#10;		ON T_TPRows.Key_TP = T_TP.Key_TP &#13;&#10;	INNER JOIN T_Oper &#13;&#10;		ON T_TPRows.Cod_Oper = T_Oper.Cod_Oper&#13;&#10;&#13;&#10;       INNER JOIN T_TPRows_Obor&#13;&#10;               ON T_TPRows_Obor.Key_TPRows= T_TPRows_Obor.Key_TPRows                                                   &#13;&#10;       INNER JOIN T_Obor&#13;&#10;               ON T_Obor.Cod_Obor =  T_TPRows_Obor.Cod_Obor                                                                       &#13;&#10;    &#13;&#10;&#13;&#10; LEFT JOIN&#13;&#10;       (&#13;&#10;          SELECT     P_VKZ.Key_VKZ, MIN(T_SPRows.Key_Predm) AS Key_Predm&#13;&#10;          FROM         T_SP INNER JOIN&#13;&#10;                                T_SPRows ON T_SP.Key_SP = T_SPRows.Key_SP INNER JOIN&#13;&#10;                                P_VKZ ON T_SP.Key_SP = P_VKZ.Key_SP&#13;&#10;          WHERE     (T_SPRows.SP_position = 0)&#13;&#10;          GROUP BY P_VKZ.Key_VKZ&#13;&#10;       ) T1&#13;&#10;       ON T1.Key_VKZ = P_VKZ.Key_VKZ&#13;&#10;       LEFT JOIN T_VPredm   PredmM&#13;&#10;               ON  PredmM.Key_Predm = T1.Key_Predm                                                                       &#13;&#10;&#13;&#10;  &#13;&#10;WHERE     &#13;&#10;	(D_Zakaz.Cod_SosZ = 'Ä') AND (VKZ_Izdel.Cod_SosZ = 'Ä') &#13;&#10;       AND (T_Obor.Name_Obor like :CodOper ) &#13;&#10;	AND dbo.Pr_VKZ_Get_Kolvo_NZ(P_VKZ.Key_VKZ) &#62; 0&#13;&#10;      AND D_Zakaz.Cod_Zak = :Cod_Zak                                     &#13;&#10;  &#13;&#10;&#13;&#10;&#13;&#10;ORDER BY Y, Q, M, Dec, Cod_Zak, Cod_Predm_Izdel, Cod_Predm                                     " PropData="05704C65667402280470546F7002200A506172616D657465727301010C3D000000204E616D653D22436F644F706572222044617461547970653D226674537472696E67222045787072657373696F6E3D22436F644F7065722E546578742200010C24000000204E616D653D22436F645F5A616B222044617461547970653D226674556E6B6E6F776E220000"/>
