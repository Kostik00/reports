<TfrxReport Version="5.6.18" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="�� ���������" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="43621,7330856134" ReportOptions.Description.Text="" ReportOptions.Name="��� �� ��������.fr3 ���������� �������" ReportOptions.LastChange="43651,4109706597" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  sEmptyDatum: String;&#13;&#10;  sAmbiguousDatum: String;&#13;&#10;  iVariant: Integer;&#13;&#10;&#13;&#10;function LabourIntensityFn: Extended;&#13;&#10;begin&#13;&#10;Result:=&#60;MainDS.&#34;SmTrudByTP&#34;&#62;+&#60;MainDS.&#34;SmTrudOstNZ&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;function CriticalDuration: String;&#13;&#10;var iCriticalDuration: Integer;&#13;&#10;begin&#13;&#10;  iCriticalDuration:=0;&#13;&#10;  if qVKZChild.FieldByName('DataPlnO').IsNull OR qVKZChild.FieldByName('DTZCRMIN').IsNull&#13;&#10;    then Result:=sEmptyDatum&#13;&#10;    else begin&#13;&#10;      iCriticalDuration:=Round(qVKZChild.FieldByName('DataPlnO').AsDateTime-qVKZChild.FieldByName('DTZCRMIN').AsDateTime)+1;&#13;&#10;      if iCriticalDuration &#60; 0 then Result:=sAmbiguousDatum;&#13;&#10;      if iCriticalDuration = 0 then Result:=sEmptyDatum;&#13;&#10;      if iCriticalDuration &#62; 0 then Result:=IntToStr(iCriticalDuration);&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;function AutomaticDuration: String;&#13;&#10;var iAutomaticDuration: Integer;&#13;&#10;begin&#13;&#10;  iAutomaticDuration:=0;&#13;&#10;  if qVKZChild.FieldByName('DTVPLNMAX').IsNull AND qVKZChild.FieldByName('MINDZR').IsNull&#13;&#10;    then Result:=sEmptyDatum;&#13;&#10;  if NOT (qVKZChild.FieldByName('DTVPLNMAX').IsNull OR qVKZChild.FieldByName('MINDZR').IsNull)&#13;&#10;    then begin&#13;&#10;      iAutomaticDuration:=Round(qVKZChild.FieldByName('DTVPLNMAX').AsDateTime-qVKZChild.FieldByName('MINDZR').AsDateTime)+1;&#13;&#10;      if iAutomaticDuration &#60; 0 then Result:=sAmbiguousDatum;&#13;&#10;      if iAutomaticDuration = 0 then Result:=sEmptyDatum;&#13;&#10;      if iAutomaticDuration &#62; 0 then Result:=IntToStr(iAutomaticDuration);&#13;&#10;    end;&#13;&#10;  if (NOT qVKZChild.FieldByName('DTVPLNMAX').IsNull) AND qVKZChild.FieldByName('MINDZR').IsNull&#13;&#10;    then begin&#13;&#10;      iAutomaticDuration:=Round(qVKZChild.FieldByName('DTVPLNMAX').AsDateTime-Date)+1;&#13;&#10;      if iAutomaticDuration &#60; 0 then Result:=sAmbiguousDatum;&#13;&#10;      if iAutomaticDuration = 0 then Result:=sEmptyDatum;&#13;&#10;      if iAutomaticDuration &#62; 0 then Result:=IntToStr(iAutomaticDuration);&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;{&#13;&#10;function DZRFn: TDateTime;&#13;&#10;begin&#13;&#10;  if qVKZChild.FieldByName('DTVPLNMAX').IsNull AND qVKZChild.FieldByName('MINDZR').IsNull then Exit;&#13;&#10;  if NOT (qVKZChild.FieldByName('DTVPLNMAX').IsNull OR qVKZChild.FieldByName('MINDZR').IsNull)&#13;&#10;    then begin&#13;&#10;      if qVKZChild.FieldByName('MINDZR').AsDateTime &#60; Date&#13;&#10;        then Result:=Date&#13;&#10;        else Result:=qVKZChild.FieldByName('MINDZR').AsDateTime;&#13;&#10;    end;&#13;&#10;  if (NOT qVKZChild.FieldByName('DTVPLNMAX').IsNull) AND qVKZChild.FieldByName('MINDZR').IsNull then Result:=Date;&#13;&#10;end;&#13;&#10;}&#13;&#10;&#13;&#10;function sDZRFn: String;&#13;&#10;begin&#13;&#10;  Result:='';&#13;&#10;  if qVKZChild.FieldByName('DTVPLNMAX').IsNull AND qVKZChild.FieldByName('MINDZR').IsNull then Exit;&#13;&#10;  if NOT (qVKZChild.FieldByName('DTVPLNMAX').IsNull OR qVKZChild.FieldByName('MINDZR').IsNull)&#13;&#10;    then begin&#13;&#10;      if qVKZChild.FieldByName('MINDZR').AsDateTime &#60; Date&#13;&#10;        then Result:= FormatDateTime('dd.mm.yy', Date)&#13;&#10;        else Result:=  FormatDateTime('dd.mm.yy', qVKZChild.FieldByName('MINDZR').AsDateTime);&#13;&#10;    end;&#13;&#10;  if (NOT qVKZChild.FieldByName('DTVPLNMAX').IsNull) AND qVKZChild.FieldByName('MINDZR').IsNull then Result:= FormatDateTime('dd.mm.yy', Date);&#13;&#10;end;&#13;&#10;&#13;&#10;function DateZapLagFn: String;&#13;&#10;var iTemp: Integer;&#13;&#10;begin&#13;&#10;  iTemp:=0;&#13;&#10;  if qVKZChild.FieldByName('DTZCRMIN').IsNull&#13;&#10;    then Result:=sEmptyDatum&#13;&#10;    else begin&#13;&#10;      iTemp:=Round(&#60;dsVKZChild.&#34;DTZCRMIN&#34;&#62;-Date);&#13;&#10;      if iTemp &#62;= 0 then Result:='+'+IntToStr(iTemp) else Result:=IntToStr(iTemp);&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;function DateVipLagFn: String;&#13;&#10;var iTemp: Integer;&#13;&#10;begin&#13;&#10;iTemp:=0;&#13;&#10;if (qVKZChild.FieldByName('DataPlnO').IsNull) OR (qVKZChild.FieldByName('DTVPLNMAX').IsNull)&#13;&#10;  then Result:=sEmptyDatum&#13;&#10;  else begin&#13;&#10;    iTemp:=Round(&#60;dsVKZChild.&#34;DataPlnO&#34;&#62;-&#60;dsVKZChild.&#34;DTVPLNMAX&#34;&#62;);&#13;&#10;    if iTemp &#62;= 0 then Result:='+'+IntToStr(iTemp) else Result:='-'+IntToStr(-iTemp);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function XCFn: Extended;&#13;&#10;var iDateVipLagFn: Integer;&#13;&#10;begin&#13;&#10;  Result:=0.0;&#13;&#10;{  if (qVKZChild.FieldByName('DataVip').IsNull) OR (qVKZChild.FieldByName('DataVipA').IsNull)&#13;&#10;    then iDateVipLagFn:=0&#13;&#10;    else iDateVipLagFn:=Round(&#60;dsVKZChild.&#34;DataVip&#34;&#62;-&#60;dsVKZChild.&#34;DataVipA&#34;&#62;);  }&#13;&#10;  iDateVipLagFn:=Round(&#60;dsVKZChild.&#34;DataVip&#34;&#62;-&#60;dsVKZChild.&#34;DataVipA&#34;&#62;);&#13;&#10;  if iDateVipLagFn &#60; 0&#13;&#10;    then Result:=(-iDateVipLagFn*(&#60;MainDS.&#34;SmTrudOstNZ&#34;&#62;+&#60;MainDS.&#34;SmTrudByPasp&#34;&#62;))/1000&#13;&#10;    else Result:=0.0;&#13;&#10;end;&#13;&#10;&#13;&#10;function sXCFn: String;&#13;&#10;var iDateVipLagFn: Integer;&#13;&#10;var eDateVipLagFn: Extended;&#13;&#10;begin&#13;&#10;  Result:='';&#13;&#10;{  if (qVKZChild.FieldByName('DataVip').IsNull) OR (qVKZChild.FieldByName('DataVipA').IsNull)&#13;&#10;    then iDateVipLagFn:=0&#13;&#10;    else iDateVipLagFn:=Round(&#60;dsVKZChild.&#34;DataVip&#34;&#62;-&#60;dsVKZChild.&#34;DataVipA&#34;&#62;);  }&#13;&#10;  iDateVipLagFn:=Round(&#60;dsVKZChild.&#34;DataVip&#34;&#62;-&#60;dsVKZChild.&#34;DataVipA&#34;&#62;);&#13;&#10;  eDateVipLagFn:=(-iDateVipLagFn*(&#60;MainDS.&#34;SmTrudOstNZ&#34;&#62;+&#60;MainDS.&#34;SmTrudByPasp&#34;&#62;))/1000;&#13;&#10;  if iDateVipLagFn &#60; 0&#13;&#10;    then if (eDateVipLagFn &#62; 0) AND (eDateVipLagFn &#60; 1) then Result:='&#60;1' else Result:= FormatFloat('# ##0', eDateVipLagFn)&#13;&#10;    else Result:='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ProcentTrud(AMemoView: TfrxMemoView);&#13;&#10;var eProCent: Extended;&#13;&#10;begin&#13;&#10;  AMemoView.Text:=sEmptyDatum;&#13;&#10;  if (&#60;MainDS.&#34;SmTrudOstNZ&#34;&#62;+&#60;MainDS.&#34;SmTrudByPasp&#34;&#62;) = 0&#13;&#10;    then AMemoView.Text:=sEmptyDatum&#13;&#10;    else&#13;&#10;      if &#60;MainDS.&#34;SmTrudOst&#34;&#62; = 0&#13;&#10;        then begin&#13;&#10;          AMemoView.Font.Style:=AMemoView.Font.Style or fsBold;&#13;&#10;          AMemoView.Text:='100%'&#13;&#10;        end&#13;&#10;        else begin&#13;&#10;          AMemoView.HAlign:=haRight;&#13;&#10;          AMemoView.Font.Style:=AMemoView.Font.Style and 0;&#13;&#10;          eProCent:=(1-&#60;MainDS.&#34;SmTrudOst&#34;&#62;/(&#60;MainDS.&#34;SmTrudOstNZ&#34;&#62;+&#60;MainDS.&#34;SmTrudByPasp&#34;&#62;))*100;&#13;&#10;          if eProCent &#60; 1 then AMemoView.Text:='&#60;1%' else AMemoView.Text:=FormatFloat('##0', eProCent)+'%';&#13;&#10;        end;&#13;&#10;end;&#13;&#10;&#13;&#10;function PrintDateFn(aFieldName: String): String;&#13;&#10;begin&#13;&#10;  Result:=sEmptyDatum;&#13;&#10;  if qVKZChild.FieldByName(aFieldName).IsNull&#13;&#10;    then Result:=sEmptyDatum&#13;&#10;    else Result:=FormatDateTime('DD.MM.YY', qVKZChild.FieldByName(aFieldName).AsDateTime);&#13;&#10;end;&#13;&#10;&#13;&#10;function CodPredmFn(aString: String = ''): String;&#13;&#10;begin&#13;&#10;  Result:=sEmptyDatum;&#13;&#10;  Result:=FindRegExpr('(^[^ ]* [^ ]*)|(^[^ ]*)', aString);&#13;&#10;  if Length(Result) &#60; 5 then Result:=Copy(aString, 1, 20) else begin if Length(Result) &#62; 20 then Result:=Copy(aString, 1, 18)+'...' end;&#13;&#10;end;&#13;&#10;&#13;&#10;{&#13;&#10;function NamePredmFn(aString: String = ''): String;&#13;&#10;begin&#13;&#10;&#13;&#10;  Result:=sEmptyDatum;&#13;&#10;  Result:=FindRegExpr('^[^ _]*', aString);&#13;&#10;  if Length(Result) &#60;= 32 then Result:=Copy(aString, 1, 32) else begin Result:=Copy(aString, 1, 30)+'...' end;&#13;&#10;//  if Length(aString) &#60;= 48 then Result:=Copy(aString, 1, 48) else begin Result:=Copy(aString, 1, 46)+'...' end;&#13;&#10;  Result:=aString;&#13;&#10;end;&#13;&#10;}&#13;&#10;&#13;&#10;procedure ColumnFooter1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (Engine.FinalPass and (&#60;Page&#62; = &#60;TotalPages&#62;)) then ColumnFooter1.Visible:=False;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MainDSName_PredmOnAfterData(Sender: TfrxComponent);&#13;&#10;var sTemp: String;&#13;&#10;begin&#13;&#10;  sTemp:='';&#13;&#10;  if TfrxMemoView(Sender).CalcWidth &#62; TfrxMemoView(Sender).Width&#13;&#10;    then begin&#13;&#10;    sTemp:=TfrxMemoView(Sender).Text;&#13;&#10;    while TfrxMemoView(Sender).CalcWidth &#62; TfrxMemoView(Sender).Width&#13;&#10;      do begin&#13;&#10;        sTemp:=Copy(sTemp, 1, Length(sTemp)-1);&#13;&#10;        TfrxMemoView(Sender).Text:=sTemp;&#13;&#10;      end;&#13;&#10;    sTemp:=Copy(sTemp, 1, Length(sTemp)-1);&#13;&#10;    sTemp:=sTemp+'...';&#13;&#10;    TfrxMemoView(Sender).Text:=sTemp;&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo32OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ProcentTrud(Memo32);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Page#&#62; = 1 then PageHeader1.Visible:=False else PageHeader1.Visible:=True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo43OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Copy(Trim(DateZapLagFn), 1, 1) = '-' then Memo43.Color:=$E0E0FF else Memo43.Color:=clNone;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo44OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Copy(Trim(DateVipLagFn), 1, 1) = '-' then Memo44.Color:=$E0E0FF else Memo44.Color:=clNone;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnDeactivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  iVariant:=ComboBox1.ItemIndex+1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo38OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  Memo38.Memo.Clear;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo38OnAfterData(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  Memo38.Memo.Clear;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MainDSCod_PredmOnAfterData(Sender: TfrxComponent);&#13;&#10;var sTemp: String;&#13;&#10;begin&#13;&#10;  sTemp:='';&#13;&#10;  if TfrxMemoView(Sender).CalcWidth &#62; TfrxMemoView(Sender).Width&#13;&#10;    then begin&#13;&#10;    sTemp:=TfrxMemoView(Sender).Text;&#13;&#10;    while TfrxMemoView(Sender).CalcWidth &#62; TfrxMemoView(Sender).Width&#13;&#10;      do begin&#13;&#10;        sTemp:=Copy(sTemp, 1, Length(sTemp)-1);&#13;&#10;        TfrxMemoView(Sender).Text:=sTemp;&#13;&#10;      end;&#13;&#10;    sTemp:=Copy(sTemp, 1, Length(sTemp)-1);&#13;&#10;    sTemp:=sTemp+'...';&#13;&#10;    TfrxMemoView(Sender).Text:=sTemp;&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  sEmptyDatum:='';&#13;&#10;  sAmbiguousDatum:='-!?-';&#13;&#10;  iVariant:=1;&#13;&#10;end." StoreInDFM="False">
