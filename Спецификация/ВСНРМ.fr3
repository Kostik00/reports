        <item FieldName="Cod_Ed_Izm" FieldAlias="Cod_Ed_Izm" FieldType="fftString"/>
        <item FieldName="Base_Ed" FieldAlias="Base_Ed" FieldType="fftString" Size="15"/>
        <item FieldName="Sortam" FieldAlias="Sortam" FieldType="fftString" Size="150"/>
