    <TfrxERQuery Name="WSIQRY" UserName="ÂÑÈ" CloseDataSource="False" FieldAliases.Text="Key_VKZ_Izdel=Key_VKZ_Izdel&#13;&#10;Key_Predm=Key_Predm&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Cod_Postav=Cod_Postav&#13;&#10;Name_Postav=Name_Postav&#13;&#10;Cod_Prin=Cod_Prin&#13;&#10;Name_K_Prin=Name_K_Prin&#13;&#10;OrderCod_Predm=OrderCod_Predm&#13;&#10;Kolvo=Kolvo&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;PrintFlag=PrintFlag&#13;&#10;Name_Prin=Name_Prin" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT     P_VKZ.Key_VKZ_Izdel, P_VKZ.Key_Predm, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, T_VPredm.Cod_Postav, T_VPredm.Name_Postav, T_VPredm.Cod_Prin, &#13;&#10;                      T_VPredm.Name_K_Prin, T_VPredm.OrderCod_Predm, SUM(P_VKZ.Kolvo) AS Kolvo, T_VPredm.Sortam, T_VPredm.Type_NTD_Sortam, T_VPredm.Name_NTD_Sortam, &#13;&#10;                      T_VPredm.Marka, T_VPredm.Type_NTD_Marka, T_VPredm.Name_NTD_Marka, T_VPredm.PrintFlag, T_VPredm.Name_Prin&#13;&#10;FROM         P_VKZ INNER JOIN&#13;&#10;                      T_VPredm ON P_VKZ.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE     (P_VKZ.Key_VKZ_Izdel = :Key_VKZ_Izdel )                          &#13;&#10;GROUP BY P_VKZ.Key_VKZ_Izdel, P_VKZ.Key_Predm, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, T_VPredm.Cod_Postav, T_VPredm.Name_Postav, T_VPredm.Cod_Prin, &#13;&#10;                      T_VPredm.Name_K_Prin, T_VPredm.OrderCod_Predm, T_VPredm.Sortam, T_VPredm.Type_NTD_Sortam, T_VPredm.Name_NTD_Sortam, T_VPredm.Marka, &#13;&#10;                      T_VPredm.Type_NTD_Marka, T_VPredm.Name_NTD_Marka, T_VPredm.PrintFlag, T_VPredm.Name_Prin&#13;&#10;ORDER BY T_VPredm.Cod_Postav, T_VPredm.Cod_Prin, T_VPredm.OrderCod_Predm&#13;&#10;    " PropData="05704C656674023C0470546F7002140A506172616D657465727301010C2A000000204E616D653D224B65795F564B5A5F497A64656C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="RezervQRY" UserName="Ðåçåðâ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="WSIQRY" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT                                          &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       P_VKZ.Key_Predm, &#13;&#10;       A_Rezerv.Key_Rezerv, &#13;&#10;       A_Rezerv.KolDT, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Sortam,&#13;&#10;       T_VPredm.Type_NTD_Sortam, &#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       T_VPredm.PrintFlag,&#13;&#10;       A_VID_Mat.VidSert, &#13;&#10;       A_VID_Mat.N_Sert, &#13;&#10;       A_VID_Mat.Date_Sert, &#13;&#10;       A_VID_Mat.N_SertPos,&#13;&#10;       A_Rezerv.DateZ&#13;&#10;           &#13;&#10;FROM         P_VKZ INNER JOIN&#13;&#10;                      P_VKZ_VMZ ON P_VKZ.Key_VKZ = P_VKZ_VMZ.Key_VKZ INNER JOIN&#13;&#10;                      P_VMZ ON P_VKZ_VMZ.Key_VMZ = P_VMZ.Key_VMZ INNER JOIN&#13;&#10;                      A_Rezerv ON P_VMZ.Key_VMZ = A_Rezerv.Key_VMZ INNER JOIN&#13;&#10;                      A_VID_Mat ON A_Rezerv.Key_Id_Mat = A_VID_Mat.Key_ID_Mat INNER JOIN&#13;&#10;                      T_VPredm ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE&#13;&#10; P_VKZ.Key_VKZ_Izdel =  :Key_VKZ_Izdel        &#13;&#10; AND P_VKZ.Key_Predm =  :Key_Predm                " PropData="05704C65667403C0000470546F7002200A506172616D657465727301010C2A000000204E616D653D224B65795F564B5A5F497A64656C222044617461547970653D226674556E6B6E6F776E2200010C26000000204E616D653D224B65795F507265646D222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="PaspQRY" UserName="PaspQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="WSIQRY" IgnoreDupParams="False" SQL.Text="SELECT     P_VKZ.Key_VKZ_Izdel, P_VKZ.Key_Predm, Pr_Pasp.Cod_Pasp, Pr_Pasp.PaspKolvo, S_Subjects.Name_Sub, A_VID_Mat.VidSert, A_VID_Mat.N_Sert, &#13;&#10;                      A_VID_Mat.Date_Sert, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, T_VPredm.Sortam, T_VPredm.Type_NTD_Sortam, T_VPredm.Name_NTD_Sortam, &#13;&#10;                      T_VPredm.Marka, T_VPredm.Type_NTD_Marka, T_VPredm.Name_NTD_Marka, T_VPredm.PrintFlag                       &#13;&#10;FROM         &#13;&#10;       Pr_PaspDet &#13;&#10;       INNER JOIN  Pr_Pasp &#13;&#10;               ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;       INNER JOIN  P_VKZ &#13;&#10;               ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ &#13;&#10;       LEFT JOIN  S_Subjects &#13;&#10;               ON Pr_Pasp.Key_Sub_Master = S_Subjects.Key_Sub &#13;&#10;       LEFT JOIN  Pr_SP &#13;&#10;               ON Pr_Pasp.Key_Pasport = Pr_SP.Key_Pasport &#13;&#10;       LEFT JOIN  A_VID_Mat &#13;&#10;               ON Pr_SP.Key_ID_Mat = A_VID_Mat.Key_ID_Mat &#13;&#10;       LEFT JOIN  T_VPredm &#13;&#10;               ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;WHERE&#13;&#10;     P_VKZ.Key_VKZ_Izdel  = :Key_VKZ_Izdel            &#13;&#10; AND P_VKZ.Key_Predm  = :Key_Predm         " PropData="05704C65667403C0000470546F7002700A506172616D657465727301010C2A000000204E616D653D224B65795F564B5A5F497A64656C222044617461547970653D226674556E6B6E6F776E2200010C26000000204E616D653D224B65795F507265646D222044617461547970653D226674556E6B6E6F776E220000"/>
