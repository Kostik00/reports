      <TfrxMemoView Name="TitleText" AllowVectorExport="True" Left="0" Top="0" Width="1046" Height="24" Font.Charset="204" Font.Color="0" Font.Height="-19" Font.Name="Arial" Font.Style="1" Frame.Typ="0" ParentFont="False" Text="Проверка операций перед утверждением ТП"/>
      <TfrxMemoView Name="TPText" AllowVectorExport="True" Left="0" Top="28" Width="1046" Height="20" Font.Charset="204" Font.Color="0" Font.Height="-11" Font.Name="Arial" Font.Style="0" Frame.Typ="0" ParentFont="False" Text="ТП: [MainDS.&#34;Cod_TP&#34;]   Дата: [Date]"/>
      <TfrxMemoView Name="Explanation" AllowVectorExport="True" Left="0" Top="53" Width="1046" Height="48" Font.Charset="204" Font.Color="0" Font.Height="-11" Font.Name="Arial" Font.Style="0" Frame.Typ="0" ParentFont="False" Text="Показаны все найденные причины. «Действует = Нет» — текущий пользователь освобождён от проверки норм. Для отсутствующей операции указана строка связанного ТП. Права утверждения и вид заготовки проверяются отдельно; отсутствие строк в отчёте не гарантирует утверждение."/>
    </TfrxReportTitle>
