    <TfrxERQuery Name="PaspQRY" RangeBegin="rbCurrent" RangeEnd="reCurrent" UserName="PaspQRY" CloseDataSource="False" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="20" Top="20" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Pasp.Key_Pasport,&#13;&#10;  Pr_Pasp.Cod_Pasp,&#13;&#10;  Pr_Pasp.Cod_Zak,&#13;&#10;  Pr_Pasp.Key_SP,&#13;&#10;  T_SP.SP_Version,&#13;&#10;  Pr_Pasp.Key_TP,&#13;&#10;  T_TP.Cod_TP,&#13;&#10;  T_TP.TP_Version,&#13;&#10;  Pr_Pasp.TTSert,&#13;&#10;  Pr_Pasp.TTZap,&#13;&#10;  Pr_Pasp.TTPr,&#13;&#10;  Pr_Pasp.TTSvr,&#13;&#10;  Pr_Pasp.ZavNumFrom,&#13;&#10;  Pr_Pasp.ZavNumTo,&#13;&#10;  &#13;&#10;  Pr_Pasp.AdInfo,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_Predm,&#13;&#10;  T_Predm.Cod_Predm,&#13;&#10;  T_Predm.Name_Predm,&#13;&#10;&#13;&#10;&#13;&#10;  Pr_Pasp.ProfRazmZagotov,&#13;&#10;  Pr_Pasp.KolvoZagotov,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_GrZap,&#13;&#10;&#13;&#10;  Pr_Pasp.PaspKolvo,                                                  &#13;&#10;&#13;&#10;  Pr_Pasp.ProfRazmProba,&#13;&#10;  Pr_Pasp.KolvoProba,&#13;&#10;  Pr_Pasp.KolProbaZag,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_Proba,&#13;&#10;  Proba.Cod_Predm Cod_Proba,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_Sub_Ver_Pasp,&#13;&#10;  S_Subjects_Pasp.Name_Sub AS Name_Sub_Pasp,&#13;&#10;  Pr_Pasp.Date_Pasp,&#13;&#10;&#13;&#10;  Pr_Pasp_Status.Name_Pasp_Status   Name_Pasp_Status,&#13;&#10;  &#13;&#10;&#13;&#10;  Pr_Pasp.Key_Sub_Ver_Prov,&#13;&#10;  S_Subjects_Prov.Name_Sub AS Name_Sub_Prov,&#13;&#10;  Pr_Pasp.Date_Prov,&#13;&#10;&#13;&#10;  T_Predm.Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS Name_NTD_Sortam,&#13;&#10;&#13;&#10;  T_Predm.Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS Name_NTD_Marka&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Pasp&#13;&#10;  LEFT JOIN T_SP&#13;&#10;    ON Pr_Pasp.Key_SP = T_SP.Key_SP&#13;&#10;  LEFT JOIN T_TP&#13;&#10;    ON Pr_Pasp.Key_TP = T_TP.Key_TP&#13;&#10;&#13;&#10;  LEFT JOIN T_Predm Proba&#13;&#10;    ON Pr_Pasp.Key_Proba=Proba.Key_Predm&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm&#13;&#10;    ON  Pr_Pasp.Key_Predm = T_Predm.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Pasp&#13;&#10;    ON S_SubVer_Pasp.Key_Sub_Ver = Pr_Pasp.Key_Sub_Ver_Pasp&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Pasp&#13;&#10;    ON S_SubVer_Pasp.Key_Sub = S_Subjects_Pasp.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN  S_SubVer S_SubVer_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub_Ver = Pr_Pasp.Key_Sub_Ver_Prov&#13;&#10;  LEFT JOIN S_Subjects S_Subjects_Prov&#13;&#10;    ON S_SubVer_Prov.Key_Sub = S_Subjects_Prov.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN dbo.Pr_Pasp_Status   Pr_Pasp_Status&#13;&#10;    ON  Pr_Pasp.Key_Pasp_Status=Pr_Pasp_Status.Key_Pasp_Status&#13;&#10;&#13;&#10;WHERE&#13;&#10;   Pr_Pasp.Key_Pasport=:Key_Pasport&#13;&#10;&#13;&#10;  ">
      <FieldDefs>
        <item FieldName="Key_Pasport" FieldAlias="Key_Pasport"/>
        <item FieldName="Cod_Pasp" FieldAlias="Cod_Pasp" FieldType="fftString" Size="50"/>
