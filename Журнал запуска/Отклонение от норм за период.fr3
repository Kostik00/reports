<TfrxReport Version="4.11.16" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41058,7321152431" ReportOptions.Description.Text="" ReportOptions.Name="Îòêëîíåíèå îò íîðì çà ïåðèîä.fr3 Æóðíàë çàïóñêà" ReportOptions.LastChange="41095,4795950347" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;function CalcOverload:double;  &#13;&#10;begin&#13;&#10;  if &#60;Îïåðàöèè.&#34;ZapS&#34;&#62; &#60; &#60;Îïåðàöèè.&#34;TSm&#34;&#62;  then            &#13;&#10;    Result:=  &#60;Îïåðàöèè.&#34;ZapF&#34;&#62; -  &#60;Îïåðàöèè.&#34;TSm&#34;&#62;&#13;&#10;  else                  &#13;&#10;    Result:=  &#60;Îïåðàöèè.&#34;ZapF&#34;&#62; -  &#60;Îïåðàöèè.&#34;ZapS&#34;&#62;;      &#13;&#10;    &#13;&#10;end ;  &#13;&#10;  &#13;&#10;  &#13;&#10;procedure Memo4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;Îïåðàöèè.&#34;TSm&#34;&#62; = 0 then&#13;&#10;    TSMMemo.Color := $008A8AFF&#13;&#10;  else&#13;&#10;    TSMMemo.Color := clNone;  &#13;&#10;      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure CheckBox1OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   Memo25.Visible:=CheckBox1.Checked;                                                                         &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2800000020446174615365743D225350526F77732220446174615365744E616D653D22CEEFE5F0E0F6E8E8220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="SPRows" UserName="Îïåðàöèè" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="&#13;&#10;SELECT &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm, &#13;&#10;	Pr_Pasp.Cod_Zak,&#13;&#10;	Pr_Pasp.Cod_Pasp,&#13;&#10;	Pr_Pasp_Rows.N_Oper_Sm, &#13;&#10;	Pr_Pasp_Rows.TSm,&#13;&#10;	Isnull(TS.TZap,0) ZapS, &#13;&#10; Isnull(TF.TZap,0) ZapF,&#13;&#10;	Isnull(TF.TZap,0) -  Pr_Pasp_Rows.TSm T,&#13;&#10; T_Oper.Name_K_Oper                             &#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;	Pr_Pasp &#13;&#10;	INNER JOIN Pr_Pasp_Rows &#13;&#10;		ON Pr_Pasp_Rows.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm&#13;&#10;	INNER JOIN T_Oper&#13;&#10;		ON T_Oper.cod_Oper = Pr_Pasp_Rows.Cod_Oper   &#13;&#10;  &#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;	(&#13;&#10;		SELECT     &#13;&#10;			Pr_Pasp_Rows.Key_Pasp_Rows,&#13;&#10;			IsNull(SUM(Pr_Tabel_MK.Tzap),0) TZap &#13;&#10;		FROM         &#13;&#10;			Pr_Tabel &#13;&#10;			INNER JOIN Pr_Tabel_MK &#13;&#10;				ON Pr_Tabel.Key_Tabel = Pr_Tabel_MK.Key_Tabel &#13;&#10;			INNER JOIN Pr_Pasp_Rows &#13;&#10;				ON Pr_Tabel_MK.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows&#13;&#10;		WHERE&#13;&#10;			Pr_Tabel.Date_Tabel &#60; :DateFrom                                                &#13;&#10;		GROUP BY Pr_Pasp_Rows.Key_Pasp_Rows&#13;&#10;	)  TS&#13;&#10;		ON TS.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows&#13;&#10;&#13;&#10;	LEFT JOIN &#13;&#10;	(&#13;&#10;		SELECT     &#13;&#10;			Pr_Pasp_Rows.Key_Pasp_Rows,&#13;&#10;			IsNull(SUM(Pr_Tabel_MK.Tzap),0) TZap &#13;&#10;		FROM         &#13;&#10;			Pr_Tabel &#13;&#10;			INNER JOIN Pr_Tabel_MK &#13;&#10;				ON Pr_Tabel.Key_Tabel = Pr_Tabel_MK.Key_Tabel &#13;&#10;			INNER JOIN Pr_Pasp_Rows &#13;&#10;				ON Pr_Tabel_MK.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows&#13;&#10;		WHERE&#13;&#10;			Pr_Tabel.Date_Tabel &#60;= :DateTo                   &#13;&#10;		GROUP BY Pr_Pasp_Rows.Key_Pasp_Rows&#13;&#10;	)  TF&#13;&#10;	ON TF.Key_Pasp_Rows = Pr_Pasp_Rows.Key_Pasp_Rows&#13;&#10;&#13;&#10;WHERE &#13;&#10;	isnull(TF.TZap,0) &#62; (isnull(Pr_Pasp_Rows.TSm,0) + 0.01)                    &#13;&#10;	AND &#13;&#10;  isnull(TS.TZap,0) &#60; (Isnull(TF.TZap,0) - 0.01)&#13;&#10; AND (&#13;&#10;       ((:CheckBox1 = 0) or ((isnull(Pr_Pasp_Rows.TSm,0) = 0))&#13;&#10;       AND (Pr_Pasp_Rows.Key_TPRows is not null))                                                            &#13;&#10;     )&#13;&#10;   &#13;&#10;&#13;&#10;  &#13;&#10;ORDER BY &#13;&#10;	Pr_Pasp.Cod_Zak, T_VPredm.Cod_Predm, T_VPredm.Name_Predm, 	Pr_Pasp.Cod_Pasp, 	Pr_Pasp_Rows.N_Oper_Sm       &#13;&#10;	  " PropData=""/>
  </TfrxDataPage>
