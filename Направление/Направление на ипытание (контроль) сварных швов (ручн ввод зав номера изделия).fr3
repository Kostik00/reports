    <TfrxERQuery Name="RezQRY2" UserName="Результат2" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_Sert_Rez.Key_Isp, &#13;&#10;       T_Sert_Attr_TT.Cod_TT, &#13;&#10;       T_Sert_Attr_TT.OrderPos, &#13;&#10;       T_Sert_Attr.Attr, &#13;&#10;       T_Sert_Rez.Attr_Val&#13;&#10;       ,T_Sert_Attr.HtmlPrefix&#13;&#10;       ,T_Sert_Rez.Attr_EI                 &#13;&#10;FROM         T_Sert_Rez INNER JOIN&#13;&#10;                      T_Sert_Attr ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr INNER JOIN&#13;&#10;                      T_Sert_Attr_TT ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr&#13;&#10;WHERE     &#13;&#10;       (T_Sert_Rez.Key_Isp = :Key_Isp ) AND (T_Sert_Attr_TT.Cod_TT = :Cod_TT )&#13;&#10;       AND T_Sert_Attr_TT.OrderPos  between 100 and 199                                                 &#13;&#10;&#13;&#10;  &#13;&#10;ORDER BY T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Attr                " PropData="05704C6566740328010470546F70037C010A506172616D657465727301010624204E616D653D224B65795F497370222044617461547970653D226674556E6B6E6F776E2200010623204E616D653D22436F645F5454222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NaprHDR" UserName="Направление" CloseDataSource="True" FieldAliases.Text="Key_Napr=Key_Napr&#13;&#10;Num_Napr=Num_Napr&#13;&#10;Data_Napr=Data_Napr&#13;&#10;Key_Pasport=Key_Pasport&#13;&#10;Cod_Pasp=Cod_Pasp&#13;&#10;ZavNumIzdel=ZavNumIzdel&#13;&#10;Cod_TP=Cod_TP&#13;&#10;Cod_Zak=Cod_Zak&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Cod_Predm_Izdel=Cod_Predm_Izdel&#13;&#10;Name_Predm_Izdel=Name_Predm_Izdel&#13;&#10;Cod_Predm_Proba=Cod_Predm_Proba" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;  Pr_Napr.Key_Napr,&#13;&#10;  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  Pr_Pasp.Key_Pasport,                            &#13;&#10;  Pr_Pasp.Cod_Pasp,&#13;&#10;          &#13;&#10;  T_TP.Cod_TP,                      &#13;&#10;     &#13;&#10;  P_VKZ.Cod_Zak,&#13;&#10;&#13;&#10;&#13;&#10;  T_VPredm.Cod_Predm,&#13;&#10;  T_VPredm.Name_Predm,&#13;&#10; &#13;&#10;--  Pr_NaprZakl.ZavNumFrom,&#13;&#10;--  Pr_NaprZakl.ZavNumTo,                          &#13;&#10;&#13;&#10;  T_VPredm_Izdel.Cod_Predm Cod_Predm_Izdel,&#13;&#10;  T_VPredm_Izdel.Name_Predm Name_Predm_Izdel,&#13;&#10;  T_VPredm_Proba.Cod_Predm Cod_Predm_Proba                                                       &#13;&#10;    &#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT JOIN Pr_NaprZakl&#13;&#10;    ON Pr_NaprZakl.Key_Napr=Pr_Napr.Key_Napr      &#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;    ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;  INNER JOIN T_TP&#13;&#10;    ON T_TP.Key_TP = Pr_Pasp.Key_TP                                                                                              &#13;&#10;      &#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm&#13;&#10;      &#13;&#10;  LEFT JOIN Pr_SP&#13;&#10;    ON Pr_SP.Key_Pasport  =  Pr_NaprZakl.Key_Pasport&#13;&#10;    AND Pr_SP.Key_PrSp = Pr_NaprZakl.Key_PrSp                                  &#13;&#10;&#13;&#10;  LEFT JOIN Pr_PaspDet&#13;&#10;    ON Pr_PaspDet.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;&#13;&#10;  LEFT JOIN P_VKZ&#13;&#10;    ON Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  LEFT JOIN P_VKZ Pr_VKZIzdel&#13;&#10;    ON Pr_VKZIzdel.Key_VKZ=P_VKZ.Key_VKZ_Izdel &#13;&#10;&#13;&#10;  LEFT JOIN T_VPredm T_VPredm_Izdel&#13;&#10;    ON T_VPredm_Izdel.Key_Predm=Pr_VKZIzdel.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN T_VPredm T_VPredm_Proba  &#13;&#10;    ON T_VPredm_Proba.Key_Predm =  Pr_Pasp.Key_Proba&#13;&#10;&#13;&#10;&#13;&#10;            &#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Napr.Key_Napr= :Key_Napr      &#13;&#10;&#13;&#10;ORDER BY Cod_Predm_Izdel, T_VPredm.Cod_Predm, Pr_Pasp.Cod_Pasp                                           " PropData="05704C656674024C0470546F7002280A506172616D657465727301010625204E616D653D224B65795F4E617072222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="TTQry" UserName="TTQry" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="SELECT                      &#13;&#10;       Pr_NaprZakl.Key_Zakl, &#13;&#10;       Pr_NaprZakl.ZavNumFrom, &#13;&#10;       Pr_NaprZakl.ZavNumTo, &#13;&#10;       Pr_NaprZakl.Key_PrSp, &#13;&#10;       Pr_NaprZakl.Cod_TT,&#13;&#10;       Pr_NaprZakl.DopInfo,             &#13;&#10;&#13;&#10;       Pr_NaprZakl.ParamKontr,&#13;&#10;       Pr_NaprZakl.VolKontr,             &#13;&#10;       Pr_NaprZakl.Name_NTD,&#13;&#10;&#13;&#10;       dbo.T_GetTechTrebNTD(Pr_NaprZakl.Cod_TT, Pr_NaprZakl.TTNTDFL) Name_NTD1,&#13;&#10;       dbo.T_GetTechTrebNTD(Pr_NaprZakl.Cod_TT, Pr_NaprZakl.TTNTDFlUd)  TTNTDUd,&#13;&#10;       dbo.T_GetTechTrebNTD(Pr_NaprZakl.Cod_TT, Pr_NaprZakl.TTNTDFlNUd)  TTNTDNUd,&#13;&#10;&#13;&#10;       Pr_NaprZakl.TxtUd,&#13;&#10;       Pr_NaprZakl.TxtNud,                             &#13;&#10;  &#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       Pr_NaprZakl.Kolvo, &#13;&#10;       Pr_NaprZakl.Key_NaprZakl&#13;&#10;       ,T_Sert_Isp.Key_Isp&#13;&#10;       , T_Sert_Isp.Cod_Isp&#13;&#10;       , T_Sert_Isp.KolvoNum&#13;&#10;       , Pr_Napr.Num_Napr&#13;&#10;       , Pr_Napr.Data_Napr&#13;&#10;       , Pr_NaprZakl.DopInfo NaprDopInfo                                       &#13;&#10;       , Pr_NaprZakl.TOInfo&#13;&#10;       , Pr_NaprZakl.TOSadka                                &#13;&#10;FROM                                &#13;&#10;       Pr_NaprZakl&#13;&#10;       INNER JOIN  T_TechTreb &#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT &#13;&#10;       LEFT JOIN  T_Sert_Isp &#13;&#10;               ON Pr_NaprZakl.Key_NaprZakl = T_Sert_Isp.Key_NaprZakl &#13;&#10;       LEFT OUTER JOIN T_VPredm &#13;&#10;               ON Pr_NaprZakl.Key_Predm_Proba = T_VPredm.Key_Predm&#13;&#10;       INNER JOIN Pr_Napr&#13;&#10;               ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr                                                                                             &#13;&#10;&#13;&#10;                        &#13;&#10;WHERE    &#13;&#10;Pr_NaprZakl.Key_NaprZakl = :Key_NaprZakl                          &#13;&#10;  &#13;&#10;-- (Pr_NaprZakl.Key_Zakl = :Key_Zakl ) AND (Pr_NaprZakl.Key_PrSp = :Key_PrSp )&#13;&#10;&#13;&#10;ORDER BY Pr_NaprZakl.Cod_TT, T_Sert_Isp.Cod_Isp    " PropData=""/>
    <TfrxERQuery Name="RezQRY3" UserName="Результат3" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_Sert_Rez.Key_Isp, &#13;&#10;       T_Sert_Attr_TT.Cod_TT, &#13;&#10;       T_Sert_Attr_TT.OrderPos, &#13;&#10;       T_Sert_Attr.Attr, &#13;&#10;       T_Sert_Rez.Attr_Val&#13;&#10;       ,T_Sert_Attr.HtmlPrefix                                   &#13;&#10;       ,T_Sert_Rez.Attr_EI                 &#13;&#10;FROM         T_Sert_Rez INNER JOIN&#13;&#10;                      T_Sert_Attr ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr INNER JOIN&#13;&#10;                      T_Sert_Attr_TT ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr&#13;&#10;WHERE     &#13;&#10;       (T_Sert_Rez.Key_Isp = :Key_Isp ) AND (T_Sert_Attr_TT.Cod_TT = :Cod_TT )&#13;&#10;       AND T_Sert_Attr_TT.OrderPos between 200 and 299                                                                                               &#13;&#10;&#13;&#10;  &#13;&#10;ORDER BY T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Attr                " PropData="05704C656674037C010470546F70037C010A506172616D657465727301010624204E616D653D224B65795F497370222044617461547970653D226674556E6B6E6F776E2200010623204E616D653D22436F645F5454222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="RezQRY4" UserName="Результат4" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_Sert_Rez.Key_Isp, &#13;&#10;       T_Sert_Attr_TT.Cod_TT, &#13;&#10;       T_Sert_Attr_TT.OrderPos, &#13;&#10;       T_Sert_Attr.Attr, &#13;&#10;       T_Sert_Rez.Attr_Val&#13;&#10;       ,T_Sert_Attr.HtmlPrefix                                   &#13;&#10;       ,T_Sert_Rez.Attr_EI                 &#13;&#10;FROM         T_Sert_Rez INNER JOIN&#13;&#10;                      T_Sert_Attr ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr INNER JOIN&#13;&#10;                      T_Sert_Attr_TT ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr&#13;&#10;WHERE     &#13;&#10;       (T_Sert_Rez.Key_Isp = :Key_Isp ) AND (T_Sert_Attr_TT.Cod_TT = :Cod_TT )&#13;&#10;       AND Isnull(T_Sert_Attr_TT.OrderPos,999) &#62;= 300&#13;&#10;         &#13;&#10;&#13;&#10;  &#13;&#10;ORDER BY T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Attr                " PropData="05704C65667403C8010470546F70037C010A506172616D657465727301010624204E616D653D224B65795F497370222044617461547970653D226674556E6B6E6F776E2200010623204E616D653D22436F645F5454222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="ERQuery1" UserName="Контролер" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="--SubjQRY&#13;&#10;SELECT&#13;&#10;  S_Subjects.Key_Sub  AS Key_Sprav,&#13;&#10;  S_Subjects.Name_Sub AS Name_Sprav,&#13;&#10;&#13;&#10;&#13;&#10;  SubAtrib11.Val_Str Val_Str11,&#13;&#10;  SubAtrib19.Val_Str Val_Str19,&#13;&#10;  SubAtrib20.Val_Str Val_Str20,&#13;&#10;&#13;&#10;  SubAtrib9.Val_Str Val_Str9&#13;&#10;&#13;&#10;&#13;&#10;FROM   S_Subjects S_Subjects&#13;&#10;   LEFT JOIN S_SubVer Sub_Ver&#13;&#10;   ON  S_Subjects.Key_Sub=Sub_Ver.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib11&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib11.Key_Sub&#13;&#10;       AND SubAtrib11.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib11.Key_Rekv = 11&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib19&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib19.Key_Sub&#13;&#10;        AND SubAtrib19.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;      AND SubAtrib19.Key_Rekv = 19&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib20&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib20.Key_Sub&#13;&#10;       AND SubAtrib20.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib20.Key_Rekv = 20&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib9&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib9.Key_Sub&#13;&#10;       AND SubAtrib9.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib9.Key_Rekv = 9&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Sub_Ver.Key_Sub_Ver = :Key_Sub_Ver_OTK                                         &#13;&#10;&#13;&#10;  " PropData="05704C6566740328010470546F7003C8010A506172616D65746572730101062C204E616D653D224B65795F5375625F5665725F4F544B222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="ERQuery2" UserName="Руководитель" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="--SubjQRY&#13;&#10;SELECT&#13;&#10;  S_Subjects.Key_Sub  AS Key_Sprav,&#13;&#10;  S_Subjects.Name_Sub AS Name_Sprav,&#13;&#10;&#13;&#10;&#13;&#10;  SubAtrib11.Val_Str Val_Str11,&#13;&#10;  SubAtrib19.Val_Str Val_Str19,&#13;&#10;  SubAtrib20.Val_Str Val_Str20,&#13;&#10;&#13;&#10;  SubAtrib9.Val_Str Val_Str9&#13;&#10;&#13;&#10;&#13;&#10;FROM   S_Subjects S_Subjects&#13;&#10;   LEFT JOIN S_SubVer Sub_Ver&#13;&#10;   ON  S_Subjects.Key_Sub=Sub_Ver.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib11&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib11.Key_Sub&#13;&#10;       AND SubAtrib11.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib11.Key_Rekv = 11&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib19&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib19.Key_Sub&#13;&#10;        AND SubAtrib19.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;      AND SubAtrib19.Key_Rekv = 19&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib20&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib20.Key_Sub&#13;&#10;       AND SubAtrib20.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib20.Key_Rekv = 20&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib9&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib9.Key_Sub&#13;&#10;       AND SubAtrib9.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib9.Key_Rekv = 9&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Sub_Ver.Key_Sub_Ver = :Key_Sub_Ver_NachOTK                                         &#13;&#10;&#13;&#10;  " PropData="05704C656674037C010470546F7003C8010A506172616D657465727301010630204E616D653D224B65795F5375625F5665725F4E6163684F544B222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="RezQRY1" UserName="Результат1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_Sert_Rez.Key_Isp, &#13;&#10;       T_Sert_Attr_TT.Cod_TT, &#13;&#10;       T_Sert_Attr_TT.OrderPos, &#13;&#10;       T_Sert_Attr.Attr, &#13;&#10;       T_Sert_Rez.Attr_Val&#13;&#10;       ,T_Sert_Attr.HtmlPrefix&#13;&#10;       ,T_Sert_Rez.Attr_EI                 &#13;&#10;FROM         T_Sert_Rez INNER JOIN&#13;&#10;                      T_Sert_Attr ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr INNER JOIN&#13;&#10;                      T_Sert_Attr_TT ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr&#13;&#10;WHERE     &#13;&#10;       (T_Sert_Rez.Key_Isp = :Key_Isp ) AND (T_Sert_Attr_TT.Cod_TT = :Cod_TT )&#13;&#10;       AND T_Sert_Attr_TT.OrderPos between 0 and 99                                                      &#13;&#10;&#13;&#10;  &#13;&#10;ORDER BY T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Attr                " PropData="05704C65667403D8000470546F70037C010A506172616D657465727301010624204E616D653D224B65795F497370222044617461547970653D226674556E6B6E6F776E2200010623204E616D653D22436F645F5454222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NominValQRY1" UserName="NominValQRY1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl, &#13;&#10;       T_Sert_Attr.Attr,&#13;&#10;       T_Sert_Attr.Key_Sert_Attr,&#13;&#10;       T_Sert_Attr.HtmlPrefix,                                   &#13;&#10;       Pr_NaprNominVal.NominVal, &#13;&#10;       Pr_NaprNominVal.NominVal_EI, &#13;&#10;       Pr_NaprNominVal.ValByKD,&#13;&#10;       Pr_NaprNominVal.ValByKD_EI, &#13;&#10;       T_Sert_Attr_TT.OrderPos&#13;&#10;FROM&#13;&#10;       Pr_NaprZakl&#13;&#10;       INNER JOIN T_Sert_Attr_TT &#13;&#10;               ON  T_Sert_Attr_TT.Cod_TT = Pr_NaprZakl.Cod_TT&#13;&#10;       INNER JOIN T_Sert_Attr                            &#13;&#10;               ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr &#13;&#10;       INNER JOIN Pr_NaprNominVal &#13;&#10;               ON Pr_NaprNominVal.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr &#13;&#10;               AND Pr_NaprNominVal.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;              &#13;&#10;WHERE &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl = :Key_NaprZakl&#13;&#10;         AND T_Sert_Attr_TT.OrderPos between 0 and 99&#13;&#10;         AND Isnull(Pr_NaprNominVal.ValByKD,'') &#60;&#62; ''                                                       &#13;&#10;ORDER BY  T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Key_Sert_Attr                               " PropData="05704C65667403D8000470546F70032C010A506172616D657465727301010629204E616D653D224B65795F4E6170725A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NominValQRY2" UserName="NominValQRY2" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl, &#13;&#10;       T_Sert_Attr.Attr,&#13;&#10;       T_Sert_Attr.Key_Sert_Attr,&#13;&#10;       T_Sert_Attr.HtmlPrefix,                                   &#13;&#10;       Pr_NaprNominVal.NominVal, &#13;&#10;       Pr_NaprNominVal.NominVal_EI, &#13;&#10;       Pr_NaprNominVal.ValByKD,&#13;&#10;       Pr_NaprNominVal.ValByKD_EI, &#13;&#10;       T_Sert_Attr_TT.OrderPos&#13;&#10;FROM&#13;&#10;       Pr_NaprZakl&#13;&#10;       INNER JOIN T_Sert_Attr_TT &#13;&#10;               ON  T_Sert_Attr_TT.Cod_TT = Pr_NaprZakl.Cod_TT&#13;&#10;       INNER JOIN T_Sert_Attr                            &#13;&#10;               ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr &#13;&#10;       INNER JOIN Pr_NaprNominVal &#13;&#10;               ON Pr_NaprNominVal.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr &#13;&#10;               AND Pr_NaprNominVal.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;              &#13;&#10;WHERE &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl = :Key_NaprZakl&#13;&#10;         AND T_Sert_Attr_TT.OrderPos between 100 and 199    &#13;&#10;         AND Isnull(Pr_NaprNominVal.ValByKD,'') &#60;&#62; ''                                                       &#13;&#10;ORDER BY  T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Key_Sert_Attr                               " PropData="05704C656674032C010470546F70032C010A506172616D657465727301010629204E616D653D224B65795F4E6170725A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NominValQRY3" UserName="NominValQRY3" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl, &#13;&#10;       T_Sert_Attr.Attr,&#13;&#10;       T_Sert_Attr.Key_Sert_Attr,&#13;&#10;       T_Sert_Attr.HtmlPrefix,                                   &#13;&#10;       Pr_NaprNominVal.NominVal, &#13;&#10;       Pr_NaprNominVal.NominVal_EI, &#13;&#10;       Pr_NaprNominVal.ValByKD,&#13;&#10;       Pr_NaprNominVal.ValByKD_EI, &#13;&#10;       T_Sert_Attr_TT.OrderPos&#13;&#10;FROM&#13;&#10;       Pr_NaprZakl&#13;&#10;       INNER JOIN T_Sert_Attr_TT &#13;&#10;               ON  T_Sert_Attr_TT.Cod_TT = Pr_NaprZakl.Cod_TT&#13;&#10;       INNER JOIN T_Sert_Attr                            &#13;&#10;               ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr &#13;&#10;       INNER JOIN Pr_NaprNominVal &#13;&#10;               ON Pr_NaprNominVal.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr &#13;&#10;               AND Pr_NaprNominVal.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;              &#13;&#10;WHERE &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl = :Key_NaprZakl&#13;&#10;         AND T_Sert_Attr_TT.OrderPos between 200 and 299    &#13;&#10;         AND Isnull(Pr_NaprNominVal.ValByKD,'') &#60;&#62; ''                                                       &#13;&#10;ORDER BY  T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Key_Sert_Attr                               " PropData="05704C656674037C010470546F700328010A506172616D657465727301010629204E616D653D224B65795F4E6170725A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NominValQRY4" UserName="NominValQRY4" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="TTQry" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl, &#13;&#10;       T_Sert_Attr.Attr,&#13;&#10;       T_Sert_Attr.Key_Sert_Attr,&#13;&#10;       T_Sert_Attr.HtmlPrefix,                                   &#13;&#10;       Pr_NaprNominVal.NominVal, &#13;&#10;       Pr_NaprNominVal.NominVal_EI, &#13;&#10;       Pr_NaprNominVal.ValByKD,&#13;&#10;       Pr_NaprNominVal.ValByKD_EI, &#13;&#10;       T_Sert_Attr_TT.OrderPos&#13;&#10;FROM&#13;&#10;       Pr_NaprZakl&#13;&#10;       INNER JOIN T_Sert_Attr_TT &#13;&#10;               ON  T_Sert_Attr_TT.Cod_TT = Pr_NaprZakl.Cod_TT&#13;&#10;       INNER JOIN T_Sert_Attr                            &#13;&#10;               ON T_Sert_Attr.Key_Sert_Attr = T_Sert_Attr_TT.Key_Sert_Attr &#13;&#10;       LEFT JOIN Pr_NaprNominVal &#13;&#10;               ON Pr_NaprNominVal.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr &#13;&#10;               AND Pr_NaprNominVal.Key_NaprZakl = Pr_NaprZakl.Key_NaprZakl&#13;&#10;              &#13;&#10;WHERE &#13;&#10;       Pr_NaprNominVal.Key_NaprZakl = :Key_NaprZakl&#13;&#10;         AND T_Sert_Attr_TT.OrderPos between 300 and 99999          &#13;&#10;         AND Isnull(Pr_NaprNominVal.ValByKD,'') &#60;&#62; ''                                                       &#13;&#10;ORDER BY  T_Sert_Attr_TT.OrderPos, T_Sert_Attr.Key_Sert_Attr                               " PropData="05704C65667403C8010470546F700328010A506172616D657465727301010629204E616D653D224B65795F4E6170725A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="KontrQRY" UserName="Контроли" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprHDR" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT                                      &#13;&#10;       Pr_NaprZakl.Key_Napr, &#13;&#10;       Pr_NaprZakl.Cod_TT,&#13;&#10;             &#13;&#10;       T_TechTreb.Name_TT  &#13;&#10;FROM                                &#13;&#10;       Pr_NaprZakl&#13;&#10;       INNER JOIN  T_TechTreb &#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT &#13;&#10;                                                                                                  &#13;&#10;&#13;&#10;                        &#13;&#10;WHERE     (Pr_NaprZakl.Key_Napr = :Key_Napr )&#13;&#10;&#13;&#10;ORDER BY Pr_NaprZakl.Cod_TT    " PropData="05704C656674024C0470546F70026C0A506172616D657465727301010625204E616D653D224B65795F4E617072222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NaprStrQRY" UserName="СтрокиНапр" CloseDataSource="True" FieldAliases.Text="Key_NaprZakl=Key_NaprZakl&#13;&#10;Key_PrSvr=Key_PrSvr&#13;&#10;Cod_TT=Cod_TT&#13;&#10;Name_TT=Name_TT&#13;&#10;VidKontr=VidKontr&#13;&#10;VolKontr=VolKontr&#13;&#10;Name_NTD=Name_NTD&#13;&#10;ParamKontr=ParamKontr&#13;&#10;Field8=Field8&#13;&#10;Kolvo=Kolvo&#13;&#10;ZavNumFrom=ZavNumFrom&#13;&#10;ZavNumTo=ZavNumTo&#13;&#10;PlusMP=PlusMP&#13;&#10;NumSvr=NumSvr&#13;&#10;OrderNumSvr=OrderNumSvr&#13;&#10;AdNumSvr=AdNumSvr&#13;&#10;KolvoSvr=KolvoSvr&#13;&#10;CatSvr=CatSvr&#13;&#10;TOInfo=TOInfo&#13;&#10;TOSadka=TOSadka&#13;&#10;Cod_TP=Cod_TP" BCDToCurrency="False" Master="NaprHDR" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;&#13;&#10;       Pr_NaprZakl.Key_NaprZakl,&#13;&#10;       Pr_Svr.Key_PrSvr,                                  &#13;&#10;&#13;&#10;            &#13;&#10;       Pr_NaprZakl.Cod_TT, &#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;         &#13;&#10;       T_TechTreb.VidKontr, &#13;&#10;       Pr_NaprZakl.VolKontr,&#13;&#10;       Pr_NaprZakl.Name_NTD,&#13;&#10;       Pr_NaprZakl.ParamKontr,                                       &#13;&#10;        dbo.T_GetTechTrebNTD(Pr_NaprZakl.Cod_TT, Pr_NaprZakl.TTNTDFL) Name_NTD,  &#13;&#10;          &#13;&#10;        Isnull(Pr_NaprZakl.Kolvo,0) Kolvo,&#13;&#10;        Pr_NaprZakl.ZavNumFrom,&#13;&#10;        Pr_NaprZakl.ZavNumTo,&#13;&#10;&#13;&#10;&#13;&#10;        Pr_NaprSvr.PlusMP,                                         &#13;&#10;&#13;&#10;        T_Svr.NumSvr,&#13;&#10;        dbo.T_Ordersortam(T_Svr.NumSvrPrn) OrderNumSvr,&#13;&#10;        Pr_Svr.AdNumSvr,&#13;&#10;        Pr_Svr.Kolvo KolvoSvr,&#13;&#10;        T_Svr.CatSvr,&#13;&#10;&#13;&#10;        Pr_NaprZakl.TOInfo,&#13;&#10;        Pr_NaprZakl.TOSadka,                              &#13;&#10;&#13;&#10;        TPSvr.Cod_TP&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;        Pr_Napr&#13;&#10;        INNER JOIN Pr_NaprZakl&#13;&#10;                ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr&#13;&#10;        INNER JOIN Pr_NaprSvr&#13;&#10;                ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl&#13;&#10;        INNER JOIN Pr_Svr&#13;&#10;                ON Pr_NaprSvr.Key_PrSvr = Pr_Svr.Key_PrSvr&#13;&#10;        INNER JOIN T_Svr&#13;&#10;                ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;        INNER JOIN T_TechTreb&#13;&#10;                ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;         &#13;&#10;&#13;&#10;                  &#13;&#10;&#13;&#10;        LEFT JOIN T_TP TPSvr&#13;&#10;               ON TPSvr.Key_TP=Pr_Svr.Key_TP&#13;&#10;&#13;&#10;&#13;&#10;        LEFT JOIN T_TP  T_SvrTP&#13;&#10;          ON T_SvrTP.Key_TP = Pr_Svr.Key_TP&#13;&#10;&#13;&#10;&#13;&#10;        LEFT JOIN Pr_Pasp Pr_Pasp1&#13;&#10;          ON Pr_Pasp1.Key_Pasport = Pr_Svr.Key_DT1&#13;&#10;        LEFT JOIN T_VPredm T_VPredm1&#13;&#10;          ON T_VPredm1.Key_Predm = Pr_Pasp1.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;        LEFT JOIN Pr_Pasp Pr_Pasp2&#13;&#10;          ON Pr_Pasp2.Key_Pasport = Pr_Svr.Key_DT2&#13;&#10;        LEFT JOIN T_VPredm T_VPredm2&#13;&#10;          ON T_VPredm2.Key_Predm = Pr_Pasp2.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE &#13;&#10;       Pr_NaprZakl.Key_Napr=:Key_Napr            &#13;&#10;       AND Pr_NaprZakl.Key_Pasport=:Key_Pasport                                                              &#13;&#10;&#13;&#10;ORDER BY&#13;&#10;       Pr_NaprZakl.Cod_TT, OrderNumSvr                " PropData="05704C65667403C4000470546F70022C0A506172616D657465727301010625204E616D653D224B65795F4E617072222044617461547970653D226674556E6B6E6F776E2200010628204E616D653D224B65795F506173706F7274222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrMQry" UserName="СвМ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr_Mat.Key_SvrMat,&#13;&#10;  Pr_Svr_Mat.Key_PrSvr,&#13;&#10;  &#13;&#10;  Pr_Svr_Mat.Key_Id_Mat,&#13;&#10;  T_VPredm.PrintFlag,&#13;&#10;  T_VPredm.Cod_Predm,                                  &#13;&#10;  T_VPredm.Name_Predm,&#13;&#10;  T_VPredm.Sortam,&#13;&#10;  T_VPredm.Type_NTD_Sortam,&#13;&#10;  T_VPredm.Name_NTD_Sortam,&#13;&#10;  T_VPredm.Marka,&#13;&#10;  T_VPredm.Type_NTD_Marka,&#13;&#10;  T_VPredm.Name_NTD_Marka,&#13;&#10;&#13;&#10;  A_VID_Mat.Key_Sert,&#13;&#10;  A_VID_Mat.VidSert,&#13;&#10;  A_VID_Mat.N_Sert,&#13;&#10;  A_VID_Mat.Date_Sert,&#13;&#10;  A_VID_Mat.Cod_Plavka,&#13;&#10;  A_VID_Mat.Party ,&#13;&#10;  A_VID_Mat.Key_Pasport,&#13;&#10;  A_VID_Mat.Cod_Pasp,&#13;&#10;&#13;&#10;	Pr_Svr_Mat.Polojenie,&#13;&#10;	Pr_Svr_Mat.Tok,&#13;&#10;	Pr_Svr_Mat.Polyarn,&#13;&#10;	Pr_Svr_Mat.Napr,&#13;&#10;	Pr_Svr_Mat.DopInfo,&#13;&#10;  Pr_Svr_Mat.Sila,&#13;&#10;  Pr_Svr_Mat.Skor,&#13;&#10;  Pr_Svr_Mat.Podacha&#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Svr_Mat&#13;&#10;  INNER JOIN A_VID_Mat&#13;&#10;    ON Pr_Svr_Mat.Key_Id_Mat = A_VID_Mat.Key_ID_Mat&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Svr_Mat.Key_PrSvr = :Key_PrSvr&#13;&#10;&#13;&#10;  " PropData="05704C6566740390010470546F70022C0A506172616D657465727301010626204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrDtMat" UserName="МатериалДт" CloseDataSource="True" FieldAliases.Text="Cod_Zak=Cod_Zak&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;Party=Party&#13;&#10;Pokovka=Pokovka&#13;&#10;PrintFlag=PrintFlag&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;Cod_Prin=Cod_Prin&#13;&#10;PrintFlag_Mat=PrintFlag_Mat&#13;&#10;Cod_Predm_Mat=Cod_Predm_Mat&#13;&#10;Name_Predm_Mat=Name_Predm_Mat&#13;&#10;Key_Predm_Mat=Key_Predm_Mat&#13;&#10;Sortam_Mat=Sortam_Mat&#13;&#10;Marka_Mat=Marka_Mat&#13;&#10;Type_NTD_Marka_Mat=Type_NTD_Marka_Mat&#13;&#10;Name_NTD_Marka_Mat=Name_NTD_Marka_Mat&#13;&#10;Type_NTD_Sortam_Mat=Type_NTD_Sortam_Mat&#13;&#10;Name_NTD_Sortam_Mat=Name_NTD_Sortam_Mat" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT                                 &#13;&#10;--  Pr_Pasp.Key_Pasport,&#13;&#10;--  Pr_Pasp.Cod_Pasp,&#13;&#10;  Pr_Pasp.Cod_Zak,&#13;&#10;--  Pr_Pasp.Key_SP,&#13;&#10;--  T_SP.SP_Version SP_Version,&#13;&#10;--  Pr_Pasp.Key_TP,&#13;&#10;--  T_TP.Cod_TP Cod_TP,&#13;&#10;--  T_TP.TP_Version TP_Version,&#13;&#10;&#13;&#10;  A_VId_Mat.Cod_Plavka,                                                                      &#13;&#10;  A_VId_Mat.Party,&#13;&#10;  A_VId_Mat.Pokovka,        &#13;&#10;  &#13;&#10;--  Pr_Pasp.Key_Predm            Key_Predm,&#13;&#10;--  Pr_Pasp.Cod_Predm            Cod_Predm,&#13;&#10;--  Pr_Pasp.Name_Predm            Name_Predm,&#13;&#10;    &#13;&#10;  T_Predm.PrintFlag            PrintFlag,&#13;&#10;  T_Predm.Sortam               Sortam,&#13;&#10;  T_Predm.Type_NTD_Sortam AS   Type_NTD_Sortam,&#13;&#10;  T_Predm.Name_NTD_Sortam AS   Name_NTD_Sortam,&#13;&#10;  T_Predm.Marka                Marka,&#13;&#10;  T_Predm.Type_NTD_Marka AS    Type_NTD_Marka,&#13;&#10;  T_Predm.Name_NTD_Marka AS    Name_NTD_Marka,&#13;&#10;  T_Predm.Cod_Prin             Cod_Prin,&#13;&#10;&#13;&#10;  T_Predm_Mat.PrintFlag        PrintFlag_Mat,&#13;&#10;  T_Predm_Mat.Cod_Predm        Cod_Predm_Mat,&#13;&#10;  T_Predm_Mat.Name_Predm       Name_Predm_Mat,&#13;&#10;  T_Predm_Mat.Key_Predm        Key_Predm_Mat,&#13;&#10;  T_Predm_Mat.Sortam           Sortam_Mat,&#13;&#10;  T_Predm_Mat.MarkaPrn         Marka_Mat,&#13;&#10;  T_Predm_Mat.Type_NTD_Marka   Type_NTD_Marka_Mat,&#13;&#10;  T_Predm_Mat.Name_NTD_Marka   Name_NTD_Marka_Mat,&#13;&#10;  T_Predm_Mat.Type_NTD_Sortam  Type_NTD_Sortam_Mat,&#13;&#10;  T_Predm_Mat.Name_NTD_Sortam  Name_NTD_Sortam_Mat&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;&#13;&#10; Pr_Svr&#13;&#10; INNER JOIN T_Svr&#13;&#10;       ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;         &#13;&#10; INNER JOIN T_SvrDt    &#13;&#10;       ON  T_SvrDt.Key_Svr= T_Svr.Key_Svr&#13;&#10;         &#13;&#10; INNER JOIN Pr_SvrDT&#13;&#10;       ON  Pr_SvrDT.Key_PrSvr  = Pr_Svr.Key_PrSvr&#13;&#10;       AND Pr_SvrDT.Key_Svr    = T_Svr.Key_Svr&#13;&#10;       AND Pr_SvrDT.NumDT      = T_SvrDt.NumDT                                  &#13;&#10;&#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;       ON  &#13;&#10;               Pr_Pasp.Key_Pasport= Pr_SvrDT.Key_Pasport&#13;&#10;         &#13;&#10;  LEFT JOIN Pr_VSP  Pr_SP&#13;&#10;    ON  Pr_SP.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;    AND Pr_SP.SP_position=0&#13;&#10;&#13;&#10;  LEFT JOIN T_SP&#13;&#10;    ON Pr_Pasp.Key_SP = T_SP.Key_SP&#13;&#10;&#13;&#10;  LEFT JOIN A_VId_Mat&#13;&#10;    ON A_VId_Mat.Key_Id_Mat=Pr_SP.Key_Id_Mat&#13;&#10;&#13;&#10;  LEFT JOIN T_VPredm T_Predm_Mat&#13;&#10;    ON  T_Predm_Mat.Key_Predm = A_VId_Mat.Key_Predm&#13;&#10;&#13;&#10;  LEFT JOIN T_TP&#13;&#10;    ON Pr_Pasp.Key_TP = T_TP.Key_TP&#13;&#10;&#13;&#10;  INNER JOIN T_VPredm T_Predm&#13;&#10;    ON  isnull(T_SvrDt.TB_Key_Predm, Pr_Pasp.Key_Predm) = T_Predm.Key_Predm&#13;&#10;&#13;&#10;  &#13;&#10;WHERE&#13;&#10;  Pr_Svr.Key_PrSvr=:Key_PrSvr" PropData="05704C6566740300020470546F70022C0A506172616D657465727301010626204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrIspQRY" UserName="Сварщики" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr_Isp.Key_PrSvr,&#13;&#10;  Pr_Svr_Isp.Key_SvrPrimen,&#13;&#10;  Pr_Svr_Isp.Key_Sub_Ver_Svr,&#13;&#10;  T_Svr_PrimenMat.SvrPrimen,&#13;&#10;  S_Subjects.Name_Sub Name_Sub_Svr&#13;&#10;&#13;&#10;  , Pr_Svr_Isp.Key_Sposob&#13;&#10;  , T_SvrSposob.SposobSvr&#13;&#10;  , T_SvrSposob.SpSvr&#13;&#10;&#13;&#10;  , dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 10) Kleimo,&#13;&#10;  dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 11) N_Ud,&#13;&#10;  dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 12) Razr&#13;&#10;      &#13;&#10;FROM&#13;&#10;  Pr_Svr_Isp&#13;&#10;  INNER JOIN T_Svr_PrimenMat&#13;&#10;    ON Pr_Svr_Isp.Key_SvrPrimen = T_Svr_PrimenMat.Key_SvrPrimen&#13;&#10;  INNER JOIN S_SubVer&#13;&#10;    ON Pr_Svr_Isp.Key_Sub_Ver_Svr = S_SubVer.Key_Sub_Ver&#13;&#10;  INNER JOIN S_Subjects&#13;&#10;    ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN dbo.T_SvrSposob T_SvrSposob&#13;&#10;    ON T_SvrSposob.Key_Sposob= Pr_Svr_Isp.Key_Sposob&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Svr_Isp.Key_PrSvr = :Key_PrSvr&#13;&#10;  " PropData="05704C6566740380020470546F70022C0A506172616D657465727301010626204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
