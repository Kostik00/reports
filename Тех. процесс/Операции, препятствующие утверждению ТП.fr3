<TfrxReport Version="2026.2.4" DotMatrixReport="False" EngineOptions.DoublePass="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="46342,9319857755" ReportOptions.Description.Text="" ReportOptions.Name="Операции, препятствующие утверждению ТП.fr3 ТП 02000.02190.05200  (Утверждено)" ReportOptions.LastChange="46342,9323374884" ScriptLanguage="PascalScript" ScriptText.Text="begin&#13;&#10;end." StoreInDFM="False">
  <Datasets>
    <item DataSet="MainFrxDS" DataSetName="MainDS"/>
    <item DataSet="BlockersQry" DataSetName="Blockers"/>
  </Datasets>
  <TfrxDataPage Name="Data" HGuides.Text="" VGuides.Text="" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="BlockersQry" UserName="Blockers" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="MainFrxDS" Left="76" Top="64" IgnoreDupParams="False" SQL.Text=";WITH TargetTP AS&#13;&#10;(&#13;&#10;    SELECT Key_TP, Cod_TP, Key_TPName, Key_SP&#13;&#10;    FROM dbo.T_TP&#13;&#10;    WHERE Key_TP = :Key_TP&#13;&#10;),&#13;&#10;RowsTP AS&#13;&#10;(&#13;&#10;    SELECT r.*, o.Name_Oper, g.Cod_Oper_Gr, g.Name_Oper_Gr,&#13;&#10;           g.Name_GrGr, g.FlKontr&#13;&#10;    FROM TargetTP t&#13;&#10;    JOIN dbo.T_TPRows r ON r.Key_TP = t.Key_TP&#13;&#10;    LEFT JOIN dbo.T_Oper o ON o.Cod_Oper = r.Cod_Oper&#13;&#10;    LEFT JOIN dbo.T_Oper_Gr g ON g.Cod_Oper_Gr = o.Cod_Oper_Gr&#13;&#10;),&#13;&#10;Issues AS&#13;&#10;(&#13;&#10;    SELECT 10 CheckOrder, r.Key_TP RowKey_TP, r.Key_TPRows,&#13;&#10;           r.Key_V_TP RelatedKey_TP,&#13;&#10;           (NCHAR(1053)+NCHAR(1077)+NCHAR(32)+NCHAR(1091)+NCHAR(1082)+NCHAR(1072)+NCHAR(1079)+NCHAR(1072)+NCHAR(1085)+NCHAR(32)+NCHAR(1086)+NCHAR(1073)+NCHAR(1103)+NCHAR(1079)+NCHAR(1072)+NCHAR(1090)+NCHAR(1077)+NCHAR(1083)+NCHAR(1100)+NCHAR(1085)+NCHAR(1099)+NCHAR(1081)+NCHAR(32)+NCHAR(1080)+NCHAR(1085)+NCHAR(1089)+NCHAR(1090)+NCHAR(1088)+NCHAR(1091)+NCHAR(1084)+NCHAR(1077)+NCHAR(1085)+NCHAR(1090)) Reason,&#13;&#10;           1 ActiveForCurrentUser&#13;&#10;    FROM RowsTP r&#13;&#10;    WHERE (r.FlKontr &#38; 1) = 1&#13;&#10;      AND (r.Key_Sub_Ver IS NULL OR&#13;&#10;           r.Key_Sub_Ver &#60;&#62; dbo.Sys_DB_StrConst(&#39;SUBJ_Key_Sub_Ver_OVK&#39;))&#13;&#10;      AND NOT EXISTS&#13;&#10;          (SELECT 1 FROM dbo.T_TPInstrum i WHERE i.Key_TPRows = r.Key_TPRows)&#13;&#10;&#13;&#10;    UNION ALL&#13;&#10;    SELECT 20, r.Key_TP, r.Key_TPRows, r.Key_V_TP,&#13;&#10;           (NCHAR(1053)+NCHAR(1077)+NCHAR(32)+NCHAR(1091)+NCHAR(1082)+NCHAR(1072)+NCHAR(1079)+NCHAR(1072)+NCHAR(1085)+NCHAR(32)+NCHAR(1086)+NCHAR(1073)+NCHAR(1103)+NCHAR(1079)+NCHAR(1072)+NCHAR(1090)+NCHAR(1077)+NCHAR(1083)+NCHAR(1100)+NCHAR(1085)+NCHAR(1099)+NCHAR(1081)+NCHAR(32)+NCHAR(1086)+NCHAR(1089)+NCHAR(1085)+NCHAR(1086)+NCHAR(1074)+NCHAR(1085)+NCHAR(1086)+NCHAR(1081)+NCHAR(32)+NCHAR(1080)+NCHAR(1085)+NCHAR(1089)+NCHAR(1090)+NCHAR(1088)+NCHAR(1091)+NCHAR(1084)+NCHAR(1077)+NCHAR(1085)+NCHAR(1090)), 1&#13;&#10;    FROM RowsTP r&#13;&#10;    WHERE (r.FlKontr &#38; 2) = 2&#13;&#10;      AND (r.Key_Sub_Ver IS NULL OR&#13;&#10;           r.Key_Sub_Ver &#60;&#62; dbo.Sys_DB_StrConst(&#39;SUBJ_Key_Sub_Ver_OVK&#39;))&#13;&#10;      AND NOT EXISTS&#13;&#10;          (SELECT 1 FROM dbo.T_TPInstrum i&#13;&#10;           WHERE i.Key_TPRows = r.Key_TPRows AND i.UseFlag &#62;= 1)&#13;&#10;&#13;&#10;    UNION ALL&#13;&#10;    SELECT 30, r.Key_TP, r.Key_TPRows, r.Key_V_TP,&#13;&#10;           (NCHAR(1053)+NCHAR(1077)+NCHAR(1090)+NCHAR(32)+NCHAR(1085)+NCHAR(1086)+NCHAR(1088)+NCHAR(1084)+NCHAR(32)+NCHAR(1074)+NCHAR(1088)+NCHAR(1077)+NCHAR(1084)+NCHAR(1077)+NCHAR(1085)+NCHAR(1080)+NCHAR(58)+NCHAR(32)+NCHAR(84)+NCHAR(112)+NCHAR(122)+NCHAR(32)+NCHAR(43)+NCHAR(32)+NCHAR(84)+NCHAR(115)+NCHAR(104)+NCHAR(116)+NCHAR(32)+NCHAR(60)+NCHAR(32)+NCHAR(48)+NCHAR(44)+NCHAR(48)+NCHAR(48)+NCHAR(49)),&#13;&#10;           CASE WHEN IS_MEMBER(&#39;dbo&#39;) = 0 AND IS_MEMBER(&#39;_Pr_Admin&#39;) = 0&#13;&#10;                THEN 1 ELSE 0 END&#13;&#10;    FROM RowsTP r&#13;&#10;    WHERE r.Name_GrGr NOT IN ((NCHAR(1050)+NCHAR(1086)+NCHAR(1085)+NCHAR(1090)+NCHAR(1088)+NCHAR(1086)+NCHAR(1083)+NCHAR(1100)+NCHAR(1085)+NCHAR(1099)+NCHAR(1077)), (NCHAR(1051)+NCHAR(1072)+NCHAR(1073)+NCHAR(1086)+NCHAR(1088)+NCHAR(1072)+NCHAR(1090)+NCHAR(1086)+NCHAR(1088)+NCHAR(1085)+NCHAR(1099)+NCHAR(1081)+NCHAR(32)+NCHAR(1082)+NCHAR(1086)+NCHAR(1085)+NCHAR(1090)+NCHAR(1088)+NCHAR(1086)+NCHAR(1083)+NCHAR(1100)))&#13;&#10;      AND r.Cod_Oper &#60;&#62; N&#39;0000&#39;&#13;&#10;      AND ISNULL(r.Tpz, 0) + ISNULL(r.Tsht, 0) &#60; 0.001&#13;&#10;      AND NOT EXISTS&#13;&#10;          (SELECT 1 FROM dbo.T_TP v&#13;&#10;           JOIN dbo.T_TPName n ON n.Key_TPName = v.Key_TPName AND n.HasVTP = 0&#13;&#10;           WHERE v.Key_TP = r.Key_V_TP)&#13;&#10;&#13;&#10;    UNION ALL&#13;&#10;    SELECT 40, r.Key_TP, r.Key_TPRows, v.Key_TP,&#13;&#10;           (NCHAR(1053)+NCHAR(1086)+NCHAR(1084)+NCHAR(1077)+NCHAR(1088)+NCHAR(32)+NCHAR(1086)+NCHAR(1087)+NCHAR(1077)+NCHAR(1088)+NCHAR(1072)+NCHAR(1094)+NCHAR(1080)+NCHAR(1080)+NCHAR(32)+NCHAR(1086)+NCHAR(1090)+NCHAR(1089)+NCHAR(1091)+NCHAR(1090)+NCHAR(1089)+NCHAR(1090)+NCHAR(1074)+NCHAR(1091)+NCHAR(1077)+NCHAR(1090)+NCHAR(32)+NCHAR(1074)+NCHAR(1086)+NCHAR(32)+NCHAR(1074)+NCHAR(1093)+NCHAR(1086)+NCHAR(1076)+NCHAR(1103)+NCHAR(1097)+NCHAR(1077)+NCHAR(1084)+NCHAR(32)+NCHAR(1058)+NCHAR(1055)), 1&#13;&#10;    FROM RowsTP r&#13;&#10;    JOIN dbo.T_TP v ON v.Key_TP = r.Key_V_TP&#13;&#10;    JOIN dbo.T_TPName n ON n.Key_TPName = v.Key_TPName AND n.HasVTP = 1&#13;&#10;    WHERE NOT EXISTS&#13;&#10;          (SELECT 1 FROM dbo.T_TPRows vr&#13;&#10;           WHERE vr.Key_TP = v.Key_TP AND vr.N_OPER_MK = r.N_OPER_MK)&#13;&#10;&#13;&#10;    UNION ALL&#13;&#10;    SELECT DISTINCT 50, vr.Key_TP, vr.Key_TPRows, t.Key_TP,&#13;&#10;           (NCHAR(1054)+NCHAR(1087)+NCHAR(1077)+NCHAR(1088)+NCHAR(1072)+NCHAR(1094)+NCHAR(1080)+NCHAR(1103)+NCHAR(32)+NCHAR(1074)+NCHAR(1093)+NCHAR(1086)+NCHAR(1076)+NCHAR(1103)+NCHAR(1097)+NCHAR(1077)+NCHAR(1075)+NCHAR(1086)+NCHAR(32)+NCHAR(1058)+NCHAR(1055)+NCHAR(32)+NCHAR(1085)+NCHAR(1077)+NCHAR(32)+NCHAR(1074)+NCHAR(1082)+NCHAR(1083)+NCHAR(1102)+NCHAR(1095)+NCHAR(1077)+NCHAR(1085)+NCHAR(1072)+NCHAR(32)+NCHAR(1074)+NCHAR(32)+NCHAR(1087)+NCHAR(1088)+NCHAR(1086)+NCHAR(1074)+NCHAR(1077)+NCHAR(1088)+NCHAR(1103)+NCHAR(1077)+NCHAR(1084)+NCHAR(1099)+NCHAR(1081)+NCHAR(32)+NCHAR(1058)+NCHAR(1055)), 1&#13;&#10;    FROM TargetTP t&#13;&#10;    JOIN dbo.T_SP sp ON sp.Key_SP = t.Key_SP&#13;&#10;    JOIN dbo.T_VPredm p ON p.Key_Predm = sp.Key_Predm&#13;&#10;    JOIN RowsTP r ON r.Key_TP = t.Key_TP&#13;&#10;    JOIN dbo.T_TP v ON v.Key_TP = r.Key_V_TP&#13;&#10;    JOIN dbo.T_TPName n ON n.Key_TPName = v.Key_TPName AND n.HasVTP = 1&#13;&#10;    JOIN dbo.T_TPRows vr ON vr.Key_TP = v.Key_TP AND vr.N_OPER_MK &#60;&#62; N&#39;&#39;&#13;&#10;    WHERE NOT EXISTS&#13;&#10;          (SELECT 1 FROM RowsTP actual&#13;&#10;           WHERE actual.Key_V_TP = v.Key_TP AND actual.N_OPER_MK = vr.N_OPER_MK)&#13;&#10;&#13;&#10;    UNION ALL&#13;&#10;    SELECT DISTINCT 60, r.Key_TP, r.Key_TPRows, parent.Key_TP,&#13;&#10;           (NCHAR(1054)+NCHAR(1087)+NCHAR(1077)+NCHAR(1088)+NCHAR(1072)+NCHAR(1094)+NCHAR(1080)+NCHAR(1103)+NCHAR(32)+NCHAR(1087)+NCHAR(1088)+NCHAR(1086)+NCHAR(1074)+NCHAR(1077)+NCHAR(1088)+NCHAR(1103)+NCHAR(1077)+NCHAR(1084)+NCHAR(1086)+NCHAR(1075)+NCHAR(1086)+NCHAR(32)+NCHAR(1058)+NCHAR(1055)+NCHAR(32)+NCHAR(1085)+NCHAR(1077)+NCHAR(32)+NCHAR(1074)+NCHAR(1082)+NCHAR(1083)+NCHAR(1102)+NCHAR(1095)+NCHAR(1077)+NCHAR(1085)+NCHAR(1072)+NCHAR(32)+NCHAR(1074)+NCHAR(32)+NCHAR(1080)+NCHAR(1089)+NCHAR(1087)+NCHAR(1086)+NCHAR(1083)+NCHAR(1100)+NCHAR(1079)+NCHAR(1091)+NCHAR(1102)+NCHAR(1097)+NCHAR(1080)+NCHAR(1081)+NCHAR(32)+NCHAR(1077)+NCHAR(1075)+NCHAR(1086)+NCHAR(32)+NCHAR(1058)+NCHAR(1055)), 1&#13;&#10;    FROM TargetTP t&#13;&#10;    JOIN dbo.T_TPName n ON n.Key_TPName = t.Key_TPName AND n.HasVTP = 1&#13;&#10;    JOIN RowsTP r ON r.Key_TP = t.Key_TP AND r.N_OPER_MK &#60;&#62; N&#39;&#39;&#13;&#10;    JOIN dbo.T_TPRows parent ON parent.Key_V_TP = t.Key_TP&#13;&#10;    WHERE NOT EXISTS&#13;&#10;          (SELECT 1 FROM dbo.T_TPRows actual&#13;&#10;           WHERE actual.Key_TP = parent.Key_TP AND actual.Key_V_TP = t.Key_TP&#13;&#10;             AND actual.N_OPER_MK = r.N_OPER_MK)&#13;&#10;)&#13;&#10;SELECT t.Key_TP CheckedKey_TP, t.Cod_TP CheckedCod_TP,&#13;&#10;       i.CheckOrder, i.Reason, i.ActiveForCurrentUser, CASE WHEN i.ActiveForCurrentUser=1 THEN (NCHAR(1044)+NCHAR(1072)) ELSE (NCHAR(1053)+NCHAR(1077)+NCHAR(1090)) END ActiveText,&#13;&#10;       r.Key_TP RowKey_TP, rt.Cod_TP RowCod_TP,&#13;&#10;       r.Key_TPRows, r.N_OPER_MK, r.Cod_Oper, o.Name_Oper,&#13;&#10;       g.Cod_Oper_Gr, g.Name_Oper_Gr, g.Name_GrGr,&#13;&#10;       r.Tpz, r.Tsht, r.Key_V_TP,&#13;&#10;       i.RelatedKey_TP, related.Cod_TP RelatedCod_TP&#13;&#10;FROM Issues i&#13;&#10;CROSS JOIN TargetTP t&#13;&#10;JOIN dbo.T_TPRows r ON r.Key_TPRows = i.Key_TPRows&#13;&#10;LEFT JOIN dbo.T_TP rt ON rt.Key_TP = r.Key_TP&#13;&#10;LEFT JOIN dbo.T_Oper o ON o.Cod_Oper = r.Cod_Oper&#13;&#10;LEFT JOIN dbo.T_Oper_Gr g ON g.Cod_Oper_Gr = o.Cod_Oper_Gr&#13;&#10;LEFT JOIN dbo.T_TP related ON related.Key_TP = i.RelatedKey_TP&#13;&#10;ORDER BY i.CheckOrder, r.N_OPER_MK, r.Key_TPRows, i.RelatedKey_TP;">
      <FieldDefs>
        <item FieldName="CheckedKey_TP"/>
        <item FieldName="CheckedCod_TP" FieldType="fftString" Size="50"/>
        <item FieldName="CheckOrder"/>
        <item FieldName="Reason" FieldType="fftString" Size="58"/>
        <item FieldName="ActiveForCurrentUser"/>
        <item FieldName="ActiveText" FieldType="fftString"/>
        <item FieldName="RowKey_TP"/>
        <item FieldName="RowCod_TP" FieldType="fftString" Size="50"/>
        <item FieldName="Key_TPRows"/>
        <item FieldName="N_OPER_MK" FieldType="fftString"/>
        <item FieldName="Cod_Oper" FieldType="fftString"/>
        <item FieldName="Name_Oper" FieldType="fftString" Size="70"/>
        <item FieldName="Cod_Oper_Gr" FieldType="fftString"/>
        <item FieldName="Name_Oper_Gr" FieldType="fftString" Size="70"/>
        <item FieldName="Name_GrGr" FieldType="fftString" Size="50"/>
        <item FieldName="Tpz"/>
        <item FieldName="Tsht"/>
        <item FieldName="Key_V_TP"/>
        <item FieldName="RelatedKey_TP"/>
        <item FieldName="RelatedCod_TP" FieldType="fftString" Size="50"/>
      </FieldDefs>
      <Parameters>
        <item Name="Key_TP" DataType="ftInteger"/>
      </Parameters>
    </TfrxERQuery>
