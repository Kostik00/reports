    <TfrxERQuery Name="NaprStrQRY" UserName="СтрокиНапр" CloseDataSource="True" BCDToCurrency="False" DataSetOptions="0" Master="NaprQRY" Left="124" Top="20" IgnoreDupParams="False" SQL.Text="SELECT --DISTINCT&#13;&#10;&#13;&#10;       Pr_NaprZakl.Key_NaprZakl,&#13;&#10;       Pr_Svr.Key_PrSvr,                                  &#13;&#10;&#13;&#10;            &#13;&#10;       Pr_NaprZakl.Cod_TT, &#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       T_TechTreb.VidKontr, &#13;&#10;       Pr_NaprZakl.VolKontr,&#13;&#10;       Pr_NaprZakl.Name_NTD,&#13;&#10;       Pr_NaprZakl.ParamKontr,               &#13;&#10;&#13;&#10;       T_Sert_Rez.Attr_Val,&#13;&#10;       T_Sert_Attr.Attr, &#13;&#10;       T_Sert_Isp.Cod_Isp,  &#13;&#10;         &#13;&#10;          &#13;&#10;        Pr_NaprZakl.Kolvo,&#13;&#10;        Pr_NaprZakl.ZavNumFrom,&#13;&#10;        Pr_NaprZakl.ZavNumTo,&#13;&#10;&#13;&#10;        Pr_NaprSvr.Key_PrSvr,&#13;&#10;        T_Svr.NumSvr,&#13;&#10;        dbo.T_Ordersortam(T_Svr.NumSvr) OrderNumSvr,&#13;&#10;        Pr_Svr.AdNumSvr,&#13;&#10;        Pr_Svr.Kolvo KolvoSvr,&#13;&#10;        T_Svr.CatSvr,&#13;&#10;&#13;&#10;--        Pr_Svr.Key_Sub_Ver_Svr,&#13;&#10;--        S_Subjects_Svr.Name_Sub AS Name_Sub_Svr,&#13;&#10;--        dbo.S_GegSubVerAtrib(Pr_Svr.Key_Sub_Ver_Svr, 10) Kleimo,&#13;&#10;&#13;&#10;          &#13;&#10;&#13;&#10;        TPSvr.Cod_TP&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;        Pr_Napr&#13;&#10;        INNER JOIN Pr_NaprZakl&#13;&#10;                ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr&#13;&#10;        INNER JOIN Pr_NaprSvr&#13;&#10;                ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl&#13;&#10;        INNER JOIN Pr_Svr&#13;&#10;                ON Pr_NaprSvr.Key_PrSvr = Pr_Svr.Key_PrSvr&#13;&#10;        INNER JOIN T_Svr&#13;&#10;                ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;        INNER JOIN T_TechTreb&#13;&#10;                ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  --     LEFT  JOIN T_TechTreb ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;         &#13;&#10;       LEFT JOIN T_Sert_Isp ON Pr_NaprZakl.Key_NaprZakl = T_Sert_Isp.Key_NaprZakl&#13;&#10;&#13;&#10;         &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez     &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez.Key_Isp&#13;&#10;               AND T_Sert_Rez.Key_Sert_Attr = 300&#13;&#10;       LEFT JOIN T_Sert_Attr &#13;&#10;               ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr&#13;&#10;                  &#13;&#10;&#13;&#10;        LEFT JOIN T_TP TPSvr&#13;&#10;               ON TPSvr.Key_TP=Pr_Svr.Key_TP&#13;&#10;&#13;&#10;&#13;&#10;--        LEFT JOIN dbo.T_SvrSposob T_SvrSposob&#13;&#10;--          ON T_SvrSposob.Key_Sposob= Pr_Svr.Key_Sposob&#13;&#10;&#13;&#10;        LEFT JOIN T_TP  T_SvrTP&#13;&#10;          ON T_SvrTP.Key_TP = Pr_Svr.Key_TP&#13;&#10;&#13;&#10;&#13;&#10;        LEFT JOIN Pr_Pasp Pr_Pasp1&#13;&#10;          ON Pr_Pasp1.Key_Pasport = Pr_Svr.Key_DT1&#13;&#10;        LEFT JOIN T_VPredm T_VPredm1&#13;&#10;          ON T_VPredm1.Key_Predm = Pr_Pasp1.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;        LEFT JOIN Pr_Pasp Pr_Pasp2&#13;&#10;          ON Pr_Pasp2.Key_Pasport = Pr_Svr.Key_DT2&#13;&#10;        LEFT JOIN T_VPredm T_VPredm2&#13;&#10;          ON T_VPredm2.Key_Predm = Pr_Pasp2.Key_Predm&#13;&#10;&#13;&#10;--        LEFT JOIN  S_SubVer S_SubVer_Svr&#13;&#10;--         ON S_SubVer_Svr.Key_Sub_Ver = Pr_Svr.Key_Sub_Ver_Svr&#13;&#10;--        LEFT JOIN S_Subjects S_Subjects_Svr&#13;&#10;--          ON S_SubVer_Svr.Key_Sub = S_Subjects_Svr.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE Pr_NaprZakl.Key_Zakl=:Key_Zakl      &#13;&#10;&#13;&#10;ORDER BY&#13;&#10;       OrderNumSvr, Pr_Svr.Key_PrSvr, Pr_NaprZakl.Cod_TT, len(T_Sert_Rez.Attr_Val),T_Sert_Rez.Attr_Val                       ">
      <FieldDefs>
        <item FieldName="Key_NaprZakl" FieldAlias="Key_NaprZakl"/>
        <item FieldName="Key_PrSvr" FieldAlias="Key_PrSvr"/>
        <item FieldName="Cod_TT" FieldAlias="Cod_TT" FieldType="fftString" Size="20"/>
        <item FieldName="Name_TT" FieldAlias="Name_TT" FieldType="fftString" Size="150"/>
        <item FieldName="VidKontr" FieldAlias="VidKontr" FieldType="fftString" Size="50"/>
        <item FieldName="VolKontr" FieldAlias="VolKontr" FieldType="fftString" Size="500"/>
        <item FieldName="Name_NTD" FieldAlias="Name_NTD" FieldType="fftString" Size="500"/>
        <item FieldName="ParamKontr" FieldAlias="ParamKontr" FieldType="fftString" Size="500"/>
        <item FieldName="Attr_Val" FieldAlias="Attr_Val" FieldType="fftString" Size="200"/>
        <item FieldName="Attr" FieldAlias="Attr" FieldType="fftString" Size="100"/>
        <item FieldName="Cod_Isp" FieldAlias="Cod_Isp" FieldType="fftString" Size="20"/>
        <item FieldName="Kolvo" FieldAlias="Kolvo" FieldType="fftString" Size="250"/>
        <item FieldName="ZavNumFrom" FieldAlias="ZavNumFrom"/>
        <item FieldName="ZavNumTo" FieldAlias="ZavNumTo"/>
        <item FieldName="Field14" FieldAlias="Field14"/>
        <item FieldName="NumSvr" FieldAlias="NumSvr" FieldType="fftString" Size="50"/>
        <item FieldName="OrderNumSvr" FieldAlias="OrderNumSvr" FieldType="fftString" Size="100"/>
