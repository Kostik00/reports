       &#13;&#10;end;&#13;&#10;&#13;&#10;function FnPredm2:string;&#13;&#10;begin&#13;&#10;  Result:=PrintNameDSE(&#60;PaspQRY.&#34;PrintFlag&#34;&#62;, &#60;PaspQRY.&#34;Cod_Predm&#34;&#62;,       &#60;PaspQRY.&#34;Name_Predm&#34;&#62;,&#13;&#10;                       &#60;PaspQRY.&#34;Sortam&#34;&#62;,    &#60;PaspQRY.&#34;Type_NTD_Sortam&#34;&#62;, &#60;PaspQRY.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;                       &#60;PaspQRY.&#34;Marka&#34;&#62;,     &#60;PaspQRY.&#34;Type_NTD_Marka&#34;&#62;,  &#60;PaspQRY.&#34;Name_NTD_Marka&#34;&#62;);&#13;&#10;   &#13;&#10;//  Result:=Result+'('+VarToStr(&#60;ÂÑÈ.&#34;PrintFlag&#34;&#62;)+')';                                                                         &#13;&#10;                         &#13;&#10;end;&#13;&#10;  &#13;&#10;procedure PrintRptyTitleOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure DtHDROnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Lnum:=Lnum+1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  NChild.Visible:=ZPrint.Checked AND (not WSIQRY.FieldByName('SpNotes').IsNull);&#13;&#10;  &#13;&#10;//  ZChild.Visible:=ZPrint.Checked   AND (not WSIQRY.FieldByName('Zamech').IsNull);&#13;&#10;    &#13;&#10;//  ZTPChild.Visible:=ZTPPrint.Checked AND (not WSIQRY.FieldByName('ZamechTP').IsNull);&#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure MasterData1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FreeSpace&#60;MasterData.Height then&#13;&#10;    Engine.ShowBand(Child1);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportParamsOnActivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MyRestoreString('ÂÑÈÊîììåíòàðèé', Comment.Lines.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportParamsOnDeactivate(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MySaveString('ÂÑÈÊîììåíòàðèé', Comment.Lines.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure WSIPageOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Lnum:=0;&#13;&#10;  ZamechHDR.Visible:=ZPrint.Checked;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="">
