    <TfrxERQuery Name="NaprQRY" UserName="Çàêëþ÷åíèå" CloseDataSource="True" FieldAliases.Text="Key_Zakl=Key_Zakl&#13;&#10;Vid_Zakl=Vid_Zakl&#13;&#10;Num_Zakl=Num_Zakl&#13;&#10;Data_Zakl=Data_Zakl&#13;&#10;Cod_TP=Cod_TP&#13;&#10;Cod_Zak=Cod_Zak&#13;&#10;Expr1=Expr1&#13;&#10;Cod_TT=Cod_TT&#13;&#10;VidKontr=VidKontr&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Name_NTD=Name_NTD&#13;&#10;Kolvo=Kolvo&#13;&#10;Cod_Izdel=Cod_Izdel&#13;&#10;Name_Izdel=Name_Izdel" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT &#13;&#10;                         Pr_Zakl.Key_Zakl, &#13;&#10;                         Pr_Zakl.Vid_Zakl, &#13;&#10;                         Pr_Zakl.Num_Zakl, &#13;&#10;                         Pr_Zakl.Data_Zakl, &#13;&#10;                         T_TP.Cod_TP, &#13;&#10;                         P_VKZ.Cod_Zak, &#13;&#10;                         P_VKZ.Cod_Zak AS Expr1, &#13;&#10;                         Pr_NaprZakl.Cod_TT, &#13;&#10;                         T_TechTreb.VidKontr, &#13;&#10;                         T_VPredm.Cod_Predm,&#13;&#10;                         T_VPredm.Name_Predm, &#13;&#10;                         Pr_NaprZakl.Name_NTD, &#13;&#10;                         Pr_NaprZakl.Kolvo,&#13;&#10;                         -- --------------------------&#13;&#10;                         Pr_NaprZakl.ZavNumTo,&#13;&#10;                         Pr_NaprZakl.ZavNumFrom,  &#13;&#10;                         -- --------------------------                                                                                          &#13;&#10;                         T_VPredm_Izdel.Cod_Predm as Cod_Izdel, &#13;&#10;                         T_VPredm_Izdel.Name_Predm as Name_Izdel                            &#13;&#10;FROM            Pr_Zakl LEFT OUTER JOIN&#13;&#10;                         Pr_NaprZakl ON Pr_NaprZakl.Key_Zakl = Pr_Zakl.Key_Zakl &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         Pr_Pasp ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         T_TP ON T_TP.Key_TP = Pr_Pasp.Key_TP &#13;&#10;                         INNER JOIN&#13;&#10;                         T_VPredm ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         Pr_PaspDet ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         P_VKZ ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         P_VKZ AS Pr_VKZIzdel ON Pr_VKZIzdel.Key_VKZ = P_VKZ.Key_VKZ_Master &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         T_VPredm AS T_VPredm_Izdel ON T_VPredm_Izdel.Key_Predm = Pr_VKZIzdel.Key_Predm &#13;&#10;                         LEFT OUTER JOIN&#13;&#10;                         T_TechTreb ON T_TechTreb.Cod_TT = Pr_NaprZakl.Cod_TT&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Zakl.Key_Zakl=:Key_Zakl" PropData="05704C656674023C0470546F7002140A506172616D657465727301010C25000000204E616D653D224B65795F5A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NaprStrQRY" UserName="ÑòðîêèÍàïð" CloseDataSource="True" FieldAliases.Text="Key_NaprZakl=Key_NaprZakl&#13;&#10;Key_PrSvr=Key_PrSvr&#13;&#10;Cod_TT=Cod_TT&#13;&#10;Name_TT=Name_TT&#13;&#10;VidKontr=VidKontr&#13;&#10;VolKontr=VolKontr&#13;&#10;Name_NTD=Name_NTD&#13;&#10;ParamKontr=ParamKontr&#13;&#10;Attr_Val=Attr_Val&#13;&#10;Attr=Attr&#13;&#10;Cod_Isp=Cod_Isp&#13;&#10;Kolvo=Kolvo&#13;&#10;ZavNumFrom=ZavNumFrom&#13;&#10;ZavNumTo=ZavNumTo&#13;&#10;Field14=Field14&#13;&#10;NumSvr=NumSvr&#13;&#10;OrderNumSvr=OrderNumSvr&#13;&#10;AdNumSvr=AdNumSvr&#13;&#10;KolvoSvr=KolvoSvr&#13;&#10;CatSvr=CatSvr&#13;&#10;Cod_TP=Cod_TP" BCDToCurrency="False" Master="NaprQRY" IgnoreDupParams="False" SQL.Text="SELECT --DISTINCT&#13;&#10;&#13;&#10;       Pr_NaprZakl.Key_NaprZakl,&#13;&#10;       Pr_Svr.Key_PrSvr,                                  &#13;&#10;&#13;&#10;            &#13;&#10;       Pr_NaprZakl.Cod_TT, &#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       T_TechTreb.VidKontr, &#13;&#10;       Pr_NaprZakl.VolKontr,&#13;&#10;       Pr_NaprZakl.Name_NTD,&#13;&#10;       Pr_NaprZakl.ParamKontr,               &#13;&#10;&#13;&#10;       T_Sert_Rez.Attr_Val,&#13;&#10;       T_Sert_Attr.Attr, &#13;&#10;       T_Sert_Isp.Cod_Isp,  &#13;&#10;         &#13;&#10;          &#13;&#10;        Pr_NaprZakl.Kolvo,&#13;&#10;        Pr_NaprZakl.ZavNumFrom,&#13;&#10;        Pr_NaprZakl.ZavNumTo,&#13;&#10;&#13;&#10;        Pr_NaprSvr.Key_PrSvr,&#13;&#10;        T_Svr.NumSvr,&#13;&#10;        dbo.T_Ordersortam(T_Svr.NumSvr) OrderNumSvr,&#13;&#10;        Pr_Svr.AdNumSvr,&#13;&#10;        Pr_Svr.Kolvo KolvoSvr,&#13;&#10;        T_Svr.CatSvr,&#13;&#10;&#13;&#10;--        Pr_Svr.Key_Sub_Ver_Svr,&#13;&#10;--        S_Subjects_Svr.Name_Sub AS Name_Sub_Svr,&#13;&#10;--        dbo.S_GegSubVerAtrib(Pr_Svr.Key_Sub_Ver_Svr, 10) Kleimo,&#13;&#10;&#13;&#10;          &#13;&#10;&#13;&#10;        TPSvr.Cod_TP&#13;&#10;&#13;&#10;&#13;&#10;FROM&#13;&#10;        Pr_Napr&#13;&#10;        INNER JOIN Pr_NaprZakl&#13;&#10;                ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr&#13;&#10;        INNER JOIN Pr_NaprSvr&#13;&#10;                ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl&#13;&#10;        INNER JOIN Pr_Svr&#13;&#10;                ON Pr_NaprSvr.Key_PrSvr = Pr_Svr.Key_PrSvr&#13;&#10;        INNER JOIN T_Svr&#13;&#10;                ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;        INNER JOIN T_TechTreb&#13;&#10;                ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;&#13;&#10;  --     LEFT  JOIN T_TechTreb ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;         &#13;&#10;       LEFT JOIN T_Sert_Isp ON Pr_NaprZakl.Key_NaprZakl = T_Sert_Isp.Key_NaprZakl&#13;&#10;&#13;&#10;         &#13;&#10;       LEFT  JOIN T_Sert_Rez  T_Sert_Rez     &#13;&#10;               ON T_Sert_Isp.Key_Isp = T_Sert_Rez.Key_Isp&#13;&#10;               AND T_Sert_Rez.Key_Sert_Attr = 300&#13;&#10;       LEFT JOIN T_Sert_Attr &#13;&#10;               ON T_Sert_Rez.Key_Sert_Attr = T_Sert_Attr.Key_Sert_Attr&#13;&#10;                  &#13;&#10;&#13;&#10;        LEFT JOIN T_TP TPSvr&#13;&#10;               ON TPSvr.Key_TP=Pr_Svr.Key_TP&#13;&#10;&#13;&#10;&#13;&#10;--        LEFT JOIN dbo.T_SvrSposob T_SvrSposob&#13;&#10;--          ON T_SvrSposob.Key_Sposob= Pr_Svr.Key_Sposob&#13;&#10;&#13;&#10;        LEFT JOIN T_TP  T_SvrTP&#13;&#10;          ON T_SvrTP.Key_TP = Pr_Svr.Key_TP&#13;&#10;&#13;&#10;&#13;&#10;        LEFT JOIN Pr_Pasp Pr_Pasp1&#13;&#10;          ON Pr_Pasp1.Key_Pasport = Pr_Svr.Key_DT1&#13;&#10;        LEFT JOIN T_VPredm T_VPredm1&#13;&#10;          ON T_VPredm1.Key_Predm = Pr_Pasp1.Key_Predm&#13;&#10;&#13;&#10;&#13;&#10;        LEFT JOIN Pr_Pasp Pr_Pasp2&#13;&#10;          ON Pr_Pasp2.Key_Pasport = Pr_Svr.Key_DT2&#13;&#10;        LEFT JOIN T_VPredm T_VPredm2&#13;&#10;          ON T_VPredm2.Key_Predm = Pr_Pasp2.Key_Predm&#13;&#10;&#13;&#10;--        LEFT JOIN  S_SubVer S_SubVer_Svr&#13;&#10;--         ON S_SubVer_Svr.Key_Sub_Ver = Pr_Svr.Key_Sub_Ver_Svr&#13;&#10;--        LEFT JOIN S_Subjects S_Subjects_Svr&#13;&#10;--          ON S_SubVer_Svr.Key_Sub = S_Subjects_Svr.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE Pr_NaprZakl.Key_Zakl=:Key_Zakl      &#13;&#10;&#13;&#10;ORDER BY&#13;&#10;       OrderNumSvr, Pr_Svr.Key_PrSvr, Pr_NaprZakl.Cod_TT, len(T_Sert_Rez.Attr_Val),T_Sert_Rez.Attr_Val                       " PropData="05704C656674027C0470546F7002140A506172616D657465727301010C25000000204E616D653D224B65795F5A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrMatQRY" UserName="ÑâàðÌàòåðèàëû" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;       Pr_Svr_Mat.Key_SvrMat,&#13;&#10;       Pr_Svr_Mat.Key_PrSvr,&#13;&#10;       Pr_Svr_Mat.Key_Id_Mat,&#13;&#10;       Pr_Svr_Mat.Polojenie,&#13;&#10;       Pr_Svr_Mat.Tok,&#13;&#10;       Pr_Svr_Mat.Polyarn,&#13;&#10;       Pr_Svr_Mat.Sila,&#13;&#10;       Pr_Svr_Mat.DopInfo,&#13;&#10;       Pr_Svr_Mat.Napr,&#13;&#10;       Pr_Svr_Mat.Skor,&#13;&#10;       Pr_Svr_Mat.Podacha,&#13;&#10;       A_VID_Mat.VidSert,&#13;&#10;       A_VID_Mat.N_Sert,&#13;&#10;       A_VID_Mat.Date_Sert,&#13;&#10;       A_VID_Mat.Cod_Plavka,&#13;&#10;       A_VID_Mat.Party,&#13;&#10;       T_VPredm.Name_Predm&#13;&#10;FROM&#13;&#10;       Pr_Svr_Mat&#13;&#10;       INNER JOIN  A_VID_Mat&#13;&#10;               ON Pr_Svr_Mat.Key_Id_Mat = A_VID_Mat.Key_ID_Mat&#13;&#10;       INNER JOIN  T_VPredm&#13;&#10;               ON A_VID_Mat.Key_Predm = T_VPredm.Key_Predm&#13;&#10;&#13;&#10;WHERE  Pr_Svr_Mat.Key_PrSvr=:Key_PrSvr" PropData="05704C65667403BC000470546F7002140A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrDtMat" UserName="ÌàòåðèàëÄò" CloseDataSource="True" FieldAliases.Text="Key_Pasport=Key_Pasport&#13;&#10;Dt_Cod_Predm=Dt_Cod_Predm&#13;&#10;Dt_Name_Predm=Dt_Name_Predm&#13;&#10;SP_position=SP_position&#13;&#10;Key_ID_Mat=Key_ID_Mat&#13;&#10;VidSert=VidSert&#13;&#10;N_Sert=N_Sert&#13;&#10;Date_Sert=Date_Sert&#13;&#10;Cod_Plavka=Cod_Plavka&#13;&#10;Party=Party&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;Sortam=Sortam&#13;&#10;Type_NTD_Sortam=Type_NTD_Sortam&#13;&#10;Name_NTD_Sortam=Name_NTD_Sortam&#13;&#10;Marka=Marka&#13;&#10;Type_NTD_Marka=Type_NTD_Marka&#13;&#10;Name_NTD_Marka=Name_NTD_Marka&#13;&#10;MarkaPrn=MarkaPrn" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="exec Pr_GetSvrMat&#13;&#10;       @Key_PrSvr=:Key_PrSvr ,&#13;&#10;       @Num_Izdel = 1" PropData="05704C65667403FC000470546F7002140A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="IzdelQRY" UserName="Èçäåëèÿ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;  Pr_Napr.Key_Napr,&#13;&#10;  Pr_Napr.Num_Napr,&#13;&#10;  Pr_Napr.Data_Napr,&#13;&#10;&#13;&#10;  T_VPredm_Izdel.Cod_Predm Cod_Predm_Izdel,&#13;&#10;  T_VPredm_Izdel.Name_Predm Name_Predm_Izdel&#13;&#10;FROM&#13;&#10;  Pr_Napr&#13;&#10;  LEFT JOIN Pr_NaprZakl&#13;&#10;    ON Pr_NaprZakl.Key_Napr=Pr_Napr.Key_Napr&#13;&#10;  INNER JOIN Pr_Pasp&#13;&#10;    ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN  T_TP&#13;&#10;    ON T_TP.Key_TP=Pr_Pasp.Key_TP&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm&#13;&#10;  LEFT JOIN Pr_PaspDet&#13;&#10;    ON Pr_PaspDet.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN P_VKZ&#13;&#10;    ON Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  LEFT JOIN P_VKZ Pr_VKZIzdel&#13;&#10;    ON Pr_VKZIzdel.Key_VKZ=P_VKZ.Key_VKZ_Master&#13;&#10;  LEFT JOIN T_VPredm T_VPredm_Izdel&#13;&#10;    ON T_VPredm_Izdel.Key_Predm=Pr_VKZIzdel.Key_Predm&#13;&#10;  LEFT JOIN T_TechTreb&#13;&#10;    ON T_TechTreb.Cod_TT= Pr_NaprZakl.Cod_TT&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Napr.Key_Napr=:Key_Napr" PropData="05704C656674023C0470546F7002600A506172616D657465727301010C25000000204E616D653D224B65795F4E617072222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="VidKontr" UserName="Âèä êîíòðîëÿ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;       Pr_Napr.Key_Napr,&#13;&#10;       T_TechTreb.VidKontr,&#13;&#10;       Pr_NaprZakl.Cod_TT,&#13;&#10;       Pr_NaprSvr.Key_PrSvr,&#13;&#10;       Pr_NaprZakl.Kolvo,&#13;&#10;       Pr_NaprZakl.VolKontr,&#13;&#10;       T_Svr.NumSvr,&#13;&#10;       dbo.T_Ordersortam(T_Svr.NumSvr) OrderNumSvr,&#13;&#10;       Pr_Svr.AdNumSvr,&#13;&#10;       T_Svr.CatSvr&#13;&#10;FROM&#13;&#10;       Pr_Napr&#13;&#10;       INNER JOIN Pr_NaprZakl&#13;&#10;               ON Pr_Napr.Key_Napr = Pr_NaprZakl.Key_Napr&#13;&#10;       INNER JOIN Pr_NaprSvr&#13;&#10;               ON Pr_NaprZakl.Key_NaprZakl = Pr_NaprSvr.Key_NaprZakl&#13;&#10;       INNER JOIN Pr_Svr&#13;&#10;               ON Pr_NaprSvr.Key_PrSvr = Pr_Svr.Key_PrSvr&#13;&#10;       INNER JOIN T_Svr&#13;&#10;               ON Pr_Svr.Key_Svr = T_Svr.Key_Svr&#13;&#10;       INNER JOIN T_TechTreb&#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT&#13;&#10;WHERE     Pr_Napr.Key_Napr=:Key_Napr&#13;&#10;      AND Pr_NaprSvr.Key_PrSvr=:Key_PrSvr&#13;&#10;ORDER BY     Pr_NaprZakl.Cod_TT" PropData="05704C656674037C010470546F7002140A506172616D657465727301010C25000000204E616D653D224B65795F4E617072222044617461547970653D226674556E6B6E6F776E2200010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="NTDQry" UserName="NTDQry" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT&#13;&#10;--  Pr_NaprZakl.Key_Napr,&#13;&#10;  Pr_NaprZakl.Name_NTD&#13;&#10;FROM&#13;&#10;   Pr_NaprZakl&#13;&#10;&#13;&#10;  LEFT JOIN Pr_Pasp&#13;&#10;    ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN  T_TP&#13;&#10;    ON T_TP.Key_TP=Pr_Pasp.Key_TP&#13;&#10;  INNER JOIN T_VPredm&#13;&#10;    ON Pr_Pasp.Key_Predm = T_VPredm.Key_Predm&#13;&#10;  LEFT JOIN Pr_PaspDet&#13;&#10;    ON Pr_PaspDet.Key_Pasport=Pr_Pasp.Key_Pasport&#13;&#10;  LEFT JOIN P_VKZ&#13;&#10;    ON Pr_PaspDet.Key_VKZ=P_VKZ.Key_VKZ&#13;&#10;  LEFT JOIN P_VKZ Pr_VKZIzdel&#13;&#10;    ON Pr_VKZIzdel.Key_VKZ=P_VKZ.Key_VKZ_Master&#13;&#10;  LEFT JOIN T_VPredm T_VPredm_Izdel&#13;&#10;    ON T_VPredm_Izdel.Key_Predm=Pr_VKZIzdel.Key_Predm&#13;&#10;  LEFT JOIN T_TechTreb&#13;&#10;    ON T_TechTreb.Cod_TT= Pr_NaprZakl.Cod_TT&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_NaprZakl.Key_Zakl=:Key_Zakl      " PropData="05704C65667403BC010470546F7002140A506172616D657465727301010C25000000204E616D653D224B65795F5A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="ERQuery1" UserName="KontrQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="--SubjQRY&#13;&#10;SELECT&#13;&#10;  S_Subjects.Key_Sub  AS Key_Sprav,&#13;&#10;  S_Subjects.Name_Sub AS Name_Sprav,&#13;&#10;&#13;&#10;&#13;&#10;  SubAtrib11.Val_Str Val_Str11,&#13;&#10;  SubAtrib19.Val_Str Val_Str19,&#13;&#10;  SubAtrib20.Val_Str Val_Str20,&#13;&#10;&#13;&#10;  SubAtrib9.Val_Str Val_Str9&#13;&#10;&#13;&#10;&#13;&#10;FROM   S_Subjects S_Subjects&#13;&#10;   LEFT JOIN S_SubVer Sub_Ver&#13;&#10;   ON  S_Subjects.Key_Sub=Sub_Ver.Key_Sub&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib11&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib11.Key_Sub&#13;&#10;       AND SubAtrib11.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib11.Key_Rekv = 11&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib19&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib19.Key_Sub&#13;&#10;        AND SubAtrib19.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;      AND SubAtrib19.Key_Rekv = 19&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib20&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib20.Key_Sub&#13;&#10;       AND SubAtrib20.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib20.Key_Rekv = 20&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;   LEFT JOIN S_SubAtrib SubAtrib9&#13;&#10;       ON  S_Subjects.Key_Sub=SubAtrib9.Key_Sub&#13;&#10;       AND SubAtrib9.Sub_Version =  Sub_Ver.Sub_Version                                      &#13;&#10;       AND SubAtrib9.Key_Rekv = 9&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Sub_Ver.Key_Sub_Ver = :Key_Sub_Ver_OTK                                         &#13;&#10;&#13;&#10;  " PropData="05704C6566740380010470546F700398000A506172616D657465727301010C2C000000204E616D653D224B65795F5375625F5665725F4F544B222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="SvrIspQRY" UserName="Èñïîëíèòåëè" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="NaprStrQRY" IgnoreDupParams="False" SQL.Text="SELECT&#13;&#10;  Pr_Svr_Isp.Key_PrSvr,&#13;&#10;  Pr_Svr_Isp.Key_SvrPrimen,&#13;&#10;  Pr_Svr_Isp.Key_Sub_Ver_Svr,&#13;&#10;  T_Svr_PrimenMat.SvrPrimen,&#13;&#10;  S_Subjects.Name_Sub Name_Sub_Svr&#13;&#10;&#13;&#10;  , Pr_Svr_Isp.Key_Sposob&#13;&#10;  , T_SvrSposob.SposobSvr&#13;&#10;  , dbo.S_GegSubVerAtrib(Pr_Svr_Isp.Key_Sub_Ver_Svr, 10) Kleimo           &#13;&#10;&#13;&#10;FROM&#13;&#10;  Pr_Svr_Isp&#13;&#10;  INNER JOIN T_Svr_PrimenMat&#13;&#10;    ON Pr_Svr_Isp.Key_SvrPrimen = T_Svr_PrimenMat.Key_SvrPrimen&#13;&#10;  INNER JOIN S_SubVer&#13;&#10;    ON Pr_Svr_Isp.Key_Sub_Ver_Svr = S_SubVer.Key_Sub_Ver&#13;&#10;  INNER JOIN S_Subjects&#13;&#10;    ON S_SubVer.Key_Sub = S_Subjects.Key_Sub&#13;&#10;&#13;&#10;  LEFT JOIN dbo.T_SvrSposob T_SvrSposob&#13;&#10;    ON T_SvrSposob.Key_Sposob= Pr_Svr_Isp.Key_Sposob&#13;&#10;&#13;&#10;&#13;&#10;WHERE&#13;&#10;  Pr_Svr_Isp.Key_PrSvr = :Key_PrSvr&#13;&#10;ORDER BY  Pr_Svr_Isp.Key_SvrPrimen desc                                       " PropData="05704C65667403FC000470546F70038C000A506172616D657465727301010C26000000204E616D653D224B65795F5072537672222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="PaspQRY" UserName="Ïàñïîðòà" CloseDataSource="True" FieldAliases.Text="Key_Zakl=Key_Zakl&#13;&#10;Key_VKZ_Izdel=Key_VKZ_Izdel&#13;&#10;Cod_Predm_Izdel=Cod_Predm_Izdel&#13;&#10;Name_Predm_Izdel=Name_Predm_Izdel&#13;&#10;Key_NaprZakl=Key_NaprZakl&#13;&#10;Key_Pasport=Key_Pasport&#13;&#10;Cod_Predm=Cod_Predm&#13;&#10;Name_Predm=Name_Predm&#13;&#10;ZavNumFrom=ZavNumFrom&#13;&#10;ZavNumTo=ZavNumTo&#13;&#10;DopInfo=DopInfo" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT        &#13;&#10;       Pr_Zakl.Key_Zakl, &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;       Izdel.Name_Predm AS Name_Predm_Izdel, &#13;&#10;       Pr_NaprZakl.Key_NaprZakl, &#13;&#10;       Pr_Pasp.Key_Pasport, &#13;&#10;       DSE.Cod_Predm, &#13;&#10;       DSE.Name_Predm,&#13;&#10;         &#13;&#10;       Pr_NaprZakl.ZavNumFrom, &#13;&#10;       Pr_NaprZakl.ZavNumTo,&#13;&#10;       Pr_NaprZakl.DopInfo                 &#13;&#10;FROM            Pr_Zakl INNER JOIN&#13;&#10;                         Pr_NaprZakl ON Pr_Zakl.Key_Zakl = Pr_NaprZakl.Key_Zakl INNER JOIN&#13;&#10;                         Pr_Pasp ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport INNER JOIN&#13;&#10;                         Pr_PaspDet ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport INNER JOIN&#13;&#10;                         P_VKZ ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ INNER JOIN&#13;&#10;                         P_VKZ AS VKZ_IZDEL ON P_VKZ.Key_VKZ_Izdel = VKZ_IZDEL.Key_VKZ INNER JOIN&#13;&#10;                         T_VPredm AS Izdel ON VKZ_IZDEL.Key_Predm = Izdel.Key_Predm INNER JOIN&#13;&#10;                         T_VPredm AS DSE ON Pr_Pasp.Key_Predm = DSE.Key_Predm&#13;&#10;WHERE&#13;&#10;       Pr_Zakl.Key_Zakl = :Key_Zakl&#13;&#10;&#13;&#10;ORDER BY&#13;&#10;Cod_Predm_Izdel ,      &#13;&#10;DSE.Cod_Predm,&#13;&#10;Pr_Pasp.Cod_Pasp,      &#13;&#10;Key_NaprZakl    &#13;&#10;                        " PropData="05704C65667402480470546F7003C4000A506172616D657465727301010C25000000204E616D653D224B65795F5A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="IzdelDSEQRY" UserName="ÈçäåëèåÄÑÅ" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="MainFrxDS" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT                        &#13;&#10; &#13;&#10;       Izdel.Cod_Predm AS Cod_Predm_Izdel, &#13;&#10;       Izdel.Name_Predm AS Name_Predm_Izdel, &#13;&#10;       DSE.Cod_Predm Cod_Predm_DSE, &#13;&#10;       DSE.Name_Predm Name_Predm_DSE, &#13;&#10;       Pr_Pasp.Cod_Pasp, &#13;&#10;       Pr_Pasp.Cod_Zak&#13;&#10;         &#13;&#10;       ,Pr_NaprZakl.Key_Pasport                          &#13;&#10;       ,Pr_NaprZakl.Key_Zakl&#13;&#10;       ,Pr_NaprZakl.ZavNumFrom&#13;&#10;       ,Pr_NaprZakl.ZavNumTo           &#13;&#10;                                  &#13;&#10;         &#13;&#10;FROM            Pr_NaprZakl INNER JOIN&#13;&#10;                         Pr_Pasp ON Pr_NaprZakl.Key_Pasport = Pr_Pasp.Key_Pasport INNER JOIN&#13;&#10;                         Pr_PaspDet ON Pr_Pasp.Key_Pasport = Pr_PaspDet.Key_Pasport INNER JOIN&#13;&#10;                         P_VKZ ON Pr_PaspDet.Key_VKZ = P_VKZ.Key_VKZ INNER JOIN&#13;&#10;                         P_VKZ AS P_VKZ_Izdel ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ INNER JOIN&#13;&#10;                         T_VPredm AS Izdel ON P_VKZ_Izdel.Key_Predm = Izdel.Key_Predm INNER JOIN&#13;&#10;                         T_VPredm AS DSE ON Pr_Pasp.Key_Predm = DSE.Key_Predm&#13;&#10;WHERE        (Pr_NaprZakl.Key_Zakl = :Key_Zakl )" PropData="05704C6566740390000470546F7003C0000A506172616D657465727301010C25000000204E616D653D224B65795F5A616B6C222044617461547970653D226674556E6B6E6F776E220000"/>
    <TfrxERQuery Name="TTQry" UserName="TTQry" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="PaspQRY" IgnoreDupParams="False" SQL.Text="SELECT                                       &#13;&#10;       Pr_NaprZakl.Key_Zakl, &#13;&#10;       Pr_NaprZakl.ZavNumFrom, &#13;&#10;       Pr_NaprZakl.ZavNumTo, &#13;&#10;       Pr_NaprZakl.Key_PrSp, &#13;&#10;       Pr_NaprZakl.Cod_TT,&#13;&#10;       Pr_NaprZakl.DopInfo,&#13;&#10;       Pr_NaprZakl.TypeObr,                             &#13;&#10;&#13;&#10;       Pr_NaprZakl.ParamKontr,&#13;&#10;       Pr_NaprZakl.VolKontr,             &#13;&#10;       Pr_NaprZakl.Kolvo,             &#13;&#10;       Pr_NaprZakl.Name_NTD,&#13;&#10;&#13;&#10;       Pr_NaprZakl.TOInfo,  &#13;&#10;       Pr_NaprZakl.TOSadka,&#13;&#10;&#13;&#10;        dbo.P_VKZ_Get_KK(Pr_NaprZakl.Key_Pasport,Pr_NaprZakl.Cod_TT)  KK,           &#13;&#10;  &#13;&#10;       dbo.Pr_Get_Zakl_TT ( Pr_NaprZakl.Key_NaprZakl ,0)   NTDTT,           &#13;&#10;       dbo.Pr_Get_Zakl_TT ( Pr_NaprZakl.Key_NaprZakl ,1)   TTNTDUd,&#13;&#10;       dbo.Pr_Get_Zakl_TT ( Pr_NaprZakl.Key_NaprZakl ,2)   TTNTDNUd,  &#13;&#10;  &#13;&#10;       Pr_NaprZakl.TxtUd,&#13;&#10;       Pr_NaprZakl.TxtNud,                             &#13;&#10;  &#13;&#10;       T_TechTreb.Name_TT,&#13;&#10;       T_VPredm.Cod_Predm,&#13;&#10;         &#13;&#10;      Pr_NaprZakl.Key_NaprZakl&#13;&#10;FROM                                &#13;&#10;       Pr_NaprZakl&#13;&#10;       LEFT JOIN Pr_SP&#13;&#10;			            	ON Pr_SP.Key_PrSP = Pr_NaprZakl.Key_PrSP&#13;&#10;  &#13;&#10;       LEFT JOIN  T_TechTreb&#13;&#10;               ON Pr_NaprZakl.Cod_TT = T_TechTreb.Cod_TT &#13;&#10; &#13;&#10;       LEFT OUTER JOIN T_VPredm &#13;&#10;               ON Pr_NaprZakl.Key_Predm_Proba = T_VPredm.Key_Predm&#13;&#10;                                                                                             &#13;&#10;&#13;&#10;                        &#13;&#10;WHERE     &#13;&#10;            (Pr_NaprZakl.Key_NaprZakl = :Key_NaprZakl )&#13;&#10; --      AND (Pr_SP.Key_Id_Mat = :Key_Id_Mat )&#13;&#10;  --     AND (Isnull(Pr_NaprZakl.TOSadka,'-') = Isnull(:TOSadka,'-') )&#13;&#10;  --     AND (Isnull(Pr_NaprZakl.TOInfo,'-') = Isnull(:TOInfo,'-') )&#13;&#10;  --     AND (Pr_NaprZakl.Key_Pasport = :Key_Pasport )           &#13;&#10;         &#13;&#10;                    &#13;&#10;ORDER BY Pr_NaprZakl.Cod_TT" PropData=""/>
