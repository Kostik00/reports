<TfrxReport Version="4.13.1" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41295,0680531829" ReportOptions.Description.Text="" ReportOptions.Name="Ïëàí çàïóñêà îñíîâíîãî ìàòåðèàëà.fr3 Ãðàôèê 605-Í02" ReportOptions.LastChange="41439,6306095949" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';&#13;&#10;  &#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2600000020446174615365743D224D61696E46727844532220446174615365744E616D653D22C2CAC72200010C2600000020446174615365743D22506C6E5152592220446174615365744E616D653D22506C6E515259220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="PlnQRY" UserName="PlnQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_VPredm_Izdel.Cod_Predm AS Cod_PredmIzdel, &#13;&#10;       P_VKZ_Izdel.Cod_Zak, &#13;&#10;       P_VKZ.DataZap, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Cod_Prin,&#13;&#10;       T_VPredm.Name_K_Prin,&#13;&#10;	      Convert (varchar,P_VKZ.DataZap,112) DateStr,&#13;&#10;&#13;&#10;        PredmM.Cod_Postav AS Cod_PostavM,&#13;&#10;        PredmM.Cod_Prin AS Cod_PrinM,&#13;&#10;            &#13;&#10;        PredmM.Cod_Predm 	AS Cod_PredmM,&#13;&#10;        PredmM.Name_Predm 	AS Name_PredmM,&#13;&#10;        PredmM.PrintFlag AS PrintFlagM,                                                                &#13;&#10;&#13;&#10;        PredmM.Sortam SortamM,&#13;&#10;        PredmM.OrderSortam OrderSortamM,&#13;&#10;            &#13;&#10;        PredmM.Type_NTD_Sortam AS Type_NTD_SortamM,&#13;&#10;        PredmM.Name_NTD_Sortam AS Name_NTD_SortamM,&#13;&#10;          &#13;&#10;        PredmM.Marka MarkaM,&#13;&#10;        PredmM.Type_NTD_Marka AS Type_NTD_MarkaM,&#13;&#10;        PredmM.Name_NTD_Marka AS Name_NTD_MarkaM,&#13;&#10;        T_SPROWS.Prof_Razm,&#13;&#10;          &#13;&#10;        Gr_VxodPredm.Cod_Gr Cod_GrM,      &#13;&#10;        Gr_Groups.Name_Gr Name_GrM, &#13;&#10;&#13;&#10;        Gr_Groups.FullNameGr FullNameGrM,&#13;&#10;            &#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_ZapP(P_VKZ.Key_VKZ) Kolvo_ZapP,&#13;&#10;            &#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_Zap(P_VKZ.Key_VKZ) Kolvo_Zap,&#13;&#10;        P_VKZ.Kolvo            &#13;&#10;FROM         &#13;&#10;       P_VKZ INNER JOIN T_VPredm &#13;&#10;               ON P_VKZ.Key_Predm = T_VPredm.Key_Predm &#13;&#10;       INNER JOIN P_VKZ AS P_VKZ_Izdel &#13;&#10;               ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ &#13;&#10;       INNER JOIN T_VPredm AS T_VPredm_Izdel &#13;&#10;               ON P_VKZ_Izdel.Key_Predm = T_VPredm_Izdel.Key_Predm&#13;&#10;&#13;&#10;       INNER JOIN dbo.T_SPRows T_SPRows &#13;&#10;               ON T_SPRows.Key_SP = P_VKZ.Key_SP&#13;&#10;               AND T_SPRows.SP_position = 0&#13;&#10;  &#13;&#10;       LEFT JOIN T_VPredm AS PredmM&#13;&#10;               ON T_SPRows.Key_Predm = PredmM.Key_Predm&#13;&#10;&#13;&#10;       LEFT JOIN Gr_VxodPredm &#13;&#10;               ON PredmM.Key_Predm = Gr_VxodPredm.Key_Predm &#13;&#10;       LEFT JOIN Gr_Groups &#13;&#10;               ON Gr_VxodPredm.Key_VidGr = Gr_Groups.Key_VidGr &#13;&#10;               AND Gr_VxodPredm.Cod_Gr = Gr_Groups.Cod_Gr&#13;&#10;			&#13;&#10;&#13;&#10;                 &#13;&#10;WHERE     &#13;&#10;       P_VKZ.DataZap     &#62;= :DateFrom                                    &#13;&#10;       AND P_VKZ.DataZap &#60;= :DateTo&#13;&#10;       AND P_VKZ.Cod_Postav = '1'                                             &#13;&#10;       AND  ((IsNull(dbo.Pr_VKZ_Get_Kolvo_Zap (P_VKZ.Key_VKZ),0) &#60; P_VKZ.Kolvo) or (:PrintZap  = 0))                                                                  &#13;&#10;       AND  ((IsNull(dbo.Pr_VKZ_Get_Kolvo_ZapP(P_VKZ.Key_VKZ),0) &#60; P_VKZ.Kolvo) or (:PrintZapP = 0))&#13;&#10;       AND P_VKZ_Izdel.Cod_SosZ='Ä'&#13;&#10;       AND P_VKZ_Izdel.LockDT = '1'                                                                                      &#13;&#10;           &#13;&#10;ORDER BY    &#13;&#10;		Cod_PostavM, &#13;&#10;		Cod_PrinM, &#13;&#10;		Cod_GrM,&#13;&#10;		Name_PredmM,&#13;&#10;		OrderSortamM,&#13;&#10;		SortamM,&#13;&#10;		MarkaM&#13;&#10;    " PropData=""/>
  </TfrxDataPage>
