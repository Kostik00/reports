<TfrxReport Version="4.4.26" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="Âåäîìîñòü ïîêóïíûõ ÂÊÇ ¹ 186" ReportOptions.LastChange="39568,0248394097" ScriptLanguage="PascalScript" ScriptText.Text="uses 'CommonRU.pas';           &#13;&#10;  &#13;&#10;  &#13;&#10;  &#13;&#10;function FnPredm:string;&#13;&#10;begin&#13;&#10;  Result:=PrintNameDSE(&#60;ÂÑÈ.&#34;PrintFlag&#34;&#62;,&#60;ÂÑÈ.&#34;Cod_Predm&#34;&#62;, &#60;ÂÑÈ.&#34;Name_Predm&#34;&#62;,&#13;&#10;                       &#60;ÂÑÈ.&#34;Sortam&#34;&#62;, &#60;ÂÑÈ.&#34;Type_NTD_Sortam&#34;&#62;, &#60;ÂÑÈ.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;                       &#60;ÂÑÈ.&#34;Marka&#34;&#62;,  &#60;ÂÑÈ.&#34;Type_NTD_Marka&#34;&#62;,  &#60;ÂÑÈ.&#34;Name_NTD_Marka&#34;&#62;);&#13;&#10;end;          &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="Pokupnye" UserName="ÂÑÈ" CloseDataSource="True" FieldAliases.Text="" Master="MainFrxDS" SQL.Text="SELECT     &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       P_VKZ.Key_Predm, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm,&#13;&#10;       T_VPredm.PrintFlag,                                 &#13;&#10;       T_VPredm.Sortam, &#13;&#10;       T_VPredm.Type_NTD_Sortam,&#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       SUM(P_VKZ.Kolvo) AS Kolvo,&#13;&#10;       SUM(P_VKZ.Kolvo_On_Izdel) AS Kolvo_On_Izdel, &#13;&#10;       P_VKZ_SB.Key_Predm AS Key_Predm_SB, &#13;&#10;       T_VPredm_SB.Cod_Predm AS Cod_Predm_SB,&#13;&#10;       T_VPredm_SB.OrderCod_Predm AS OrderCod_Predm_SB, &#13;&#10;       SUM(P_VKZ_SB.Kolvo) AS Kolvo_SB, &#13;&#10;       P_VKZ.Cod_Postav, &#13;&#10;       Gr_VxodPredm.Key_VidGr, &#13;&#10;       Gr_VxodPredm.Cod_Gr, &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr&#13;&#10;FROM         &#13;&#10;       P_VKZ &#13;&#10;       INNER JOIN P_VKZ AS P_VKZ_SB &#13;&#10;               ON P_VKZ.Key_VKZ_Master = P_VKZ_SB.Key_VKZ &#13;&#10;       INNER JOIN T_VPredm &#13;&#10;               ON P_VKZ.Key_Predm = T_VPredm.Key_Predm &#13;&#10;       INNER JOIN T_VPredm AS T_VPredm_SB &#13;&#10;               ON P_VKZ_SB.Key_Predm = T_VPredm_SB.Key_Predm &#13;&#10;       INNER JOIN Gr_VxodPredm &#13;&#10;               ON P_VKZ.Key_Predm = Gr_VxodPredm.Key_Predm &#13;&#10;       INNER JOIN Gr_Groups &#13;&#10;               ON Gr_VxodPredm.Key_VidGr = Gr_Groups.Key_VidGr &#13;&#10;               AND Gr_VxodPredm.Cod_Gr = Gr_Groups.Cod_Gr&#13;&#10;GROUP BY &#13;&#10;       P_VKZ.Key_VKZ_Izdel, &#13;&#10;       P_VKZ.Key_Predm, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.PrintFlag,                                 &#13;&#10;       T_VPredm.Sortam, &#13;&#10;       T_VPredm.Type_NTD_Sortam,&#13;&#10;       T_VPredm.Name_NTD_Sortam, &#13;&#10;       T_VPredm.Marka, &#13;&#10;       T_VPredm.Type_NTD_Marka, &#13;&#10;       T_VPredm.Name_NTD_Marka, &#13;&#10;       P_VKZ_SB.Key_Predm,&#13;&#10;       T_VPredm_SB.Cod_Predm, &#13;&#10;       T_VPredm_SB.OrderCod_Predm, &#13;&#10;       P_VKZ.Cod_Postav, &#13;&#10;       Gr_VxodPredm.Key_VidGr, &#13;&#10;       Gr_VxodPredm.Cod_Gr, &#13;&#10;       Gr_Groups.Name_Gr,&#13;&#10;       Gr_Groups.FullNameGr&#13;&#10;HAVING      &#13;&#10;       (P_VKZ.Key_VKZ_Izdel = :Key_VKZ_Izdel) &#13;&#10;       AND (P_VKZ.Cod_Postav &#60;&#62; '1') &#13;&#10;       AND (Gr_VxodPredm.Key_VidGr = 1)&#13;&#10;ORDER BY&#13;&#10;       Gr_VxodPredm.Cod_Gr,  &#13;&#10;       T_VPredm_SB.OrderCod_Predm&#13;&#10;    " SQLSchema="" PropData="05704C65667402300470546F7002300A506172616D657465727301010C2A000000204E616D653D224B65795F564B5A5F497A64656C222044617461547970653D226674556E6B6E6F776E220000"/>
