<TfrxReport Version="4.11.16" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="�� ���������" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38513,0822621875" ReportOptions.Description.Text="" ReportOptions.Name="����-����.fr3 ������ ���������" ReportOptions.LastChange="40793,5125849074" ScriptLanguage="PascalScript" ScriptText.Text="Uses 'CommonRU.pas';  &#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;  &#13;&#10;function FnPredm:string;&#13;&#10;begin&#13;&#10;  Result:=PrintPredm  (&#60;ItogQRY.&#34;PrintFlag&#34;&#62;,&#60;ItogQRY.&#34;Cod_Predm&#34;&#62;,       &#60;ItogQRY.&#34;Name_Predm&#34;&#62;,&#13;&#10;                       &#60;ItogQRY.&#34;Sortam&#34;&#62;,   &#60;ItogQRY.&#34;Type_NTD_Sortam&#34;&#62;, &#60;ItogQRY.&#34;Name_NTD_Sortam&#34;&#62;,&#13;&#10;                       &#60;ItogQRY.&#34;Marka&#34;&#62;,    &#60;ItogQRY.&#34;Type_NTD_Marka&#34;&#62;,  &#60;ItogQRY.&#34;Name_NTD_Marka&#34;&#62;);&#13;&#10;   &#13;&#10;//  Result:=Result+'('+VarToStr(&#60;���.&#34;PrintFlag&#34;&#62;)+')';                                                                         &#13;&#10;                         &#13;&#10;end;          &#13;&#10;  &#13;&#10;procedure DialogPage1OnActivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('StartDate',Str);        &#13;&#10;  DateFrom.Date:= StrToDate( Str );  &#13;&#10;  Str:='01.01.01';&#13;&#10;  MyRestoreString('EndDate',Str);        &#13;&#10;  DateTo.Date:= StrToDate( Str );  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DialogPage1OnDeactivate(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  Str:string;                                 &#13;&#10;begin&#13;&#10;  Str:=DateToStr(DateFrom.Date);&#13;&#10;  MySaveString('StartDate',Str);        &#13;&#10;  Str:=DateToStr(DateTo.Date);&#13;&#10;  MySaveString('EndDate',Str);        &#13;&#10;end;&#13;&#10;  &#13;&#10;  &#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnAfterCalcHeight(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.Freespace &#60; (GroupFooter1.Height+TfrxMasterData(Sender).Height) then&#13;&#10;    Engine.NewPage;                                            &#13;&#10;    &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ItogQRY" UserName="ItogQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" Master="SUBQRY" IgnoreDupParams="False" SQL.Text="Declare @Key_Sub_Ver_From int &#13;&#10;Declare @Key_Sub_Ver_To int&#13;&#10;&#13;&#10;SET @Key_Sub_Ver_From = :Key_Sub_Ver_From                                &#13;&#10;Set @Key_Sub_Ver_To = :Key_Sub_Ver_To   &#13;&#10;&#13;&#10;SELECT     &#13;&#10; A_Nacl_Str.Key_ID_Mat, &#13;&#10; A_LZK.Cod_Zak, &#13;&#10; A_VID_Mat.VidSert, &#13;&#10; A_VID_Mat.N_Sert, &#13;&#10; A_VID_Mat.Date_Sert, &#13;&#10; A_VID_Mat.Cod_Plavka, &#13;&#10; A_VID_Mat.Party, &#13;&#10; A_VID_Mat.RegN_Sert, &#13;&#10; A_VID_Mat.Cod_Pasp, &#13;&#10; T_VPREDMSKL.Cod_Predm, &#13;&#10; T_VPREDMSKL.Name_Predm, &#13;&#10; T_VPREDMSKL.Sortam, &#13;&#10; T_VPREDMSKL.OrderSortam,  &#13;&#10; T_VPREDMSKL.Type_NTD_Sortam, &#13;&#10; T_VPREDMSKL.Name_NTD_Sortam, &#13;&#10; T_VPREDMSKL.Marka, &#13;&#10; T_VPREDMSKL.Type_NTD_Marka, &#13;&#10; T_VPREDMSKL.Name_NTD_Marka, &#13;&#10; T_VPREDMSKL.Name_K_Ed, &#13;&#10; T_VPREDMSKL.Sklad_Ed_Izm, &#13;&#10; T_VPREDMSKL.PrintFlag, &#13;&#10; SUM(     A_Nacl_Str_LZK.Kolvo * dbo.A_PlusZero(A_Nacl.Key_Sub_Ver_To, @Key_Sub_Ver_To) &#13;&#10;        - A_Nacl_Str_LZK.Kolvo * dbo.A_PlusZero(A_Nacl.Key_Sub_Ver_From, @Key_Sub_Ver_To)) AS Kolvo,&#13;&#10; dbo.T_GetKoefTo(T_VPREDMSKL.Key_Predm, T_VPREDMSKL.Sklad_Ed_Izm, '166') as K                                                           &#13;&#10;FROM         &#13;&#10; A_Nacl &#13;&#10; INNER JOIN A_Nacl_Str ON A_Nacl.Key_Nacl = A_Nacl_Str.Key_Nacl &#13;&#10; INNER JOIN A_Nacl_Str_LZK ON A_Nacl_Str.Key_Nacl_Str = A_Nacl_Str_LZK.Key_Nacl_Str &#13;&#10; INNER JOIN A_LZK ON A_Nacl_Str_LZK.Key_LZK = A_LZK.Key_LZK &#13;&#10; INNER JOIN A_VID_Mat ON A_Nacl_Str.Key_ID_Mat = A_VID_Mat.Key_ID_Mat &#13;&#10; INNER JOIN T_VPREDMSKL ON A_VID_Mat.Key_Predm = T_VPREDMSKL.Key_Predm&#13;&#10;WHERE     &#13;&#10; (A_Nacl.Data_Nacl &#62;= :DateFrom)&#13;&#10; AND (A_Nacl.Data_Nacl &#60;= :DateTo)&#13;&#10; AND A_Nacl.Key_Sub_Ver_To   in (@Key_Sub_Ver_From, @Key_Sub_Ver_To)&#13;&#10; AND A_Nacl.Key_Sub_Ver_From in (@Key_Sub_Ver_From, @Key_Sub_Ver_To)&#13;&#10;&#13;&#10;GROUP BY &#13;&#10; A_Nacl_Str.Key_ID_Mat, &#13;&#10; A_LZK.Cod_Zak, &#13;&#10; A_VID_Mat.VidSert, &#13;&#10; A_VID_Mat.N_Sert, &#13;&#10; A_VID_Mat.Date_Sert, &#13;&#10; A_VID_Mat.Cod_Plavka, &#13;&#10; A_VID_Mat.Party, &#13;&#10; A_VID_Mat.RegN_Sert, &#13;&#10; A_VID_Mat.Cod_Pasp, &#13;&#10; T_VPREDMSKL.Cod_Predm, &#13;&#10; T_VPREDMSKL.Name_Predm, &#13;&#10; T_VPREDMSKL.Sortam, &#13;&#10; T_VPREDMSKL.OrderSortam,  &#13;&#10; T_VPREDMSKL.Type_NTD_Sortam, &#13;&#10; T_VPREDMSKL.Name_NTD_Sortam, &#13;&#10; T_VPREDMSKL.Marka, &#13;&#10; T_VPREDMSKL.Type_NTD_Marka, &#13;&#10; T_VPREDMSKL.Name_NTD_Marka, &#13;&#10; T_VPREDMSKL.Name_K_Ed, &#13;&#10; T_VPREDMSKL.Sklad_Ed_Izm, &#13;&#10; T_VPREDMSKL.PrintFlag,&#13;&#10; dbo.T_GetKoefTo(T_VPREDMSKL.Key_Predm, T_VPREDMSKL.Sklad_Ed_Izm, '166')     &#13;&#10;ORDER BY &#13;&#10; A_LZK.Cod_Zak, &#13;&#10; T_VPREDMSKL.Name_Predm, &#13;&#10; T_VPREDMSKL.OrderSortam  &#13;&#10;    " PropData=""/>
    <TfrxERQuery Name="SUBQRY" UserName="SUBQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT DISTINCT S1.Key_Class, S1.Name_Sub Name_Sub_From,  A.Key_Sub_Ver_From, S3.Key_Class, A.Key_Sub_Ver_To,  S3.Name_Sub   Name_Sub_To                    &#13;&#10;FROM&#13;&#10;    A_VNacl A&#13;&#10;    INNER JOIN S_SubVer S ON (A.Key_Sub_Ver_From=S.Key_Sub_Ver)&#13;&#10;    INNER JOIN S_Subjects S1 ON (S.Key_Sub=S1.Key_Sub)&#13;&#10;    INNER JOIN S_SubVer S2 ON (A.Key_Sub_Ver_To=S2.Key_Sub_Ver)&#13;&#10;    INNER JOIN S_Subjects S3 ON (S2.Key_Sub=S3.Key_Sub)&#13;&#10;WHERE&#13;&#10;    S1.Key_Class =6 AND&#13;&#10;    S3.Key_Class in (1,5)&#13;&#10;&#13;&#10;ORDER BY Name_Sub_From, Name_Sub_To                                     " SQLSchema="" PropData="05704C65667402380470546F7002080A506172616D65746572730100"/>
  </TfrxDataPage>
