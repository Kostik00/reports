<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="5.5.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="42831,608181169" ReportOptions.Description.Text="" ReportOptions.Name="Количество ТП по ответственным.fr3 Список ТП" ReportOptions.LastChange="44806,4111740046" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False">
  <Datasets>
    <item DataSet="ERQuery1" DataSetName="Статистика"/>
  </Datasets>
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="ERQuery1" UserName="Статистика" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT        Name_Sub, DATEPART(yy, Datazap) AS Y, DATEPART(MONTH, Datazap) AS M, COUNT(Cod_Pasp) AS CNT&#13;&#10;FROM            (SELECT        Sys_Log.Key_Docum, MIN(Sys_Log.LogDate) AS Datazap, S_PERSONNEL.Name_Sub, Pr_Pasp.Cod_Pasp, Pr_Pasp.Cod_Zak, T_VPredm_DSE.Cod_Predm, T_VPredm_DSE.Name_Predm&#13;&#10;                          FROM            Sys_Log INNER JOIN&#13;&#10;                                                    S_PERSONNEL ON Sys_Log.UserName = S_PERSONNEL.cod_sub INNER JOIN&#13;&#10;                                                    Pr_Pasp ON Sys_Log.Key_Docum = Pr_Pasp.Key_Pasport INNER JOIN&#13;&#10;                                                    T_VPredm_DSE ON Pr_Pasp.Key_Predm = T_VPredm_DSE.Key_Predm&#13;&#10;                          WHERE        (Sys_Log.Docum = 'Технологический паспорт') AND (Sys_Log.AdData LIKE '%Подготовка маршрута%')&#13;&#10;                          GROUP BY Sys_Log.Key_Docum, S_PERSONNEL.Name_Sub, Pr_Pasp.Cod_Pasp, Pr_Pasp.Cod_Zak, T_VPredm_DSE.Cod_Predm, T_VPredm_DSE.Name_Predm) AS T1&#13;&#10;GROUP BY Name_Sub, DATEPART(yy, Datazap), DATEPART(MONTH, Datazap)&#13;&#10;HAVING        (DATEPART(yy, Datazap) &#62;= 2020) AND (Name_Sub Like 'Андреева%') OR&#13;&#10;                         (Name_Sub Like 'Лобанова%') OR&#13;&#10;                         (Name_Sub Like 'Захарова%') OR&#13;&#10;                         (Name_Sub Like 'Воронина%') OR&#13;&#10;                         (Name_Sub Like 'Кочергина%')&#13;&#10;ORDER BY Y DESC, M DESC, CNT DESC, Name_Sub      " PropData="05704C656674024C0470546F7002340A506172616D65746572730100"/>
  </TfrxDataPage>
  <TfrxReportPage Name="Page1" PaperWidth="210" PaperHeight="297" PaperSize="9" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10" ColumnWidth="0" ColumnPositions.Text="" HGuides.Text="" VGuides.Text="">
