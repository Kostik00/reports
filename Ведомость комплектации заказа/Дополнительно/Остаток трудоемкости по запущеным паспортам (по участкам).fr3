<TfrxReport Version="4.12.2" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Ïî óìîë÷àíèþ" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41183,6439494097" ReportOptions.Description.Text="" ReportOptions.Name="+Îñòàòîê òðóäîåìêîñòè ïî çàïóùåíûì ïàñïîðòàì (ïî ó÷àñòêàì).fr3 ÂÊÇ ¹ 465-À02" ReportOptions.LastChange="41208,6586987616" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;begin&#13;&#10;&#13;&#10;end." StoreInDFM="False" PropData="044C65667403800203546F70022008446174617365747301010C2800000020446174615365743D22547275645152592220446174615365744E616D653D2254727564515259220000095661726961626C65730100055374796C650100">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="TrudQRY" UserName="TrudQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;	P_VKZ_IZDEL.Cod_Zak, &#13;&#10;	P_VKZ_IZDEL.Key_VKZ_Izdel, &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm, &#13;&#10;	P_VKZ_IZDEL.Kolvo AS KolvoIzdel, &#13;&#10;	T_V_OPERGR.Name_GrGr, &#13;&#10;	P_VKZ_IZDEL.Kolvo,&#13;&#10;	SUM(Pr_Pasp_Rows.Tsm*Pr_PaspDet.KolvoZap/Pr_Pasp.PaspKolvo) SMTrudByPasp,&#13;&#10;	SUM(Pr_Pasp_Rows.Tsm*Pr_PaspDet.KolvoZap * dbo.Sys_EQ(Pr_Pasp_Rows.Status_Oper,2)/Pr_Pasp.PaspKolvo) SMTrudByPaspF&#13;&#10;&#13;&#10;FROM         &#13;&#10;	P_VKZ AS P_VKZ_IZDEL&#13;&#10; INNER JOIN D_Zakaz&#13;&#10;       ON D_Zakaz.Cod_Zak=P_VKZ_IZDEL.Cod_Zak&#13;&#10;       AND D_Zakaz.Cod_SosZ='Ä'                                                                      &#13;&#10;	INNER JOIN T_VPredm &#13;&#10;		ON P_VKZ_IZDEL.Key_Predm = T_VPredm.Key_Predm &#13;&#10;	INNER JOIN P_VKZ &#13;&#10;		ON P_VKZ_IZDEL.Key_VKZ_Izdel = P_VKZ.Key_VKZ_Izdel &#13;&#10;	INNER JOIN Pr_PaspDet &#13;&#10;--		ON P_VKZ_IZDEL.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;		on P_VKZ.Key_VKZ = Pr_PaspDet.Key_VKZ &#13;&#10;	INNER JOIN Pr_Pasp &#13;&#10;		ON Pr_PaspDet.Key_Pasport = Pr_Pasp.Key_Pasport &#13;&#10;	INNER JOIN Pr_Pasp_Rows &#13;&#10;		ON Pr_Pasp.Key_Pasport = Pr_Pasp_Rows.Key_Pasport &#13;&#10;	LEFT JOIN T_V_OPERGR &#13;&#10;		ON Pr_Pasp_Rows.Cod_Oper = T_V_OPERGR.Cod_Oper&#13;&#10;WHERE     &#13;&#10;	(P_VKZ_IZDEL.Key_VKZ_Master IS NULL)&#13;&#10; AND Pr_Pasp.Key_Pasp_Status &#62; 0                              &#13;&#10;	AND Pr_Pasp.PaspKolvo &#62;0&#13;&#10;GROUP BY&#13;&#10;	P_VKZ_IZDEL.Cod_Zak, &#13;&#10;	P_VKZ_IZDEL.Key_VKZ_Izdel, &#13;&#10;	T_VPredm.Cod_Predm, &#13;&#10;	T_VPredm.Name_Predm, &#13;&#10;	P_VKZ_IZDEL.Kolvo, &#13;&#10;	T_V_OPERGR.Name_GrGr, &#13;&#10;	P_VKZ_IZDEL.Kolvo&#13;&#10;ORDER BY&#13;&#10;	T_V_OPERGR.Name_GrGr Desc,           &#13;&#10;	P_VKZ_IZDEL.Cod_Zak,&#13;&#10;	T_VPredm.Cod_Predm &#13;&#10;      " PropData="05704C656674024C0470546F7002500A506172616D65746572730100"/>
  </TfrxDataPage>
