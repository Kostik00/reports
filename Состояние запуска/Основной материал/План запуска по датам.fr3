  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxERQuery Name="PlnQRY" UserName="PlnQRY" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT     &#13;&#10;       T_VPredm_Izdel.Cod_Predm AS Cod_PredmIzdel, &#13;&#10;       P_VKZ_Izdel.Cod_Zak, &#13;&#10;       P_VKZ.DataZap, &#13;&#10;       T_VPredm.Cod_Predm, &#13;&#10;       T_VPredm.Name_Predm, &#13;&#10;       T_VPredm.Cod_Prin,&#13;&#10;       T_VPredm.Name_K_Prin,&#13;&#10;	   Convert (varchar,P_VKZ.DataZap,112) DateStr,&#13;&#10;&#13;&#10;        PredmM.Cod_Predm 	AS Cod_PredmM,&#13;&#10;        PredmM.Name_Predm 	AS Name_PredmM,&#13;&#10;        PredmM.PrintFlag AS PrintFlagM,                                                                &#13;&#10;&#13;&#10;        PredmM.Sortam SortamM,&#13;&#10;        PredmM.Type_NTD_Sortam AS Type_NTD_SortamM,&#13;&#10;        PredmM.Name_NTD_Sortam AS Name_NTD_SortamM,&#13;&#10;          &#13;&#10;        PredmM.Marka MarkaM,&#13;&#10;        PredmM.Type_NTD_Marka AS Type_NTD_MarkaM,&#13;&#10;        PredmM.Name_NTD_Marka AS Name_NTD_MarkaM,&#13;&#10;        T_SPROWS.Prof_Razm,&#13;&#10;        dbo.Pr_VKZ_Get_Kolvo_Zap(P_VKZ.Key_VKZ) Kolvo_Zap,&#13;&#10;        P_VKZ.Kolvo            &#13;&#10;FROM         &#13;&#10;       P_VKZ INNER JOIN T_VPredm &#13;&#10;               ON P_VKZ.Key_Predm = T_VPredm.Key_Predm &#13;&#10;       INNER JOIN P_VKZ AS P_VKZ_Izdel &#13;&#10;               ON P_VKZ.Key_VKZ_Izdel = P_VKZ_Izdel.Key_VKZ &#13;&#10;       INNER JOIN T_VPredm AS T_VPredm_Izdel &#13;&#10;               ON P_VKZ_Izdel.Key_Predm = T_VPredm_Izdel.Key_Predm&#13;&#10;&#13;&#10;	   LEFT JOIN dbo.T_SPRows T_SPRows &#13;&#10;				ON T_SPRows.Key_SP = P_VKZ.Key_SP&#13;&#10;				AND T_SPRows.SP_position = 0&#13;&#10;	   LEFT JOIN T_VPredm AS PredmM&#13;&#10;               ON T_SPRows.Key_Predm = PredmM.Key_Predm&#13;&#10;			&#13;&#10;&#13;&#10;                 &#13;&#10;WHERE     &#13;&#10;       P_VKZ.DataZap     &#62;= :DateFrom                                    &#13;&#10;       AND P_VKZ.DataZap &#60;= :DateTo&#13;&#10;       AND P_VKZ.Cod_Postav = '1'                                             &#13;&#10;       AND  ((IsNull(dbo.Pr_VKZ_Get_Kolvo_Zap(P_VKZ.Key_VKZ),0) &#60; P_VKZ.Kolvo) or (:PrintZap = 1))&#13;&#10;       AND P_VKZ_Izdel.LockDT = 1&#13;&#10;       AND P_VKZ_Izdel.Cod_SosZ = 'Ä'                                                          &#13;&#10;         &#13;&#10;ORDER by DateStr, T_VPredm_Izdel.OrderCod_Predm, T_VPredm.OrderCod_Predm, &#13;&#10;       T_VPredm.Name_Predm  " PropData=""/>
  </TfrxDataPage>
